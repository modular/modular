        "lib/DeviceContext/MojoBindings.cpp",
    ],
    hdrs = [
        "include/AsyncRT/DeviceContext/BinaryID.h",
    ],
    output_name = "AsyncRTMojoBindings",
    deps = [
        ":DeviceContext.headers",
        ":DeviceContextImpl",
        "//Support:BinaryID",
    ],
