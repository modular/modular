modular_cc_library(
    name = "Runtime",
    srcs = glob(["lib/Runtime/*.cpp"]),
    hdrs = glob([
        "include/AsyncRT/Runtime/Globals/*.h",
        "include/AsyncRT/Runtime/*.h",
    ]) + [
        "include/AsyncRT/ForwardDecls.h",
    ],
    local_defines = select({
        "//:asyncrt_no_affinity_setting": ["ASYNCRT_NO_AFFINITY=1"],
        "//conditions:default": [],
    }) + select({
        ":worker_stats_setting": ["ASYNCRT_WORKER_STATS=1"],
        "//conditions:default": [],
    }),
    deps = [
        ":Runtime.headers",
        ":Support",
        "//Support:ADT",
        "//Support:Context",
        "//Support:Profiling",
    ],
)

modular_shared_library(
    name = "RuntimeGlobals",
    srcs = glob(["lib/Runtime/Globals/*.cpp"]),
    output_name = "AsyncRTRuntimeGlobals",
    deps = [
        ":Runtime.headers",
        "//Support:BinaryID",
        "//Support:SymbolExport",
        "//bazel/third-party:tcmalloc",
        "@llvm-project//llvm:Support",
    ],
)

modular_cc_library(
    name = "Support",
    srcs = glob(["lib/Support/*.cpp"]),
    hdrs = glob(["include/AsyncRT/Support/*.h"]),
    tags = ["no-clang-tidy-headers"],
    deps = [
        "//Support:MArchTarget",
        "//Support:Threading",
    ],
)

modular_cc_library(
    name = "NIXL",
    data = select({
        "//:linux_x86_64": [
            ":plugin_ucx_cpu",
            ":plugin_ucx_cuda",
            ":plugin_ucx_cuda_verbs",
            ":plugin_ucx_rocm",
            ":plugin_ucx_rocm_verbs",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":NIXLLibOnly",
        "//AsyncRT:DeviceContext",
    ],
)

modular_cc_library(
    name = "NIXLLibOnly",
    srcs = glob(
        [
            "lib/NIXL/**/*.cpp",
        ],
        exclude = [
            "lib/NIXL/plugins/ucx/**",
            "lib/NIXL/utils/ucx/**",
        ],
    ),
    hdrs = glob(
        [
            "include/AsyncRT/NIXL/**/*.h",
        ],
        exclude = [
            "include/AsyncRT/NIXL/plugins/ucx/**",
            "include/AsyncRT/NIXL/utils/ucx/**",
        ],
    ),
    include_prefix = "",
    strip_include_prefix = "include",
    tags = ["no-clang-tidy"],  # Copied code doesn't conform to our style
    visibility = ["//visibility:private"],
    deps = [
        "//AsyncRT:Support",
        "//Support:Threading",
        "@llvm-project//llvm:Support",
    ],
    # This is needed for `utils/sync-stubfiles.py` to work
    alwayslink = True,
)

modular_shared_library(
    # NOTE: currently the target name is coupled to NIXL's plugin discovery
    # logic, which looks for `libplugin_*.so`.
    name = "plugin_ucx_cpu",
    srcs = glob([
        "lib/NIXL/plugins/ucx/**",
        "lib/NIXL/utils/ucx/**",
    ]),
    hdrs = glob(
        [
            "include/AsyncRT/NIXL/plugins/ucx/**",
            "include/AsyncRT/NIXL/utils/ucx/**",
        ],
    ),
    tags = [
        ALLOW_UNUSED_TAG,
        "no-clang-tidy",  # Copied code doesn't conform to our style
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":DeviceContextImpl",
        ":NIXLLibOnly",
        ":NVPTX",
        ":Support",
        "@ucx_prebuilt//:ucx_cpu",
    ],
)

modular_shared_library(
    # NOTE: currently the target name is coupled to NIXL's plugin discovery
    # logic, which looks for `libplugin_*.so`.
    name = "plugin_ucx_cuda",
    srcs = glob([
        "lib/NIXL/plugins/ucx/**",
        "lib/NIXL/utils/ucx/**",
    ]),
    hdrs = glob(
        [
            "include/AsyncRT/NIXL/plugins/ucx/**",
            "include/AsyncRT/NIXL/utils/ucx/**",
        ],
    ),
    linkopts = select({
        # This allows us to ignore missing libcuda.so.1, libnvidia-ml.so.1 etc.
        # symbols at link time. But now it requires that they are available at
        # runtime when this plugin is loaded. This shared lib does not automatically
        # load them if they are missing. They should be loaded in advance to loading
        # this plugin.
        "@platforms//os:linux": [
            "-Wl,-z,undefs",
            "-Wl,-rpath,$ORIGIN/../../lib",
        ],
        "@platforms//os:macos": [
            "-Wl,-undefined,dynamic_lookup",
            "-Wl,-rpath,@loader_path/../../lib",
        ],
    }),
    local_defines = ["PLUGIN_UCX_CUDA"],
    tags = [
        ALLOW_UNUSED_TAG,
        "no-clang-tidy",  # Copied code doesn't conform to our style
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":DeviceContextImpl",
        ":NIXLLibOnly",
        ":NVPTX",
        ":Support",
        "@ucx_prebuilt//:ucx_cuda",
    ],
)

modular_shared_library(
    name = "plugin_ucx_cuda_verbs",
    srcs = glob([
        "lib/NIXL/plugins/ucx/**",
        "lib/NIXL/utils/ucx/**",
    ]),
    hdrs = glob(
        [
            "include/AsyncRT/NIXL/plugins/ucx/**",
            "include/AsyncRT/NIXL/utils/ucx/**",
        ],
    ),
    # Like plugin_ucx_cuda above but with additional Infiniband support.
    # We link libibverb.so directly instead of relying on user to dlopen it at
    # runtime. This is due to a weird bug where `ibv_get_device_list` would return
    # invalid contents if we do it the other way, even though it should functionally
    # be the same. Note that we have added libibverbs.so to sysroot so that the
    # CI machine have this dep at build time.
    linkopts = select({
        "@platforms//os:linux": [
            "-l:libibverbs.so.1",
            "-Wl,-z,undefs",
            "-Wl,-rpath,$ORIGIN/../../lib",
        ],
        "@platforms//os:macos": [
            "-Wl,-undefined,dynamic_lookup",
            "-Wl,-rpath,@loader_path/../../lib",
        ],
    }),
    local_defines = ["PLUGIN_UCX_CUDA"],
    tags = [
        ALLOW_UNUSED_TAG,
        "no-clang-tidy",  # Copied code doesn't conform to our style
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":DeviceContextImpl",
        ":NIXLLibOnly",
        ":NVPTX",
        ":Support",
        "@ucx_prebuilt//:ucx_cuda_verbs",
    ],
)

