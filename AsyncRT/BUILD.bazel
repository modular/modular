load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("//bazel:api.bzl", "modular_cc_library", "modular_shared_library", "tsan_variant")

# gazelle:default_visibility //AsyncRT:consumers
# gazelle:default_features layering_check,parse_headers

package(
    default_visibility = ["//AsyncRT:consumers"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

package_group(
    name = "consumers",
    packages = [
        "//AsyncRT/...",
        "//Cache/...",
        "//GraphCompiler/...",
        "//Init/...",
        "//Kernels/unittests/...",
        "//MLRT/...",
        "//Mojo/...",
        "//Target/...",
        "//bazel/...",
        "//max/...",
        "//plugins/...",
        "//utils/...",
    ],
)

bool_flag(
    name = "worker_stats",
    build_setting_default = False,
)

config_setting(
    name = "worker_stats_setting",
    flag_values = {":worker_stats": "true"},
)

bool_flag(
    name = "alloc_logging",
    build_setting_default = False,
)

config_setting(
    name = "alloc_logging_setting",
    flag_values = {":alloc_logging": "true"},
)

modular_cc_library(
    name = "CompilerSupport",
    srcs = glob(["lib/CompilerSupport/*.cpp"]),
    hdrs = glob(["include/AsyncRT/CompilerSupport/*.h"]),
    includes = ["include"],
    deps = [
        ":Runtime",
        ":Support",
        "//Support:Base",
        "//Support:Context",
        "//Support:MDialect",
        "//Support:SymbolExport",
        "//Support:Threading",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IR",
    ],
)

modular_cc_library(
    name = "Runtime",
    srcs = glob(["lib/Runtime/*.cpp"]),
    hdrs = glob([
        "include/AsyncRT/Runtime/Globals/*.h",
        "include/AsyncRT/Runtime/*.h",
    ]) + [
        "include/AsyncRT/ForwardDecls.h",
    ],
    includes = ["include"],
    local_defines = select({
        ":worker_stats_setting": ["ASYNCRT_WORKER_STATS=1"],
        "//conditions:default": ["ASYNCRT_WORKER_STATS=0"],
    }) + select({
        ":alloc_logging_setting": ["MODULAR_ALLOC_LOGGING=1"],
        "//conditions:default": ["MODULAR_ALLOC_LOGGING=0"],
    }),
    deps = [
        ":RuntimeGlobals.static",
        ":Support",
        "//Support:ADT",
        "//Support:Base",
        "//Support:ConcurrentAppendingVector",
        "//Support:Configuration",
        "//Support:Log",
        "//Support:Profiling",
        "//Support:ProfilingRanges",
        "//Support:SymbolExport",
        "//Support:Threading",
        "//Support:TimeProfiler",
        "//Support:TypeID",
        "@llvm-project//llvm:Support",
    ],
)

modular_shared_library(
    name = "RuntimeGlobals",
    srcs = glob(["lib/Runtime/Globals/*.cpp"]),
    hdrs = glob([
        "include/AsyncRT/Runtime/Globals/*.h",
        "include/AsyncRT/Runtime/*.h",
    ]) + [
        "include/AsyncRT/ForwardDecls.h",
    ],
    dynamic_deps = [
        "//Support:Globals",
        "//bazel/internal:LLVMSupport",
    ] + select({
        "//bazel/internal:profiling_off": [],
        # TimeProfiler describes the host with clang, in profiling builds only.
        "//conditions:default": [
            "@llvm-project//clang:clangBasic",
            "@llvm-project//llvm:LLVM",
        ],
    }),
    exports_filter = [
        "//Support:ExternalProfilerAnnotationHostGlue",
        "//Support:ProfilerHostGlue",
        "@abseil-cpp//:__subpackages__",
    ],
    includes = ["include"],
    # The host glue overrides weak defaults in //Support:ProfilingRanges, which
    # only works within one link, so it lives beside them. internal_deps: the
    # OSS build drops it and keeps the inert weak defaults.
    internal_deps = [
        "//Support:ExternalProfilerAnnotationHostGlue",
        "//Support:ProfilerHostGlue",
    ],
    # Under TSan the system allocator replaces tcmalloc, whose load-time arena
    # mmap lands in TSan shadow memory (MOCO-5030). The library then installs
    # under lib/tsan/ with the same SONAME, so `mojo build --sanitize thread`
    # swaps it in through an rpath.
    local_defines = select({
        "//:tsan_linux": ["ASYNCRT_TSAN_SYSTEM_MALLOC=1"],
        "//conditions:default": ["ASYNCRT_TSAN_SYSTEM_MALLOC=0"],
    }),
    output_name = "AsyncRTRuntimeGlobals",
    shared_lib_name = select({
        "//:tsan_linux": "tsan/libAsyncRTRuntimeGlobals.so",
        "//conditions:default": "libAsyncRTRuntimeGlobals.so",
    }),
    visibility = [
        ":consumers",
        "//mach/crates/max-sys-internal:__pkg__",
    ],
    # Shared by CompilerRT and //MLRT:Driver/Compilation, which can load
    # without each other.
    exports = [
        ":Support",
        "//Config",
        "//Support:ADT",
        "//Support:Base",
        "//Support:BazelRunfiles",
        "//Support:Buffer",
        "//Support:CPUCache",
        "//Support:Configuration",
        "//Support:DLFcn",
        "//Support:DeviceSpecs",
        "//Support:Filesystem",
        "//Support:Profiling",
        "//Support:ProfilingRanges",
        "//Support:Threading",
        "//Support:TimeProfiler",
        "//Support:TypeID",
        "@abseil-cpp//absl/debugging:symbolize",
        "@abseil-cpp//absl/hash",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:cord",
        "@abseil-cpp//absl/strings:str_format",
        "@rules_cc//cc/runfiles",
    ] + select({
        # TimeProfiler links it only in profiling builds.
        "//bazel/internal:profiling_off": [],
        "//conditions:default": ["//Support:MArchTargetMinimal"],
    }),
    deps = [
        ":Support",
        "//Support:ADT",
        "//Support:Base",
        "//Support:BinaryID",
        "//Support:SymbolExport",
        "//Support:Threading",
        "//Support:TimeProfiler",
        "//Support:TypeID",
        "@llvm-project//llvm:Support",
    ] + select({
        "//:tsan_linux": [],
        "//conditions:default": [
            "//bazel/internal:tcmalloc_numa_aware",
            "//bazel/internal:tcmalloc_want_numa_aware",
        ],
    }),
)

# The TSan build of RuntimeGlobals, for `mojo build --sanitize thread` (see
# the selects in RuntimeGlobals above).
tsan_variant(
    name = "RuntimeGlobalsTSan",
    testonly = True,
    src = ":RuntimeGlobals",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

tsan_variant(
    name = "RuntimeGlobalsTSan.stripped",
    src = ":RuntimeGlobals.stripped",
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
)

modular_cc_library(
    name = "Support",
    srcs = glob(["lib/Support/*.cpp"]),
    hdrs = glob(["include/AsyncRT/Support/*.h"]),
    includes = ["include"],
    deps = [
        "//Support:Base",
        "//Support:SymbolExport",
        "//Support:Threading",
        "@llvm-project//llvm:Support",
    ],
)

# Carries jemalloc's malloc/free definitions so the `max` CLI can LD_PRELOAD
# them. Linux only: replacing malloc this way is a glibc-specific path.
modular_shared_library(
    name = "JemallocPreload",
    srcs = ["lib/JemallocPreload/JemallocPreload.cpp"],
    output_name = "jemalloc_preload",
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//bazel/internal:jemalloc_global"],
)
