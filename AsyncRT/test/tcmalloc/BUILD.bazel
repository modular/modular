load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//bazel:api.bzl", "modular_cc_test", "mojo_binary")

# gazelle:default_visibility //visibility:private
package(
    default_visibility = ["//visibility:private"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

# Minimal Mojo program. The runtime links tcmalloc, which reads
# /sys/devices/system/cpu at startup.
mojo_binary(
    name = "minimal_mojo_program",
    testonly = True,
    srcs = ["minimal.mojo"],
    deps = ["@mojo//:std"],
)

# The program must start with /sys/devices/system/cpu hidden. Linux-only:
# the masking uses user+mount namespaces and the bug is Linux-specific.
sh_test(
    name = "mojo_runs_without_sys_cpu",
    srcs = ["run_without_sys_cpu.sh"],
    args = ["$(rootpath :minimal_mojo_program)"],
    data = [":minimal_mojo_program"],
    # Needs unprivileged user namespaces, which GitHub-hosted runners don't
    # allow; the script fails rather than skips without them.
    tags = ["skip-external-ci"],
    target_compatible_with = ["@platforms//os:linux"],
)

# An allocation must not crash when the frame pointer register holds the end of
# the stack, as Mojo code may leave it. x86-64 only: the test sets %rbp.
modular_cc_test(
    name = "bogus_frame_pointer_test",
    size = "small",
    srcs = ["bogus_frame_pointer_test.cpp"],
    dynamic_deps = [
        "@llvm-project//llvm:LLVM",
        "//AsyncRT:RuntimeGlobals",
        "//Support:Globals",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//AsyncRT:RuntimeGlobals.static",
        "//Support:Globals.static",
    ],
)
