load("//bazel:api.bzl", "modular_cc_binary")

package(
    default_visibility = ["//AsyncRT:__subpackages__"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

modular_cc_binary(
    name = "crash-report-path-info",
    srcs = glob(["*.cpp"]),
    dynamic_deps = [
        "@llvm-project//llvm:LLVM",
        "//AsyncRT:RuntimeGlobals",
        "//Support:Globals",
        "@llvm-project//mlir:MLIR",
    ],
    deps = [
        "//AsyncRT:RuntimeGlobals.static",
        "//Init",
        "//Support:Base",
        "//Support:Configuration",
        "//Support:CrashReporting",
        "//Support:Globals.static",
        "@llvm-project//llvm:Support",
    ],
)
