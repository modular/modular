        "//Support:Globals",
    ],
)

modular_cc_test(
    name = "DeviceContextTest",
    size = "small",
    srcs = ["DeviceContextTest.cpp"],
    deps = [
        ":TestUtils",
        "//AsyncRT:DeviceContextImpl",
    ],
)

modular_cc_test(
    name = "GPUDeviceContextTest",
