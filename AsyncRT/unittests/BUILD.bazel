load("//bazel:api.bzl", "modular_cc_library", "modular_cc_test")

# Header adding test helpers for using gtest with `ErrorOr<T>`.
modular_cc_library(
    name = "TestUtils",
    testonly = True,
    hdrs = [
        "TestUtils.h",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "@llvm-project//third-party/unittest:gtest_main",
    ],
)

modular_cc_test(
    name = "AllocatorTest",
    timeout = "short",
    srcs = ["AllocatorTest.cpp"],
    deps = [
        "//AsyncRT:Runtime",
        "//AsyncRT:RuntimeGlobals",
        "//Support:Globals",
    ],
)

modular_cc_test(
    name = "AsyncValueTest",
    size = "small",
    srcs = ["AsyncValueTest.cpp"],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//AsyncRT:Runtime",
        "//AsyncRT:RuntimeGlobals",
        "//Support:Globals",
    ],
)

modular_cc_test(
    name = "DebuggingAllocatorsTest",
