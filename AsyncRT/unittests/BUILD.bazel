load("//bazel:api.bzl", "modular_cc_library", "modular_cc_test")

# Header adding test helpers for using gtest with `ErrorOr<T>`.
modular_cc_library(
    name = "TestUtils",
    testonly = True,
    hdrs = [
        "TestUtils.h",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "@llvm-project//third-party/unittest:gtest_main",
    ],
)

modular_cc_test(
    name = "AllocatorTest",
    timeout = "short",
    srcs = ["AllocatorTest.cpp"],
    deps = [
        "//AsyncRT:Runtime",
        "//AsyncRT:RuntimeGlobals",
        "//Support:Base",
        "//Support:Globals",
    ],
)

modular_cc_test(
    name = "AsyncValueTest",
    size = "small",
    srcs = ["AsyncValueTest.cpp"],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//AsyncRT:Runtime",
        "//AsyncRT:RuntimeGlobals",
        "//AsyncRT:Support",
        "//Support:Globals",
        "@llvm-project//llvm:Support",
    ],
)

modular_cc_test(
    name = "BufferCacheTest",
    size = "small",
    srcs = [
        "BufferCacheTest.cpp",
        "ScopedEnvVar.h",
    ],
    env = {
        # Set up consistent buffer cache environment for testing
        "MODULAR_DEVICE_CONTEXT_BUFFER_CACHE_SIZE": "25",
        "MODULAR_DEVICE_CONTEXT_BUFFER_CACHE_CHUNK_PERCENT": "25",
        "MODULAR_DEVICE_CONTEXT_BUFFER_CACHE_SELF_CHECK": "True",
        "MODULAR_DEVICE_CONTEXT_BUFFER_CACHE_LOG": "False",
    },
    deps = [
        ":TestUtils",
        "//AsyncRT:DeviceContextImpl",
        "@llvm-project//llvm:Support",
    ],
)

