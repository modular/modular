# When set, GPU tests disable MAX's device memory manager (caching allocator)
# so each `enqueue_create_buffer` is a 1:1 device allocation and
# compute-sanitizer memcheck/initcheck see true per-buffer bounds. Without this,
# small OOBs and OOB reads land inside the shared ~205MB pool and go undetected.
# Consumed by `get_default_test_env` in bazel/internal/config.bzl.
bool_flag(
    name = "gpu_disable_memory_manager",
    build_setting_default = False,
    tags = [ALLOW_UNUSED_TAG],
)

config_setting(
    name = "gpu_memory_manager_disabled",
    flag_values = {"//:gpu_disable_memory_manager": "true"},
    tags = [ALLOW_UNUSED_TAG],
)

# Tracy profiling config family, mirrored from the internal //BUILD.bazel so the
# shared source (Kernels/Support/max) that selects on these resolves when built
# from source in OSS (SDLC-4549).
bool_flag(
    name = "tracy_profiling",
    build_setting_default = False,
    tags = [ALLOW_UNUSED_TAG],
)

config_setting(
    name = "tracy_enabled",
    flag_values = {"//:tracy_profiling": "true"},
    tags = [ALLOW_UNUSED_TAG],
)

config_setting(
    name = "tracy_disabled",
    flag_values = {"//:tracy_profiling": "false"},
    tags = [ALLOW_UNUSED_TAG],
)

string_flag(
    name = "tracy_verbosity",
    build_setting_default = "0",
    tags = [ALLOW_UNUSED_TAG],
    values = [
        "0",
        "1",
        "2",
    ],
)

config_setting(
    name = "tracy_verbosity_1",
    flag_values = {"//:tracy_verbosity": "1"},
    tags = [ALLOW_UNUSED_TAG],
)

config_setting(
    name = "tracy_verbosity_2",
    flag_values = {"//:tracy_verbosity": "2"},
    tags = [ALLOW_UNUSED_TAG],
)

selects.config_setting_group(
    name = "tracy_cuda_enabled",
    match_all = [
        ":tracy_enabled",
        ":nvidia_gpu",
    ],
)

selects.config_setting_group(
    name = "tracy_rocm_enabled",
    match_all = [
        ":tracy_enabled",
        ":amd_gpu",
    ],
)

selects.config_setting_group(
    name = "linux_x86_64_no_tracy",
    match_all = [
        ":linux_x86_64",
        ":tracy_disabled",
    ],
)

