load("//bazel:api.bzl", "modular_cc_library")

modular_cc_library(
    name = "Cache",
    srcs = glob(["lib/**/*.cpp"]),
    hdrs = glob(["include/Cache/**/*.h"]),
    copts = [
        # TODO(35394): This isn't what cmake is doing
        '-DMODULAR_DERIVED_DIR=\\"/tmp/modularderived\\"',
    ],
    deps = [
        "//AsyncRT:CompilerSupport",
        "//AsyncRT:Runtime",
        "//Support:Base",
        "//Support:Base64",
        "//Support:Buffer",
        "//Support:Compiler",
        "//Support:Configuration",
        "//Support:HTTP",
        "//Support:Telemetry",
        "//Support:URI",
        "@llvm-project//mlir:BytecodeWriter",
        "@llvm-project//mlir:Pass",
    ],
)
