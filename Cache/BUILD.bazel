load("@llvm-project//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

cc_library(
    name = "Cache",
    srcs = glob(["lib/*.cpp"]),
    # TODO: I don't think we want a recursive glob here
    hdrs = glob(["include/Cache/**/*.h"]),
    copts = [
        # TODO(35394): This isn't what cmake is doing
        '-DMODULAR_DERIVED_DIR=\\"/tmp/modularderived\\"',
    ],
    strip_include_prefix = "include",
    deps = [
        "//LLCL:Runtime",
        "//Support:Base64",
        "//Support:Buffer",
        "//Support:Configuration",
        "//Support:HMAC",
        "//Support:URI",
    ],
)

cc_library(
    name = "Backends",
    srcs = glob(["lib/Backends/*.cpp"]),
    hdrs = glob(["include/Cache/Backends/*.h"]),
    strip_include_prefix = "include",
    deps = ["//Support:HTTP"],
)

td_library(
    name = "CacheTdFiles",
    srcs = glob(["include/Cache/CacheDialect/*.td"]),
    includes = ["include"],
    deps = [
        "@llvm-project//mlir:BuiltinDialectTdFiles",
    ],
)

gentbl_cc_library(
    name = "CacheTypes",
    strip_include_prefix = "include",
    tbl_outs = [
        (
            [
                "-gen-op-decls",
            ],
            "include/Cache/CacheDialect/Cache.h.inc",
        ),
        (
            [
                "-gen-op-defs",
            ],
            "include/Cache/CacheDialect/Cache.cpp.inc",
        ),
        (
            [
                "-gen-dialect-defs",
                "-dialect=cache",
            ],
            "include/Cache/CacheDialect/CacheDialect.cpp.inc",
        ),
        (
            [
                "-gen-dialect-decls",
                "-dialect=cache",
            ],
            "include/Cache/CacheDialect/CacheDialect.h.inc",
        ),
        (
            [
                "-gen-typedef-defs",
                "-typedefs-dialect=cache",
            ],
            "include/Cache/CacheDialect/CacheTypes.cpp.inc",
        ),
        (
            [
                "-gen-typedef-decls",
                "-typedefs-dialect=cache",
            ],
            "include/Cache/CacheDialect/CacheTypes.h.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/Cache/CacheDialect/Cache.td",
    deps = [":CacheTdFiles"],
)

gentbl_cc_library(
    name = "CacheAttrs",
    strip_include_prefix = "include",
    tbl_outs = [
        (
            [
                "-gen-attrdef-decls",
                "-dialect=cache",
            ],
            "include/Cache/CacheDialect/CacheAttrs.h.inc",
        ),
        (
            [
                "-gen-attrdef-defs",
                "-dialect=cache",
            ],
            "include/Cache/CacheDialect/CacheAttrs.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/Cache/CacheDialect/CacheAttrs.td",
    deps = [":CacheTdFiles"],
)

gentbl_cc_library(
    name = "CacheAttrInterfaces",
    strip_include_prefix = "include",
    tbl_outs = [
        (
            [
                "-gen-attr-interface-decls",
            ],
            "include/Cache/CacheDialect/CacheAttrInterfaces.h.inc",
        ),
        (
            [
                "-gen-attr-interface-defs",
            ],
            "include/Cache/CacheDialect/CacheAttrInterfaces.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/Cache/CacheDialect/CacheAttrInterfaces.td",
    deps = [":CacheTdFiles"],
)

td_library(
    name = "CachePassesTdFiles",
    srcs = glob(["include/Cache/CachePasses/*.td"]),
    includes = ["include"],
    deps = [
        "@llvm-project//mlir:PassBaseTdFiles",
    ],
)

gentbl_cc_library(
    name = "CachePassesTd",
    strip_include_prefix = "include",
    tbl_outs = [
        (
            [
                "-gen-pass-decls",
            ],
            "include/Cache/CachePasses/CachePasses.h.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/Cache/CachePasses/CachePasses.td",
    deps = [":CachePassesTdFiles"],
)

cc_library(
    name = "CachePasses",
    srcs = ["lib/CachePasses/CachePasses.cpp"],
    hdrs = ["include/Cache/CachePasses/CachePasses.h"],
    strip_include_prefix = "include",
    deps = [
        ":CacheDialect",
        ":CachePassesTd",
        "//Support:Base",
        "@llvm-project//mlir:FuncDialect",
        "@llvm-project//mlir:Pass",
    ],
)

cc_library(
    name = "CacheDialect",
    srcs = glob(["lib/CacheDialect/*.cpp"]),
    hdrs = glob(["include/Cache/CacheDialect/*.h"]),
    strip_include_prefix = "include",
    deps = [
        ":Cache",
        ":CacheAttrInterfaces",
        ":CacheAttrs",
        ":CacheTypes",
        "//LLCL:CompilerSupport",
        "//Support:Compiler",
        "//Support:MDialect",
        "@llvm-project//mlir:AsmParser",
        "@llvm-project//mlir:Pass",
    ],
)

cc_test(
    name = "CacheTest",
    srcs = glob(["unittests/*.cpp"]),
    deps = [
        ":Backends",
        ":Cache",
        ":CacheDialect",
        ":CachePasses",
        "@com_github_google_googletest//:gtest_main",
        "@llvm-project//mlir:BytecodeWriter",
        "@llvm-project//mlir:FuncDialect",
    ],
)
