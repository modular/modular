        "//AsyncRT:Runtime",
        "//AsyncRT:Support",
        "//Config",
        "//Support:Base",
        "//Support:Base64",
        "//Support:Buffer",
        "//Support:Compiler",
        "//Support:Configuration",
        "//Support:Context",
        "//Support:Filesystem",
        "//Support:HTTP",
        "//Support:HashUtils",
        "//Support:Telemetry",
        "//Support:URI",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:AsmParser",
        "@llvm-project//mlir:BytecodeWriter",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:Support",
    ],
)
