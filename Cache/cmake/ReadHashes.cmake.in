# Read the contents from @FILENAME@. They should be a collection of hashes
# from `cache-mgr`. It expects something like `HASH1234;HASH3456;` as the
# contents of the file.
file(READ @FILENAME@ HASH_CONTENT)
# Strip trailing `;` - `cache-mgr` uses semicolons to delimit the list because
# that's what CMake does, but it also inserts one at the end, and CMake doesn't
# like that so we strip it off.
string(REPLACE ";" " " HASHES ${HASH_CONTENT})
string(STRIP ${HASHES} HASHES)
string(REPLACE " " ";" HASHES ${HASHES})
# Turn the configured variable into a list explicitly (it should be one already
# but CMake is weird about it sometimes).
list(APPEND NAMES_LIST "@NAMES@")
# Since we don't have ZIP_LISTS, we have to iterate by index.
list(LENGTH HASHES hashes_len)
# CMake RANGE statement is inclusive, so set the end to the last index, which
# is len - 1
math(EXPR hashes_len "${hashes_len} - 1")
# Setup the #define statements that we're going to jam into the header file.
set(STMTS)
set(STMTS "#include \"llvm/ADT/StringRef.h\"\n")
set(STMTS "${STMTS}\nnamespace M::CASID {\n")
foreach (idx RANGE ${hashes_len})
  list(GET NAMES_LIST ${idx} name)
  list(GET HASHES ${idx} hash)
  set(STMTS "${STMTS}inline constexpr llvm::StringLiteral ${name} = \"${hash}\";\n")
endforeach()
set(STMTS "${STMTS}}\n")

# Configure the header file with the #define statements we just created.
get_filename_component(OUTFILE @OUTFILE@ NAME_WE)
set(CONTENTS
"//===----------------------------------------------------------------------===//
//
// This file is Modular Inc proprietary.
//
//===----------------------------------------------------------------------===//
// THIS FILE IS AUTOGENERATED
//===----------------------------------------------------------------------===//

#ifndef ${OUTFILE}_H
#define ${OUTFILE}_H

${STMTS}

#endif // ${OUTFILE}_H")

file(WRITE @TMPFILE@ "${CONTENTS}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different @TMPFILE@ @OUTFILE@)
file(REMOVE @TMPFILE)
