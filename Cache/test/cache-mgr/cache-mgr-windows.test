# RUN: cache-mgr -base-dir=%t -input="tV5NLrcFHYiZClV58DGhuHgoxuIfxTgClA4ngQbC6EI=" -o=%t/some_file_from_cas_windows.txt && cat %t/some_file_from_cas_windows.txt | FileCheck %s --check-prefix=GET-FILE

# The hex encoding below is a hash of "tV5NLrcFHYiZClV58DGhuHgoxuIfxTgClA4ngQbC6EI="
# To reproduce: `echo "tV5NLrcFHYiZClV58DGhuHgoxuIfxTgClA4ngQbC6EI=" | base64 -d | xxd -p`
