load("//bazel:api.bzl", "modular_cc_binary")

package(
    default_visibility = ["//Cache:__subpackages__"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

modular_cc_binary(
    name = "cache-mgr",
    srcs = glob(["*.cpp"]),
    deps = [
        "//Cache",
        "//Init",
        "//MLRT:AsyncRT/Runtime",
        "//MLRT:AsyncRT/RuntimeGlobals",
        "//MLRT:AsyncRT/Support",
        "//Support:Base",
        "//Support:CommonCLOptions",
        "//Support:Context",
        "//Support:Globals",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:Support",
    ],
)
