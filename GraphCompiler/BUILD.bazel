# TODO: Move deeper into subdirectories, this being so high up is wack.
# Circular dependency between these two directories, so we need to be
# mindful.
modular_cc_library(
    name = "GraphCompilerConversion",
    srcs = glob(
        ["lib/Conversion/*.cpp"],
        # OperandInference and ParameterInference are their own targets.
        exclude = [
            "lib/Conversion/OperandInference.cpp",
            "lib/Conversion/ParameterInference.cpp",
        ],
    ),
    hdrs = glob(
        ["include/GraphCompiler/Conversion/*.h"],
        exclude = [
            "include/GraphCompiler/Conversion/OperandInference.h",
            "include/GraphCompiler/Conversion/ParameterInference.h",
        ],
    ) + [
        # MGPTransforms consumes this pass header but cannot depend on the
        # :MOGGToMGP target (that would cycle), so re-export it here as before.
        "include/GraphCompiler/Conversion/MOGGToMGP/MOGGToMGP.h",
    ],
    tags = ["no-clang-tidy-headers"],
    deps = [
        ":MOGGToMGPIncGen",
        ":MOSHDialect",
        "//Mojo:KGENDialect",
        "//Support:Base",
        "//Support:Compiler",
        "@llvm-project//llvm:Support",
    ],
)

# Shared operand inference used by both the MO->MOGG and MO->MAP lowering paths.
# Depends only on MOGGDialect.headers (not the MOGGDialect impl) so it does not
# cycle with MOGGDialect, which consumes it.
modular_cc_library(
    name = "OperandInference",
    srcs = ["lib/Conversion/OperandInference.cpp"],
    hdrs = ["include/GraphCompiler/Conversion/OperandInference.h"],
    copts = ["-fvisibility=default"],
    deps = [
        ":MODialect",
        ":MOGGDialect.headers",
    ],
)

# Shared parameter inference used by both the MO->MOGG and MO->MAP lowering
# paths: derives a kernel's parameter dictionary from an MO op's attributes and
# infers a kernel's Mojo call parameters. Like OperandInference it depends only
# on MOGGDialect.headers (not the MOGGDialect impl) so it does not cycle with
# MOGGDialect, which consumes it.
modular_cc_library(
    name = "ParameterInference",
    srcs = ["lib/Conversion/ParameterInference.cpp"],
    hdrs = ["include/GraphCompiler/Conversion/ParameterInference.h"],
    copts = ["-fvisibility=default"],
    deps = [
        ":MODialect",
        ":MOGGDialect.headers",
        "//Mojo:KGENDialect",
        "//Mojo:LITDialect",
    ],
)

