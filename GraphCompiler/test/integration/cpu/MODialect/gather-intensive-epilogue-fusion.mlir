  %data_add_zero = mo.add(%zero, %data) : !mo.tensor<[12, 2], f32>
  %gather = mo.gather(%data_add_zero, %indices) [axis = 0] : (!mo.tensor<[12, 2], f32>, !mo.tensor<[2, 5, 4], ui32>) -> !mo.tensor<[2, 5, 4, 2], f32>
