// RUN: mo-opt %s --gc-pipeline="constant-fold=false" -o %t.mlir
// RUN: mt --execute --model-inputs=ones --result-output-style=full %t.mlir | FileCheck %s

// RUN: cat %t.mlir | FileCheck %s --check-prefix=CHECK-IR

// Generated from numpy:
// np.sum(input, axis=axis,  keepdims=True) where:
// input = np.arange(...)
// For all axes and input / indices shapes in the range:
// input_data_shapes = [(3), (128,), (2, 2),
//                       (1, 4), (32, 4), (3, 9, 16),
//                      (4, 5, 2, 3), (9, 5, 1, 1, 1, 1, 36)]

// We skip reductions along dims of 1 as MO folds those.

mo.graph @reduce_add_inshape_3_axis_0_test() -> (!mo.tensor<[1], ui32>) {
  %data = mo.constant <#M.dense_array<0,1,2> : tensor<3xui32>> : !mo.tensor<[3], ui32>
  %res = mo.reduce.add(%data) : (!mo.tensor<[3], ui32>) -> !mo.tensor<[1], ui32>
  mo.output %res : !mo.tensor<[1], ui32>
}

