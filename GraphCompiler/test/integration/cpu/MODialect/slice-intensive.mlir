// input_data_shapes = [(3, 11, 5)]
// start_stop_step = [
//        [(0, 0, 0), (2, -4, 3), (1, 1, 1)],
//        [(2, -4, 3), (0, 0, 0), (-1, -1, -1)],
//        [(1, 10, 0), (3, 0, 3), (1, -3, 2)],
//        [(3, 0, 3), (1, 10, 0), (-1, 3, -2)],
