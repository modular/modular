  %g2 = mo.constant <#M.dense_array<1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0, 1.0, 0.5, 2.0, -1.0> : tensor<128xf32>> : !mo.tensor<[128], f32>
