// RUN: mo-opt %s --mlir-very-unsafe-disable-verifier-on-parsing --gc-pipeline="constant-fold=false default-device-label=gpu" -o %t.mlir
// RUN: mt --execute --default-device-label=gpu --result-output-style=full %t.mlir | FileCheck %s

// The MAP IR names kernels the pipeline imports, so the parser can't verify
// it first.

// rms_norm(rms_norm(x) + residual) written as MAP IR, with a row cache: the
// cache computes h = rms_norm(x, g1) + r once per element and stores it,
// the second fold sums h * h from the cache, and the map phase writes
// y = rms_norm(h, g2) from it. Each row's mean square is 4 for both x and h,
// so the results are exact. The rows have 128 elements, which keeps the tile
// in registers on a GPU.

// Rows of x: [2, -2] * 64 and [4, 0, 0, 0] * 32; r makes h [2, -2] * 64 and
// [0, 4, 0, 0] * 32; g1 is 1 and g2 is [1, 0.5, 2, -1] * 32.
// CHECK{LITERAL}: 'residual' returned tensor<2x128xf32> [1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 1.000000e+00, -5.000000e-01, 2.000000e+00, 1.000000e+00, 0.000000e+00, 1.000000e+00, 0.000000e+00, -0.000000e+00, 0.000000e+00, 1.000000e+00, 0.000000e+00, -0.000000e+00, 0.00