      row     (%row: !map.index<2>) -> (!mo.tensor<[2, 128], f32>, !mo.tensor<[2, 128], f32>) {
    %acc = map.iter.reduce @builtin_kernels.monoids.ReduceSum index (%i: !map.index<2>) -> f32 {
      %v = map.load %x[%i] : !mo.tensor<[2, 128], f32>
      %sq = map.call.elementwise @builtin_kernels.elementwise.Mul(%i, %v, %v) : !map.index<2>, f32, f32 -> f32
      map.yield %sq : f32
    }
    %si = map.index.broadcast<#map.index.broadcast.spec<[] -> [2, 1]>> (%row) : !map.index<2> -> !map.index<0>
    %nv = map.load %n[%si] : !mo.tensor<[], f32>
    %ms = map.call.elementwise @builtin_kernels.elementwise.Div(%row, %acc, %nv) : !map.index<2>, f32, f32 -> f32
    %inv = map.call.elementwise @builtin_kernels.elementwise.Rsqrt(%row, %ms) : !map.index<2>, f32 -> f32
    %c = map.iter.cache index (%k: !map.index<2>) -> f32 {
      %v = map.load %x[%k] : !mo.tensor<[2, 128], f32>
      %nx = map.call.elementwise @builtin_kernels.elementwise.Mul(%k, %v, %inv) : !map.index<2>, f32, f32 -> f32
      %gi = map.index.broadcast<#map.index.broadcast.spec<[128] -> [2, 128]>> (%k) : !map.index<2> -> !map.index<1>
      %gv = map.load %g1[%gi] : !mo.tensor<[128], f32>
      %y = map.call.elementwise @builtin_kernels.elementwise.Mul(%k, %nx, %gv) : !map.index<2>, f32, f32 -> f32
      %rv = map.load %res[%k] : !mo.tensor<[2, 128], f32>
      %hv = map.call.elementwise @builtin_kernels.elementwise.Add(%k, %y, %rv) : !map.index<2>, f32, f32 -> f32
      map.store %h[%k] = %hv : !mo.tensor<[2, 128], f32>
      map.yield %hv : f32
    }
    %acc2 = map.iter.reduce @builtin_kernels.monoids.ReduceSum index (%i: !map.index<2>) -> f32 {
      %hv = map.iter.cache.load %c[%i] : !map.index<2>, f32
      %sq = map.call.elementwise @builtin_kernels.elementwise.Mul(%i, %hv, %hv) : !map.index<2>, f32, f32 -> f32
      map.yield %sq : f32
    }
    %ms2 = map.call.elementwise @builtin_kernels.elementwise.Div(%row, %acc2, %nv) : !map.index<2>, f32, f32 -> f32
    %inv2 = map.call.elementwise @builtin_kernels.elementwise.Rsqrt(%row, %ms2) : !map.index<2>, f32 -> f32
    map.iter.map index (%j: !map.index<2>) {
      %hv = map.iter.cache.load %c[%j] : !map.index<2>, f32
      %nh = map.call.elementwise @builtin_kernels.elementwise.Mul(%j, %hv, %inv2) : !map.index<2>, f32, f32 -> f32
      %gi = map.index.broadcast<#map.index.broadcast.spec<[128] -> [2, 128]>> (%j) : !map.index<2> -> !map.index<1>
      %gv = map.load %g2[%gi] : !mo.tensor<[128], f32>
      %y = map.call.elementwise @builtin_kernels.elementwise.Mul(%j, %nh, %gv) : !map.index<2>, f32, f32 -> f32
      map.store %out[%j] = %y : !mo.tensor<[2, 128], f32>
    }
  }
  mo.output %r#0, %r#1 : !mo.tensor<[2, 128], f32>, !mo.tensor<[2, 128], f32>
}
