// RUN: mo-opt %s | FileCheck %s
// RUN: mo-opt %s | mo-opt

// Test we can parse the custom mogg operations.
// CHECK: mogg.kernel.decl @kernels.matmul

!Bool = !lit.struct<@std::@builtin::@bool::@Bool>
!ComputeOutputFusion = !lit.trait<@extensibility::@managed_tensor_slice::@ComputeOutputFusion>
!DType = !lit.struct<@std::@builtin::@dtype::@DType>
!DeviceContext = !lit.struct<@std::@gpu::@host::@device_context::@DeviceContext>
!Error = !lit.struct<@std::@builtin::@error::@Error>
!IO = !lit.struct<@extensibility::@managed_tensor_slice::@IO>
!InputFusion = !lit.trait<@extensibility::@managed_tensor_slice::@InputFusion>
!Int = !lit.struct<@std::@builtin::@int::@Int>
!OutputFusion = !lit.trait<@extensibility::@managed_tensor_slice::@OutputFusion>
!TensorLayout = !lit.trait<@layout::@tile_layout::@TensorLayout>
#IOSpec = #lit<symbol@extensibility::@managed_tensor_slice::@IOSpec>
#ManagedTensorSlice = #lit<symbol@extensibility::@managed_tensor_slice::@ManagedTensorSlice>
#Origin = #lit<symbol@std::@builtin::@type_aliases::@Origin>
#StaticTensorSpec = #lit<symbol@extensibility::@managed_tensor_slice::@StaticTensorSpec>
#StringSpan = #lit<symbol@std::@collections::@string::@string_span::@StringSpan>
#alias_StaticConstantOrigin = #kgen<sugar alias, !lit.struct<#Origin <:!Bool {:i1 0}, :origin<false> #lit.origin.field<#lit.static.origin : !lit.origin<false>, "__constants__">>>, *"StaticConstantOrigin`0x8", *?> : !lit.struct<#Origin <:!Bool {:i1 0}, :origin<false> #lit.origin.field<#lit.static.origin : !lit.origin<false>, "__constants__">>>
#alias_Input = #kgen<sugar alias, !lit.struct<#IOSpec <:!Bool {:i1 0}, :!IO sugar_member_alias(!IO, "Input", sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {1}), {value: !Int = {1}}))>>, *"Input`0x1", apply(:!lit.generator<() -> !lit.struct<#IOSpec <:!Bool {:i1 0}, :!IO sugar_member_alias(!IO, "Input", sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {1}), {value: !Int = {1}}))>>> @extensibility::@managed_tensor_slice::@IOSpec::@"__init__()"<:!Bool {:i1 0}, :!IO sugar_member_alias(!IO, "Input", sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {1}), {value: !Int = {1}}))>)> : !lit.struct<#IOSpec <:!Bool {:i1 0}, :!IO sugar_member_alias(!IO, "Input", sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {1}), {value: !Int = {1}}))>>

module {

mogg.kernel.decl @kernels.matmul registration = "mo.matmul" device_info = <"", "", "", ""> execute = <<!lit.generator<<"transpose_b": !Bool, "packed_b": !Bool, "has_epilogue_fusion": !Bool, "target": !lit.struct<#StringSpan <:origin<false> #lit.origin.field<#lit.static.origin : !lit.origin<false>, "__constants__">, :!lit.struct<#Origin <:!Bool {:i1 0}, :origin<false> #lit.origin.field<#lit.static.origin : !lit.origin<false>, "__constants__">>> #alias_StaticConstantOrigin>>, "_trace_name": !lit.struct<#StringSpan <:origin<false> #lit.origin.field<#lit.static.origin : !lit.origin<false>, "__constants__">, :!lit.struct<#Origin <:!Bool {:i1 0}, :origin<false> #lit.origin.field<#lit.static.origin : !lit.origin<false>, "__constants__">>> #alias_StaticConstantOrigin>>, ?, "c.dtype`2x": !DType, "c.InFusion`2x1": !InputFusion, "c.OutFusion`2x2": !OutputFusion, "c.ComputeFusion`2x3": !ComputeOutputFusion, "c.static_spec.static_layout`1`2x4": !TensorLayout, "c.static_spec`2x5": !lit.struct<#StaticTensorSpec <:!DType *(0,5), :!Int {2}, :!TensorLayout *(0,9), :!InputFusion *(0,6), :!OutputFusion *(0,7), :!ComputeOutputFusion *(0,8)>>, "a.dtype`2x6": !DType, "a.InFusion`2x7": !InputFusion, "a.OutFusion`2x8": !OutputFusion, "a.ComputeFusion`2x9": !ComputeOutputFusion, "a.static_spec.static_layout`1`2x10": !TensorLayout, "a.static_spec`2x11": !lit.struct<#StaticTensorSpec <:!DType *(0,11), :!Int {2}, :!TensorLayout *(0,15), :!InputFusion *(0,12), :!OutputFusion *(0,13), :!ComputeOutputFusion *(0,14)>>, "b.dtype`2x12": !DType, "b.InFusion`2x13": !InputFusion, "b.OutFusion`2x14": !OutputFusion, "b.ComputeFusion`2x15": !ComputeOutputFusion, "b.static_spec.static_layout`1`2x16": !TensorLayout, "b.static_spec`2x17": !lit.struct<#StaticTensorSpec <:!DType *(0,17), :!Int {2}, :!TensorLayout *(0,21), :!InputFusion *(0,18), :!OutputFusion *(0,19), :!ComputeOutputFusion *(0,20)>>>[3]("c": !lit.struct<#ManagedTensorSlice <:!Bool {:i1 1}, :!IO sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {31}), {value: !Int = {31}}), :!DType *(0,5), :!Int {2}, :!InputFusion *(0,6), :!OutputFusion *(0,7), :!ComputeOutputFusion *(0,8), :!TensorLayout *(0,9), :!lit.struct<#IOSpec <:!Bool {:i1 1}, :!IO sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {31}), {value: !Int = {31}})>> apply(:!lit.generator<() -> !lit.struct<#IOSpec <:!Bool {:i1 1}, :!IO sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {31}), {value: !Int = {31}})>>> @extensibility::@managed_tensor_slice::@IOSpec::@"__init__()"<:!Bool {:i1 1}, :!IO sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {31}), {value: !Int = {31}})>), :!lit.struct<#StaticTensorSpec <:!DType *(0,5), :!Int {2}, :!TensorLayout *(0,9), :!InputFusion *(0,6), :!OutputFusion *(0,7), :!ComputeOutputFusion *(0,8)>> *(0,10)>>, "a": !lit.struct<#ManagedTensorSlice <:!Bool {:i1 0}, :!IO sugar_member_alias(!IO, "Input", sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {1}), {value: !Int = {1}})), :!DType *(0,11), :!Int {2}, :!InputFusion *(0,12), :!OutputFusion *(0,13), :!ComputeOutputFusion *(0,14), :!TensorLayout *(0,15), :!lit.struct<#IOSpec <:!Bool {:i1 0}, :!IO sugar_member_alias(!IO, "Input", sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {1}), {value: !Int = {1}}))>> #alias_Input, :!lit.struct<#StaticTensorSpec <:!DType *(0,11), :!Int {2}, :!TensorLayout *(0,15), :!InputFusion *(0,12), :!OutputFusion *(0,13), :!ComputeOutputFusion *(0,14)>> *(0,16)>>, "b": !lit.struct<#ManagedTensorSlice <:!Bool {:i1 0}, :!IO sugar_member_alias(!IO, "Input", sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {1}), {value: !Int = {1}})), :!DType *(0,17), :!Int {2}, :!InputFusion *(0,18), :!OutputFusion *(0,19), :!ComputeOutputFusion *(0,20), :!TensorLayout *(0,21), :!lit.struct<#IOSpec <:!Bool {:i1 0}, :!IO sugar_member_alias(!IO, "Input", sugar_builtin(apply(:!lit.generator<("value": !Int) -> !IO> @extensibility::@managed_tensor_slice::@IO::@"__init__(::Int)", {1}), {value: !Int = {1}}))>> #alias_Input, :!lit.struct<#StaticTensorSpec <:!DType *(0,17), :!Int {2}, :!TensorLayout *(0,21), :!InputFusion *(0,18), :!OutputFusion *(0,19), :!ComputeOutputFusion *(0,20)>> *(0,22)>>, "ctx": !lit.ref<!DeviceContext, imm *[0,0]> imm_mem, ?, "__error__": !lit.ref<!Error, mut *[0,1]> byref_error, "__result__": !lit.ref<none, mut *[0,2]> byref_result) throws -> i1>>, [#kgen<param.decl transpose_b : !Bool>, #kgen<param.decl packed_b : !Bool>, #kgen<param.decl has_epilogue_fusion : !Bool>, #kgen<param.decl target : !lit.struct<#StringSpan <:origin<false> #lit.origin.field<#lit.static.origin : !lit.origin<false>, "__constants__">, :!lit.struct<#Origin <:!Bool {:i1 0}, :origin<false> #lit.origin.field<#lit.static.origin : !lit.origin<false>, "__constants__">>> #alias_StaticConstantOrigin>>>, #kgen<param.decl _trace_name : !lit.struct<#StringSpan <:origin<false> #lit.origin.field<#lit.static.origin : !lit.origin<false>, "__constants__">, :!lit.struct<#Origin <:!Bool {:i1 0}, :origin<false> #lit.origin.field<#lit.static.origin : !lit.origin<false>, "__constants__">>> #alias_StaticConstantOrigin>>>, #kgen<param.decl *"c.dtype`2x" : !DType>, #kgen<param.decl *"c.InFusion`2x1" : !InputFusion>, #kgen<param.decl *"c.OutFusion`2x2" : !OutputFusion>, #kgen<param.decl *"c.ComputeFusion`2x3" : !ComputeOutputFusion>, #kgen<param.decl *"c.static_spec.static_layout`1`2x4" : !TensorLayout>, #kgen<param.decl *"c.static_spec`2x5" : !lit.struct<#StaticTensorSpec <:!DType *"c.dtype`2x", :!Int {2}, :!TensorLayout *"c.static_spec.static_layout`1`2x4", :!InputFusion *"c.InFusion`2x1", :!OutputFusion *"c.OutFusion`2x2", :!ComputeOutputFusion *"c.ComputeFusion`2x3">>>, #kgen<param.decl *"a.dtype`2x6" : !DType>, #kgen<param.decl *"a.InFusion`2x7" : !InputFusion>, #kgen<param.decl *"a.OutFusion`2x8" : !OutputFusion>, #kgen<param.decl *"a.ComputeFusion`2x9" : !ComputeOutputFusion>, #kgen<param.decl *"a.static_spec.static_layout`1`2x10" : !TensorLayout>, #kgen<param.decl *"a.static_spec`2x11" : !lit.struct<#StaticTensorSpec <:!DType *"a.dtype`2x6", :!Int {2}, :!TensorLayout *"a.static_spec.static_layout`1`2x10", :!InputFusion *"a.InFusion`2x7", :!OutputFusion *"a.OutFusion`2x8", :!ComputeOutputFusion *"a.ComputeFusion`2x9">>>, #kgen<param.decl *"b.dtype`2x12" : !DType>, #kgen<param.decl *"b.InFusion`2x13" : !InputFusion>, #kgen<param.decl *"b.OutFusion`2x14" : !OutputFusion>, #kgen<param.decl *"b.ComputeFusion`2x15" : !ComputeOutputFusion>, #kgen<param.decl *"b.static_spec.static_layout`1`2x16" : !TensorLayout>, #kgen<param.decl *"b.static_spec`2x17" : !lit.struct<#StaticTensorSpec <:!DType *"b.dtype`2x12", :!Int {2}, :!TensorLayout *"b.static_spec.static_layout`1`2x16", :!InputFusion *"b.InFusion`2x13", :!OutputFusion *"b.OutFusion`2x14", :!ComputeOutputFusion *"b.ComputeFusion`2x15">>>, #kgen<param.decl *"ctx`2x18" : !lit.origin<false>>, #kgen<param.decl *"__error__`2x19" : !lit.origin<true>>, #kgen<param.decl *"__result__`2x20" : !lit.origin<true>>], [unit, unit, unit, unit, unit, unit], [unit], []> struct_params = [] is_user_defined = false

// Test MOGG_ShapeFuncResult type roundtrip with different ranks
func.func @shapeFuncResultTypeRoundTrip(%shape_rank3: !mogg.shape_func_result<3>,
                                        %shape_rank5: !mogg.shape_func_result<5>) -> (!mogg.shape_func_result<3>, !mogg.shape_func_result<5>) {
  return %shape_rank3, %shape_rank5 : !mogg.shape_func_result<3>, !mogg.shape_func_result<5>
}

}
