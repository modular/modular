// The graph compiler must honor an explicit `default-device-target-arch` (plus
// `default-device-target-triple`, which identifies the accelerator vendor and
// gates the override to GPU targets) and generate code for that target GPU
// regardless of the host's accelerator. Cross-compiling is pure codegen and
// needs no physical GPU, so each backend is exercised wherever its toolchain
// lives: the NVPTX and AMDGPU backends are built into the Linux toolchain, and
// Apple Metal needs macOS (`xcrun metal`). Each RUN line is gated to the
// platform that can run it and asserts the expected, backend-specific artifact.

// RUN: %if system-linux %{ mo-opt --gc-pipeline="default-device-label=gpu default-device-target-arch=sm_90a default-device-target-triple=nvptx64-nvidia-cuda save-temp-prefix=%t" %s -o %t.mlir && find $(dirname %t) -type f -name "*.ptx" -print -quit | xargs grep "Generated by LLVM NVPTX Back-End" %}

// RUN: %if system-linux %{ mo-opt --gc-pipeline="default-device-label=gpu default-device-target-arch=gfx942 default-device-target-triple=amdgcn-amd-amdhsa save-temp-prefix=%t" %s -o %t.mlir && find $(dirname %t) -type f -name "*.amdgcn" -print -quit | xargs grep "amdgcn_target" %}

// RUN: %if system-darwin %{ mo-opt --gc-pipeline="default-device-label=gpu default-device-target-arch=metal:3 default-device-target-triple=air64-apple-macosx save-temp-prefix=%t" %s -o %t.mlir && find $(dirname %t) -type f -name "*.air" -print -quit | xargs strings | grep "air64-apple-macosx" %}

mo.graph @graph(%a : !mo.tensor<[4, 4], f32>) -> !mo.tensor<[4, 1], f32>
{
  %ch0 = mo.chain.create()
  %a_gpu, %ch1 = mo.transfer[%ch0] %a : !mo.tensor<[4, 4], f32> to <"gpu", 0>
  %b_gpu = mo.reduce.add (%a_gpu) {device = #M.device_ref<"gpu", 0>} : (!mo.tensor<[4, 4], f32, gpu:0>) -> !mo.tensor<[4, 1], f32, gpu:0>
  %b, %ch2 = mo.transfer[%ch1] %b_gpu : !mo.tensor<[4, 1], f32, gpu:0> to <"cpu", 0>
  mo.output %b : !mo.tensor<[4, 1], f32>
}
