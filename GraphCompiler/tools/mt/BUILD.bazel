load("@mojo//:mojo.bzl", "INTERNAL_KERNEL_MOJOPKGS")
load("//bazel:api.bzl", "modular_cc_binary")
load("//bazel:config.bzl", "ASYNCRT_PROFILING_LOCAL_DEFINES")

package(default_visibility = [
    "//:__pkg__",
    "//GraphCompiler:__subpackages__",
])

modular_cc_binary(
    name = "mt",
    srcs = glob(["*.cpp"]),
    dynamic_deps = [
        "@llvm-project//llvm:LLVM",
        "//AsyncRT:RuntimeGlobals",
        "//GraphCompiler:MGPRT",
        "//MLRT:Driver/DeviceContext",
        "//Mojo:CompilerRT",
        "//Support:Globals",
        "@llvm-project//mlir:MLIR",
    ],
    local_defines = ASYNCRT_PROFILING_LOCAL_DEFINES,
    mojo_deps = [
        "//max:builtin_kernels",
        "//max:builtin_primitives",
    ] + INTERNAL_KERNEL_MOJOPKGS,
    deps = [
        "//GraphCompiler:CommonDriver",
        "//GraphCompiler:ExecutionDriver",
        "//GraphCompiler:FrameworkFrontend",
        "//GraphCompiler:MEFModel",
        "//Init",
        "//Mojo:CompilerRT.static",
        "//Support:Context",
        "//Support:Globals.static",
        "//Support:ML",
    ],
)
