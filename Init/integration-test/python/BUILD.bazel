load("//bazel:api.bzl", "modular_nanobind_extension", "modular_py_test")

modular_nanobind_extension(
    name = "init_bindings",
    testonly = True,
    srcs = ["InitBindings.cpp"],
    new_link_root = "lib",
    deps = [
        "//AsyncRT:Runtime",
        "//AsyncRT:RuntimeGlobals",
        "//Init",
        "//SDK:GraphPython",
        "//SDK:Support",
        "//Support:Configuration",
        "//Support:Context",
        "//Support:CrashReporting",
        "//Support:HTTP",
        "//Support:MArchTarget",
        "//Support:Telemetry",
        "@llvm-project//llvm:Support",
    ],
)

modular_py_test(
    name = "test_signal_handler_python",
    srcs = ["test_signal_handler_python.py"],
    data = [
        "test_script.py",
        ":init_bindings",
    ],
)
