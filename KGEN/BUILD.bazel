$(location :gen_matplotlib_initialization_tool) \
    $(location :lib/MojoJupyter/MatplotlibInitialization.h.in) \
    $(location :lib/MojoJupyter/enable_matplotlib.py) \
    $(location :lib/MojoJupyter/matplotlib_backend.py) > $(OUTS)
""",
    tools = [":gen_matplotlib_initialization_tool"],
)

modular_shared_library(
    name = "MojoJupyter",
    srcs = glob(["lib/MojoJupyter/*.cpp"]) + [":gen_matplotlib_initialization"],
    hdrs = glob(["include/KGEN/MojoJupyter/*.h"]),
    deps = [
        ":KGENDialect",
        ":MojoLLDB",
        ":MojoLLDBPublicHeaders",
        ":MojoTooling",
        "//Support:Context",
        "@llvm-project//lldb:liblldb.wrapper",
        "@llvm-project//lldb:lldb24.0.0git",
    ],
)

dialect_checksum(
    name = "gen_dialect_checksum",
    srcs = [
        ":CODialectTdFiles",
        ":HLCFDialectTdFiles",
        ":InterpreterTdFiles",
        ":KGENDialectTdFiles",
        ":LITDialectTdFiles",
        ":POPDialectTdFiles",
    ],
)

modular_cc_library(
    name = "DialectChecksum",
    srcs = [
        "lib/DialectChecksum/DialectChecksum.cpp",
        ":gen_dialect_checksum",
    ],
    hdrs = ["include/KGEN/DialectChecksum/DialectChecksum.h"],
    copts = ["-I$(GENDIR)/KGEN"],
)

alias(
    name = "mojo",
    actual = "//KGEN/tools/mojo:mojo-full",
    # Used as a run target
    tags = [TOP_LEVEL_TAG],
)
