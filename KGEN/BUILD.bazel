genrule(
    name = "gen_matplotlib_initialization_script",
    outs = ["gen_matplotlib_initialization_tool.py"],
    cmd = """
cat > $(OUTS) <<EOF
import sys

print(
    open(sys.argv[1]).read()
    .replace("@ENABLE_MATPLOTLIB_STR@", open(sys.argv[2]).read())
    .replace("@MATPLOTLIB_BACKEND_STR@", open(sys.argv[3]).read())
)
EOF
""",
)

modular_py_binary(
    name = "gen_matplotlib_initialization_tool",
    srcs = [":gen_matplotlib_initialization_script"],
)

genrule(
    name = "gen_matplotlib_initialization",
    srcs = [
        "lib/MojoJupyter/MatplotlibInitialization.h.in",
        "lib/MojoJupyter/matplotlib_backend.py",
        "lib/MojoJupyter/enable_matplotlib.py",
    ],
    outs = ["MojoJupyter/MatplotlibInitialization.h"],
    cmd = """
$(location :gen_matplotlib_initialization_tool) \
    $(location :lib/MojoJupyter/MatplotlibInitialization.h.in) \
    $(location :lib/MojoJupyter/enable_matplotlib.py) \
    $(location :lib/MojoJupyter/matplotlib_backend.py) > $(OUTS)
""",
    tools = [":gen_matplotlib_initialization_tool"],
)

modular_shared_library(
    name = "MojoJupyter",
    srcs = glob(["lib/MojoJupyter/*.cpp"]) + [":gen_matplotlib_initialization"],
