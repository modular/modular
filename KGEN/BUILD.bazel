    outs = ["gen_matplotlib_initialization_tool.py"],
    cmd = """
cat > $(OUTS) <<EOF
import sys

print(
    open(sys.argv[1]).read()
    .replace("@ENABLE_MATPLOTLIB_STR@", open(sys.argv[2]).read())
    .replace("@MATPLOTLIB_BACKEND_STR@", open(sys.argv[3]).read())
)
EOF
""",
)

