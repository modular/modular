# Dependency-light per-target metadata (`TargetTraits`), dispatched by triple.
# Lives below the codegen layer so any KGEN component can query a target's
# metadata without linking `TargetBackend`. Each target self-registers from its
# own source file; dropping a target's file drops it from the build.
modular_cc_library(
    name = "TargetTraits",
    # TargetLowering.{cpp,h} live in this same directory but belong to the
    # separate :TargetLowering target, so exclude them from this recursive glob.
    srcs = glob(
        ["lib/Target/**/*.cpp"],
        exclude = ["lib/Target/TargetLowering.cpp"],
    ),
    hdrs = glob(
        ["lib/Target/**/*.h"],
        exclude = ["lib/Target/TargetLowering.h"],
    ),
    strip_include_prefix = "lib",
    visibility = [
        "//KGEN:consumers",
        "//KGEN:plugin_consumers",
    ],
    deps = [
        ":Support",
        "//Support:Configuration",
        "@llvm-project//llvm:Support",
    ],
    # TargetTraits implementations self-register via a static initializer and
    # aren't referenced directly, so the linker would drop them. Force them to
    # be linked.
    alwayslink = True,
)

