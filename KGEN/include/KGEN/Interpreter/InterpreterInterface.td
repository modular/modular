#ifndef INTERPRETERINTERFACE_TD
#define INTERPRETERINTERFACE_TD

include "KGEN/Interpreter/InterpreterInterfaceGen.td"

//===----------------------------------------------------------------------===//
// InterpreterOpInterface
//===----------------------------------------------------------------------===//

/// This is a delegate interface definition that is processed by op declaration
/// gen but which isn't generated by op interface gen. This allows using
/// `DeclareOpInterfaceMethods<InterpreterOpInterface>`, but we manually define
/// the actual interface declaration in C++ as a delegate interface to
/// `BytecodeInterpreterOpInterface`.
def InterpreterOpInterface : OpInterface<"InterpreterDelegateOpInterface"> {
  let description = [{
    This interface defines an API for operations to be "interpreted" at compile
    time. Operations may normally plug into the IR interpreter by defining an
    operation folder. However, some operations require more information or state
    to be interpreted. This interface provides access to an interpreter state
    that contains a memory model, a symbol table, and the ability to recursively
    invoke the interpreter.
  }];

  let cppNamespace = "::M::detail";

  let methods = [
    InterfaceMethod<[{
      Given the constant value inputs to the operation, compute the constant
      value results, with access to the interpreter state and the contextual
      value map.
    }], "ErrorTreeOrSuccess", "interpret",
    (ins "ArrayRef<Attribute>":$operands, "InterpreterState &":$state)>
  ];
}

//===----------------------------------------------------------------------===//
// ParametricInterpreterOpInterface
//===----------------------------------------------------------------------===//

/// This is a delegate interface definition that is processed by op declaration
/// gen but which isn't generated by op interface gen. This allows using
/// `DeclareOpInterfaceMethods<ParametricInterpreterOpInterface>`,
/// but we manually define the actual interface declaration in C++ as
/// a delegate interface to `BytecodeInterpreterOpInterface`.
def ParametricInterpreterOpInterface :
  OpInterface<"ParametricInterpreterDelegateOpInterface"> {
  let description = [{
    This interface defines an API for operations to be "interpreted"
    parametrically at compile time. Operations may normally plug into the
    IR interpreter by defining an operation folder. However, some operations
    require more information or state to be interpreted. This interface
    provides access to an interpreter state that contains a memory model,
    a symbol table, and the ability to recursively invoke the interpreter.
  }];

  let cppNamespace = "::M::detail";

  let methods = [
    InterfaceMethod<[{
      Given the constant value inputs to the operation, compute the constant
      value results, with access to the interpreter state and the contextual
      value map.
    }], "ErrorTreeOrSuccess", "parametric_interpret",
    (ins "ArrayRef<Attribute>":$operands, "ParametricInterpreterState &":$state)>
  ];
}

//===----------------------------------------------------------------------===//
// BytecodeOpInterface
//===----------------------------------------------------------------------===//

/// This is a delegate interface definition that is processed by op declaration
/// gen but which isn't generated by op interface gen. This allows using
/// `DeclareOpInterfaceMethods<InterpreterOpInterface>`, but we manually define
/// the actual interface declaration in C++ as a delegate interface to
/// `BytecodeInterpreterOpInterface`.
def BytecodeOpInterface : OpInterface<"BytecodeDelegateOpInterface"> {
  let description = [{
    This interface defines an API for an operation to participate in interpreter
    bytecode generation with a custom payload type.
  }];

  let cppNamespace = "::M::detail";

  let methods = [
    InterfaceMethod<[{
      Preprocess the operation into its payload in the bytecode.
    }], "ErrorOrSuccess", "compile",
    (ins "Payload &":$payload, "TargetInfoAttr":$target)>,
    InterfaceMethod<[{
      Interpret the operation with a custom
    }], "ErrorTreeOrSuccess", "interpret",
    (ins "ArrayRef<Attribute>":$operands, "const Payload &":$payload,
         "InterpreterState":$state)>
  ];
}

//===----------------------------------------------------------------------===//
// ParametricBytecodeOpInterface
//===----------------------------------------------------------------------===//

def ParametricBytecodeOpInterface :
  OpInterface<"ParametricBytecodeDelegateOpInterface"> {
  let description = [{
    This interface defines an API for an operation to participate in
    parametric interpreter bytecode generation with a custom payload type.
  }];

  let cppNamespace = "::M::detail";

  let methods = [
    InterfaceMethod<[{
      Preprocess the operation into its payload in the bytecode.
    }], "ErrorOrSuccess", "parametric_compile",
    (ins "Payload &":$payload, "TargetInfoAttr":$target)>,
    InterfaceMethod<[{
      Interpret the operation with a custom
    }], "ErrorTreeOrSuccess", "interpret",
    (ins "ArrayRef<Attribute>":$operands, "const Payload &":$payload,
         "InterpreterState":$state)>
  ];
}

#endif // INTERPRETERINTERFACE_TD
