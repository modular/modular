  ];
}

//===----------------------------------------------------------------------===//
// EliminateDeadSymbols
//===----------------------------------------------------------------------===//

def EliminateDeadSymbols: Pass<"eliminate-dead-symbols", "ModuleOp"> {
  let summary = "remove dead symbols.";
  let description = [{
    This pass walks the symbols defined in the module and removes them
    if they aren't exported and have no uses.
  }];

  let dependentDialects = [
    "MDialect",
    "KGENDialect",
  ];

  let statistics = [
    Statistic<"numErased", "num-erased", "the number of dead symbols removed">,
  ];
}

//===----------------------------------------------------------------------===//
// LowerCallingConventions
//===----------------------------------------------------------------------===//

def LowerCallingConventions : Pass<"lower-calling-conventions", "FuncOp"> {
  let summary = "Lower calling convention after elaboration.";
  let description = [{
    The `lower-calling-conventions` pass performs any calling convention
    transformation. This pass runs on concrete IR, because it is not possible to
    lower calling conventions on parametric IR. This pass will:

    1. Replace `!kgen.none` function results with no results.
  }];
}

//===----------------------------------------------------------------------===//
// LowerArgConventions
//===----------------------------------------------------------------------===//

def LowerArgConventions : Pass<"lower-arg-conventions", "FuncOp"> {
  let summary = "Lower argument argument conventions after elaboration.";
  let description = [{
    This pass performs the lowering of argument input conventions of concrete
    functions. This pass must run before inlining, but after elaboration.
  }];

  let dependentDialects = [
    "HLCF::HLCFDialect"
  ];
}

//===----------------------------------------------------------------------===//
// StackReuse
//===----------------------------------------------------------------------===//

def StackReuse : Pass<"stack-reuse", "KGEN::FuncOp"> {
  let summary = "Elide redundant stack values.";
  let description = [{
    The `stack-reuse` pass is an optimization that attempts to remove unneeded
    stack allocations from the program. These are stack allocations where at all
    points the memory is read, the stack allocation has a value equal to some
    other live stack allocation in the program, and therefore it can be removed.

    NOTE: This pass *must* run after `lower-closures`, because stack allocations
    are assumed to never cross implicit control-flow boundaries.

    Example:

    ```mlir
    %s0 = pop.stack_allocation 1 x index
    %s1 = pop.stack_allocation 1 x index
    pop.store %arg0, %s0
    pop.store %arg1, %s1

    %s2 = pop.stack_allocation 1 x index
    pop.store %arg0, %s2
    %v0 = pop.load %s2
    pop.store %arg1, %s2
    %v1 = pop.load %s2
    ```

    The third stack allocation can be replaced entirely by a combination of the
    first two:

    ```mlir
    %s0 = pop.stack_allocation 1 x index
    %s1 = pop.stack_allocation 1 x index
    pop.store %arg0, %s0
    pop.store %arg1, %s1

    %v0 = pop.load %s0
    %v1 = pop.load %s1
    ```
  }];

  let statistics = [
    Statistic<"numElidedVars", "num-elided-vars",
              "the number of stack allocations elided">,
    Statistic<"numErasedOps", "num-erased-ops",
              "the number of operations erased, including stack allocations">,
  ];
}

//===----------------------------------------------------------------------===//
// Mem2Reg
//===----------------------------------------------------------------------===//

def Mem2Reg : Pass<"mem-2-reg"> {
  let summary = "Optimization pass that promotes memory to registers";
  let description = [{
    The `mem-2-reg` pass does memory elision over POP dialect operations by
    promoting values that live in stack memory, denoted by
    `pop.stack_allocation`, to register values, when all uses of the value by
    loads and stores are visible.

    This pass can run both before and after elaboration, but it can only analyze
    stack allocations with concrete sizes, and it can only run before
    control-flow lowering, since it does not work on CFGs.

    This pass is very basic and only elides stack allocations if all stores are
    in the same scope. It can replace loads spanning multiple regions though.

    Example:

    ```mlir
    %0 = pop.stack_allocation 1 x index
    pop.store %arg0, %0 : !kgen.pointer<index>
    %1 = pop.load %0 : !kgen.pointer<index>
    kgen.return %1 : index
    ```

    Will become:

    ```mlir
    kgen.return %arg0 : index
    ```

    However, stores within a nested region will not be elided (yet).

    ```mlir
    %0 = pop.stack_allocation 1 x index
    hlcf.if %arg2 {
      pop.store %arg0, %0 : !kgen.pointer<index>
    } else {
      pop.store %arg1, %0 : !kgen.pointer<index>
    }
    %1 = pop.load %0 : !kgen.pointer<index>
    kgen.return %1 : index
    ```
  }];

  let statistics = [
    Statistic<"numAllocsElided", "num-allocs-elided",
              "the number of variables moved from memory to registers">,
    Statistic<"numLoadsElided", "num-loads-elided",
              "the number of loads elided">,
    Statistic<"numStoresElided", "num-stores-elided",
              "the number of stores elided">,
  ];
}

//===----------------------------------------------------------------------===//
// Basic Invariant code motion
//===----------------------------------------------------------------------===//

def HoistTrivialInvariants : Pass<"hoist-trivial-invariants"> {
  let summary = "Hoist trivial invariant operations out of regions";
  let description = [{
    Hoists operations which are trivially invariant within if and for blocks
    into earliest block we can.

    ```mlir
      %s = pop.load %arg0 : !kgen.pointer<struct<(index, index, index)>>

      hlcf.loop {
        %0 = kgen.struct.extract %s[0] : !kgen.pointer<struct<(index, index, index)>>
        hlcf.loop {
          %1 = kgen.struct.extract %s[1] : !kgen.pointer<struct<(index, index, index)>>
          hlcf.if %arg2 {
            %2 = kgen.struct.extract %s[2] :
                        !kgen.pointer<struct<(index, index, index)>>
            // ...
          } else {
            // ..
          }
        }
      }
    ```

    Becomes:

    ```mlir
      %s = pop.load %arg0 : !kgen.pointer<struct<(index, index, index)>>
      %0 = kgen.struct.extract %s[0] : !kgen.pointer<struct<(index, index, index)>>
      %1 = kgen.struct.extract %s[1] : !kgen.pointer<struct<(index, index, index)>>
      %2 = kgen.struct.extract %s[2] : !kgen.pointer<struct<(index, index, index)>>

      hlcf.loop {
        hlcf.loop {
          hlcf.if %arg2 {
            // ...
          } else {
            // ..
          }
        }
      }
    ```

    Even though `extract_2` was within a condition it is still safe to move
    as it has no side effect. LLVM can move it back into the condition if it is
    more performant, however if we do not move it LLVM is limited in many
    situations from being able to move it back.
  }];

  let statistics = [
    Statistic<"numHoisted", "num-hoisted", "the number of operations hoisted">,
  ];
}

//===----------------------------------------------------------------------===//
// Control Flow Simplification
//===----------------------------------------------------------------------===//

def SimplifyCF : Pass<"simplify-cf", "KGEN::FuncOp"> {
  let summary = "Simplify control flow constructs";
  let description = [{
    Simplifies control flow in the given function, e.g. removes trivial loops,
    which have just one iteration.
    Hoists operations which are trivially invariant within if and for blocks
    into earliest block we can.

    ```mlir
      hlcf.loop {
        some_ops  // no other break or contrinue ops
        hlcf.break
      }
    ```

    Becomes:

    ```mlir
      some_ops
    ```
  }];

  let statistics = [
    Statistic<"numErasedLoops", "num-erased-loops",
              "the number of trivial loops erased">,
    Statistic<"numErasedTry", "num-erased-try",
              "the number of trivial try erased">,
  ];
}

//===----------------------------------------------------------------------===//
// ArgPromotion
//===----------------------------------------------------------------------===//

def ArgPromotion : Pass<"arg-promotion", "ModuleOp"> {
  let summary = "promotion of in-memory arguments";
  let description = [{
    The `arg-promotion` pass is an inter-procedural optimization pass that
    rewrites internal function signatures to pass in-memory arguments by value
    if and only if the pointer is not captured.

    If possible, this rewrites borrowed and owned in-memory arguments to pass in
    the arguments by value, inout and ref arguments to return the result as an
    SSA result, and byref result arguments to return the new value as a result.
  }];

  let options = [
    Option<"maxInlineSize", "max-inline-size", "unsigned", "256",
           "The maximum argument size to promote, in bytes.">,
  ];

  let dependentDialects = ["POP::POPDialect"];
}

//===----------------------------------------------------------------------===//
// ExpandStructs
//===----------------------------------------------------------------------===//

def ExpandStructs : Pass<"expand-structs", "FuncOp"> {
  let summary = "expand structs across control flow boundaries";
  let description = [{
    The `expand-structs` pass removes `!kgen.struct` recursively across
    control-flow boundaries, including functions and function calls. This
    results in less IR bloat but is also part of the Mojo function ABI.
  }];
}

//===----------------------------------------------------------------------===//
// SROA
//===----------------------------------------------------------------------===//

def SROA : Pass<"sroa"> {
  let summary = "Scalar replacement of aggregates";
  let description = [{
    SROA identifies memory allocations of compostite structures and breaks them
    down into scalar alternatives where possible.

    ```mlir
    %strct = pop.stack_allocation 1 x !kgen.struct<(index, index, index, index)>
    ```

    Becomes

    ```mlir
    %sclar1 = pop.stack_allocation 1 x index
    %sclar2 = pop.stack_allocation 1 x index
    %sclar3 = pop.stack_allocation 1 x index
    %sclar4 = pop.stack_allocation 1 x index
    ```

    Doing this gives mem-2-reg an easier time identifying optimization
    opportunities as it eliminates problematic aliasing.
  }];

  let statistics = [
    Statistic<"numReplacedAllocs", "num-replaced-allocas",
              "the number of aggregate allocations replaced with scalars">,
  ];

  let options = [
    Option<"maxNumElements", "max-num-elements", "unsigned", "256",
           "The maximum number of elements to decompose">,
  ];
}

//===----------------------------------------------------------------------===//
// StripParserMetadata
//===----------------------------------------------------------------------===//

def StripParserMetadata : Pass<"strip-parser-metadata"> {
  let summary = "Strip parser metadata from the IR.";
  let description = [{
    The `strip-parser-metadata` pass is a debugging aid. It strips metadata from
    the IR that may have been generated by the parser. This includes:

    - Doc strings.
    - Precompiled packages.
  }];
}

//===----------------------------------------------------------------------===//
// LowerRuntimeClosures
//===----------------------------------------------------------------------===//

def LowerRuntimeClosures : Pass<"lower-runtime-closures", "ModuleOp"> {
  let summary = "Lowers closure types into struct of two pointers";

  let description = [{
    In the runtime-closures pass, we lifted nested functions into top level
     functions and replaced references to them with kgen closure operations.
     In this pass, the closure operations are lowered to llvm dialect.

    1) The op that represents a closure creation should lower to
        (a) a top level function that knows how to unpack the state
            and call the lifted function
        (b) an allocation of memory and storage of captured state
        (c) creation of a struct that contains a pointer to (a) and a pointer to (b)
    2) The op that represents a closure inmvocation should be lowered to
        (a) extraction of function pointer from struct
        (b) extraction of data pointer from struct
        (c) invoke function with (b) + dynamic arguments
  }];

  let dependentDialects = ["KGENDialect", "POP::POPDialect"];
}

//===----------------------------------------------------------------------===//
// SynthesizeDebugInfo
//===----------------------------------------------------------------------===//

def SynthesizeDebugInfo : Pass<"synth-debuginfo", "ModuleOp"> {
  let summary = "Synthesize debuginfo from IR locations";

  let description = [{
    This pass generates synthetic debuginfo from the IR, using file locations
    present on the operations in the IR. This pass is a workaround debuginfo
    being broken pre-elaboration due to parameters. If there are no file
    locations in the IR, this pass will fail.
  }];

  let dependentDialects = ["DebugInfo::DebugInfoDialect"];

  let options = [
    Option<"debugInfoLanguage", "debug-info-language",
           "llvm::dwarf::SourceLanguage", "llvm::dwarf::DW_LANG_Mojo",
           "The DWARF language to specify in the debug info, either `C` or "
           "`Mojo`. Defaults to `Mojo`.",
           "llvm::cl::values(clEnumValN(llvm::dwarf::DW_LANG_C, \"C\", \"C language.\"),"
           "clEnumValN(llvm::dwarf::DW_LANG_Mojo, \"Mojo\", \"Mojo language\"))">,
  ];
}

//===----------------------------------------------------------------------===//
// RaiseForLoops
//===----------------------------------------------------------------------===//

def RaiseForLoops: Pass<"raise-for-loops", "KGEN::FuncOp"> {
  let summary = "raise hlcf.for loops.";
  let description = [{
    The `raise-for-loops` pass will transform simple `hlcf.loop` with no early exits
    into `hlcf.for` operation. This pass must run on concrete KGEN IR.
  }];

  let dependentDialects = ["HLCF::HLCFDialect"];
}

//===----------------------------------------------------------------------===//
// LoopUnrolling
//===----------------------------------------------------------------------===//

def LoopUnrolling : Pass<"loop-unrolling", "KGEN::FuncOp"> {
  let summary = "unroll loops";
  let description = [{
    The `loop-unrolling` pass will unroll hlcf for-loops with factors from the
    for loop decorator. This pass will strip hlcf for-loop's `unroll_factor`
    attribute.  This pass must run on concrete KGEN IR.
  }];

  let dependentDialects = ["HLCF::HLCFDialect"];

  let options = [
    Option<"optimizationLevel", "optimization-level", "unsigned", "3",
           "The compilation optimization level.">
  ];
}

//===----------------------------------------------------------------------===//
// LowerLoops
//===----------------------------------------------------------------------===//

def LowerLoops: Pass<"lower-loops", "KGEN::FuncOp"> {
  let summary = "lower high-level loop abstractions to `hlcf.loop`";
  let description = [{
    The `lower-loops` pass will lower high-level loop abstractions, such as
    `hlcf.for` operations, to `hlcf.loop`.
  }];

  let dependentDialects = ["HLCF::HLCFDialect"];
}

//===----------------------------------------------------------------------===//
// AutomaticInliner
//===----------------------------------------------------------------------===//

def AutomaticInline: Pass<"automatic-inline", "ModuleOp"> {
  let summary = "KGEN automatic inliner pass";
  let description = [{
    The `automatic inliner` pass inlines functions with InlineLevel::Automatic
    automatically based on inline heuristics. This pass also inlines
    `always_inline` functions, but not `no_inline` (should not be inlined) ones.
    The inline heuristics is based on compilation optimization level with more
    `-O3` has the most aggressive inlining and `-O0` the least.
    The heuristics is simple for current implementation, and is subject
    to improve over time.
  }];

  let dependentDialects = [
    "MDialect",
    "HLCF::HLCFDialect",
  ];

  let options = [
    Option<"updateDebugInfo", "update-debug-info",
           "M::KGEN::InlinerDebugInfoUpdateTime",
           "M::KGEN::InlinerDebugInfoUpdateTime::kDeferred",
           "How to update debug info of inlined functions.", "llvm::cl::values("
           "clEnumValN(M::KGEN::InlinerDebugInfoUpdateTime::kImmediate,"
           "\"immediate\", \"Update immediately.\"),"
           "clEnumValN(M::KGEN::InlinerDebugInfoUpdateTime::kDeferred,"
           "\"deferred\", \"Update at the end of the pass.\"),"
           "clEnumValN(M::KGEN::InlinerDebugInfoUpdateTime::kNever,"
           "\"never\", \"Do not update debug info.\"))">,
    Option<"optimizationLevel", "optimization-level", "unsigned", "1",
           "Specify the compilation optimization level.">,
    Option<"funcPipelineStr", "func-pipeline", "std::string", "\"\"",
           "Specify the inner pipeline to use on functions.">
  ];
}

//===----------------------------------------------------------------------===//
// IPDF
//===----------------------------------------------------------------------===//

def IPDF : Pass<"ipdf", "ModuleOp"> {
  let summary = "interprocedural dataflow analysis and optimization";
}

//===----------------------------------------------------------------------===//
// SCCP
//===----------------------------------------------------------------------===//

def SCCP: Pass<"sccp"> {
  let summary = "KGEN sparse conditional constant propagation pass";
  let description = [{
    Sparse conditional constant propagation (SCCP).
    SCCP is an optimization that combines Dead Code Elimination (DCE) and
    Constant Propagation with the knowledge of the control flow
    (back edges for repetition) and dataflow (SSA values) of the program.

    This pass doesn't have inter-procedural support (yet).
  }];

  let dependentDialects = ["HLCF::HLCFDialect"];
}

//===----------------------------------------------------------------------===//
// DeadArgumentElimination
//===----------------------------------------------------------------------===//

def DeadArgumentElimination:
    Pass<"dead-argument-elimination", "ModuleOp"> {
  let summary = "KGEN dead argument elimination`";
  let description = [{
    The `dead argument elimination` pass eliminates dead function arguments and
    results whose values are not being used in the program, and update function
    callsites with fewer arguments and return values.
  }];

  let dependentDialects = ["MDialect"];
}


//===----------------------------------------------------------------------===//
// Remove unused arguments
//===----------------------------------------------------------------------===//

def RemoveUnusedParams : Pass<"remove-unused-params", "mlir::ModuleOp"> {
  let summary = "Rewrites functions to remove unused args & params";
  let description = [{
    Replaces a function with a new function that drops all unused
    parameters and arguments, updating all the callers to reflect
    the new function call.
  }];
}

//===----------------------------------------------------------------------===//
// `custom` dialect lowering
//===----------------------------------------------------------------------===//

def LowerCustomOpsPreElab : Pass<"lower-custom-ops-pre-elab", "ModuleOp"> {
  let summary = "Lower operations from the `custom` dialect before elaboration";
  let description = [{
    This pass lowers all operations of the `custom` dialect to function calls
    to their implementation. `register-custom-ops` should not be called before
    this pass.
  }];

  let dependentDialects = [
    "KGENDialect",
    "Custom::CustomDialect",
  ];
}

def LowerCustomOps : Pass<"lower-custom-ops", "ModuleOp"> {
  let summary = "Lower operations from the `custom` dialect";
  let description = [{
    This pass lowers all operations of the `custom` dialect to function calls
    to their implementation.
  }];

  let dependentDialects = [
    "KGENDialect",
    "DebugInfo::DebugInfoDialect",
    "HLCF::HLCFDialect",
    "MDialect",
    "Custom::CustomDialect",
    "mlir::LLVM::LLVMDialect",
    "mlir::NVVM::NVVMDialect",
    "mlir::index::IndexDialect",
  ];
}

//===----------------------------------------------------------------------===//
// `custom` dialect registration
//===----------------------------------------------------------------------===//

def RegisterCustomOps : Pass<"register-custom-ops", "ModuleOp"> {
  let summary = "Register ops from the `custom` dialect";
  let description = [{
    This pass registers all `custom` ops in the `custom` dialect.
    In particular, it JITs the canonicalization patterns and registers them in
    the `custom` dialect.
  }];

  // FIXME(#15949): Should not require all these dialects to be loaded.
  let dependentDialects = [
    "KGENDialect",
    "DebugInfo::DebugInfoDialect",
    "HLCF::HLCFDialect",
    "MDialect",
    "Custom::CustomDialect",
    "mlir::LLVM::LLVMDialect",
    "mlir::NVVM::NVVMDialect",
    "mlir::index::IndexDialect",
  ];
}
