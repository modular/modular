include "mlir/Pass/PassBase.td"

//===----------------------------------------------------------------------===//
// Canonicalizer
//===----------------------------------------------------------------------===//

def Canonicalizer : Pass<"canonicalizer"> {
  let summary = "Canonicalize operations.";
  let description = [{
    The `canonicalizer` pass runs all registered canonicalization patterns in
    addition to KGEN-specific canonicalization patterns that run on the hybrid
    IR representation. This pass also disables the region simplifier, since KGEN
    IR only has single-block regions.
  }];

  let dependentDialects = ["mlir::index::IndexDialect"];
}

//===----------------------------------------------------------------------===//
// VerifyParameters
//===----------------------------------------------------------------------===//

def VerifyParameters : Pass<"verify-parameters", "mlir::ModuleOp"> {
  let summary = "Run the parameter verifier.";
  let description = [{
    The `verify-parameters` pass runs the KGEN parameter verifier. The pass
    ensures that all parameter uses are of the right type and reference
    parameters with declarations, it detects conflicting declarations, and it
    detects cycles in parameter definitions and uses.
  }];

  let options = [
    Option<"simplifyParameters", "simplify", "bool", "false",
           "If true, parameter simplification will run after verification.">
  ];
}

//===----------------------------------------------------------------------===//
// LiftAndFoldApply
//===----------------------------------------------------------------------===//

def LiftAndFoldApply : Pass<"lift-and-fold-apply", "mlir::ModuleOp"> {
  let summary = "Lift apply operators and fold them if possible.";
  let description = [{
    This pass walks parameter expressions within the bodies of functions and
    lifts and deduplicates visited 'apply' operators to `kgen.param.apply`
    operations within the function body. This enables the elaborator to
    multi-version generators from 'apply' operators whose callee has multiple
    candidates.

    This pass also attempts to interpret 'apply' operators on constant inputs
    on non-parametric callees.

    Note that the IR generated by this pass may not pass `verify-parameters`.
    This is because by modifying 'apply' operators within call operations, it
    can create concrete signatures that disagree with what the standard
    `ParameterEvaluator` determines as the concrete signature for a callee.
  }];

  let statistics = [
    Statistic<"numDedupedApplies", "num-deduped-applies",
              "the number of 'apply' operators deduplicated">,
  ];
}

//===----------------------------------------------------------------------===//
// LowerSemanticCF
//===----------------------------------------------------------------------===//

def LowerSemanticCF
  : Pass<"lower-semantic-cf", "mlir::ModuleOp"> {
  let summary = "Lower lexical terminators and prune unreachable code.";
  let description = [{
    The `lower-semantic-cf` pass will replace lexical Lit terminators with
    real terminators. It will prune any unreachable code (and warn about it),
    and verify that return parameters are the same at all return sites.

    Example:

    ```mlir
    lit.func @foo<() -> index>(%arg0: i32, %arg1: i32) -> i32 {
      lit.param_return<2>
      lit.return %arg0 : i32
      lit.return %arg1 : i32
      lit.end_func
    }
    ```

    Becomes:

    ```mlir
    lit.func @foo<() -> index>(%arg0: i32, %arg1: i32) -> i32 {
      kgen.param.result_bind<2>
      kgen.return %arg0 : i32
    }
    ```
  }];
}

//===----------------------------------------------------------------------===//
// CheckLifetimes
//===----------------------------------------------------------------------===//

def CheckLifetimes : Pass<"check-lifetimes"> {
  let summary = "Check and lower value lifetime invariants.";
  let description = [{
    The `check-lifetimes` pass inserts destructor calls after the last
    use of a value, diagnoses use-before-definition problems, and implements a
    borrow checker.
  }];
}

//===----------------------------------------------------------------------===//
// CheckRecursiveStructs
//===----------------------------------------------------------------------===//

def CheckRecursiveStructs: Pass<"check-recursive-structs"> {
  let summary = "Check nested recursive structs and report error.";
  let description = [{
    The `check-recursive-structs` checks if a struct contains illegal
    nested recursive struct field and reports error to avoid infinite
    recursion in lowering.
  }];
}

//===----------------------------------------------------------------------===//
// LowerLIT
//===----------------------------------------------------------------------===//

def LowerLIT : Pass<"lower-lit", "mlir::ModuleOp"> {
  let summary = "Lower the `lit` dialects to the `kgen` dialect.";
  let description = [{
    This pass performs lowers high level abstractions from "lit" to "kgen"
    and diagnoses any errors that are found along the way.
  }];

  let dependentDialects = [
    "KGENDialect",
    "HLCF::HLCFDialect",
    "mlir::index::IndexDialect",
  ];
}

//===----------------------------------------------------------------------===//
// LowerPreElaboratedLIT
//===----------------------------------------------------------------------===//

def LowerPreElaboratedLIT : Pass<"lower-preelaborated-lit", "mlir::ModuleOp"> {
  let summary = "Lower the pre-elaborated `lit` dialect to the `kgen` dialect.";
  let description = [{
    This pass lowers high level abstractions, that have already been elaborated,
    from "lit" to "kgen" and diagnoses any errors that are found along the way.
  }];

  let dependentDialects = ["KGENDialect"];
}

//===----------------------------------------------------------------------===//
// LowerClosures
//===----------------------------------------------------------------------===//

def LowerClosures : Pass<"lower-closures", "mlir::ModuleOp"> {
  let summary = "Lower `async` functions and closures.";
  let description = [{
    The `lower-closures` pass transforms `async` functions into normal
    `kgen.func` by adding the required POP-level coroutine machinery, and it
    lowers inline closure operations like `lit.async.execute` and
    `kgen.stage_closure` by lifting their regions into top-level functions.
  }];

  let dependentDialects = ["POPDialect"];
}

//===----------------------------------------------------------------------===//
// LowerStructs
//===----------------------------------------------------------------------===//

def LowerStructs : Pass<"lower-structs", "mlir::ModuleOp"> {
  let summary = "Lower struct declarations to POP structs.";
  let description = [{
    This pass lowerings struct decls and decl reference types to in-inline POP
    struct types.
  }];

  let dependentDialects = ["POP::POPDialect"];
}

//===----------------------------------------------------------------------===//
// OutlineClosures
//===----------------------------------------------------------------------===//

def OutlineClosures : Pass<"outline-closures", "mlir::ModuleOp"> {
  let summary = "Outlines region parameters into explicit closures.";
  let description = [{
    This pass outlines region parameters into functions that are called with
    a struct that contains all captures.
  }];

  let dependentDialects = ["KGENDialect", "POP::POPDialect"];
}

//===----------------------------------------------------------------------===//
// LowerKGENToLLVM
//===----------------------------------------------------------------------===//

def LowerKGENToLLVM : Pass<"lower-kgen-to-llvm", "mlir::ModuleOp"> {
  let summary = "Lower the `kgen` dialect to the `llvm` dialect.";
  let description = [{
    This pass performs a conversion from the fully-elaborated and specified
    `kgen.func` ops and kgen types to the corresponding LLVM-dialect
    structures/types/ops.

    Functions marked as exported are marked as external. All other functions are
    marked as internal linkage. For exported functions, wrapper functions are
    generated with C-compatible calling conventions. This breaks up argument and
    results structs in-place and converts arrays to be pass-by-reference.

    For example, consider the following function that accepts and returns a
    buffer:

    ```mlir
    llvm.func @slice(%a: !llvm.struct<(i64, ptr<f32>)>, %i: !llvm.ptr<i64>)
        -> !llvm.struct<(i64, ptr<f32>)>
    ```

    The resulting wrapper's signature will be:

    ```mlir
    llvm.func @slice_c(%a_0: i64, %a_1: !llvm.ptr<f32>, %i: !llvm.ptr<i64>,
                     %res_0: !llvm.ptr<i64>, %res_1: !llvm.ptr<ptr<f32>)
    ```
  }];

  // We generate the LLVM dialect.
  let dependentDialects = ["::mlir::LLVM::LLVMDialect"];
}

//===----------------------------------------------------------------------===//
// TweakSpilledAllocas
//===----------------------------------------------------------------------===//

def TweakSpilledAllocas : Pass<"tweak-spilled-allocas",
                               "mlir::LLVM::LLVMFuncOp"> {
  let summary = "Trim and optimize lifetimes of spilled allocas.";
  let description = [{
    When LLVM lowers coroutines, spilled allocas are hoisted into the coroutine
    frame, invalidating their lifetime markers. LLVM's `coro-split` pass pukes
    when this happens, so prevent it by stripping lifetimes of spilled allocas.
    This pass must run prior to `lower-control-flow`, since the algorithm is
    trivial on region control-flow form.

    This pass also makes a small optimization to reduce the number of variables
    places on coroutine frames. Since `pop.stack_allocation` operations are
    lowered to an `alloca` at the top of the function, it is quite common to see
    `alloca > await > lifetime.start > lifetime.end`. Only the switched-resume
    lowering is intelligent enough to do this automatically, but since KGEN
    coroutines use the async lowering, it has to be done here.
  }];

  let statistics = [
    Statistic<"numLocalVars", "num-local-vars",
              "the number of variables moved off the coroutine frame">,
  ];
}

//===----------------------------------------------------------------------===//
// LowerKGENCoroutinesAsync
//===----------------------------------------------------------------------===//

def LowerKGENCoroutinesAsync : Pass<"lower-coroutines-async",
                                    "mlir::ModuleOp"> {
  let summary = "Lower async functions to async LLVM coroutines.";
  let description = [{
    The `lower-coroutines-async` pass lowers KGEN coroutines implemented with
    POP coroutine operations to LLVM async coroutine intrinsics. LLVM async
    coroutine intrinsics require the front-end to handle control-flow and ABI.
    We generate the code to marshall function arguments and results through the
    coroutine async context and we handle control-flow using by storing the
    current resume function in the context.
  }];

  let dependentDialects = ["::mlir::LLVM::LLVMDialect"];
}

//===----------------------------------------------------------------------===//
// LowerPOPToLLVM
//===----------------------------------------------------------------------===//

def LowerPOPToLLVM : Pass<"lower-pop-to-llvm"> {
  let summary = "Lower the `pop` dialect to the `llvm` dialect.";
  let description = [{
    This pass performs a conversion of fully-elaborated and specified `pop`
    dialect operations to LLVM dialect operations.
  }];

  let dependentDialects = ["::mlir::LLVM::LLVMDialect"];
}

//===----------------------------------------------------------------------===//
// LowerGlobalPOPToLLVM
//===----------------------------------------------------------------------===//

def LowerGlobalPOPToLLVM : Pass<"lower-global-pop-to-llvm", "mlir::ModuleOp"> {
  let summary = "Lower global `pop` dialect operations to the `llvm` dialect.";
  let description = [{
    This module pass lowers `pop` operations that have global implications,
    and thus their lowering pass needs to run on the whole module. These are
    external calls and glboal constant operations.
  }];

  let dependentDialects = ["::mlir::LLVM::LLVMDialect"];
  // FIXME(#16605): Global destructors don't work in JIT mode.
  let options = [
    Option<"disableGlobalDtors", "disable-global-dtors", "bool", "false",
           "If true, global destructors are not generated.">
  ];
}

//===----------------------------------------------------------------------===//
// LowerControlFlow
//===----------------------------------------------------------------------===//

def LowerControlFlow : Pass<"lower-control-flow"> {
  let summary = "Lower structured control flow to LLVM and CFGs.";
  let description = [{
    This pass converts structured control-flow operations to LLVM operations and
    control-flow graph regions. Because this pass generates CFG regions, it must
    run after `lower-kgen-to-llvm`, which lowers `kgen.func` to `llvm.func`.
  }];

  let dependentDialects = ["::mlir::LLVM::LLVMDialect"];
}

//===----------------------------------------------------------------------===//
// ElaborateGenerators
//===----------------------------------------------------------------------===//

def ElaborateGenerators : Pass<"elaborate-generators", "mlir::ModuleOp"> {
  let summary = "elaborate generators into fully concrete funcs";
  let description = [{
    This pass performs the elaboration step for the kgen pipeline,
    converting generators and generator interfaces into concrete
    funcs.
  }];

  // FIXME(#15949): Should not require all these dialects to be loaded.
  let dependentDialects = [
    "DebugInfo::DebugInfoDialect",
    "HLCF::HLCFDialect",
    "MDialect",
    "mlir::LLVM::LLVMDialect",
    "mlir::index::IndexDialect",
  ];

  let options = [
    Option<"enableSearch", "enable-search", "bool", "false",
           "If true, benchmark implementations to find the fastest one.">,
    Option<"testDiagnostics", "test-diagnostics", "bool", "false",
           "If true, emit additional interesting diagnostics.">,
    Option<"maxDepth", "max-depth", "unsigned",
           "std::numeric_limits<unsigned>::max()",
           "The maximum elaborator instantiation depth.">,
    Option<"elaborateLocations", "elaborate-locations", "bool", "false",
           "If true, parameter references in locations will be concretized.">,
  ];
}

//===----------------------------------------------------------------------===//
// PruneImpossibleVariants
//===----------------------------------------------------------------------===//

def PruneImpossibleVariants: Pass<"prune-impossible-variants",
                                  "mlir::ModuleOp"> {
  let summary = "remove variant cases that are known to be impossible";
  let description = [{
    The `prune-impossible-variants` pass runs a simple forward data-flow
    analysis to determine variant cases that are impossible.

    The pass folds `pop.variant.is` operations to constants when the operand is
    known to be or not to be the queried type and rewrites function signatures
    that contain variants of known types to those types.

    This pass must run post-elaboration.
  }];
}

//===----------------------------------------------------------------------===//
// AlwaysInlineParametric
//===----------------------------------------------------------------------===//

def AlwaysInlineParametric : Pass<"always-inline-param", "mlir::ModuleOp"> {
  let summary = "Process concrete 'always_inline' operations";
  let description = [{
    The `always-inline-param` pass will process all concrete calls to
    'always_inline' generators and inline them. If a cycle is encountered during
    inlining, the pass emits an error and fails to inline the cycle. This pass
    will strip debug info as appropriate for functions marked
    'always_inline(nodebug)'. This pass can only run on parametric KGEN IR.
  }];

  let dependentDialects = ["HLCF::HLCFDialect"];

  let options = [
    Option<"nodebugOnly", "nodebug-only", "bool", "false",
           "If true, only `always_inline_no_debug` functions are inlined.">
  ];
}

//===----------------------------------------------------------------------===//
// ConstraintReduction
//===----------------------------------------------------------------------===//

def ConstraintReduction : Pass<"constraint-reduction", "KGEN::GeneratorOp"> {
  let summary = "Use a constraint set to reduce generator constraints.";
  let description = [{
    This pass analyses equivalence and equality constraints on a generator to
    determine whether there are redundant constraints that can be removed or
    whether the generator has a contradiction in its constraint set.
  }];
}

//===----------------------------------------------------------------------===//
// ForceInline
//===----------------------------------------------------------------------===//

def ForceInline : Pass<"force-inline", "mlir::ModuleOp"> {
  let summary = "Process all 'always_inline' functions";
  let description = [{
    The `force-inline` pass will process all calls to 'always_inline` functions
    and inline them. If a cycle is encountered during inlining, the pass emits
    an error and fails to inline the cycle. This pass will strip debug info as
    appropriate for functions marked 'always_inline(nodebug)'. This pass must
    run on concrete KGEN IR.
  }];

  let dependentDialects = ["HLCF::HLCFDialect"];

  let options = [
    Option<"updateDebugInfo", "update-debug-info", "bool", "true",
           "If true, debug info of inlined functions are updated accordingly.">,
    Option<"funcPipelineStr", "func-pipeline", "std::string", "\"\"",
           "Specify the inner pipeline to use on functions.">
  ];
}

//===----------------------------------------------------------------------===//
// CleanupCompilerGlobals
//===----------------------------------------------------------------------===//

def CleanupCompilerGlobals: Pass<"cleanup-compiler-globals",
                                 "KGEN::FuncOp"> {
  let summary = "remove uses of global variables";
  let description = [{
    We use global variables to pass captures into lifted region parameters.
    These lifted regions are marked always_inline, so after inlining we
    can clean up usages of global variables. This pass is responsible for
    doing that.

    This pass must run post-elaboration, and after inlining.
  }];

  let dependentDialects = ["KGENDialect", "POP::POPDialect"];
}

//===----------------------------------------------------------------------===//
// EliminateDeadSymbols
//===----------------------------------------------------------------------===//

def EliminateDeadSymbols: Pass<"eliminate-dead-symbols", "ModuleOp"> {
  let summary = "remove dead symbols.";
  let description = [{
    This pass walks the symbols defined in the module and removes them
    if they aren't exported and have no uses.
  }];

  let dependentDialects = ["KGENDialect"];

  let statistics = [
    Statistic<"numErased", "num-erased", "the number of dead symbols removed">,
  ];
}

//===----------------------------------------------------------------------===//
// FoldGlobalConstLoads
//===----------------------------------------------------------------------===//

def FoldGlobalConstLoads : Pass<"fold-global-const-loads", "KGEN::FuncOp"> {
  let summary = "Replace loads from global constants with the constant";
  let description = [{
    When we load from a global constant we can just directly replace it with
    the constant itself. This improves codegen as the global constant itself
    cannot be directly folded but the constant obviously can.
  }];

  let dependentDialects = ["KGENDialect", "POP::POPDialect"];

  let statistics = [
    Statistic<"numLoadsFolded", "num-loads-folded",
              "the number of loads folded away">,
  ];
}

//===----------------------------------------------------------------------===//
// StackReuse
//===----------------------------------------------------------------------===//

def StackReuse : Pass<"stack-reuse", "KGEN::FuncOp"> {
  let summary = "Elide redundant stack values.";
  let description = [{
    The `stack-reuse` pass is an optimization that attempts to remove unneeded
    stack allocations from the program. These are stack allocations where at all
    points the memory is read, the stack allocation has a value equal to some
    other live stack allocation in the program, and therefore it can be removed.

    NOTE: This pass *must* run after `lower-closures`, because stack allocations
    are assumed to never cross implicit control-flow boundaries.

    Example:

    ```mlir
    %s0 = pop.stack_allocation 1 x index
    %s1 = pop.stack_allocation 1 x index
    pop.store %arg0, %s0
    pop.store %arg1, %s1

    %s2 = pop.stack_allocation 1 x index
    pop.store %arg0, %s2
    %v0 = pop.load %s2
    pop.store %arg1, %s2
    %v1 = pop.load %s2
    ```

    The third stack allocation can be replaced entirely by a combination of the
    first two:

    ```mlir
    %s0 = pop.stack_allocation 1 x index
    %s1 = pop.stack_allocation 1 x index
    pop.store %arg0, %s0
    pop.store %arg1, %s1

    %v0 = pop.load %s0
    %v1 = pop.load %s1
    ```
  }];

  let statistics = [
    Statistic<"numElidedVars", "num-elided-vars",
              "the number of stack allocations elided">,
    Statistic<"numErasedOps", "num-erased-ops",
              "the number of operations erased, including stack allocations">,
  ];
}

//===----------------------------------------------------------------------===//
// Mem2Reg
//===----------------------------------------------------------------------===//

def Mem2Reg : Pass<"mem-2-reg"> {
  let summary = "Optimization pass that promotes memory to registers";
  let description = [{
    The `mem-2-reg` pass does memory elision over POP dialect operations by
    promoting values that live in stack memory, denoted by
    `pop.stack_allocation`, to register values, when all uses of the value by
    loads and stores are visible.

    This pass can run both before and after elaboration, but it can only analyze
    stack allocations with concrete sizes, and it can only run before
    control-flow lowering, since it does not work on CFGs.

    This pass is very basic and only elides stack allocations if all stores are
    in the same scope. It can replace loads spanning multiple regions though.

    Example:

    ```mlir
    %0 = pop.stack_allocation 1 x index
    pop.store %arg0, %0 : !pop.pointer<index>
    %1 = pop.load %0 : !pop.pointer<index>
    kgen.return %1 : index
    ```

    Will become:

    ```mlir
    kgen.return %arg0 : index
    ```

    However, stores within a nested region will not be elided (yet).

    ```mlir
    %0 = pop.stack_allocation 1 x index
    hlcf.if %arg2 {
      pop.store %arg0, %0 : !pop.pointer<index>
    } else {
      pop.store %arg1, %0 : !pop.pointer<index>
    }
    %1 = pop.load %0 : !pop.pointer<index>
    kgen.return %1 : index
    ```
  }];

  let statistics = [
    Statistic<"numAllocsElided", "num-allocs-elided",
              "the number of variables moved from memory to registers">,
    Statistic<"numLoadsElided", "num-loads-elided",
              "the number of loads elided">,
    Statistic<"numStoresElided", "num-stores-elided",
              "the number of stores elided">,
  ];
}

//===----------------------------------------------------------------------===//
// Basic Invariant code motion
//===----------------------------------------------------------------------===//

def HoistTrivialInvariants : Pass<"hoist-trivial-invariants", "KGEN::FuncOp"> {
  let summary = "Hoist trivial invariant operations out of regions";
  let description = [{
    Hoists operations which are trivially invariant within if and for blocks
    into earliest block we can.

    ```mlir
      %s = pop.load %arg0 : !pop.pointer<struct<index, index, index>>

      hlcf.loop {
        %0 = pop.struct.extract %s[0] : !pop.pointer<struct<index, index, index>>
        hlcf.loop {
          %1 = pop.struct.extract %s[1] : !pop.pointer<struct<index, index, index>>
          hlcf.if %arg2 {
            %2 = pop.struct.extract %s[2] :
                        !pop.pointer<struct<index, index, index>>
            // ...
          } else {
            // ..
          }
        }
      }
    ```

    Becomes:

    ```mlir
      %s = pop.load %arg0 : !pop.pointer<struct<index, index, index>>
      %0 = pop.struct.extract %s[0] : !pop.pointer<struct<index, index, index>>
      %1 = pop.struct.extract %s[1] : !pop.pointer<struct<index, index, index>>
      %2 = pop.struct.extract %s[2] : !pop.pointer<struct<index, index, index>>

      hlcf.loop {
        hlcf.loop {
          hlcf.if %arg2 {
            // ...
          } else {
            // ..
          }
        }
      }
    ```

    Even though `extract_2` was within a condition it is still safe to move
    as it has no side effect. LLVM can move it back into the condition if it is
    more performant, however if we do not move it LLVM is limited in many
    situations from being able to move it back.
  }];

  let statistics = [
    Statistic<"numHoisted", "num-hoisted", "the number of operations hoisted">,
  ];
}

//===----------------------------------------------------------------------===//
// Control Flow Simplification
//===----------------------------------------------------------------------===//

def SimplifyCF : Pass<"simplify-cf", "KGEN::FuncOp"> {
  let summary = "Simplify control flow constructs";
  let description = [{
    Simplifies control flow in the given function, e.g. removes trivial loops,
    which have just one iteration.
    Hoists operations which are trivially invariant within if and for blocks
    into earliest block we can.

    ```mlir
      hlcf.loop {
        some_ops  // no other break or contrinue ops
        hlcf.break
      }
    ```

    Becomes:

    ```mlir
      some_ops
    ```
  }];

  let statistics = [
    Statistic<"numErasedLoops", "num-erased-loops",
              "the number of trivial loops erased">,
    Statistic<"numErasedTry", "num-erased-try",
              "the number of trivial try erased">,
  ];
}

//===----------------------------------------------------------------------===//
// SROA
//===----------------------------------------------------------------------===//

def SROA : Pass<"sroa"> {
  let summary = "Scalar replacement of aggregates";
  let description = [{
    SROA identifies memory allocations of compostite structures and breaks them
    down into scalar alternatives where possible.

    ```mlir
    %struct = pop.stack_allocation 1 x !pop.struct<index, index, index, index>
    ```

    Becomes

    ```mlir
    %sclar1 = pop.stack_allocation 1 x index
    %sclar2 = pop.stack_allocation 1 x index
    %sclar3 = pop.stack_allocation 1 x index
    %sclar4 = pop.stack_allocation 1 x index
    ```

    Doing this gives mem-2-reg an easier time identifying optimization
    opportunities as it eliminates problematic aliasing.
  }];

  let statistics = [
    Statistic<"numReplacedAllocs", "num-replaced-allocas",
              "the number of aggregate allocations replaced with scalars">,
  ];
}

//===----------------------------------------------------------------------===//
// LowerRuntimeClosures
//===----------------------------------------------------------------------===//

def LowerRuntimeClosures : Pass<"lower-runtime-closures", "mlir::ModuleOp"> {
  let summary = "Lowers closure types into struct of two pointers";

  let description = [{
    In the runtime-closures pass, we lifted nested functions into top level
     functions and replaced references to them with kgen closure operations.
     In this pass, the closure operations are lowered to llvm dialect.

    1) The op that represents a closure creation should lower to
        (a) a top level function that knows how to unpack the state
            and call the lifted function
        (b) an allocation of memory and storage of captured state
        (c) creation of a struct that contains a pointer to (a) and a pointer to (b)
    2) The op that represents a closure inmvocation should be lowered to
        (a) extraction of function pointer from struct
        (b) extraction of data pointer from struct
        (c) invoke function with (b) + dynamic arguments
  }];

  let dependentDialects = ["KGENDialect", "POP::POPDialect"];
}

//===----------------------------------------------------------------------===//
// SynthesizeDebugInfo
//===----------------------------------------------------------------------===//

def SynthesizeDebugInfo : Pass<"synth-debuginfo", "mlir::ModuleOp"> {
  let summary = "Synthesize debuginfo from IR locations";

  let description = [{
    This pass generates synthetic debuginfo from the IR, using file locations
    present on the operations in the IR. This pass is a workaround debuginfo
    being broken pre-elaboration due to parameters. If there are no file
    locations in the IR, this pass will fail.
  }];

  let dependentDialects = ["DebugInfo::DebugInfoDialect"];
}

//===----------------------------------------------------------------------===//
// RaiseForLoops
//===----------------------------------------------------------------------===//

def RaiseForLoops: Pass<"raise-for-loops", "KGEN::FuncOp"> {
  let summary = "raise hlcf.for loops.";
  let description = [{
    The `raise-for-loops` pass will transform simple `hlcf.loop` with no early exits
    into `hlcf.for` operation. This pass must run on concrete KGEN IR.
  }];

  let dependentDialects = ["HLCF::HLCFDialect"];
}

//===----------------------------------------------------------------------===//
// LoopUnrolling
//===----------------------------------------------------------------------===//

def LoopUnrolling : Pass<"loop-unrolling", "KGEN::FuncOp"> {
  let summary = "unroll loops";
  let description = [{
    The `loop-unrolling` pass will unroll hlcf for-loops with factors from the
    for loop decorator. This pass will strip hlcf for-loop's `unroll_factor`
    attribute.  This pass must run on concrete KGEN IR.
  }];

  let dependentDialects = ["HLCF::HLCFDialect"];
}

//===----------------------------------------------------------------------===//
// LowerLoops
//===----------------------------------------------------------------------===//

def LowerLoops: Pass<"lower-loops", "KGEN::FuncOp"> {
  let summary = "lower high-level loop abstractions to `hlcf.loop`";
  let description = [{
    The `lower-loops` pass will lower high-level loop abstractions, such as
    `hlcf.for` operations, to `hlcf.loop`.
  }];

  let dependentDialects = ["HLCF::HLCFDialect"];
}

//===----------------------------------------------------------------------===//
// ExternalizePrecompiledFunctions
//===----------------------------------------------------------------------===//

def ExternalizePrecompiledFunctions:
    Pass<"externalize-precompiled-functions"> {
  let summary = "Externalize precompiled functions.";
  let description = [{
    The `externalize-precompiled-funcs` pass will find precompiled functions,
    and replace them with kgen.extern.func.

    When used in conjunction with packages, this should greatly reduce the
    amount of code passed to LLVM.
  }];
}
