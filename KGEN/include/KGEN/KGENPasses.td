//===----------------------------------------------------------------------===//

def ResolveCompilerPromises : Pass<"resolve-compiler-promises", "ModuleOp"> {
  let summary = "reverse callgraph specialization to resolve promises";
  let description = [{
    TODO
  }];

  let dependentDialects = [
