static const char *kInitMatplotlibStr = R"python(%%python
display_start = "{display_start}"
display_end = "{display_end}"
backend_str = """{@ENABLE_MATPLOTLIB_STR@}"""

@MATPLOTLIB_BACKEND_STR@
)python";
