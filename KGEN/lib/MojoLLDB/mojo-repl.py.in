#!$<TARGET_FILE:Python3::Interpreter>
import shutil
import subprocess
import sys

if __name__ == "__main__":
  lldb_path = shutil.which("lldb")
  if not lldb_path:
    print("Can't find 'lldb' - please run 'build-llvm lldb && build MojoLLDB'")
    exit(1)

  subprocess.run([lldb_path, "-R", "mojo", "-r", *sys.argv[1:]])
