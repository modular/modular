//
//===----------------------------------------------------------------------===//
//
// This file is intended to be #include'd multiple times to extract information
// about special functions.
//
//===----------------------------------------------------------------------===//

#ifndef SF
#error "must define SF macro before including this header"
#endif

// SF should be defined like this:
//     SF(ENUM, NAME, NUMOPERANDS, FLAGS)
// Where numoperands is the number of operands required (when not -1).

SF(kNew, "__new__", -1, kImplicitlyStaticMethod)
SF(kInit, "__init__", -1, kInstMethod)

// Unary arithmetic operators.
SF(kNeg, "__neg__", 1, kInstMethod)
SF(kPos, "__pos__", 1, kInstMethod)
SF(kInvert, "__invert__", 1, kInstMethod)

// Normal comparison operators.
SF(kCmpLess, "__lt__", 2, kInstMethod)
SF(kCmpLessEqual, "__le__", 2, kInstMethod)
SF(kCmpEqual, "__eq__", 2, kInstMethod)
SF(kCmpNotEqual, "__ne__", 2, kInstMethod)
SF(kCmpGreater, "__gt__", 2, kInstMethod)
SF(kCmpGreaterEqual, "__ge__", 2, kInstMethod)

// Normal arithmetic operators.
SF(kAdd, "__add__", 2, kInstMethod)
SF(kSub, "__sub__", 2, kInstMethod)
SF(kMul, "__mul__", 2, kInstMethod)
SF(kMatmul, "__matmul__", 2, kInstMethod)
SF(kTrueDiv, "__truediv__", 2, kInstMethod)
SF(kFloorDiv, "__floordiv__", 2, kInstMethod)
SF(kMod, "__mod__", 2, kInstMethod)
// TODO: pow has 3 arguments: __pow__(base, exp[, mod])
// Only the two-argument form pow(base, exp) is equivalent
// to using the power operator: base ** exp. Once we have default parameters
// we can support mod=None, but for now we keep it as 2 arguments definition.
SF(kPow, "__pow__", 2, kInstMethod)
SF(kLshift, "__lshift__", 2, kInstMethod)
SF(kRshift, "__rshift__", 2, kInstMethod)
SF(kAnd, "__and__", 2, kInstMethod)
SF(kXor, "__xor__", 2, kInstMethod)
SF(kOr, "__or__", 2, kInstMethod)

// Reversed arithmetic operators.
SF(kRAdd, "__radd__", 2, kInstMethod)
SF(kRSub, "__rsub__", 2, kInstMethod)
SF(kRMul, "__rmul__", 2, kInstMethod)
// ... more

// In place operators like +=
SF(kIAdd, "__iadd__", 2, kByRefSelfInstMethod)
SF(kISub, "__isub__", 2, kByRefSelfInstMethod)
SF(kIMul, "__imul__", 2, kByRefSelfInstMethod)
SF(kIMatmul, "__imatmul__", 2, kByRefSelfInstMethod)
SF(kITrueDiv, "__itruediv__", 2, kByRefSelfInstMethod)
SF(kIFloorDiv, "__ifloordiv__", 2, kByRefSelfInstMethod)
SF(kIMod, "__imod__", 2, kByRefSelfInstMethod)
// TODO: ipow has 3 arguments: __ipow__(base, exp[, mod])
// Only the two-argument form pow(base, exp) is equivalent
// to using the power operator: base ** exp. Once we have default parameters
// we can support mod=None, but for now we keep it as 2 arguments definition.
SF(kIPow, "__ipow__", 2, kByRefSelfInstMethod)
SF(kILshift, "__ilshift__", 2, kByRefSelfInstMethod)
SF(kIRshift, "__irshift__", 2, kByRefSelfInstMethod)
SF(kIAnd, "__iand__", 2, kByRefSelfInstMethod)
SF(kIXor, "__ixor__", 2, kByRefSelfInstMethod)
SF(kIOr, "__ior__", 2, kByRefSelfInstMethod)
#undef SF
