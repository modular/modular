//
// This file is intended to be #include'd multiple times to extract information
// about special functions.
//
//===----------------------------------------------------------------------===//

#ifndef SF
#error "must define SF macro before including this header"
#endif

// SF should be defined like this:
//     SF(ENUM, NAME, NUMOPERANDS, FLAGS)
// Where numoperands is the number of operands required (when not -1).

SF(kNew, "__new__", -1, kImplicitlyStaticMethod)
SF(kInit, "__init__", -1, kInstMethod)

// Normal arithmetic operators.
SF(kAdd, "__add__", 2, kInstMethod)
SF(kSub, "__sub__", 2, kInstMethod)
SF(kMul, "__mul__", 2, kInstMethod)
// ... more: https://docs.python.org/3/reference/datamodel.html#object.__add__

// Reversed arithmetic operators.
SF(kRAdd, "__radd__", 2, kInstMethod)
SF(kRSub, "__rsub__", 2, kInstMethod)
SF(kRMul, "__rmul__", 2, kInstMethod)
// ... more

// In place operators like +=
SF(kIAdd, "__iadd__", 2, kByRefSelfInstMethod)
SF(kISub, "__isub__", 2, kByRefSelfInstMethod)
SF(kIMul, "__imul__", 2, kByRefSelfInstMethod)

#undef SF
