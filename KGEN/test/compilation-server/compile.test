 "params":{"module":"module attributes {M.target_info = #M.target<triple = \"arm64-apple-darwin23.4.0\", arch = \"apple-m3\">}{kgen.func export @inc(%arg0: index) -> index {kgen.return %arg0 : index}}"}}
