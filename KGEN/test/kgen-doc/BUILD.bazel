load("//bazel:api.bzl", "lit_tests")

package(default_visibility = ["//visibility:private"])

lit_tests(
    name = "kgen-doc",
    srcs = glob(
        ["**/*.mojo"],
        exclude = [
            "dotted.pkg/**/*.mojo",
            "test_std_mock/**/*.mojo",
            "test_package/**/*.mojo",
            "test_dir_package/**/*.mojo",
        ],
    ),
    data = glob([
        "dotted.pkg/**/*.mojo",
        "test_std_mock/**/*.mojo",
        "test_package/**/*.mojo",
        "test_dir_package/**/*.mojo",
    ]),
    mojo_deps = [
        "//max:layout",  # required by mojo_doc.mojo (layout.int_tuple)
        "@mojo//:std",
    ],
    tools = [
        "//KGEN/tools/kgen-doc",
    ],
)
