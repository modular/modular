# RUN: kgen -execute -func='$error-handling::main():index()' %s | FileCheck %s

# CHECK: first success
# CHECK-NEXT: second had an error
# CHECK-NEXT: --- '$error-handling::main()' returned 0


struct Error:
    fn __new__() -> Error:
        var value: Error
        return value


@raises
fn raiseErrorIf(cond: __mlir_type.i1) -> __mlir_type.index:
    if cond:
        raise Error()
    return 1


def implicitlyPropagate(cond: __mlir_type.i1) -> __mlir_type.index:
    return raiseErrorIf(cond)


@export
fn main() -> __mlir_type.index:
    try:
        implicitlyPropagate(False)
        __mlir_op.`zap.print`[fmt:"first success\n"]()
    except e0:
        __mlir_op.`zap.print`[fmt:"first had an error\n"]()
    try:
        implicitlyPropagate(True)
        __mlir_op.`zap.print`[fmt:"second success\n"]()
    except e1:
        __mlir_op.`zap.print`[fmt:"second had an error\n"]()
    return 0
