# RUN: kgen -execute -func='$error-handling::run_me():index()' %s | FileCheck %s

# CHECK: first success
# CHECK-NEXT: second had an error
# CHECK-NEXT: --- '$error-handling::run_me()' returned 0

from IO import print
from Int import Int
from Error import Error


@raises
fn raiseErrorIf(cond: BoolLiteral) -> Int:
    if cond:
        raise Error()
    return 0


def implicitlyPropagate(cond: BoolLiteral) -> Int:
    return raiseErrorIf(cond)


@export
fn run_me() -> __mlir_type.index:
    try:
        let a = implicitlyPropagate(False)
        print("first success\n")
    except e0:
        print("first had an error\n")
    try:
        let b = implicitlyPropagate(True)
        print("second success\n")
    except e1:
        print("second had an error\n")
    return 0
