# RUN: lit -enable-search %s | FileCheck %s

from Int import Int
from IO import print

# COM: We expect this to return 1 because the implementation chosen should be
# COM: the second impl of the inner interface.
# CHECK: 1


struct Foo:
    alias t = __mlir_type[`index`]
    var v: t

    fn __clone__(self&) -> Self:
      return Foo{v: self.v}

    fn __new__() -> Foo:
        return Foo {v: 0}

    fn bar(self):
        return


@export
fn top(x: Foo) -> __mlir_type.index:
    return top_itf(x)


@interface
@evaluator(evaluator)
fn top_itf(x: Foo) -> __mlir_type.index:
    ...


fn evaluator(
    funcs: __mlir_type.`!pop.pointer<(index) -> ()>`,
    size: __mlir_type.`index`,
) -> __mlir_type.`index`:
    return 1


@implements(top_itf)
fn top_itf_impl(ptr: Foo) -> __mlir_type.index:
    @always_inline
    fn _set():
        ptr.bar()
        return

    return inner_itf()


@interface
fn inner_itf() -> __mlir_type.index:
    ...


@implements(inner_itf)
fn inner_itf_impl1() -> __mlir_type.index:
    return 0


@implements(inner_itf)
fn inner_itf_impl2() -> __mlir_type.index:
    return 1


fn main():
    let f = Foo()
    let result = top(f)
    print(result)
