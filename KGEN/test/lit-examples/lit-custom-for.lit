# RUN: mojo %s | FileCheck %s

from Pointer import Pointer
from Int import Int
from IO import print


struct my_iter:
    var start: Int
    var end: Int
    var list: MyList

    fn __clone__(self&) -> Self:
        return Self {start: self.start, end: self.end, list: self.list}

    fn __new__(list: MyList) -> my_iter:
        return my_iter {start: 0, end: list.size, list: list}

    fn __next__(self&: my_iter) -> Int:
        let result: Int = self.start
        self.start += 1
        return self.list[result]

    fn __len__(self&: my_iter) -> Int:
        if self.start < self.end:
            return self.end - self.start
        return 0


struct MyList:
    var start: Pointer[Int]
    var size: Int

    fn __clone__(self&) -> Self:
        return Self {start: self.start, size: self.size}

    fn __new__(ptr: Pointer[Int], size: Int) -> MyList:
        return MyList {start: ptr, size: size}

    fn __setitem__(self&, idx: Int, val: Int):
        let ptr = self.start + idx
        ptr.store(val)

    fn __getitem__(self&, idx: Int) -> Int:
        let ptr = self.start + idx
        return ptr.load()

    fn __iter__(self&) -> my_iter:
        return my_iter(self)


fn printInt(x: Int):
    print(x.value)


fn main():
    let buffer = __mlir_op.`pop.stack_allocation`[
        count:3, _type : __mlir_type[`!pop.pointer<`, Int, `>`]
    ]()
    let my_pointer = Pointer[Int](buffer)

    var my_list = MyList(my_pointer, Int(3))
    my_list[0] = 25
    my_list[1] = 23
    my_list[2] = 19

    # CHECK: 25
    # CHECK: 23
    # CHECK: 19
    for item in my_list:
        printInt(item)
