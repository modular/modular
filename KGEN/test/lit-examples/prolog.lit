  fn __pow__(self, rhs: Int) -> Int:
    # CHECK: %0 = lit.struct.extract %rhs[value]
    # CHECK: %1 = kgen.call_param[(index) -> !kgen.ref<@Int>: @Int::@__new__](%0)
