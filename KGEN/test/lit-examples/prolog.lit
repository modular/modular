# RUN: kgen-translate -import-lit -verify-diagnostics %s | FileCheck %s
#===------------------------------------------------------------------------===#
#
# Standard Prolog(ue) for Lit.
#
# This file implements basic datatypes used commonly across lit programs.
#
#===------------------------------------------------------------------------===#

__include "../../../Kernels/lit-stdlib/Bool.lit"

# CHECK-LABEL: assertParam
fn assertParam[condVal: __mlir_type.i1]():
# CHECK: kgen.param.assert <condVal>, "param assertion failed"
  __mlir_op.`kgen.param.assert`[_type: [],
                                cond: condVal,
                                message: "param assertion failed"]()

fn printF32(x: F32):
  var f64 = __mlir_op.`pop.cast`[_type: __mlir_type.`!pop.scalar<f64>`](x.value)
  __mlir_op.`zap.print`[_type: [], fmt: "%f\n"](f64)

fn printInt(x: Int):
  __mlir_op.`zap.print`[_type: [], fmt: "%ld\n"](x.value)

#===------------------------------------------------------------------------===#
# Int
#===------------------------------------------------------------------------===#

# CHECK-LABEL: kgen.struct.decl @Int {
struct Int:
  # CHECK-NEXT: kgen.struct.field value : index
  var value : __mlir_type.index

  # CHECK-LABEL: lit.func @"__new__(__mlir_type.index)"(%value: index) -> !kgen.declref<@Int> attributes {isStatic} {
  fn __new__(value: __mlir_type.index) -> Int:
    # CHECK: %0 = kgen.struct.create(%value) : (index) -> !kgen.declref<@Int>
    # CHECK: kgen.return %0
    return __mlir_op.`kgen.struct.create`[_type: Int](value)

  # CHECK-LABEL: lit.func @"__lt__
  fn __lt__(self, rhs: Int) -> Bool:
    # CHECK: = index.cmp slt(%0, %1)
    return __mlir_op.`index.cmp`[pred:
                __mlir_attr.`#index<cmp_predicate slt>`](self.value, rhs.value)

  fn __le__(self, rhs: Int) -> Bool:
    return __mlir_op.`index.cmp`[pred:
                __mlir_attr.`#index<cmp_predicate sle>`](self.value, rhs.value)

  fn __eq__(self, rhs: Int) -> Bool:
    return __mlir_op.`index.cmp`[pred:
                __mlir_attr.`#index<cmp_predicate eq>`](self.value, rhs.value)

  fn __ne__(self, rhs: Int) -> Bool:
    return __mlir_op.`index.cmp`[pred:
                __mlir_attr.`#index<cmp_predicate ne>`](self.value, rhs.value)

  fn __gt__(self, rhs: Int) -> Bool:
    return __mlir_op.`index.cmp`[pred:
                __mlir_attr.`#index<cmp_predicate sgt>`](self.value, rhs.value)

  fn __ge__(self, rhs: Int) -> Bool:
    return __mlir_op.`index.cmp`[pred:
                __mlir_attr.`#index<cmp_predicate sge>`](self.value, rhs.value)

  fn __pos__(self) -> Int:
    return self

  fn __neg__(self) -> Int:
    return Int(__mlir_op.`index.sub`(0, self.value))

  fn __invert__(self) -> Int:
    return self ^ -1

  # CHECK-LABEL: lit.func @"__add__(Int,Int)"(%self: !kgen.declref<@Int>, %rhs: !kgen.declref<@Int>) -> !kgen.declref<@Int> {
  fn __add__(self, rhs: Int) -> Int:
    # CHECK: %0 = kgen.struct.extract %self[value]
    # CHECK: %1 = kgen.struct.extract %rhs[value]
    # CHECK: %2 = index.add %0, %1
    # CHECK: %3 = kgen.call @Int::@"__new__{{.*}}(%2) : (index) -> !kgen.declref<@Int>
    # CHECK: kgen.return %3
    return __mlir_op.`index.add`(self.value, rhs.value)
  # CHECK: }

  fn __sub__(self, rhs: Int) -> Int:
    return __mlir_op.`index.sub`(self.value, rhs.value)

  fn __mul__(self, rhs: Int) -> Int:
    return __mlir_op.`index.mul`(self.value, rhs.value)

  #fn __truediv__(self, rhs: Int) -> Int:
  #  return Int(rhs.value)      # TODO: Implement this

  fn __floordiv__(self, rhs: Int) -> Int:
    return __mlir_op.`index.floordivs`(self.value, rhs.value)

  #fn __mod__(self, rhs: Int) -> Int:
  #  TODO: use floored reminder as in Python
  #  ex. 1 // -2 = -1
  #      1 %  -2 = -1
  #  index.rems returns 1 (truncated division)
  #  So we need to adjust the result as follows
  # var r = Int(__mlir_op.`index.rems`(self.value, rhs.value))
  # if (r > Int(0) and rhs < Int(0)) or (r < Int(0) and rhs > Int(0)):
  #   r += rhs
  # return r
  # return Int(rhs.value)      # TODO: Implement this

  fn __pow__(self, rhs: Int) -> Int:
    var res = Int(1)
    var n = rhs
    if n < 0:
      # Not defined for integers, this should raise an
      # exception.
      res = Int(0)
    while n > 0:
        res *= self
        n -= 1
    return res

  fn __lshift__(self, rhs: Int) -> Int:
    if rhs < 0:
      # this should raise an exception.
      return 0
    return __mlir_op.`index.shl`(self.value, rhs.value)

  fn __rshift__(self, rhs: Int) -> Int:
    if rhs < 0:
      # this should raise an exception.
      return 0
    return __mlir_op.`index.shrs`(self.value, rhs.value)

  fn __and__(self, rhs: Int) -> Int:
    return __mlir_op.`index.and`(self.value, rhs.value)

  fn __xor__(self, rhs: Int) -> Int:
    return __mlir_op.`index.xor`(self.value, rhs.value)

  fn __or__(self, rhs: Int) -> Int:
    return __mlir_op.`index.or`(self.value, rhs.value)

  #===----------------------------------------------------------------------===#
  # In place operations.
  #===----------------------------------------------------------------------===#

  # CHECK-LABEL: lit.func @"__iadd__
  # CHECK-SAME: %self: !pop.pointer<@Int> byref, %rhs: !kgen.declref<@Int>) -> !kgen.declref<@Int> {
  fn __iadd__(self&, rhs: Int) -> Int:
    # CHECK: %0 = pop.load %self : !pop.pointer<@Int>
    # CHECK: %1 = kgen.call @Int::@"__add__{{.*}}(%0, %rhs) : (!kgen.declref<@Int>, !kgen.declref<@Int>) -> !kgen.declref<@Int>
    # CHECK: pop.store %1, %self
    self = self + rhs
    # CHECK: %2 = pop.load %self
    # CHECK: kgen.return %2
    return self

  fn __isub__(self&, rhs: Int) -> Int:
    self = self - rhs
    return self

  fn __imul__(self&, rhs: Int) -> Int:
    self = self * rhs
    return self

  # TODO: Since / returns a F32 this cannot be done inplace
  #fn __itruediv__(self&, rhs: Int) -> Int:
  #  self = self / rhs
  #  return self

  fn __ifloordiv__(self&, rhs: Int) -> Int:
    self = self // rhs
    return self

  #fn __imod__(self&, rhs: Int) -> Int:
  #  self = self % rhs
  #  return self

  fn __ipow__(self&, rhs: Int) -> Int:
    self = self ** rhs
    return self

  fn __ilshift__(self&, rhs: Int) -> Int:
    self = self << rhs
    return self

  fn __irshift__(self&, rhs: Int) -> Int:
    self = self >> rhs
    return self

  fn __iand__(self&, rhs: Int) -> Int:
    self = self & rhs
    return self

  fn __ixor__(self&, rhs: Int) -> Int:
    self = self ^ rhs
    return self

  fn __ior__(self&, rhs: Int) -> Int:
    self = self | rhs
    return self

#===------------------------------------------------------------------------===#
# F32
#===------------------------------------------------------------------------===#
#
# TODO: This should eventually be a typealias for a generic scalar type when
# parameters are fully working, and we have typealiases.
#

# CHECK-LABEL: kgen.struct.decl @F32 {
struct F32:
  var value : __mlir_type.`!pop.scalar<f32>`

  fn __new__(value: __mlir_type.`!pop.scalar<f32>`) -> F32:
    return __mlir_op.`kgen.struct.create`[_type: F32](value)

  # Literals always are represented with f64 for now.
  fn __new__(value: __mlir_type.f64) -> F32:
    var pop64 = __mlir_op.`pop.cast_from_builtin`
      [_type: __mlir_type.`!pop.scalar<f64>`](value)
    return F32(__mlir_op.`pop.cast`
      [_type: __mlir_type.`!pop.scalar<f32>`](pop64))

  fn __lt__(self, rhs: F32) -> Bool:
    return __mlir_op.`pop.cmp`[pred:
                      __mlir_attr.`#pop<cmp_pred lt>`](self.value, rhs.value)

  fn __le__(self, rhs: F32) -> Bool:
    return __mlir_op.`pop.cmp`[pred:
                      __mlir_attr.`#pop<cmp_pred le>`](self.value, rhs.value)

  fn __eq__(self, rhs: F32) -> Bool:
    return __mlir_op.`pop.cmp`[pred:
                       __mlir_attr.`#pop<cmp_pred eq>`](self.value, rhs.value)

  fn __ne__(self, rhs: F32) -> Bool:
    return __mlir_op.`pop.cmp`[pred:
                      __mlir_attr.`#pop<cmp_pred ne>`](self.value, rhs.value)

  fn __gt__(self, rhs: F32) -> Bool:
    return __mlir_op.`pop.cmp`[pred:
                      __mlir_attr.`#pop<cmp_pred gt>`](self.value, rhs.value)

  fn __ge__(self, rhs: F32) -> Bool:
    return __mlir_op.`pop.cmp`[pred:
                      __mlir_attr.`#pop<cmp_pred ge>`](self.value, rhs.value)

  fn __pos__(self) -> F32:
    return self

  fn __neg__(self) -> F32:
    var zero = __mlir_op.`pop.constant`[value: __mlir_attr.`0.0: f32`,
                                        _type: __mlir_type.`!pop.scalar<f32>`]()
    return __mlir_op.`pop.sub`(zero, self.value)

  fn __add__(self, rhs: F32) -> F32:
    return __mlir_op.`pop.add`(self.value, rhs.value)

  fn __sub__(self, rhs: F32) -> F32:
    return __mlir_op.`pop.sub`(self.value, rhs.value)

  fn __mul__(self, rhs: F32) -> F32:
    return __mlir_op.`pop.mul`(self.value, rhs.value)

  fn __truediv__(self, rhs: F32) -> F32:
    return __mlir_op.`pop.div`(self.value, rhs.value)

  # fn __floordiv__(self, rhs: F32) -> F32: # TODO: Implement this
  # fn __mod__(self, rhs: F32) -> F32: # TODO: Implement this
  # fn __pow__(self, rhs: F32) -> F32: # TODO: Implement this

  #===----------------------------------------------------------------------===#
  # In place operations.
  #===----------------------------------------------------------------------===#

  fn __iadd__(self&, rhs: F32) -> F32:
    self = self + rhs
    return self

  fn __isub__(self&, rhs: F32) -> F32:
    self = self - rhs
    return self

  fn __imul__(self&, rhs: F32) -> F32:
    self = self * rhs
    return self

  fn __itruediv__(self&, rhs: F32) -> F32:
    self = self / rhs
    return self

  #fn __ifloordiv__(self&, rhs: F32) -> F32:
  #  self = self.__floordiv__(rhs)
  #  return self

  #fn __imod__(self&, rhs: F32) -> F32:
  #  self = self.__mod__(rhs)
  #  return self

  #fn __ipow__(self&, rhs: F32) -> F32:
  #  self = self.__pow__(rhs)
  #  return self

#===------------------------------------------------------------------------===#
# WIP Types
#===------------------------------------------------------------------------===#

# NOTE: This would be more naturally modeled as an enum, but this works for now.
struct DType:
  var value : __mlir_type.`!kgen.dtype`

  fn __new__(value: __mlir_type.`!kgen.dtype`) -> DType:
    return __mlir_op.`kgen.struct.create`[_type: DType](value)

  # TODO: This should be something like:
  # @static var f32 = DType(__mlir_attr.`#kgen.dtype.constant<f32> : !kgen.dtype`)
  @staticmethod
  fn getF32() -> DType:
    return DType(__mlir_attr.`#kgen.dtype.constant<f32> : !kgen.dtype`)

  @staticmethod
  fn getF64() -> DType:
    return DType(__mlir_attr.`#kgen.dtype.constant<f64> : !kgen.dtype`)

  @staticmethod
  fn getSI32() -> DType:
    return DType(__mlir_attr.`#kgen.dtype.constant<si32> : !kgen.dtype`)

  @staticmethod
  fn getSI64() -> DType:
    return DType(__mlir_attr.`#kgen.dtype.constant<si64> : !kgen.dtype`)

struct Scalar[type: DType]:
  pass

#===------------------------------------------------------------------------===#
# SIMD
#===------------------------------------------------------------------------===#

# CHECK-LABEL: kgen.struct.decl @SIMD<size, type: dtype> {
struct SIMD[size: __mlir_type.index, type: __mlir_type.`!kgen.dtype`]:
  # CHECK: kgen.struct.field value : !pop.simd<size, type>
  var value: __mlir_type.`!pop.simd<#lit.placeholder : index, #lit.placeholder : !kgen.dtype>`[size, type]

  # CHECK-LABEL:  lit.func @"__new__{{.*}}(%value: !pop.simd<size, type>) -> !kgen.declref<@SIMD<size = size, type: dtype = type>> attributes {isStatic}
  fn __new__(value: __mlir_type.`!pop.simd<#lit.placeholder : index, #lit.placeholder : !kgen.dtype>`[size, type]) -> SIMD[size, type]:
    # CHECK: %0 = kgen.struct.create(%value) : (!pop.simd<size, type>) -> !kgen.declref<@SIMD<size = size, type: dtype = type>>
    # CHECK: kgen.return %0
    return __mlir_op.`kgen.struct.create`[_type: SIMD[size, type]](value)

  # Initialize from FP literal.
  fn __new__(value: __mlir_type.f64) -> SIMD[size, type]:
    # TODO: should be 'let' declarations to reduce IR size.
    var pop = __mlir_op.`pop.cast_from_builtin`[_type: __mlir_type.`!pop.scalar<f64>`](value)
    var popCast = __mlir_op.`pop.cast`[_type: __mlir_type.`!pop.simd<1, #lit.placeholder : !kgen.dtype>`[type]](pop)
    var result = __mlir_op.`pop.simd.splat`[_type: __mlir_type.`!pop.simd<#lit.placeholder : index, #lit.placeholder : !kgen.dtype>`[size, type]](popCast)
    return __mlir_op.`kgen.struct.create`[_type: SIMD[size, type]](result)

  # CHECK-LABEL: lit.func @"__add__{{.*}}(%self: !kgen.declref<@SIMD<size = size, type: dtype = type>>,
  fn __add__(self, rhs: SIMD[size, type]) -> SIMD[size, type]:
    # CHECK: %0 = kgen.struct.extract %self[value] : !pop.simd<size, type> from
    # CHECK: %1 = kgen.struct.extract %rhs[value] : !pop.simd<size, type> from
    # CHECK: %2 = pop.add %0, %1 : !pop.simd<size, type>
    # CHECK: %3 = kgen.call @SIMD::@"__new__{{.*}}<size = size, type: dtype = type>(%2) : (!pop.simd<size, type>) -> !kgen.declref<@SIMD<size = size, type: dtype = type>>
    # CHECK: kgen.return %3 : !kgen.declref<@SIMD<size = size, type: dtype = type>>
    return __mlir_op.`pop.add`(self.value, rhs.value)

  fn __sub__(self, rhs: SIMD[size, type]) -> SIMD[size, type]:
    return __mlir_op.`pop.sub`(self.value, rhs.value)

  fn __mul__(self, rhs: SIMD[size, type]) -> SIMD[size, type]:
    return __mlir_op.`pop.mul`(self.value, rhs.value)

  fn __truediv__(self, rhs: SIMD[size, type]) -> SIMD[size, type]:
    return __mlir_op.`pop.div`(self.value, rhs.value)

  # fn __floordiv__(self, rhs: F32) -> F32: # TODO: Implement this
  # fn __mod__(self, rhs: F32) -> F32: # TODO: Implement this
  # fn __pow__(self, rhs: F32) -> F32: # TODO: Implement this

  fn __lt__(self, rhs: SIMD[size, type])
     -> SIMD[size, __mlir_attr.`#kgen.dtype.constant<bool> : !kgen.dtype`]:
    return __mlir_op.`pop.cmp`[pred: __mlir_attr.`#pop<cmp_pred lt>`](self.value, rhs.value)

  fn __le__(self, rhs: SIMD[size, type])
     -> SIMD[size, __mlir_attr.`#kgen.dtype.constant<bool> : !kgen.dtype`]:
    return __mlir_op.`pop.cmp`[pred: __mlir_attr.`#pop<cmp_pred le>`](self.value, rhs.value)

  fn __eq__(self, rhs: SIMD[size, type])
     -> SIMD[size, __mlir_attr.`#kgen.dtype.constant<bool> : !kgen.dtype`]:
    return __mlir_op.`pop.cmp`[pred: __mlir_attr.`#pop<cmp_pred eq>`](self.value, rhs.value)

  fn __ne__(self, rhs: SIMD[size, type])
     -> SIMD[size, __mlir_attr.`#kgen.dtype.constant<bool> : !kgen.dtype`]:
    return __mlir_op.`pop.cmp`[pred: __mlir_attr.`#pop<cmp_pred ne>`](self.value, rhs.value)

  fn __gt__(self, rhs: SIMD[size, type])
     -> SIMD[size, __mlir_attr.`#kgen.dtype.constant<bool> : !kgen.dtype`]:
    return __mlir_op.`pop.cmp`[pred: __mlir_attr.`#pop<cmp_pred gt>`](self.value, rhs.value)

  fn __ge__(self, rhs: SIMD[size, type])
     -> SIMD[size, __mlir_attr.`#kgen.dtype.constant<bool> : !kgen.dtype`]:
    return __mlir_op.`pop.cmp`[pred: __mlir_attr.`#pop<cmp_pred ge>`](self.value, rhs.value)

  fn __pos__(self) -> SIMD[size, type]:
    return self

  fn __neg__(self) -> SIMD[size, type]:
    return __mlir_op.`pop.neg`(self.value)

  #===----------------------------------------------------------------------===#
  # In place operations.
  #===----------------------------------------------------------------------===#

  fn __iadd__(self&, rhs: SIMD[size, type]) -> SIMD[size, type]:
    self = self + rhs
    return self

  fn __isub__(self&, rhs: SIMD[size, type]) -> SIMD[size, type]:
    self = self - rhs
    return self

  fn __imul__(self&, rhs: SIMD[size, type]) -> SIMD[size, type]:
    self = self * rhs
    return self

  fn __itruediv__(self&, rhs: SIMD[size, type]) -> SIMD[size, type]:
    self = self / rhs
    return self

  #fn __ifloordiv__(self&, rhs: SIMD[size, type]) -> SIMD[size, type]:
  #  self = self // rhs
  #  return self

  #fn __imod__(self&, rhs: SIMD[size, type]) -> SIMD[size, type]:
  #  self = self.__mod__(rhs)
  #  return self

  #fn __ipow__(self&, rhs: SIMD[size, type]) -> SIMD[size, type]:
  #  self = self.__pow__(rhs)
  #  return self

  # TODO: Move to global function.
  fn fma(self, multiplier: SIMD[size, type], accumulator: SIMD[size, type])
     -> SIMD[size, type]:
    return __mlir_op.`pop.fma`(self.value, multiplier.value, accumulator.value)

#===------------------------------------------------------------------------===#
# Error
#===------------------------------------------------------------------------===#

struct StringRef:
    var data: __mlir_type.`!pop.pointer<!pop.scalar<si8>>`
    var size: __mlir_type.`index`

struct Error:
    var msg: StringRef

    fn __new__(msg: StringRef) -> Error:
        var result: Error
        result.msg = msg
        return result

struct ErrorOr[type: __mlir_type.`!kgen.mlirtype`]:
    var value: __mlir_type.`!pop.variant<@Error, #lit.placeholder : !kgen.mlirtype>>`[type]

    fn __new__(value: __mlir_type.`!pop.variant<@Error, #lit.placeholder : !kgen.mlirtype>>`[type])
      -> ErrorOr[type]:
        return __mlir_op.`kgen.struct.create`[_type: ErrorOr[type]](value)

    fn __new__(err: Error) -> ErrorOr[type]:
        return __mlir_op.`kgen.struct.create`[_type: ErrorOr[type]](
          __mlir_op.`pop.variant.create`[_type: __mlir_type.`!pop.variant<@Error, #lit.placeholder : !kgen.mlirtype>>`[type]](err))

    fn __new__(value: __mlir_type.`!kgen.paramref<#lit.placeholder : !kgen.mlirtype>>`[type]) -> ErrorOr[type]:
        return __mlir_op.`kgen.struct.create`[_type: ErrorOr[type]](
           __mlir_op.`pop.variant.create`[_type: __mlir_type.`!pop.variant<@Error, #lit.placeholder : !kgen.mlirtype>>`[type]](value))

    fn __bool__(self: ErrorOr[type]) -> Bool:
        return Bool.false()
           if Bool(__mlir_op.`pop.variant.is`[testType: __mlir_attr.`!kgen.declref<@Error>`](self.value))
           else Bool.true()

    fn getValue(self: ErrorOr[type]) -> __mlir_type.`!kgen.paramref<#lit.placeholder : !kgen.mlirtype>>`[type]:
        return __mlir_op.`pop.variant.get`[_type: __mlir_type.`!kgen.paramref<#lit.placeholder : !kgen.mlirtype>>`[type]](self.value)

    fn getError(self: ErrorOr[type]) -> Error:
        return __mlir_op.`pop.variant.get`[_type: Error](self.value)

#===------------------------------------------------------------------------===#
# object
#===------------------------------------------------------------------------===#

# TODO: This should eventually model a dynamic object base class.  For now, this
# is just a placeholder to be used by untyped 'def' operands.
struct object:
