  # CHECK: lit.func @__and__(%self: !kgen.ref<@Int>, %rhs: !kgen.ref<@Int>) -> !kgen.ref<@Int> {
  fn __and__(self, rhs: Int) -> Int:
    # CHECK: %0 = lit.struct.extract %rhs[value]
