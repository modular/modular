# RUN: kgen-translate -import-lit -verify-diagnostics %s | FileCheck %s

# This is the start of a standard Prolog for Lit to use.

struct DType:
  pass

struct Scalar[type: DType]:
  pass

# CHECK-LABEL: lit.struct.decl @Int {
struct Int:
  # CHECK-NEXT: %value = lit.var.decl "value" : <index>
  var value : index

  # CHECK: lit.func @__new__(%value_0: index) -> !kgen.ref<@Int> attributes {isStatic} {
  fn __new__(value: index) -> Int:
    # TODO: Enable dict_display somehow so we can use "return {value: value}"
    var result: Int
    result.value = value
    return result

  # CHECK: lit.func @__add__(%self: !kgen.ref<@Int>, %rhs: !kgen.ref<@Int>) -> !kgen.ref<@Int> {
  fn __add__(self, rhs: Int) -> Int:
    # CHECK: %0 = lit.struct.extract %rhs[value]
    # CHECK: %1 = kgen.call_param[(index) -> !kgen.ref<@Int>: @Int::@__new__](%0)
    return Int(rhs.value)      # TODO: Use this somehow. :)
    # CHECK: kgen.return %1
  # CHECK: }

  # CHECK: lit.func @__sub__(%self: !kgen.ref<@Int>, %rhs: !kgen.ref<@Int>) -> !kgen.ref<@Int> {
  fn __sub__(self, rhs: Int) -> Int:
    # CHECK: %0 = lit.struct.extract %rhs[value]
    # CHECK: %1 = kgen.call_param[(index) -> !kgen.ref<@Int>: @Int::@__new__](%0)
    return Int(rhs.value)      # TODO: Use this somehow. :)
    # CHECK: kgen.return %1
  # CHECK: }

  # CHECK: lit.func @__mul__(%self: !kgen.ref<@Int>, %rhs: !kgen.ref<@Int>) -> !kgen.ref<@Int> {
  fn __mul__(self, rhs: Int) -> Int:
    # CHECK: %0 = lit.struct.extract %rhs[value]
    # CHECK: %1 = kgen.call_param[(index) -> !kgen.ref<@Int>: @Int::@__new__](%0)
    return Int(rhs.value)      # TODO: Use this somehow. :)
    # CHECK: kgen.return %1
  # CHECK: }

  # CHECK: lit.func @__matmul__(%self: !kgen.ref<@Int>, %rhs: !kgen.ref<@Int>) -> !kgen.ref<@Int> {
  fn __matmul__(self, rhs: Int) -> Int:
    # CHECK: %0 = lit.struct.extract %rhs[value]
    # CHECK: %1 = kgen.call_param[(index) -> !kgen.ref<@Int>: @Int::@__new__](%0)
    return Int(rhs.value)      # TODO: Use this somehow. :)
    # CHECK: kgen.return %1
  # CHECK: }

  # CHECK: lit.func @__truediv__(%self: !kgen.ref<@Int>, %rhs: !kgen.ref<@Int>) -> !kgen.ref<@Int> {
  fn __truediv__(self, rhs: Int) -> Int:
    # CHECK: %0 = lit.struct.extract %rhs[value]
    # CHECK: %1 = kgen.call_param[(index) -> !kgen.ref<@Int>: @Int::@__new__](%0)
    return Int(rhs.value)      # TODO: Use this somehow. :)
    # CHECK: kgen.return %1
  # CHECK: }

  # CHECK: lit.func @__floordiv__(%self: !kgen.ref<@Int>, %rhs: !kgen.ref<@Int>) -> !kgen.ref<@Int> {
  fn __floordiv__(self, rhs: Int) -> Int:
    # CHECK: %0 = lit.struct.extract %rhs[value]
    # CHECK: %1 = kgen.call_param[(index) -> !kgen.ref<@Int>: @Int::@__new__](%0)
    return Int(rhs.value)      # TODO: Use this somehow. :)
    # CHECK: kgen.return %1
  # CHECK: }

  # CHECK: lit.func @__mod__(%self: !kgen.ref<@Int>, %rhs: !kgen.ref<@Int>) -> !kgen.ref<@Int> {
