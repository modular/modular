    # CHECK: %1 = kgen.param.constant: (!kgen.ref<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int> = <@Int::@__sub__>
    # CHECK: %2 = kgen.partial_apply %1(%0, ?) : (!kgen.ref<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>
    # CHECK: %3 = kgen.call_indirect %2(%rhs) : (!kgen.ref<@Int>) -> !kgen.ref<@Int>
    # CHECK: pop.store %3, %self
    self = self.__sub__(rhs)
    # CHECK: %4 = pop.load %self
    # CHECK: kgen.return %4
    return self

  # CHECK: lit.func @__imul__(%self: !pop.pointer<@Int>, %rhs: !kgen.ref<@Int>) -> !kgen.ref<@Int> {
  fn __imul__(&self, rhs: Int) -> Int:
