  # CHECK: lit.func @__or__(%self: !kgen.ref<@Int>, %rhs: !kgen.ref<@Int>) -> !kgen.ref<@Int> {
  fn __or__(self, rhs: Int) -> Int:
    # CHECK: %0 = lit.struct.extract %rhs[value]
