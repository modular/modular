# RUN: mojo %s -doc-gen | FileCheck %s

"""
This is a module summary, that
spills over to the next line."""


# CHECK: # Module: lit-doc

# CHECK: This is a module summary, that spills over to the next line.

# CHECK: [TOC]

# CHECK: ## InMemoryStruct

# CHECK: ### fn_with_by_conventions
# CHECK: >  `` fn_with_by_conventions(self: Self&, arg: Self&, *args: Self&) -> Self& ``

# CHECK: This is a function summary.

# CHECK: **Args:**
# CHECK: - `` arg: Self& ``: This is a by-ref argument.
# CHECK: - `` *args: Self& ``: This is a variadic argument.

# CHECK: **Returns:**
# CHECK: This is a by-ref return value.


struct InMemoryStruct:
    fn __copy__(self) -> Self:
        return Self {}

    fn fn_with_by_conventions(
        self&, arg&: InMemoryStruct, *args&: InMemoryStruct
    ) -> InMemoryStruct:
        """This is a function summary.

        Args:
            arg: This is a by-ref argument.
            args: This is a variadic argument.

        Returns:
            This is a by-ref return value.
        """
        return arg


# CHECK: ## ParameterClass
# CHECK: This is a class summary.
# CHECK: The is some kind of description.

# CHECK: **Parameters:**
