load("//bazel:api.bzl", "lit_tests")

package(default_visibility = ["//visibility:private"])

lit_tests(
    name = "test",
    size = "large",
    srcs = glob([
        "*.lldb",
        "*.mojo",
    ]) + glob(
        ["internal/*.lldb"],
        # `internal/` is excluded via .bazelignore in the open source build.
        allow_empty = True,
    ),
    custom_substitutions = {
        # Mirrored from lit.cfg.py to avoid searching $PATH for 'mojo'
        "%debug": "$(rlocationpath //KGEN/tools/mojo) debug -X -x -X --source-quietly -X -S -X $(rlocationpath //KGEN/unittests:lit-lldb-init.in)",
    },
    data = glob(["Inputs/*.mojo"]) + [
        "//KGEN:MojoLLDB",
        "//KGEN:gdb-server",
        "//KGEN:mojo-lldb",
        "//KGEN/unittests:lit-lldb-init.in",
    ],
    mojo_deps = [
        "@mojo//:std",
    ],
    tools = [
        "//KGEN/tools/mojo",
    ],
)
