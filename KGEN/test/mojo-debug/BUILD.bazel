load("//bazel:api.bzl", "lit_tests")

lit_tests(
    name = "test",
    size = "large",
    srcs = glob([
        "*.lldb",
        "*.mojo",
    ]),
    custom_substitutions = {
        # Mirrored from lit.cfg.py to avoid searching $PATH for 'mojo'
        "%debug": "$(rlocationpath //KGEN/tools/mojo) debug -X -x -X --source-quietly -X -S -X ../../../utils/lit-lldb-init.in",
    },
    data = glob(["Inputs/*.mojo"]) + [
        "//utils:lit-lldb-init.in",
    ],
    mojo_deps = [
        "@mojo//:stdlib",
    ],
    tools = [
        "//KGEN/tools/mojo",
    ],
)
