# RUN: mojo build --debug-level full -O0 '%S/Inputs/builtin-types.mojo' -o %t

# RUN: %debug -Xlldb -o -Xlldb 'b builtin-types.mojo:112' -Xlldb -o -Xlldb 'r' -Xlldb -o -Xlldb 'frame var' %t | FileCheck %s

# CHECK: (AStruct) a_struct = {
# CHECK:   int = {
# CHECK:     [0] = 12
# CHECK:   }
# CHECK:   tuple = {
# CHECK:     [0] = 1
# CHECK:     [1] = {
# CHECK:       [0] = 87
# CHECK:     }
# CHECK:     [2] = {
# CHECK:       [0] = 123.125
# CHECK:     }
# CHECK:   }
# CHECK: }
# CHECK: (ParamStruct[_"stdlib::builtin::int::Int"]) p_struct_int = {
# CHECK:   t = 8
# CHECK: }
# CHECK: (scalar<f32>) another_float = {
# CHECK:   [0] = 4.125
# CHECK: }
# CHECK: (string) a_string_literal = "fofofo"
# CHECK: (!kgen.pack<[index, scalar<f64>, index]>) a_list = {
# CHECK:   [0] = 1
# CHECK:   [1] = {
# CHECK:     [0] = 2.125
# CHECK:   }
# CHECK:   [2] = 3
# CHECK: }
# CHECK: (simd<4, f16>) a_simd = {
# CHECK:   [0] = 1.125
# CHECK:   [1] = 2.5
# CHECK:   [2] = 0
# CHECK:   [3] = -3.7246
# CHECK: }
# CHECK: (simd<32, si64>) b_simd = {
# CHECK:   [0] = 1
# CHECK:   [1] = 2
# CHECK:   [2] = 3
# CHECK:   [7] = 8
# CHECK:   [8] = 9
# CHECK:   [9] = 10
# CHECK:   [10] = 11
# CHECK:   [15] = 16
# CHECK:   [16] = -1
# CHECK:   [17] = -2
# CHECK:   [18] = -3
# CHECK:   [19] = -4
# CHECK:   [26] = -11
# CHECK:   [27] = -12
# CHECK:   [28] = -13
# CHECK:   [29] = -14
# CHECK:   [30] = -15
# CHECK:   [31] = -16
# CHECK: }
# CHECK: (simd<2, index>) c_simd = {
# CHECK:   [0] = 5
# CHECK:   [1] = 6
# CHECK: }
# CHECK: (Variant[scalar<f64>, scalar<bool>, simd<2, index>]) a_float_or_bool_or_simd = {
# CHECK:   variant[2] = {
# CHECK:     [0] = 5
# CHECK:     [1] = 6
# CHECK:   }
# CHECK: }
# CHECK: (None) none = None
# CHECK: (si64) a_var_index = 48
# CHECK: (si64) a_let_index = 48
# CHECK: (si64) an_int = 123
# CHECK: (scalar<f64>) a_literal_float = {
# CHECK:   [0] = 3.125
# CHECK: }
# CHECK: (scalar<f32>) a_float = {
# CHECK:   [0] = 3.125
# CHECK: }
# CHECK: (si64) ^ uncommon name = 1123123
