load("//bazel:api.bzl", "lit_tests")

package(default_visibility = ["//visibility:private"])

_DATA = [
    "inputs/**",
]

filegroup(
    name = "fixtures",
    testonly = True,
    srcs = glob([
        "inputs/**/*.ll",
        "inputs/**/*.mojo",
    ]),
)

lit_tests(
    name = "test",
    srcs = glob(
        [
            "**/*.mlir",
            "**/*.mojo",
        ],
        exclude = _DATA,
    ),
    data = [":fixtures"],
    mojo_deps = [
        "//max:layout",
        "@mojo//:std",
    ],
    tags = ["gpu"],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/kgen",
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/kgen-translate",
        "//KGEN/tools/llvm-module-split",
        "//KGEN/tools/mojo",
        "@llvm-project//llvm:llvm-as",
        "@llvm-project//llvm:llvm-dis",
        "@llvm-project//llvm:llvm-nm",
        "@llvm-project//llvm:llvm-objdump",
    ],
)

lit_tests(
    name = "test_std_srcs",
    # This tests require the std, where other tests do
    # not require them
    srcs = glob(["*.test"]),
    data = [":fixtures"] + [
        "//oss/modular/mojo/stdlib/std:std_srcs",
    ],
    env = {
        "MODULAR_MOJO_IMPORT_SRCS": "$(locations //oss/modular/mojo/stdlib/std:std_srcs)",
    },
    mojo_deps = [
        "@mojo//:std",
    ],
    tools = [
        "//KGEN/tools/hash-mlir",
        "//KGEN/tools/kgen",
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/kgen-translate",
    ],
)
