load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("//bazel:api.bzl", "lit_tests")

_DATA = [
    "inputs/**",
]

lit_tests(
    name = "test",
    srcs = glob(
        [
            "*.mlir",
            "**/*.mojo",
        ],
        exclude = _DATA,
    ),
    data = glob(["inputs/**/*.mojo"]),
    gpu_constraints = ["//:has_gpu"],
    mojo_deps = [
        "//Kernels/mojo/gpu",
        "//Kernels/mojo/_mlir",
        "//Kernels/mojo/runtime",
        "//open-source/max/mojo/stdlib/stdlib",
    ],
    tags = [
        "A100",
        "gpu",
    ],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/kgen",
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/kgen-translate",
        "//KGEN/tools/llvm-module-split",
        "//KGEN/tools/mojo",
        "@llvm-project//llvm:llvm-objdump",
    ],
)

lit_tests(
    name = "test_stdlib_srcs",
    # This tests require the stdlib and mlirc srcs, where other tests do
    # not require them
    srcs = glob(["*.test"]),
    data = glob(["inputs/**/*.mojo"]) + [
        "//Kernels/mojo/_mlir:_mlir_srcs",
        "//open-source/max/mojo/stdlib/stdlib:stdlib_srcs",
    ],
    env = {
        "MODULAR_MOJO_IMPORT_SRCS": "$(locations //Kernels/mojo/_mlir:_mlir_srcs) $(locations //open-source/max/mojo/stdlib/stdlib:stdlib_srcs)",
    },
    mojo_deps = [
        "//open-source/max/mojo/stdlib/stdlib",
    ],
    tools = [
        "//KGEN/tools/hash-mlir",
        "//KGEN/tools/kgen",
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/kgen-translate",
    ],
)

pkg_files(
    name = "test_python",
    srcs = [
        "mojo_build_python.mojo",
    ],
    visibility = ["//visibility:public"],
)
