load("//bazel:api.bzl", "lit_tests")

lit_tests(
    name = "test",
    srcs = glob(
        [
            "*.mojo",
            "*.mlir",
        ],
        exclude = ["multiresult_asm_mma.mojo"],
    ),
    data = glob(["inputs/**/*.mojo"]) + [
        "//:libpython",
        "//KGEN:CompilerRT",
        "//KGEN:CompilerRT.distributable",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    env = {
        "MODULAR_MOJO_COMPILERRT_PATH": "$(location //KGEN:CompilerRT)",
        "MODULAR_MOJO_COMPILERRT_STATIC_PATH": "$(location //KGEN:CompilerRT.distributable)",
        "MODULAR_MOJO_ORCRT_PATH": "$(location @llvm-project//compiler-rt:orc_rt)",
        "MODULAR_MOJO_PYTHON_LIB": "$(location //:libpython)",
        "MOJO_PYTHON_LIBRARY": "$(location //:libpython)",
    },
    mojo_deps = [
        "//Kernels/mojo/gpu",
        "//Kernels/mojo/runtime",
        "//open-source/mojo/stdlib/stdlib:stdlib",
    ],
    tools = [
        "//KGEN/tools/kgen",
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/kgen-translate",
        "//KGEN/tools/llvm-module-split",
        "//KGEN/tools/mojo",
    ],
)

lit_tests(
    name = "test_stdlib_srcs",
    # This test requres the stdlib srcs, where another test requires not having the srcs
    srcs = ["multiresult_asm_mma.mojo"],
    data = glob(["inputs/**/*.mojo"]) + [
        "//KGEN:CompilerRT",
        "//open-source/mojo/stdlib/stdlib:stdlib_srcs",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    env = {
        "MODULAR_MOJO_COMPILERRT_PATH": "$(location //KGEN:CompilerRT)",
        "MODULAR_MOJO_IMPORT_SRCS": "$(locations //open-source/mojo/stdlib/stdlib:stdlib_srcs)",
        "MODULAR_MOJO_ORCRT_PATH": "$(location @llvm-project//compiler-rt:orc_rt)",
    },
    mojo_deps = [
        "//open-source/mojo/stdlib/stdlib:stdlib",
    ],
    tools = [
        "//KGEN/tools/kgen",
    ],
)
