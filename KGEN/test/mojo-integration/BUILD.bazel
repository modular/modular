load("//utils/bazel/build/rules:lit.bzl", "lit_tests")

lit_tests(
    name = "test",
    srcs = glob(
        [
            "*.mojo",
            "*.mlir",
        ],
        exclude = ["multiresult_asm_mma.mojo"],
    ),
    data = glob(["inputs/**/*.mojo"]) + [
        "//KGEN:CompilerRT.distributable",
        "//KGEN:CompilerRT.shared.file",
        "@llvm-project//compiler-rt:orc_rt",
        "@stock-torch//:libpython",
    ],
    env = {
        "MODULAR_MOJO_COMPILERRT_PATH": "$(location //KGEN:CompilerRT.shared.file)",
        "MODULAR_MOJO_COMPILERRT_STATIC_PATH": "$(location //KGEN:CompilerRT.distributable)",
        "MODULAR_MOJO_ORCRT_PATH": "$(location @llvm-project//compiler-rt:orc_rt)",
        "MODULAR_MOJO_PYTHON_LIB": "$(location @stock-torch//:libpython)",
        "MOJO_PYTHON_LIBRARY": "$(location @stock-torch//:libpython)",
    },
    mojo_deps = [
        "//Kernels/mojo/gpu",
        "//Kernels/mojo/runtime",
        "//Kernels/mojo/stdlib",
    ],
    tools = [
        "//KGEN/tools/kgen:kgen.opt",
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/kgen-translate",
        "//KGEN/tools/llvm-module-split",
        "//KGEN/tools/mojo:mojo.opt",
    ],
)

lit_tests(
    name = "test_stdlib_srcs",
    # This test requres the stdlib srcs, where another test requires not having the srcs
    srcs = ["multiresult_asm_mma.mojo"],
    data = glob(["inputs/**/*.mojo"]) + [
        "//KGEN:CompilerRT.shared.file",
        "//Kernels/mojo/stdlib:stdlib_srcs",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    env = {
        "MODULAR_MOJO_COMPILERRT_PATH": "$(location //KGEN:CompilerRT.shared.file)",
        "MODULAR_MOJO_IMPORT_SRCS": "$(locations //Kernels/mojo/stdlib:stdlib_srcs)",
        "MODULAR_MOJO_ORCRT_PATH": "$(location @llvm-project//compiler-rt:orc_rt)",
    },
    mojo_deps = [
        "//Kernels/mojo/stdlib",
    ],
    tools = [
        "//KGEN/tools/kgen:kgen.opt",
    ],
)
