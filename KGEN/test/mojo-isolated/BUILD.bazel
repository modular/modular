load("//bazel:api.bzl", "lit_tests")

_DATA = [
    "**/inputs/**/*.mojo",
    "**/debuginfo_module.mojo",
    "**/docs_package/**/*.mojo",
    "**/imported_cached_module.mojo",
    "**/imported_module.mojo",
    "**/test_bad_package/**",
    "**/test_package.foo",
    "**/test_package/**",
    "**/test_package_user/**/*.mojo",
]

lit_tests(
    name = "mojo-isolated",
    srcs = glob(
        [
            "**/*.mojo",
            "**/*.test",
        ],
        exclude = _DATA,
    ),
    data = [
        "//KGEN/test/test-packages",
        "//KGEN/test/test-packages:stdlib/__init__.mojo",
        "//KGEN/test/test-packages:stdlib/prelude/__init__.mojo",
    ] + glob(_DATA),
    env = {
        "MODULAR_MOJO_IMPORT_SRCS": "$(locations //KGEN/test/test-packages:stdlib/__init__.mojo) $(locations //KGEN/test/test-packages:stdlib/prelude/__init__.mojo)",
    },
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/kgen-translate",
    ],
)
