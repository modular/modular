load("//bazel:api.bzl", "lit_tests")

package(default_visibility = ["//visibility:private"])

lit_tests(
    name = "mojo-jupyter",
    srcs = glob(["**/*.test"]),
    custom_substitutions = {
        "%mojo_jupyter_executor": "$(rlocationpath //KGEN/tools/mojo-jupyter-executor) --lldb-init-file ../../../utils/lit-lldb-init.in",
    },
    data = glob([
        "*.ipynb",
        "*.mojo",
    ]) + [
        "//open-source/max/mojo/stdlib/std:std_srcs",
        "//utils:lit-lldb-init.in",
    ],
    env = {
        "MODULAR_MOJO_IMPORT_SRCS": "$(locations //open-source/max/mojo/stdlib/std:std_srcs)",
    },
    force_strip = True,  # TODO(MOTO-1190): Debug and fix this duplicate symbol issue
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//:ubsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/mojo-jupyter-executor",
    ],
)
