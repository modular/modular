load("//bazel:api.bzl", "lit_tests")

lit_tests(
    name = "mojo-jupyter",
    srcs = glob(["**/*.test"]),
    custom_substitutions = {
        "%mojo_jupyter_executor": "$(rlocationpath //KGEN/tools/mojo-jupyter-executor) --lldb-init-file ../../../utils/lit-lldb-init.in",
    },
    data = glob([
        "*.ipynb",
        "*.mojo",
    ]) + [
        "//open-source/max/mojo/stdlib/stdlib:stdlib_srcs",
        "//utils:lit-lldb-init.in",
    ],
    env = {
        "MODULAR_MOJO_IMPORT_SRCS": "$(locations //open-source/max/mojo/stdlib/stdlib:stdlib_srcs)",
    },
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//:ubsan": ["@platforms//:incompatible"],
        "//:b200_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }) + select({
        # TODO(MOTO-1190): Debug and fix this duplicate symbol issue
        "//:strip_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tools = [
        "//KGEN/tools/mojo-jupyter-executor",
    ],
)
