# RUN: mojo build --debug-level full -O0 --debug-info-language Mojo --no-alnum-symbols '%S/Inputs/builtin-types.mojo' -o %t

# RUN: %lldb %t -o 'b builtin-types.mojo:73' -o 'r' -o 'frame var' -o 'v *a_var_index' -o 'v *a_struct' | FileCheck %s

# CHECK: (pointer<si64>) a_var_index = 0x
# CHECK: (ARegisterPassableStruct) a_register_passable_struct = {
# CHECK:   int = -101
# CHECK:   f32 = 24.125
# CHECK:   another_int = 101
# CHECK:   float16 = 25.125
# CHECK:   uint8 = 123
# CHECK:   uint16 = 123
# CHECK:   int32 = 485
# CHECK: }
# CHECK: (pointer<!kgen.declref<_"$anonymous_{{[0-9]+}}"::_struct>>) a_struct = 0x
# CHECK: (f32) another_float = 4.125
# CHECK: (string) a_string_literal = "fofofo"
# CHECK: (pack) a_list = {
# CHECK:     m0 = 1
# CHECK:     m1 = 2.125
# CHECK:     m2 = 3
# CHECK: }
# CHECK: (si64) a_let_index = 48
# CHECK: (si64) an_int = 123
# CHECK: (f64) a_literal_float = 3.125
# CHECK: (f32) a_float = 3.125
# CHECK: (si64) ^ uncommon name = 1123123

# CHECK: (si64) *a_var_index = 48

# CHECK: (struct) *a_struct = {
# CHECK:   m0 = 12
# CHECK:   m1 = {
# CHECK:     m0 = 1
# CHECK:     m1 = 87
# CHECK:     m2 = 123.125
# CHECK:   }
# CHECK: }
