# RUN: %lldb -R go -r <%s 2>&1 | FileCheck %s

# Note: in REPL mode, expressions are delimited by empty lines.

# some comment
def foo():
  print("foo")
  # another comment
# a tricky comment
  print("bar")
  # another comment
# some other comment
print("foo defined")

foo()
# CHECK: foo defined
# CHECK-NEXT: foo
# CHECK-NEXT: bar

:platform shell sleep 3
