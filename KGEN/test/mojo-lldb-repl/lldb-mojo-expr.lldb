# RUN: %lldb <%s 2>&1 | FileCheck %s

# Note: in REPL mode, expressions are delimited by empty lines.

# Check that we can properly define variables with large alignments.
let bigValue = SIMD[DType.float32, 64]()

# CHECK: (SIMD[f32, 64]) bigValue = {
# CHECK:   (simd<64, f32>) value = {
# CHECK:     (f32) [0] = 0
# CHECK:     (f32) [1] = 0
# CHECK:     (f32) [62] = 0
# CHECK:     (f32) [63] = 0
# CHECK:   }
# CHECK: }

# Check that we can define variables with weird names.
let `^ weird name` = 12

# CHECK: (Int) ^ weird name = {
# CHECK:   (index) value = 12
# CHECK: }
