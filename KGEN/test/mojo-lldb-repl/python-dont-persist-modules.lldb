# UNSUPPORTED: asan
# RUN: %lldb -R MOJO -r <%s 2>&1 | FileCheck %s

# Note: in REPL mode, expressions are delimited by empty lines.

%%python
def foo():
  return "this is sparta"
# CHECK: ($PythonObject::PythonObject) foo =

%%python
x = foo()
# CHECK-NEXT: ($PythonObject::PythonObject) x =

%%python
print(x)
# CHECK-NOT: lldb_python_module

:platform shell sleep 3
