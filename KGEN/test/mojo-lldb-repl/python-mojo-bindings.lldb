# REQUIRES: python-lldb-integration
#
# Note: See https://github.com/modularml/modular/issues/16274
# for why `ALLOW_RETRIES` is set.  This is a known flaky test.
# ALLOW_RETRIES: 5
# RUN: %repl <%s 2>&1 | FileCheck %s

# Note: in REPL mode, expressions are delimited by empty lines.

%%python
def foo():
  a = 12
b = '123'
import os, sys
import platform
import json as myjson, io as _io
class bar:
  def func():
    z = None

# CHECK-NOT: ($PythonObject::PythonObject) a =
# CHECK: ($PythonObject::PythonObject) b =
# CHECK-NEXT: ($PythonObject::PythonObject) foo =
# CHECK-NEXT: ($PythonObject::PythonObject) myjson =
# CHECK-NEXT: ($PythonObject::PythonObject) os =
# CHECK-NEXT: ($PythonObject::PythonObject) platform =
# CHECK-NEXT: ($PythonObject::PythonObject) sys =
# CHECK-NOT: ($PythonObject::PythonObject) z =

# Expressions that don't declare symbols shouldn't fail and shouldn't produce
# output variables.

%%python
print(420)

# CHECK: 420
# CHECK-NOT: ($PythonObject::PythonObject)
