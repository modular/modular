# UNSUPPORTED: system-darwin
# RUN: %repl <%s 2>%t | FileCheck %s -check-prefix=CHECK
# RUN: cat %t | FileCheck %s -check-prefix=CHECK-STDERR

# Note: in REPL mode, expressions are delimited by empty lines.

# Test a simple parser error.
let var = 10
# CHECK-STDERR: expected name for 'let' declaration

# Check that we can fix this in a following expression.
let value = 25
print(value)
# CHECK: 25

# Test an error diagnosed in the MLIR pass pipeline, not during the parser.
fn foo() -> Int:
    pass
# CHECK-STDERR: return expected at end of function with results

# Test an error diagnosed in the MLIR pass pipeline, not during the parser.
fn foo() -> Int:
    return 0
# CHECK-STDERR-NOT: return expected at end of function with results
