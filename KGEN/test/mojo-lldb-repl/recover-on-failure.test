# UNSUPPORTED: asan
# RUN: %lldb -R go -r <%s 2>&1 | FileCheck %s

# Note: in REPL mode, expressions are delimited by empty lines.

# Test a simple parser error.
let var = 10
# CHECK: expected name for 'let' declaration

# Check that we can fix this in a followon expression.
let value = 25
print(value)
# CHECK: 25

# Test an error diagnosed in the MLIR pass pipeline, not during the parser.
fn foo() -> Int:
    pass
# CHECK: return expected at end of function with results

# Test an error diagnosed in the MLIR pass pipeline, not during the parser.
fn foo() -> Int:
    return 0
# CHECK-NOT: return expected at end of function with results
