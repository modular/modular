# RUN: %repl <%s 2>&1 | FileCheck %s

# Note: in REPL mode, expressions are delimited by empty lines.

# CHECK: (Int) x = {
# CHECK:   (index) value = 12
# CHECK: }
let x = 12

# CHECK: (FloatLiteral) x = {
# CHECK:   (scalar<f64>) value = {
# CHECK:     (f64) [0] = 4.2{{.*}}
# CHECK:   }
# CHECK: }
let x = 4.2

# CHECK: (Bool) x = {
# CHECK:   (scalar<bool>) value = {
# CHECK:     (i1) [0] = 1
# CHECK:   }
# CHECK: }
let x = True

# CHECK:  (SIMD[si32, 8]) x = {
# CHECK:    (simd<8, si32>) value = {
# CHECK:      (si32) [0] = 5
# CHECK:      (si32) [1] = 6
# CHECK:      (si32) [2] = 7
# CHECK:      (si32) [3] = 8
# CHECK:      (si32) [4] = 9
# CHECK:      (si32) [5] = 10
# CHECK:      (si32) [6] = 11
# CHECK:      (si32) [7] = 12
# CHECK:    }
# CHECK:  }
let x = SIMD[DType.int32, 8](5, 6, 7, 8, 9, 10, 11, 12)

# CHECK:  (SIMD[si64, 4]) x = {
# CHECK:    (simd<4, si64>) value = {
# CHECK:      (si64) [0] = 1
# CHECK:      (si64) [1] = 2
# CHECK:      (si64) [2] = 3
# CHECK:      (si64) [3] = 4
# CHECK:    }
# CHECK:  }
let x = SIMD[DType.int64, 4](1, 2, 3, 4)

# CHECK: (Int) v = {
# CHECK:   (index) value = -101
# CHECK: }
let v = -101

# CHECK: (SIMD[si8, 2]) w = {
# CHECK:   (simd<2, si8>) value = {
# CHECK:     (si8) [0] = -50
# CHECK:     (si8) [1] = 31
# CHECK:   }
# CHECK: }
let w = SIMD[DType.int8, 2](-50, 31)

# CHECK: (DynamicVector[Int]) z = {
# CHECK:   (Pointer[Int]) data = {
# CHECK:     (pointer<!kgen.declref<_"$builtin"::_"$int"::_Int>>) address = 0x
# CHECK:   }
# CHECK:   (Int) size = {
# CHECK:     (index) value = 3
# CHECK:   }
# CHECK:   (Int) capacity = {
# CHECK:     (index) value = 4
# CHECK:   }
# CHECK: }
let z = DynamicVector[Int](2)
z.push_back(1)
z.push_back(2)
z.push_back(3)


# CHECK: (Foo) f = {
# CHECK:   (Int) v = {
# CHECK:     (index) value = -101
# CHECK:   }
# CHECK:   (SIMD[si8, 2]) w = {
# CHECK:     (simd<2, si8>) value = {
# CHECK:       (si8) [0] = -50
# CHECK:       (si8) [1] = 31
# CHECK:     }
# CHECK:   }
# CHECK:   (Int) x = {
# CHECK:     (index) value = 101
# CHECK:   }
# CHECK:   (StringLiteral) y = {
# CHECK:     (string) value = "fofofo"
# CHECK:   }
# CHECK:   (SIMD[f32, 4]) z = {
# CHECK:     (simd<4, f32>) value = {
# CHECK:       (f32) [0] = 1
# CHECK:       (f32) [1] = 2
# CHECK:       (f32) [2] = 3
# CHECK:       (f32) [3] = 4
# CHECK:     }
# CHECK:   }
# CHECK: }
@value
@register_passable("trivial")
struct Foo:
  var v: Int
  var w: SIMD[DType.int8, 2]
  var x: Int
  var y: StringLiteral
  var z: SIMD[DType.float32, 4]
  fn __init__() -> Self:
    return Self {
      v: -101,
      w: SIMD[DType.int8, 2](-50, 31),
      x: 101,
      y: "fofofo",
      z:  SIMD[DType.float32, 4](1, 2, 3, 4)
    }
let f = Foo()

# CHECK: (StringLiteral) empty = {
# CHECK:   (string) value =
# CHECK: }
# CHECK: (StringLiteral) long = {
# CHECK:   (string) value = "abcdefghijklmnopqrstuvwxyz1234567890"
# CHECK: }
# CHECK: (StringLiteral) short = {
# CHECK:   (string) value = "123"
# CHECK: }
let empty = ""
let long = "abcdefghijklmnopqrstuvwxyz1234567890"
let short = "123"
