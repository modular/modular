# RUN: %repl <%s 2>&1 | FileCheck %s

# Note: in REPL mode, expressions are delimited by empty lines.

# CHECK: (Int) x = {
# CHECK:   (index) value = 12
# CHECK: }
let x = 12

# CHECK: (FloatLiteral) x = {
# CHECK:   (scalar<f64>) value = {
# CHECK:     (f64)  = 4.2{{.*}}
# CHECK:   }
# CHECK: }
let x = 4.2

# CHECK: (Bool) x = {
# CHECK:   (scalar<bool>) value = {
# CHECK:     (i1)  = 1
# CHECK:   }
# CHECK: }
let x = True

# CHECK:  (SIMD[si32, 8]) x = {
# CHECK:    (simd<8, si32>) value = {
# CHECK:      (si32) [0] = 5
# CHECK:      (si32) [1] = 6
# CHECK:      (si32) [2] = 7
# CHECK:      (si32) [3] = 8
# CHECK:      (si32) [4] = 9
# CHECK:      (si32) [5] = 10
# CHECK:      (si32) [6] = 11
# CHECK:      (si32) [7] = 12
# CHECK:    }
# CHECK:  }
let x = SIMD[DType.int32, 8](5, 6, 7, 8, 9, 10, 11, 12)

# CHECK:  (SIMD[si64, 4]) x = {
# CHECK:    (simd<4, si64>) value = {
# CHECK:      (si64) [0] = 1
# CHECK:      (si64) [1] = 2
# CHECK:      (si64) [2] = 3
# CHECK:      (si64) [3] = 4
# CHECK:    }
# CHECK:  }
let x = SIMD[DType.int64, 4](1, 2, 3, 4)
