# RUN: %repl <%s 2>&1 | FileCheck %s

# Note: in REPL mode, expressions are delimited by empty lines.

# Check that we can properly define variables with large alignments.
from DType import DType
from SIMD import SIMD
let bigValue = SIMD[DType.f32, 64]()
print(bigValue)
# CHECK: ($SIMD::SIMD[{f32}, {64}]) bigValue

# Check that we can define variables with weird names.
# CHECK: ($Int::Int) ^ weird name =
let `^ weird name` = 12

# CHECK: 12
print(`^ weird name`)

:platform shell sleep 3
