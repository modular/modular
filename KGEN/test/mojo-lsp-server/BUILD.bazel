load("//bazel:api.bzl", "lit_tests", "modular_py_binary")
load(":lsp_test_helpers.bzl", "parse_entry")

package(default_visibility = ["//visibility:private"])

modular_py_binary(
    name = "parse-mojo-files-with-lsp",
    srcs = ["parse-mojo-files-with-lsp.py"],
)

lit_tests(
    name = "mojo-lsp-server-misc",
    srcs = glob(
        [
            "**/*.test",
            "**/*.mojo",
        ],
        exclude = ["parse-stdlib/**"],
    ),
    mojo_deps = [
        "@mojo//:std",
    ],
    # Excluded from ASAN: instrumentation overhead causes timeouts.
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/mojo-lsp-server",
        "//KGEN/tools/mojo-lsp-simple-client",
    ],
)

# Umbrella target: bt //KGEN/test/mojo-lsp-server runs everything.
test_suite(
    name = "mojo-lsp-server",
    tests = [
        ":mojo-lsp-server-misc",
        # parse-stdlib and parse-extra temporarily disabled — re-enable by
        # restoring ":mojo-lsp-server-parse-stdlib" here and removing tags=["manual"] below.
    ],
)

# Stdlib subdirs where mojo-lsp-server crashes (MOCO-3398).
# No test target is generated for these until the crashes are fixed.
# To re-enable: move the subdir from _DISABLED_SUBDIRS to _ENABLED_SUBDIRS.
_DISABLED_SUBDIRS = [
    "benchmark",
    "compile",
    "ffi",
    "gpu",
    "iter",
    "reflection",
]

# Non-stdlib directories where mojo-lsp-server still crashes —
# no test target is generated for these until the crashes are fixed:
#   max/kernels/src/layout  (SMFixIt assertion in SourceMgr.cpp, unrelated to MOCO-3399)
#
# To enable one of the above once crashes are fixed:
#   1. Add a filegroup to the directory's BUILD.bazel that exports the .mojo sources:
#        filegroup(
#            name = "srcs",
#            srcs = glob(["**/*.mojo"]),
#            visibility = ["//KGEN/test/mojo-lsp-server:__pkg__"],
#        )
#   2. Move the entry from the comment above into _EXTRA_ENABLED_DIRS below.

# Non-stdlib directories that parse cleanly. Format: name → (source-path, data-label).
# - source-path: repo-relative path, used as $TEST_SRCDIR/_main/{source-path} at test time
# - data-label: filegroup target that exports the directory's .mojo sources as runfiles
_EXTRA_ENABLED_DIRS = {}

# Stdlib subdirs that parse cleanly through the LSP server.
#
# Each entry is either:
#   "subdir"                        — all files in that subdir (no filter)
#   ("subdir", "suffix", "regex")   — only files whose stem matches regex;
#                                     suffix disambiguates the Bazel target name
#
# Use tuples to split large subdirs into smaller pieces for CI.
# The regex is anchored at the start (re.match) against the file stem.
_ENABLED_SUBDIRS = [
    # algorithm has ~18 files (including subdirs); split into 6 pieces.
    ("algorithm", "algorithm-init", "^_"),  # 4 files
    ("algorithm", "algorithm-e-f", "^[e-fE-F]"),  # 3 files
    ("algorithm", "algorithm-m", "^[mM]"),  # 2 files
    ("algorithm", "algorithm-p-r", "^[p-rP-R]"),  # 4 files
    ("algorithm", "algorithm-s-t", "^[s-tS-T]"),  # 3 files
    ("algorithm", "algorithm-u-z", "^[u-zU-Z]"),  # 2 files
    "base64",
    "bit",
    # builtin has ~38 files; split into 8 pieces.
    ("builtin", "builtin-underscore", "^_"),  # 5 files
    ("builtin", "builtin-a-b", "^[a-bA-B]"),  # 4 files
    ("builtin", "builtin-c-d", "^[c-dC-D]"),  # 6 files
    ("builtin", "builtin-e-f", "^[e-fE-F]"),  # 4 files
    ("builtin", "builtin-g-l", "^[g-lG-L]"),  # 5 files
    ("builtin", "builtin-n-r", "^[n-rN-R]"),  # 5 files
    ("builtin", "builtin-s", "^[sS]"),  # 5 files
    ("builtin", "builtin-t-z", "^[t-zT-Z]"),  # 4 files
    # collections has ~25 files; same CI ratio, split into 3 pieces.
    ("collections", "collections-a-d", "^[_a-dA-D]"),  # ~14 files
    ("collections", "collections-e-l", "^[e-lE-L]"),  # ~5 files
    ("collections", "collections-m-z", "^[m-zM-Z]"),  # ~7 files
    "complex",
    "documentation",
    "format",
    "hashlib",
    "io",
    "itertools",
    "logger",
    "math",
    "memory",
    "os",
    "pathlib",
    "prelude",
    "pwd",
    "python",
    "random",
    "runtime",
    "stat",
    "subprocess",
    "sys",
    "tempfile",
    "testing",
    "time",
    "utils",
]

_PARSE_STDLIB_TOOLS = [
    ":parse-mojo-files-with-lsp",
    "//KGEN/tools/mojo-lsp-server",
    "//KGEN/tools/mojo-lsp-simple-client",
]

# LSP parse tests are excluded from ASAN because the instrumentation overhead
# makes them too slow and they time out reliably under that configuration.
_ASAN_INCOMPATIBLE = select({
    "//:asan": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# One test target per enabled stdlib subdir (or subdir slice), all driven from
# a shared template. {DIR} and {FILE_REGEX} are substituted at test time.
# To re-enable a crashing subdir: move it to _ENABLED_SUBDIRS above.
[
    lit_tests(
        name = "parse-stdlib-{}".format(e["suffix"]),
        size = "medium",
        srcs = ["parse-stdlib/parse-dir.test.template"],
        custom_substitutions = {
            "{DIR}": "$MODULAR_MOJO_MAX_IMPORT_PATH/{}".format(e["subdir"]),
            "{FILE_REGEX}": "--file-regex {}".format(e["regex"]) if e["regex"] else "",
        },
        data = ["//oss/modular/mojo/stdlib/std:std_srcs"],
        mojo_deps = ["@mojo//:std"],
        tags = ["manual"],
        target_compatible_with = _ASAN_INCOMPATIBLE,
        tools = _PARSE_STDLIB_TOOLS,
        unique_suffix = e["suffix"],
    )
    for e in [parse_entry(s) for s in _ENABLED_SUBDIRS]
]

# One test target per enabled extra (non-stdlib) dir, same template.
# {DIR} is substituted to $TEST_SRCDIR/_main/{source-path} at test time.
# To enable a dir: add an entry to _EXTRA_ENABLED_DIRS above.
[
    lit_tests(
        name = "parse-{}".format(name),
        size = "medium",
        srcs = ["parse-stdlib/parse-dir.test.template"],
        custom_substitutions = {
            "{DIR}": "$TEST_SRCDIR/_main/{}".format(path),
            "{FILE_REGEX}": "",
        },
        data = [label],
        mojo_deps = ["@mojo//:std"],
        tags = ["manual"],
        target_compatible_with = _ASAN_INCOMPATIBLE,
        tools = _PARSE_STDLIB_TOOLS,
        unique_suffix = name,
    )
    for name, (path, label) in _EXTRA_ENABLED_DIRS.items()
]

# The stdlib root __init__.mojo is tested separately with --no-recursive.
lit_tests(
    name = "parse-stdlib-root",
    size = "medium",
    srcs = ["parse-stdlib/parse-stdlib-root.test"],
    data = ["//oss/modular/mojo/stdlib/std:std_srcs"],
    mojo_deps = ["@mojo//:std"],
    tags = ["manual"],
    target_compatible_with = _ASAN_INCOMPATIBLE,
    tools = _PARSE_STDLIB_TOOLS,
)

# Coverage check: fails if a new stdlib subfolder is not listed above.
# The {ALL_SUBDIRS} placeholder is substituted by lit via custom_substitutions.
lit_tests(
    name = "check-stdlib-coverage",
    size = "medium",
    srcs = ["parse-stdlib/check-stdlib-coverage.test"],
    custom_substitutions = {
        # Build a deduped, sorted list of all subdir names (enabled + disabled).
        # Duplicates arise when one subdir has multiple tuple entries (e.g. builtin).
        # Using a dict deduplicates without Python's set() which is not in Starlark.
        "{ALL_SUBDIRS}": ",".join(sorted({
            s: None
            for s in [parse_entry(e)["subdir"] for e in _ENABLED_SUBDIRS] + _DISABLED_SUBDIRS
        }.keys())),
    },
    data = ["//oss/modular/mojo/stdlib/std:std_srcs"],
    mojo_deps = ["@mojo//:std"],
    tags = ["manual"],
    target_compatible_with = _ASAN_INCOMPATIBLE,
    tools = [":parse-mojo-files-with-lsp"],
)

# Run all per-subfolder targets together.  Individual failures are reported as
# actionable Bazel targets, e.g. //KGEN/test/mojo-lsp-server:parse-stdlib-stat.
# Temporarily excluded from the mojo-lsp-server umbrella suite via tags=["manual"].
test_suite(
    name = "mojo-lsp-server-parse-stdlib",
    tags = ["manual"],
    tests = ["parse-stdlib-{}".format(parse_entry(s)["suffix"]) for s in _ENABLED_SUBDIRS] +
            ["parse-{}".format(name) for name in _EXTRA_ENABLED_DIRS] + [
        ":check-stdlib-coverage",
        ":parse-stdlib-root",
    ],
)

# Profile tool: prints a table of LSP parse time per stdlib subdir.
# Usage: bazel run //KGEN/test/mojo-lsp-server:profile-parse-stdlib
modular_py_binary(
    name = "profile-parse-stdlib",
    srcs = ["profile-parse-stdlib.py"],
    args = [
        "--subdirs",
        ",".join(sorted({
            s: None
            for s in [parse_entry(e)["subdir"] for e in _ENABLED_SUBDIRS]
        }.keys())),
    ],
    data = [
        ":parse-mojo-files-with-lsp",
        "//KGEN/tools/mojo-lsp-server",
        "//KGEN/tools/mojo-lsp-simple-client",
    ],
    mojo_deps = ["@mojo//:std"],
)
