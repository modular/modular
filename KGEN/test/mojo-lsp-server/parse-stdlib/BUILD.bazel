# LSP parse tests for the Mojo stdlib.
#
# --- Running tests ---
#
# Run all stdlib parse tests:
#   bt //KGEN/test/mojo-lsp-server/parse-stdlib:mojo-lsp-server-parse-stdlib
#
# Run a single file directly (fastest):
#   bb //KGEN/tools/mojo-lsp-simple-client //KGEN/tools/mojo-lsp-server
#   export MODULAR_MOJO_MAX_IMPORT_PATH=$PWD/bazel-bin/oss/modular/mojo/stdlib/std
#   ./bazel-bin/KGEN/tools/mojo-lsp-simple-client/mojo-lsp-simple-client \
#       --fail-on-diagnostics oss/modular/mojo/stdlib/std/sys/info.mojo

load("//bazel:api.bzl", "modular_py_test")

package(default_visibility = ["//visibility:private"])

# LSP parse tests are excluded from sanitizer builds (ASAN, UBSAN) because the
# instrumentation overhead makes them too slow and they time out reliably.
_SANITIZER_INCOMPATIBLE = select({
    "//:asan": ["@platforms//:incompatible"],
    "//:ubsan": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Files with true LSP/compiler bugs that prevent the file from being processed
# at all. These are skipped entirely. Paths are relative to the stdlib root
# (oss/modular/mojo/stdlib/std). To re-enable: remove from this list.
#
# This list exists as an emergency escape hatch: if the LSP server crashes or
# hangs on a specific file and blocks the build, add that file here to restore
# CI quickly while the underlying bug is investigated. It should normally be
# empty — do not add files that merely produce diagnostics.
_NO_RUN_LIST = [
]

# Files with known docstring example errors. These run against the LSP server
# with --no-docstring-checks: file structure is validated but docstring code
# blocks are not parsed or type-checked. To fully enable: remove from this list.
#
# The long-term goal is to drive this list to empty by fixing the docstrings.
_NO_DOCSTRING_LIST = [
    "algorithm/backend/vectorize.mojo",  # docstring fix needed: stale UnsafePointer.alloc() API
    "benchmark/__init__.mojo",  # docstring fix needed: 'benchmark'/'report' not in scope in later blocks
    "benchmark/_progress.mojo",  # docstring fix needed: missing import of 'Progress'
    "benchmark/benchmark.mojo",  # docstring fix needed: 'benchmark' not in scope in later blocks
    "bit/_mask.mojo",  # docstring fix needed: wrong import path 'std.bit.mask' → 'std.bit._mask'
    "builtin/anytype.mojo",  # docstring fix needed: missing 'Path' import; stale UnsafePointer.alloc API
    "builtin/debug_assert.mojo",  # docstring fix needed: split examples; vars defined in block 1, used in block 2
    "builtin/floatable.mojo",  # docstring fix needed: struct missing @fieldwise_init
    "builtin/int.mojo",  # docstring fix needed: struct missing @fieldwise_init
    "builtin/len.mojo",  # docstring fix needed: struct missing @fieldwise_init
    "builtin/variadics.mojo",  # docstring fix needed: missing '_type_is_eq' import; wrong trait constraint
    "collections/dict.mojo",  # docstring fix needed: intentional error illustrations need LSP exclusion
    "collections/list.mojo",  # docstring fix needed: intentional error illustrations need LSP exclusion
    "collections/string/format.mojo",  # docstring fix needed: undefined placeholder 'myComplicatedObject'
    "collections/string/string_slice.mojo",  # docstring fix needed: blank line after ```mojo confuses lexer; '.center()' renamed
    "ffi/unsafe_union.mojo",  # docstring fix needed: missing 'from std.ffi import UnsafeUnion'
    "format/__init__.mojo",  # docstring fix needed: missing @fieldwise_init; bare method snippets need struct context
    "format/_utils.mojo",  # docstring fix needed: wrong import paths for _hex_digits_to_hex_chars/_write_hex
    "gpu/compute/__init__.mojo",  # docstring fix needed: undeclared placeholder vars 'a', 'b', 'c'
    "gpu/compute/arch/__init__.mojo",  # docstring fix needed (doc update required): relative imports in illustration snippets
    "gpu/compute/mma.mojo",  # docstring fix needed: undeclared 'ptr' placeholder
    "gpu/host/device_context.mojo",  # docstring fix needed: stale API; wrong field name; missing imports
    "gpu/host/info.mojo",  # docstring fix needed: escaped triple-quote confuses lexer; missing imports
    "gpu/memory/memory.mojo",  # docstring fix needed: wrong 'Scope.CTA' (should be 'Scope.BLOCK'); undeclared 'addr'
    "gpu/primitives/warp.mojo",  # docstring fix needed: wrong import paths; not re-exported from std.gpu
    "gpu/profiler.mojo",  # docstring fix needed: undefined placeholder 'run_gpu_kernel'
    "gpu/sync/semaphore.mojo",  # docstring fix needed: undefined 'thread_id' placeholder
    "io/file.mojo",  # docstring fix needed: missing 'import std.os' for os.SEEK_*
    "io/file_descriptor.mojo",  # docstring fix needed: passes FileHandle where FileDescriptor expected
    "iter/__init__.mojo",  # docstring fix needed: wrong constraint ('Iterable' should be 'Iterator')
    "itertools/itertools.mojo",  # docstring fix needed: missing imports for 'product'/'cycle'/'repeat'
    "math/math.mojo",  # docstring fix needed: missing 'from std.math import sqrt'; DivModable self-reference
    "memory/_nonnull.mojo",  # docstring fix needed: missing 'UnsafePointer' import
    "pathlib/path.mojo",  # docstring fix needed: imports assert_false but calls assert_true
    "python/_cpython.mojo",  # docstring fix needed: missing imports for Python/GILAcquired/GILReleased
    "python/bindings.mojo",  # docstring fix needed: undefined placeholders; missing PythonObject/OwnedKwargsDict imports
    "python/python.mojo",  # docstring fix needed: ListLiteral does not implement ConvertibleToPython
    "reflection/struct_fields.mojo",  # docstring fix needed: missing imports + undefined example structs
    "reflection/type_info.mojo",  # docstring fix needed: missing import of get_base_type_name
    "sys/_assembly.mojo",  # docstring fix needed: undefined 'my_bf16_as_int16' placeholder
    "sys/_libc_errno.mojo",  # docstring fix needed: missing 'import std.os'
    "sys/info.mojo",  # docstring fix needed: wrong name 'platform_alias' → 'platform_map'; missing import
    "sys/intrinsics.mojo",  # docstring fix needed: missing import of 'gather'/'scatter' in docstring examples
    "tempfile/tempfile.mojo",  # docstring fix needed: typo in import; uses private _rmtree; missing os imports
    "utils/_nicheable.mojo",  # docstring fix needed: missing import of UnsafeNicheable/UnsafeSingleNicheable
]

# One sharded test target covering the entire stdlib:
#   - _NO_RUN_LIST files are skipped entirely (true LSP bugs)
#   - _NO_DOCSTRING_LIST files run without docstring validation (docstring fixes pending)
#   - all other files run with full validation
#
# shard_count=50 (the repo maximum) divides ~240 enabled files into ~5 files
# per shard (~25 s each), well within the medium timeout.
modular_py_test(
    name = "mojo-lsp-server-parse-stdlib",
    size = "medium",
    srcs = ["parse-mojo-files-with-lsp.py"],
    args = ["$(COMPUTED_IMPORT_PATH)"] + [
        arg
        for f in _NO_RUN_LIST
        for arg in [
            "--skip-file",
            f,
        ]
    ] + [
        arg
        for f in _NO_DOCSTRING_LIST
        for arg in [
            "--no-docstring-checks-file",
            f,
        ]
    ],
    data = [
        "//KGEN/tools/mojo-lsp-simple-client",
        "//oss/modular/mojo/stdlib/std:std_srcs",
    ],
    main = "parse-mojo-files-with-lsp.py",
    mojo_deps = ["@mojo//:std"],
    shard_count = 50,
    tags = [
        "manual",
        "no-pydeps",
    ],
    target_compatible_with = _SANITIZER_INCOMPATIBLE,
    visibility = ["//KGEN/test/mojo-lsp-server:__pkg__"],
)
