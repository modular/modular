# LSP parse tests for the Mojo stdlib.
#
# --- Running tests ---
#
# Run all stdlib parse tests:
#   bt //KGEN/test/mojo-lsp-server/parse-stdlib:mojo-lsp-server-parse-stdlib
#
# Run a single file directly (fastest):
#   bb //KGEN/tools/mojo-lsp-simple-client //KGEN/tools/mojo-lsp-server
#   export MODULAR_MOJO_MAX_IMPORT_PATH=$PWD/bazel-bin/oss/modular/mojo/stdlib/std
#   ./bazel-bin/KGEN/tools/mojo-lsp-simple-client/mojo-lsp-simple-client \
#       --fail-on-diagnostics oss/modular/mojo/stdlib/std/sys/info.mojo

load("//bazel:api.bzl", "modular_py_test")

package(default_visibility = ["//visibility:private"])

# LSP parse tests are excluded from sanitizer builds (ASAN, UBSAN) because the
# instrumentation overhead makes them too slow and they time out reliably.
_SANITIZER_INCOMPATIBLE = select({
    "//:asan": ["@platforms//:incompatible"],
    "//:ubsan": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Files with known LSP errors. Paths are relative to the stdlib root
# (oss/modular/mojo/stdlib/std). To re-enable a file: remove it from this list.
_FILE_BLOCKLIST = [
    "algorithm/backend/vectorize.mojo",  # LSP error (MOCO-3593): 'UnsafePointer' has no attribute 'alloc'
    "benchmark/__init__.mojo",  # LSP error (MOCO-3594): undeclared 'benchmark'/'report' in docstring example
    "benchmark/_progress.mojo",  # LSP error (MOCO-3594): undeclared 'Progress' in docstring example
    "benchmark/benchmark.mojo",  # LSP error (MOCO-3594): undeclared 'benchmark' in docstring example
    "bit/_mask.mojo",  # LSP error (MOCO-3592): unable to locate module 'mask'
    "builtin/anytype.mojo",  # LSP error (MOCO-3594): undeclared 'Path' in docstring example; 'UnsafePointer' failed to infer parameter 'origin'
    "builtin/debug_assert.mojo",  # LSP error (MOCO-3594): undeclared 'name'/'person' in docstring example
    "builtin/floatable.mojo",  # LSP error (MOCO-3593): invalid call to '__init__': no candidates found
    "builtin/int.mojo",  # LSP error (MOCO-3593): invalid call to '__init__': no candidates found
    "builtin/len.mojo",  # LSP error (MOCO-3593): invalid call to '__init__': no candidates found
    "builtin/variadics.mojo",  # LSP error (MOCO-3589): undeclared '_type_is_eq' (compiler builtin); type mismatches in predicate parameter
    "collections/dict.mojo",  # LSP error (MOCO-3594): no matching function in initialization; expression must be mutable
    "collections/list.mojo",  # LSP error (MOCO-3594): incompatible types in docstring example; expression must be mutable
    "collections/string/format.mojo",  # LSP error (MOCO-3594): undeclared 'myComplicatedObject' in docstring
    "collections/string/string.mojo",  # LSP error (MOCO-3592): failed to resolve parent package body
    "collections/string/string_slice.mojo",  # LSP error (MOCO-3590): empty/unterminated backtick identifiers; 'StaticString' has no attribute 'center'
    "ffi/unsafe_union.mojo",  # LSP error (MOCO-3594): undeclared 'UnsafeUnion' in docstring example
    "format/__init__.mojo",  # LSP error (MOCO-3592): failed to resolve parent package body; invalid call to '__init__'
    "format/_utils.mojo",  # LSP error (MOCO-3518): module 'write' missing '_hex_digits_to_hex_chars'/'_write_hex'
    "gpu/compute/__init__.mojo",  # LSP error (MOCO-3594): undeclared 'a' in docstring example
    "gpu/compute/arch/__init__.mojo",  # LSP error (MOCO-3592): cannot import relative to top-level package; undeclared 'is_nvidia_gpu'
    "gpu/compute/mma.mojo",  # LSP error (MOCO-3594): undeclared 'ptr' in docstring example
    "gpu/host/device_context.mojo",  # LSP error (MOCO-3593): 'DeviceStream' no 'create_event'; (MOCO-3594): undeclared 'stream'/'register'/'DeviceContext'
    "gpu/host/info.mojo",  # LSP error (MOCO-3591): unexpected '\' character in docstring causes lexer errors
    "gpu/memory/memory.mojo",  # LSP error (MOCO-3593): 'Scope' has no attribute 'CTA'
    "gpu/primitives/warp.mojo",  # LSP error (MOCO-3593): package 'gpu' does not contain 'shuffle_idx'/'shuffle_xor'/'lane_group_reduce'
    "gpu/profiler.mojo",  # LSP error (MOCO-3594): undeclared 'run_gpu_kernel' in docstring example
    "gpu/sync/semaphore.mojo",  # LSP error (MOCO-3593): no matching function in initialization
    "io/file.mojo",  # LSP error (MOCO-3594): undeclared 'os' in docstring example
    "io/file_descriptor.mojo",  # LSP error (MOCO-3593): 'FileHandle' cannot convert to 'FileDescriptor' in print()
    "iter/__init__.mojo",  # LSP error (MOCO-3449): 'I' has no attribute 'bounds'; undeclared 'lower'
    "itertools/itertools.mojo",  # LSP error (MOCO-3594): undeclared 'product'/'cycle'/'repeat' in docstring examples
    "math/math.mojo",  # LSP error (MOCO-3594): undeclared 'sqrt'/'DivModable' in docstring example
    "memory/_nonnull.mojo",  # LSP error (MOCO-3594): undeclared 'NonNullUnsafePointer' in docstring example
    "pathlib/path.mojo",  # LSP error (MOCO-3594): undeclared 'assert_true' in docstring example
    "python/_cpython.mojo",  # LSP error (MOCO-3594): undeclared 'Python'/'GILAcquired'/'GILReleased' in docstring
    "python/bindings.mojo",  # LSP error (MOCO-3594): undeclared 'my_func'/'MyType'/'PythonObject'/'OwnedKwargsDict' in docstring
    "python/python.mojo",  # LSP error (MOCO-3594): could not infer type of parameter pack 'args'
    "reflection/struct_fields.mojo",  # LSP error (MOCO-3594): undeclared 'struct_field_count'/'struct_field_names'/etc. in docstring
    "reflection/type_info.mojo",  # LSP error (MOCO-3594): undeclared 'get_base_type_name' in docstring
    "sys/_assembly.mojo",  # LSP error (MOCO-3485): undeclared 'my_bf16_as_int16' in docstring example
    "sys/_libc_errno.mojo",  # LSP error (MOCO-3486): undeclared 'os' in docstring example
    "sys/info.mojo",  # LSP error (MOCO-3483): compiler builtin 'platform_alias' unknown to LSP
    "sys/intrinsics.mojo",  # LSP error (MOCO-3484): compiler builtins 'gather'/'scatter' unknown to LSP
    "tempfile/tempfile.mojo",  # LSP error (MOCO-3594): undeclared 'os'; package 'tempfile' does not contain '_rmtree'
    "utils/_nicheable.mojo",  # LSP error (MOCO-3589): compiler builtins 'UnsafeNicheable'/'UnsafeSingleNicheable' unknown to LSP
]

# One sharded test target covering the entire stdlib (minus blocklisted files).
# shard_count=50 (the repo maximum) divides ~240 enabled files into ~5 files
# per shard (~25 s each), well within the medium timeout.
modular_py_test(
    name = "mojo-lsp-server-parse-stdlib",
    size = "medium",
    srcs = ["parse-mojo-files-with-lsp.py"],
    args = ["$(COMPUTED_IMPORT_PATH)"] + [
        arg
        for f in _FILE_BLOCKLIST
        for arg in [
            "--skip-file",
            f,
        ]
    ],
    data = [
        "//KGEN/tools/mojo-lsp-simple-client",
        "//oss/modular/mojo/stdlib/std:std_srcs",
    ],
    main = "parse-mojo-files-with-lsp.py",
    mojo_deps = ["@mojo//:std"],
    shard_count = 50,
    tags = [
        "manual",
        "no-pydeps",
    ],
    target_compatible_with = _SANITIZER_INCOMPATIBLE,
    visibility = ["//KGEN/test/mojo-lsp-server:__pkg__"],
)
