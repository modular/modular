# LSP parse tests for the Mojo stdlib.
#
# --- Running tests ---
#
# Run all stdlib parse tests:
#   bt //KGEN/test/mojo-lsp-server/parse-stdlib:mojo-lsp-server-parse-stdlib
#
# Run a single file directly (fastest):
#   bb //KGEN/tools/mojo-lsp-simple-client //KGEN/tools/mojo-lsp-server
#   export MODULAR_MOJO_MAX_IMPORT_PATH=$PWD/bazel-bin/oss/modular/mojo/stdlib/std
#   ./bazel-bin/KGEN/tools/mojo-lsp-simple-client/mojo-lsp-simple-client \
#       --fail-on-diagnostics oss/modular/mojo/stdlib/std/sys/info.mojo

load("//bazel:api.bzl", "modular_py_test")

package(default_visibility = ["//visibility:private"])

# LSP parse tests are excluded from sanitizer builds (ASAN, UBSAN) because the
# instrumentation overhead makes them too slow and they time out reliably.
_SANITIZER_INCOMPATIBLE = select({
    "//:asan": ["@platforms//:incompatible"],
    "//:ubsan": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Files with true LSP/compiler bugs that prevent the file from being processed
# at all. These are skipped entirely. Paths are relative to the stdlib root
# (oss/modular/mojo/stdlib/std). To re-enable: remove from this list.
#
# This list exists as an emergency escape hatch: if the LSP server crashes or
# hangs on a specific file and blocks the build, add that file here to restore
# CI quickly while the underlying bug is investigated. It should normally be
# empty — do not add files that merely produce diagnostics.
_NO_RUN_LIST = [
]

# Files with known docstring example errors. These run against the LSP server
# with --no-docstring-checks: file structure is validated but docstring code
# blocks are not parsed or type-checked. To fully enable: remove from this list.
#
# The long-term goal is to drive this list to empty by fixing the docstrings.
_NO_DOCSTRING_LIST = [
]

# One sharded test target covering the entire stdlib:
#   - _NO_RUN_LIST files are skipped entirely (true LSP bugs)
#   - _NO_DOCSTRING_LIST files run without docstring validation (docstring fixes pending)
#   - all other files run with full validation
#
# shard_count=50 (the repo maximum) divides ~240 enabled files into ~5 files
# per shard (~25 s each), well within the medium timeout.
#
# mojo_deps includes max:compiler/layout/tensor so the LSP can resolve imports
# from those packages when validating stdlib docstring examples (MOCO-3767).
# The scan root is pinned to @mojo//:std (stdlib only) via --scan-root-file so
# the test only parses stdlib source files, not the MAX packages.
modular_py_test(
    name = "mojo-lsp-server-parse-stdlib",
    size = "medium",
    srcs = ["parse-mojo-files-with-lsp.py"],
    args = [
        "--scan-root-file",
        "$(rootpath //oss/modular/mojo/stdlib/std:__init__.mojo)",
    ] + [
        arg
        for f in _NO_RUN_LIST
        for arg in [
            "--skip-file",
            f,
        ]
    ] + [
        arg
        for f in _NO_DOCSTRING_LIST
        for arg in [
            "--no-docstring-checks-file",
            f,
        ]
    ],
    data = [
        "//KGEN/tools/mojo-lsp-simple-client",
        "//oss/modular/mojo/stdlib/std:__init__.mojo",
        "//oss/modular/mojo/stdlib/std:std_srcs",
    ],
    main = "parse-mojo-files-with-lsp.py",
    mojo_deps = [
        "//max:compiler",
        "//max:layout",
        "//max:tensor",
        "@mojo//:std",
    ],
    shard_count = 50,
    tags = [
        "manual",
        "no-pydeps",
    ],
    target_compatible_with = _SANITIZER_INCOMPATIBLE,
    visibility = ["//KGEN/test/mojo-lsp-server:__pkg__"],
)
