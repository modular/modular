    "utils/_nicheable.mojo",  # LSP error: undeclared 'UnsafeNicheable'/'UnsafeSingleNicheable'
    "utils/numerics.mojo",  # MOCO-3399: LSP crash
    "memory/_nonnull.mojo",  # LSP error: use of unknown declaration 'NonNullUnsafePointer'
    "utils/variant.mojo",  # LSP error: undeclared 'random' in docstring example
]

# One sharded test target covering the entire stdlib (minus blocklisted files).
# shard_count=50 (the repo maximum) divides ~240 enabled files into ~5 files
# per shard (~25 s each), well within the medium timeout.
modular_py_test(
    name = "mojo-lsp-server-parse-stdlib",
    size = "medium",
    srcs = ["parse-mojo-files-with-lsp.py"],
    args = ["$(COMPUTED_IMPORT_PATH)"] + [
        arg
        for f in _FILE_BLOCKLIST
        for arg in [
            "--skip-file",
            f,
        ]
    ],
    data = [
        "//KGEN/tools/mojo-lsp-simple-client",
        "//oss/modular/mojo/stdlib/std:std_srcs",
    ],
    main = "parse-mojo-files-with-lsp.py",
    mojo_deps = ["@mojo//:std"],
    shard_count = 50,
    tags = [
        "manual",
        "no-pydeps",
    ],
    target_compatible_with = _SANITIZER_INCOMPATIBLE,
    visibility = ["//KGEN/test/mojo-lsp-server:__pkg__"],
)
