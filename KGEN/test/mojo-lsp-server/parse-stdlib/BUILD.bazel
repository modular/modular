# LSP parse tests for the Mojo stdlib.
#
# --- Running tests ---
#
# Run all stdlib parse tests:
#   bt //KGEN/test/mojo-lsp-server/parse-stdlib:mojo-lsp-server-parse-stdlib
#
# Run a single file directly (fastest):
#   bb //KGEN/tools/mojo-lsp-simple-client //KGEN/tools/mojo-lsp-server
#   export MODULAR_MOJO_MAX_IMPORT_PATH=$PWD/bazel-bin/oss/modular/mojo/stdlib/std
#   ./bazel-bin/KGEN/tools/mojo-lsp-simple-client/mojo-lsp-simple-client \
#       --fail-on-diagnostics oss/modular/mojo/stdlib/std/sys/info.mojo

load("//bazel:api.bzl", "modular_py_test")

package(default_visibility = ["//visibility:private"])

# LSP parse tests are excluded from sanitizer builds (ASAN, UBSAN) because the
# instrumentation overhead makes them too slow and they time out reliably.
_SANITIZER_INCOMPATIBLE = select({
    "//:asan": ["@platforms//:incompatible"],
    "//:ubsan": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Files with known LSP errors. Paths are relative to the stdlib root
# (oss/modular/mojo/stdlib/std). To re-enable a file: remove it from this list.
_FILE_BLOCKLIST = [
    "algorithm/backend/cpu/reduction.mojo",  # MOCO-3399: LSP crash
    "algorithm/backend/gpu/reduction.mojo",  # MOCO-3399: LSP crash
    "algorithm/backend/vectorize.mojo",  # LSP error: 'UnsafePointer' has no attribute 'alloc'
    "benchmark/__init__.mojo",  # MOCO-3399: LSP crash
    "benchmark/_progress.mojo",  # MOCO-3399: LSP crash
    "benchmark/bencher.mojo",  # MOCO-3399: LSP crash
    "benchmark/benchmark.mojo",  # MOCO-3399: LSP crash
    "benchmark/compiler.mojo",  # MOCO-3399: LSP crash
    "bit/_mask.mojo",  # LSP error: unable to locate module 'mask'
    "builtin/anytype.mojo",  # LSP error: undeclared 'Path' in docstring example
    "builtin/comparable.mojo",  # LSP error: 'var' statement does not allow decorators
    "builtin/debug_assert.mojo",  # LSP error: undeclared 'name' in docstring example
    "builtin/floatable.mojo",  # LSP error: invalid call to '__init__': no candidates found
    "builtin/int.mojo",  # LSP error: invalid call to '__init__': no candidates found
    "builtin/len.mojo",  # LSP error: invalid call to '__init__': no candidates found
    "builtin/simd.mojo",  # LSP error: undeclared 'value' in docstring example
    "builtin/string_literal.mojo",  # LSP error: 'String' has no attribute 'center'
    "builtin/value.mojo",  # LSP error: undeclared 'other' in docstring example
    "builtin/variadics.mojo",  # LSP error: undeclared '_type_is_eq' (compiler builtin)
    "collections/dict.mojo",  # LSP error: no matching function in initialization
    "collections/list.mojo",  # LSP error: incompatible types in docstring example
    "collections/string/format.mojo",  # LSP error: undeclared 'myComplicatedObject' in docstring
    "collections/string/string.mojo",  # MOCO-3399: LSP crash
    "collections/string/string_slice.mojo",  # LSP error: empty/unterminated backtick identifier (multiple issues; escape-sequence location fix helps but does not eliminate all failures)
    "compile/__init__.mojo",  # MOCO-3399: LSP crash
    "ffi/__init__.mojo",  # MOCO-3399: LSP crash
    "ffi/unsafe_union.mojo",  # MOCO-3399: LSP crash
    "format/__init__.mojo",  # LSP error: 'var' statement does not allow decorators
    "format/_utils.mojo",  # LSP error: module 'write' missing '_hex_digits_to_hex_chars'
    "gpu/__init__.mojo",  # MOCO-3399: LSP crash
    "gpu/compute/__init__.mojo",  # MOCO-3399: LSP crash
    "gpu/compute/arch/__init__.mojo",  # MOCO-3399: LSP crash
    "gpu/compute/mma.mojo",  # MOCO-3399: LSP crash
    "gpu/host/device_context.mojo",  # MOCO-3399: LSP crash
    "gpu/host/info.mojo",  # MOCO-3399: LSP crash
    "gpu/memory/memory.mojo",  # MOCO-3399: LSP crash
    "gpu/primitives/warp.mojo",  # MOCO-3399: LSP crash
    "gpu/profiler.mojo",  # MOCO-3399: LSP crash
    "gpu/sync/semaphore.mojo",  # MOCO-3399: LSP crash
    "hashlib/hash.mojo",  # LSP error: 'var' statement does not allow decorators
    "io/file.mojo",  # LSP error: undeclared 'os' in docstring example
    "io/file_descriptor.mojo",  # LSP error: incompatible types in print() call in docstring
    "iter/__init__.mojo",  # MOCO-3399: LSP crash
    "itertools/itertools.mojo",  # LSP error: undeclared 'product'/'cycle' in docstring examples
    "math/fast.mojo",  # MOCO-3399: LSP crash
    "math/math.mojo",  # LSP error: no matching function in initialization
    "math/polynomial.mojo",  # MOCO-3399: LSP crash
    "os/path/path.mojo",  # MOCO-3399: LSP crash
    "pathlib/path.mojo",  # LSP error: undeclared 'assert_true' in docstring example
    "python/_cpython.mojo",  # LSP error: undeclared 'Python'/'GILAcquired' in docstring
    "python/bindings.mojo",  # MOCO-3399: LSP crash
    "python/python.mojo",  # LSP error: could not infer type of parameter pack 'args'
    "random/philox.mojo",  # MOCO-3399: LSP crash
