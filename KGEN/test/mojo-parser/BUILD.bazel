load("//bazel:api.bzl", "lit_tests")

package(default_visibility = ["//visibility:private"])

lit_tests(
    name = "mojo-parser",
    srcs = glob(["**/*.mojo"]),
    data = [
        "//open-source/max/mojo/stdlib/std:std_srcs",
    ],
    env = {
        "MODULAR_MOJO_IMPORT_SRCS": "$(locations //open-source/max/mojo/stdlib/std:std_srcs)",
    },
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/kgen-translate",
    ],
)
