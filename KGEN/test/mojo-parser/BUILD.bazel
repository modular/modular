load("//bazel:api.bzl", "lit_tests")

package(default_visibility = ["//visibility:private"])

_DATA = [
    "**/inputs/**/*.mojo",
    "**/debuginfo_module.mojo",
    "**/docs_package/**/*.mojo",
    "**/imported_cached_module.mojo",
    "**/imported_module.mojo",
    "**/test_bad_package/**",
    "**/test_package.foo",
    "**/test_package/**",
    "**/test_package_user/**/*.mojo",
    "**/test_reexport_name_collision/**/*.mojo",
    "**/test_std_mock/**",
]

lit_tests(
    name = "mojo-parser",
    srcs = glob(
        [
            "**/*.mojo",
            "**/*.test",
        ],
        exclude = _DATA,
    ),
    data = ["//KGEN/test/test-packages"] + glob(_DATA),
    generate_litcfg = False,
    mojo_deps = [
        "@mojo//:std",
    ],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/kgen-translate",
        "//KGEN/tools/mojo",
    ],
)
