load("//bazel:api.bzl", "lit_tests")

lit_tests(
    name = "mojo-preelab-integration",
    srcs = glob(["*.mojo"]),
    data = [
        "//open-source/mojo/stdlib/stdlib:stdlib_srcs",
    ],
    env = {
        "MODULAR_MOJO_IMPORT_SRCS": "$(locations //open-source/mojo/stdlib/stdlib:stdlib_srcs)",
    },
    mojo_deps = [
        "//Kernels/mojo/extensibility/compiler_internal",
        "//Kernels/mojo/extensibility/tensor_utils_internal",
        "//open-source/mojo/stdlib/stdlib",
    ],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/kgen-translate",
        "//KGEN/tools/mojo",
    ],
)
