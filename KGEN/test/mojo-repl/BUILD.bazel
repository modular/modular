load("//bazel:api.bzl", "lit_tests", "requirement")

lit_tests(
    name = "test",
    srcs = glob(["**/*.lldb"]),
    custom_substitutions = {
        # Mirrored from lit.cfg.py to avoid searching $PATH for 'mojo'
        "%repl": "$(rlocationpath //KGEN/tools/mojo) repl --source-quietly -S $(rlocationpath //utils:lit-lldb-init.in)",
        "\\\\$MODULAR_DERIVED_PATH/third-party/llvm-project/build/bin/lldb": "$(rlocationpath //KGEN:mojo-lldb)",
        "source \\\\$MODULAR_DERIVED_PATH/autovenv/bin/activate": "true",
    },
    data = glob(["Inputs/*.mojo"]) + [
        "//KGEN:MojoLLDB",
        "//KGEN:gdb-server",
        "//KGEN:mojo-lldb",
        "//KGEN/tools/mojo-repl-entry-point",
        "//utils:lit-lldb-init.in",
    ],
    generate_litcfg = True,
    mojo_deps = [
        "//Kernels/mojo/buffer",
        "//Kernels/mojo/gpu",
        "//Kernels/mojo/runtime",
        "//open-source/mojo/stdlib/stdlib",
    ],
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],  # __jit_debug_descriptor exists in liblldb and libMojoLLDB
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/mojo",
    ],
    deps = [
        requirement("matplotlib"),
    ],
)
