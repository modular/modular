# RUN: %repl <%s 2>%t | FileCheck %s -check-prefix=CHECK
# RUN: cat %t | FileCheck %s -check-prefix=CHECK-STDERR

# Note: in REPL mode, expressions are delimited by empty lines.

# Test a simple parser error.
var var = 10
# CHECK-STDERR: Expression [3]:2:5: expected name for 'var' declaration

# Check that we can fix this in a following expression.
var value = 25
print(value)
# CHECK: 25

# Test an error diagnosed in the MLIR pass pipeline, not during the parser.
fn foo() -> Int:
    pass
# CHECK-STDERR: Expression [5]:2:4: return expected at end of function with results

# Test an error diagnosed in the MLIR pass pipeline, not during the parser.
fn foo() -> Int:
    return 0
# CHECK-STDERR-NOT: return expected at end of function with results

# Test declaration of an uninitialized value.
var some_uninit : String
# CHECK-STDERR: Expression [7]{{.*}}: 'some_uninit' is uninitialized at the implicit return from this function
