# RUN: %repl <%s 2>&1 | FileCheck %s

# Note: in REPL mode, expressions are delimited by empty lines.

# CHECK: (Int) x = 12
let x = 12

# CHECK: (FloatLiteral) x = {
# CHECK:   (scalar<f64>) value = {
# CHECK:     (f64) [0] = 4.2{{.*}}
# CHECK:   }
# CHECK: }
let x = 4.2

# CHECK:  (SIMD[si32, 8]) x = {
# CHECK:    (si32) [0] = 5
# CHECK:    (si32) [1] = 6
# CHECK:    (si32) [2] = 7
# CHECK:    (si32) [3] = 8
# CHECK:    (si32) [4] = 9
# CHECK:    (si32) [5] = 10
# CHECK:    (si32) [6] = 11
# CHECK:    (si32) [7] = 12
# CHECK:  }
let x = SIMD[DType.int32, 8](5, 6, 7, 8, 9, 10, 11, 12)

# CHECK:  (SIMD[si64, 4]) x = {
# CHECK:    (si64) [0] = 1
# CHECK:    (si64) [1] = 2
# CHECK:    (si64) [2] = 3
# CHECK:    (si64) [3] = 4
# CHECK:  }
let x = SIMD[DType.int64, 4](1, 2, 3, 4)

# CHECK: (Int) v = -101
let v = -101

# CHECK: (SIMD[si8, 2]) w = {
# CHECK:   (si8) [0] = -50
# CHECK:   (si8) [1] = 31
# CHECK: }
let w = SIMD[DType.int8, 2](-50, 31)


# CHECK: (Foo) f = {
# CHECK:   (Int) v = -101
# CHECK:   (SIMD[si8, 2]) w = {
# CHECK:     (si8) [0] = -50
# CHECK:     (si8) [1] = 31
# CHECK:   }
# CHECK:   (Bool) x = True
# CHECK:   (StringLiteral) y = "fofofo"
# CHECK:   (SIMD[f32, 4]) z = {
# CHECK:     (f32) [0] = 1
# CHECK:     (f32) [1] = 2
# CHECK:     (f32) [2] = 3
# CHECK:     (f32) [3] = 4
# CHECK:   }
# CHECK: }
@value
@register_passable("trivial")
struct Foo:
  var v: Int
  var w: SIMD[DType.int8, 2]
  var x: Bool
  var y: StringLiteral
  var z: SIMD[DType.float32, 4]
  fn __init__() -> Self:
    return Self {
      v: -101,
      w: SIMD[DType.int8, 2](-50, 31),
      x: True,
      y: "fofofo",
      z:  SIMD[DType.float32, 4](1, 2, 3, 4)
    }
let f = Foo()

# CHECK: (StringLiteral) empty =
# CHECK: (StringLiteral) long = "abcdefghijklmnopqrstuvwxyz1234567890"
# CHECK: (StringLiteral) short = "123"
let empty = ""
let long = "abcdefghijklmnopqrstuvwxyz1234567890"
let short = "123"


# CHECK: (Bool) a_bool = True
# CHECK-NEXT: (Bool) another_bool = False
let a_bool = True
let another_bool = False


# CHECK: (DynamicVector[Int]) z = (size 3) {
# FIXME(32514): We need to fix the display type for the first entry of a vector.
# CHECK:   (index) [0] = 1
# CHECK:   (Int) [1] = 2
# CHECK:   (Int) [2] = 3
# CHECK: }
from collections.vector import DynamicVector
var z = DynamicVector[Int](capacity=2)
z.push_back(1)
z.push_back(2)
z.push_back(3)


# CHECK: (Tuple[Int, SIMD[si8, 4]]) a = {
# CHECK:   (Int) [0] = 1
# CHECK:   (SIMD[si8, 4]) [1] = {
# CHECK:     (si8) [0] = 1
# CHECK:     (si8) [1] = 2
# CHECK:     (si8) [2] = 3
# CHECK:     (si8) [3] = 0
# CHECK:   }
# CHECK: }
a = (1, SIMD[DType.int8, 4](1, 2, 3, 0))

# CHECK: (String) s1 = "let_string"
# CHECK: (String) s2 = "012345678910111213141
# CHECK: (String) s3 = ""
let s1 = String("let_string")
var s2 = String()
for i in range(0, 100):
    s2 += str(i)
var s3 = String()
