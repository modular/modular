load("//bazel:api.bzl", "lit_tests")

lit_tests(
    name = "mojo-tool",
    srcs = glob(
        [
            "**/*.test",
            "**/*.mojo",
        ],
        exclude = [
            "**/inputs/**",
            "package/test_package/**/*.mojo",
            "package/test_package_with_main/**/*.mojo",
            "package/test_package_moco_773/**/*.mojo",
        ],
    ),
    data = [
        "//utils/mblack",
    ] + glob([
        "**/inputs/**",
        "package/test_package/**/*.mojo",
        "package/test_package_with_main/**/*.mojo",
        "package/test_package_moco_773/**/*.mojo",
        "build/inputs/**/*.mojo",
        "test/inputs/**/*.mojo",
        "test/inputs/**/*.🔥",
    ]),
    env = {
        "MODULAR_MOJO_MAX_MBLACK_PATH": "$(rootpath //utils/mblack)",
    },
    mojo_deps = [
        "@mojo//:layout",
        "@mojo//:stdlib",
    ],
    target_compatible_with = select({
        "//:b200_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/mojo",
        "@llvm-project//llvm:llvm-objdump",
    ],
    deps = [
        "//utils/mblack",
    ],
)
