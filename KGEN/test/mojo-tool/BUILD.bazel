load("//bazel:api.bzl", "lit_tests")

package(default_visibility = ["//visibility:private"])

lit_tests(
    name = "mojo-tool",
    srcs = glob(
        [
            "**/*.test",
            "**/*.mojo",
        ],
        exclude = [
            "**/inputs/**",
            "package/test_package/**/*.mojo",
            "package/test_package_with_main/**/*.mojo",
            "package/test_package_moco_773/**/*.mojo",
            "package/test_package_fixit/**/*.mojo",
            "package/test_package_fixit_patch_empty/**/*.mojo",
            "package/test_package_werror/**/*.mojo",
        ],
    ),
    data = [
        "//KGEN/tools/mblack",
    ] + glob([
        "**/inputs/**",
        # test_package/ is also copied to KGEN/test/kgen-doc/test_package/.
        # Keep both trees in sync when adding or modifying package fixture files.
        "package/test_package/**/*.mojo",
        "package/test_package_with_main/**/*.mojo",
        "package/test_package_moco_773/**/*.mojo",
        "package/test_package_fixit/**/*.mojo",
        "package/test_package_fixit_patch_empty/**/*.mojo",
        "package/test_package_werror/**/*.mojo",
        "build/inputs/**/*.mojo",
    ]),
    env = {
        "MODULAR_MOJO_MAX_MBLACK_PATH": "$(rootpath //KGEN/tools/mblack)",
    },
    force_strip = True,  # TODO(MOTO-1190): Debug and fix this duplicate symbol issue
    mojo_deps = [
        "//max:layout",
        "//max:max_mojo",
        "@mojo//:std",
    ],
    tools = [
        "//KGEN:MojoLLDB",
        "//KGEN:gdb-server",
        "//KGEN:mojo-lldb",
        "//KGEN/tools/kgen",
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/mojo",
        "@llvm-project//llvm:llvm-as",
        "@llvm-project//llvm:llvm-objdump",
    ],
    deps = [
        "//KGEN/tools/mblack",
    ],
)
