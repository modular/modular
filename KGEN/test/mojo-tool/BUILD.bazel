load("//utils/bazel/build/rules:lit.bzl", "lit_tests")

lit_tests(
    name = "mojo-tool",
    srcs = glob(
        [
            "**/*.test",
            "**/*.mojo",
        ],
        exclude = [
            "**/inputs/**",
            "package/test_package/**/*.mojo",
            "package/test_package_with_main/**/*.mojo",
            "format/mojo-format.test",  # TODO: Requires mblack
            "test/test_execution.mojo",  # TODO: Debug crash
            "debug/mojo-lldb-version.mojo",  # TODO: LLDB
        ],
    ),
    data = [
        "//KGEN:CompilerRT",
        "//KGEN:CompilerRT.distributable",
        "//KGEN/tools/mojo-build-server",
        "@llvm-project//compiler-rt:orc_rt",
    ] + glob([
        "**/inputs/**",
        "package/test_package/**/*.mojo",
        "package/test_package_with_main/**/*.mojo",
        "build/inputs/**/*.mojo",
        "test/inputs/**/*.mojo",
        "test/inputs/**/*.🔥",
    ]),
    env = {
        "MODULAR_MOJO_ORCRT_PATH": "$(location @llvm-project//compiler-rt:orc_rt)",
        "MODULAR_MOJO_COMPILERRT_PATH": "$(location //KGEN:CompilerRT)",
        "MODULAR_MOJO_COMPILERRT_STATIC_PATH": "$(location //KGEN:CompilerRT.distributable)",
        "MODULAR_MOJO_BUILD_SERVER_PATH": "$(location //KGEN/tools/mojo-build-server)",
    },
    mojo_deps = [
        "//Kernels/mojo/layout",
        "//open-source/mojo/stdlib/stdlib:stdlib",
    ],
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/mojo:mojo.opt",
        "@llvm-project//llvm:llvm-objdump",
    ],
)
