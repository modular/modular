load("//bazel:api.bzl", "lit_tests")

lit_tests(
    name = "mojo-tool",
    srcs = glob(
        [
            "**/*.test",
            "**/*.mojo",
        ],
        exclude = [
            "**/inputs/**",
            "package/test_package/**/*.mojo",
            "package/test_package_with_main/**/*.mojo",
            "package/test-package-moco-773/**/*.mojo",
            "test/test_execution.mojo",  # TODO: Debug crash
        ],
    ),
    data = [
        "//KGEN:CompilerRT",
        "//KGEN:CompilerRT.distributable",
        "//KGEN:MojoLLDB",
        "//KGEN:mojo-lldb",
        "//utils/mblack:shim.py",
        "@llvm-project//compiler-rt:orc_rt",
    ] + glob([
        "**/inputs/**",
        "package/test_package/**/*.mojo",
        "package/test_package_with_main/**/*.mojo",
        "package/test-package-moco-773/**/*.mojo",
        "build/inputs/**/*.mojo",
        "test/inputs/**/*.mojo",
        "test/inputs/**/*.🔥",
    ]),
    env = {
        "MODULAR_MOJO_MAX_MBLACK_PATH": "$(location //utils/mblack:shim.py)",
    },
    mojo_deps = [
        "//Kernels/mojo/layout",
        "//open-source/mojo/stdlib/stdlib",
    ],
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//KGEN/tools/kgen-opt",
        "//KGEN/tools/mojo",
        "@llvm-project//llvm:llvm-objdump",
    ],
    deps = [
        "//utils/mblack",
    ],
)
