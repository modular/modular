// RUN: mojo package %S/test_package -o - | kgen-opt | FileCheck %s
// RUN: not mojo package %S/test_package_with_main -o - 2>&1 | FileCheck %s --check-prefix=MAIN_IN_PACKAGE

// MAIN_IN_PACKAGE: defining 'main' within a package is not yet supported

// CHECK-DAG: #local_variable{{[0-9]+}} =
// CHECK-DAG: !subroutine{{[0-9]+}} =

// CHECK: lit.package @test_package
// CHECK-SAME: postParseModule = {{.*}}

// CHECK: lit.package @inner1
// CHECK:   lit.file_module @myfile
// CHECK:     lit.struct.decl @Struct
// CHECK:       lit.func @"parametric{{.*}}<{{.*}}>
// CHECK-NEXT:    debuginfo.value
// CHECK-NEXT:    kgen.param.constant
// CHECK-NEXT:    lit.return
// CHECK:       lit.func @"foo{{.*}}"{{.*}}preCompiledModuleRef = {{.*}}
// CHECK-NEXT:    lit.extern_func

// CHECK: lit.struct.decl @ParametricStruct<{{.*}}: !Int>
// CHECK:       lit.func @"foo(
// CHECK-NEXT:    debuginfo.value
// CHECK-NEXT:    kgen.param.constant
// CHECK-NEXT:    lit.return

// CHECK: lit.package @inner2
// CHECK:   lit.file_module @myfile2
// CHECK:     lit.func export @"bar()"{{.*}}linkageName = "bar", preCompiledModuleRef = {{.*}}
// CHECK-NEXT: lit.extern_func

// CHECK: {-#
// CHECK: dialect_resources
// CHECK: builtin
// CHECK: bytecode_{{.*}}: {{.*}}
// CHECK-NOT: archive_{{.*}}: {{.*}}
