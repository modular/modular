// RUN: mojo test --co %S/inputs/ | FileCheck %s
// RUN: mojo test --co %S/inputs/unit_suffix_test.mojo | FileCheck %s --check-prefix=CHECK-FILE
// RUN: mojo test --co %S/inputs/package | FileCheck %s --check-prefix=CHECK-PACKAGE
// RUN: mojo test --co "%S/inputs/test_unit_prefix.mojo::test_fn()" | FileCheck %s --check-prefix=CHECK-TEST
// RUN: mojo test --co "%S/inputs/doc.mojo@doc_fn(\3A\3AInt).__doc__" | FileCheck %s --check-prefix=CHECK-SUITE
// RUN: mojo test --co "%S/inputs/doc.mojo@doc_fn(\3A\3AInt).__doc__::0" | FileCheck %s --check-prefix=CHECK-SUITE-AND-TEST
// RUN: mojo test --co --diagnostic-format json "%S/inputs/doc.mojo@doc_fn(\3A\3AInt).__doc__" | FileCheck %s --check-prefix=CHECK-JSON

// RUN: not mojo test --co "%S/inputs/doc.mojo@doc_fn.::0" 2>&1 | FileCheck %s --check-prefix=CHECK-INVALID-SCOPE-0
// RUN: not mojo test --co "%S/inputs/doc.mojo@.doc_fn::0" 2>&1 | FileCheck %s --check-prefix=CHECK-INVALID-SCOPE-1
// RUN: not mojo test --co "%S/inputs/doc.mojo@\1::0" 2>&1 | FileCheck %s --check-prefix=CHECK-INVALID-SCOPE-2

// Test that relative paths get resolved correctly.
// RUN: mojo test --co %S/./inputs/ | FileCheck %s

// CHECK-INVALID-SCOPE-0: error: empty scope in test name, expected name after '.'
// CHECK-INVALID-SCOPE-1: error: empty scope in test name, expected name before '.'
// CHECK-INVALID-SCOPE-2: error: invalid escape sequence in test name

// CHECK-NOT: non_unit.mojo
// CHECK: inputs
// CHECK:   inputs/doc.mojo>
// CHECK:     inputs/doc.mojo@__doc__>
// CHECK:       inputs/doc.mojo@__doc__::0>
// CHECK:       inputs/doc.mojo@__doc__::1>
// CHECK:     inputs/doc.mojo@doc_fn({{.*}}).__doc__>
// CHECK:       inputs/doc.mojo@doc_fn({{.*}}).__doc__::0>
// CHECK:     inputs/doc.mojo@Struct.doc_fn({{.*}}).__doc__>
// CHECK:       inputs/doc.mojo@Struct.doc_fn({{.*}}).__doc__::0>
// CHECK:   inputs/test_fire.🔥>
// CHECK:     inputs/test_fire.🔥::test_fn()>
// CHECK:     inputs/test_fire.🔥::fn_test()>
// CHECK:   inputs/test_unit_prefix.mojo>
// CHECK:     inputs/test_unit_prefix.mojo::test_fn()>
// CHECK:     inputs/test_unit_prefix.mojo::fn_test()>
// CHECK:     inputs/test_unit_prefix.mojo::test_someone\2Ecould\2Etechnically\2Edo\2Ethis()>
// CHECK:     inputs/test_unit_prefix.mojo::test_def()>
// CHECK:     inputs/test_unit_prefix.mojo::def_test()>
// CHECK:   inputs/unit_suffix_test.mojo>
// CHECK:     inputs/unit_suffix_test.mojo::test_fn()>
// CHECK:     inputs/unit_suffix_test.mojo::fn_test()>

// CHECK-FILE-NOT: test_unit_prefix
// CHECK-FILE:   inputs/unit_suffix_test.mojo>
// CHECK-FILE:     inputs/unit_suffix_test.mojo::test_fn()>
// CHECK-FILE:     inputs/unit_suffix_test.mojo::fn_test()>

// CHECK-PACKAGE: inputs/package>
// CHECK-PACKAGE:   inputs/package/__init__.mojo>
// CHECK-PACKAGE:     inputs/package/__init__.mojo@package_fn().__doc__>
// CHECK-PACKAGE:       inputs/package/__init__.mojo@package_fn().__doc__::0>
// CHECK-PACKAGE:   inputs/package/test/test_inside_package.mojo>
// CHECK-PACKAGE:     inputs/package/test/test_inside_package.mojo::test_fn()>

// CHECK-TEST: inputs/test_unit_prefix.mojo::test_fn()>

// CHECK-SUITE:  inputs/doc.mojo@doc_fn({{.*}}).__doc__>
// CHECK-SUITE:    inputs/doc.mojo@doc_fn({{.*}}).__doc__::0>

// CHECK-SUITE-AND-TEST: doc.mojo@doc_fn(\3A\3AInt).__doc__::0

// CHECK-JSON:   "children":
// CHECK-JSON:       "id": "{{.*}}inputs/doc.mojo@doc_fn(\\3A\\3AInt).__doc__::0"
// CHECK-JSON:   "id": "{{.*}}inputs/doc.mojo@doc_fn(\\3A\\3AInt).__doc__"
