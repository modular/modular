// RUN: mojo package %mojo_cpu_build_arch %S/test_package --name mojo-test-pkg | FileCheck %s
// RUN: mojo package -debug-level full %mojo_cpu_build_arch %S/test_package --name mojo-test-pkg | FileCheck %s --check-prefix=DEBUGINFO

// DEBUGINFO-DAG: #local_variable{{[0-9]+}} =
// DEBUGINFO-DAG: !subroutine{{[0-9]+}} =

// CHECK: lit.package @"$mojo-test-pkg" attributes {archiveBytes = {{.*}}, compiledFor = {{.*}}, postElaborationModule = {{.*}}, preElaborationModule = {{.*}}

// CHECK: lit.package @"$inner1"
// CHECK:   lit.file_module @"$myfile"
// CHECK:     lit.struct.decl @Struct
// CHECK:       lit.func @"parametric{{.*}}"<{{.*}}>
// CHECK-NEXT:    kgen.param.constant
// CHECK-NEXT:    lit.return
// CHECK:       lit.func @"foo{{.*}}"{{.*}} preCompiledModuleRef = {{.*}}
// CHECK-NEXT:    lit.extern_func

// CHECK: lit.struct.decl @ParametricStruct<{{.*}}: {{.*}}@"$Int"::@Int>
// CHECK:       lit.func @"foo(
// CHECK-NEXT:    kgen.param.constant
// CHECK-NEXT:    lit.return

// CHECK: lit.package @"$inner2"
// CHECK:   lit.file_module @"$myfile2"
// CHECK:     lit.func export @"bar()"{{.*}} linkageName = "bar", preCompiledModuleRef = {{.*}}
// CHECK-NEXT: lit.extern_func

// CHECK: {-#
// CHECK: dialect_resources
// CHECK: builtin
// CHECK: archive_{{.*}}: {{.*}}
// CHECK: bytecode_{{.*}}: {{.*}}
