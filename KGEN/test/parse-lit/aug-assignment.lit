# RUN: kgen-translate -import-lit %s | FileCheck %s

__include "../lit-examples/prolog.lit"

struct M:
  var value : __mlir_type.index
  fn __new__(value: __mlir_type.index) -> M:
    return M(0)

  fn __imatmul__(self&, rhs: M) -> M:
    return M(0)

def basic_assignments(a: Int, b: Int, c: M, d: M):
  # CHECK:      %a_0 = lit.var.decl "a"
  # CHECK:      %b_1 = lit.var.decl "b"
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__iadd__(%a_0, %[[LOAD_B]])
  a += b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__isub__(%a_0, %[[LOAD_B]])
  a -= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__imul__(%a_0, %[[LOAD_B]])
  a *= b
  # HECK:      %[[LOAD_C:.*]] = pop.load %c_2  : !pop.pointer<@M>
  # HECK-NEXT: %[[RES:.*]] = kgen.call @M::@__imatmul__(%d_3, %[[LOAD_C]])
  #d @= c
  # HECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # HECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__itruediv__(%a_0, %[[LOAD_B]])
  #a /= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__ifloordiv__(%a_0, %[[LOAD_B]])
  a //= b
  # HECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # HECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__imod__(%a_0, %[[LOAD_B]])
  # a %= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__ipow__(%a_0, %[[LOAD_B]])
  a **= b
  # HECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # HECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__irshift__(%a_0, %[[LOAD_B]])
  #a >>= b
  # HECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # HECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__ilshift__(%a_0, %[[LOAD_B]])
  #a <<= b
  # HECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # HECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__iand__(%a_0, %[[LOAD_B]])
  #a &= b
  # HECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # HECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__ixor__(%a_0, %[[LOAD_B]])
  #a ^= b
  # HECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # HECK-NEXT: %[[RES:.*]] = kgen.call @Int::@__ior__(%a_0, %[[LOAD_B]])
  #a |= b
