# RUN: kgen-translate -import-lit %s | FileCheck %s

__include "../lit-examples/prolog.lit"

def basic_assignments(a: Int, b: Int):
  # CHECK:      %a_0 = lit.var.decl "a" : <@Int>
  # CHECK:      %b_1 = lit.var.decl "b" : <@Int>
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__iadd__](%a_0, %[[LOAD_B]])
  a += b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__isub__](%a_0, %[[LOAD_B]])
  a -= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__imul__](%a_0, %[[LOAD_B]])
  a *= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__imatmul__](%a_0, %[[LOAD_B]])
  a @= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__itruediv__](%a_0, %[[LOAD_B]])
  a /= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__ifloordiv__](%a_0, %[[LOAD_B]])
  a //= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__imod__](%a_0, %[[LOAD_B]])
  a %= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__ipow__](%a_0, %[[LOAD_B]])
  a **= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__irshift__](%a_0, %[[LOAD_B]])
  a >>= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__ilshift__](%a_0, %[[LOAD_B]])
  a <<= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__iand__](%a_0, %[[LOAD_B]])
  a &= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__ixor__](%a_0, %[[LOAD_B]])
  a ^= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1  : !pop.pointer<@Int>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param[(!pop.pointer<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__ior__](%a_0, %[[LOAD_B]])
  a |= b
