# RUN: kgen-translate -import-lit %s | FileCheck %s

__include "../lit-examples/prolog.lit"

struct M:
  var value : index
  fn __new__(value: index) -> M:
    return M(0)

  fn __imatmul__(&self, rhs: M) -> M:
    return M(0)

def basic_assignments(a: Int, b: Int, c: M, d: M):
  # CHECK:      %a_0 = lit.var.decl "a" : <@Int>
  # CHECK:      %b_1 = lit.var.decl "b" : <@Int>
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__iadd__](%a_0, %[[LOAD_B]])
  a += b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__isub__](%a_0, %[[LOAD_B]])
  a -= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__imul__](%a_0, %[[LOAD_B]])
  a *= b
  # CHECK:      %[[LOAD_C:.*]] = pop.load %c_2  : !pop.pointer<@M>
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @M::@__imatmul__](%d_3, %[[LOAD_C]])
  d @= c
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__itruediv__](%a_0, %[[LOAD_B]])
  a /= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__ifloordiv__](%a_0, %[[LOAD_B]])
  a //= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__imod__](%a_0, %[[LOAD_B]])
  a %= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__ipow__](%a_0, %[[LOAD_B]])
  a **= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__irshift__](%a_0, %[[LOAD_B]])
  a >>= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__ilshift__](%a_0, %[[LOAD_B]])
  a <<= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__iand__](%a_0, %[[LOAD_B]])
  a &= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__ixor__](%a_0, %[[LOAD_B]])
  a ^= b
  # CHECK:      %[[LOAD_B:.*]] = pop.load %b_1
  # CHECK-NEXT: %[[RES:.*]] = kgen.call_param{{.*}} @Int::@__ior__](%a_0, %[[LOAD_B]])
  a |= b
