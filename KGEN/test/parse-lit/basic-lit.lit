# RUN: kgen-translate -import-lit %s | FileCheck %s

__include "../lit-examples/prolog.lit"

# CHECK: module {

# CHECK-LABEL: lit.func @empty_def() -> !lit.none {
# CHECK: %0 = kgen.param.constant: !lit.none = <#lit.none>
# CHECK: kgen.return %0 : !lit.none
fn empty_def():
  # Pass isn't required.

fn take_3index(a: index, b: index, c: index) -> index:
  return a

# CHECK-LABEL: lit.func @fancy_signature
# CHECK-SAME: <dt: !kgen.ref<@DType>, size>
# CHECK-SAME: (%x: !kgen.ref<@SIMD<size = size, dt: !kgen.ref<@DType> = dt>>,
# CHECK-SAME:  %exp: !kgen.ref<@SIMD<size = size, dt: !kgen.ref<@DType> = dt>>) -> index {
def fancy_signature[dt: DType, size: index]
  (x: SIMD[size, dt], exp: (SIMD)[size, dt]) -> index:

  # CHECK: %local = lit.var.decl "local" : <index>
  # CHECK: %[[TMP1:.*]] = kgen.param.constant = <size>
  # CHECK: %[[TMP2:.*]] = kgen.param.constant = <size>
  # CHECK: %[[TMP3:.*]] = kgen.param.constant = <size>
  # CHECK: %[[RES:.*]] = kgen.call_param[(index, index, index) -> index: @take_3index](%[[TMP1]], %[[TMP2]], %[[TMP3]])
  # CHECK: pop.store %[[RES]], %local : !pop.pointer<index>
  local = take_3index(size, size, size)

  # CHECK: %[[TMP:.*]] = kgen.param.constant = <add(size, 42)>
  # CHECK: kgen.return %[[TMP]] : index
  return size+42

# CHECK-LABEL: lit.func @noop()
def noop():
  pass
  # CHECK-NEXT : kgen.return

# CHECK-LABEL: lit.struct.decl @EmptyStruct {
struct EmptyStruct:
  # No body
# CHECK-NEXT: }

# CHECK-LABEL: lit.struct.decl @OneLineStruct<size: !kgen.ref<@Int>> {
struct OneLineStruct[size: Int]: pass; pass
# CHECK-NEXT: }

# CHECK-LABEL: lit.struct.decl @StructExample {
struct StructExample:
  fn __new__() -> StructExample:
    var result : StructExample
    return result

  # CHECK: lit.func @static(%x: !kgen.ref<@Int>) -> !lit.none attributes {isStatic} {
  @staticmethod
  fn static(x: Int):
    # CHECK: %0 = index.constant 4
    # CHECK: %1 = kgen.call_param[(index) -> !kgen.ref<@Int>: @Int::@__new__](%0)
    # CHECK: %2 = kgen.call_param[(!kgen.ref<@Int>) -> !lit.none: @StructExample::@static](%1)
    StructExample.static(Int(4))
    pass

  # CHECK: lit.func @mutatingMethod(%self: !pop.pointer<@StructExample>) -> !lit.none
  fn mutatingMethod(&self):

# CHECK: }
# CHECK-NEXT: }

# CHECK: lit.func @callStatic(%a: !kgen.ref<@Int>) -> !lit.none
fn callStatic(a: Int):
  # CHECK: kgen.call_param[(!kgen.ref<@Int>) -> !lit.none: @StructExample::@static](%a)
  StructExample.static(a)

  # CHECK: kgen.call_param[() -> !kgen.ref<@StructExample>: @StructExample::@__new__]()
  # CHECK: kgen.call_param[(!kgen.ref<@Int>) -> !lit.none: @StructExample::@static](%a)
  StructExample().static(a)

# CHECK-LABEL: lit.func @simpleMath
fn simpleMath(a: Int, b: Int) -> Int:
  # CHECK: %0 = kgen.call_param[(!kgen.ref<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__mul__](%b, %a)
  # CHECK: %1 = kgen.call_param[(!kgen.ref<@Int>, !kgen.ref<@Int>) -> !kgen.ref<@Int>: @Int::@__add__](%a, %0)
  # CHECK: kgen.return %1 : !kgen.ref<@Int>
  return a+b*a


# CHECK-LABEL: lit.struct.decl @Pair<dt: !kgen.ref<@DType>> {
struct Pair[dt: DType]:
 # CHECK: %a = lit.var.decl "a" : <@SIMD<size = 42, dt: !kgen.ref<@DType> = dt>>
 # CHECK: %b = lit.var.decl "b" : <@Int>
  var a : SIMD[42, dt]
  var b : Int

  # CHECK: lit.func @__new__() -> !kgen.ref<@Pair<dt: !kgen.ref<@DType> = dt>> attributes {isStatic}
  fn __new__() -> Pair[dt]:
    var result : Pair[dt]
    # TODO: Fill this in.
    return result
  # CHECK: }

# CHECK: }

# CHECK-LABEL:  lit.func @var_decls(%untyped: !kgen.ref<@object>)
def var_decls(untyped):
  # CHECK: %x = lit.var.decl "x" : <index>
  x = 123
  # CHECK: %y = lit.var.decl "y" : <@Int>
  var y : Int
  y = y #+1
  # CHECK: [[TMP:%.*]] = pop.load %y : !pop.pointer<@Int>
  # CHECK: pop.store [[TMP]], %y : !pop.pointer<@Int>

  # CHECK: %z = lit.var.decl "z" : <index>
  var z : index
  z = 42
  # CHECK: [[TMP:%.*]] = index.constant 42
  # CHECK: pop.store [[TMP]], %z


def patterns():
  (((z2))) = 42  # Paren patterns
  # CHECK: [[TMP:%.*]] = index.constant 42
  # CHECK: pop.store [[TMP]], %z2

# CHECK-LABEL: lit.struct.decl @SIMD<size, dt: !kgen.ref<@DType>> {
struct SIMD[size: index, dt: DType]:
  pass

fn generic_fn[a: DType, b: index, c: type](d : index):

# CHECK: @call_generic<dt: !kgen.ref<@DType>>()
fn call_generic[dt: DType]():
  # CHECK: %0 = index.constant 57
  # CHECK: kgen.call_param[(index) -> !lit.none: @generic_fn<a: !kgen.ref<@DType> = dt, b = 42, c: type = !kgen.ref<@DType>>](%0)
  generic_fn[dt, 42, DType](57)

  # CHECK: [[TMP:%.*]] = index.constant 57
  # CHECK: kgen.call_param[(index) -> !lit.none: @generic_fn<a: !kgen.ref<@DType> = dt, b = 13, c: type = !kgen.ref<@SIMD<size = 4, dt: !kgen.ref<@DType> = dt>>>]([[TMP]])
  generic_fn[dt, 13, SIMD[4, dt]](57)

@interface
#CHECK: lit.func @func_interface0<type: !kgen.ref<@DType>>(%x: index) -> index attributes {isInterface} {
fn func_interface0[type: DType](x: index) -> index:

@interface
#CHECK: lit.func @func_interface1<type: !kgen.ref<@DType>>(%x: index) -> index attributes {isInterface} {
fn func_interface1[type: DType](x: index) -> index: pass

@interface
#CHECK: lit.func @func_interface2<type: !kgen.ref<@DType>>(%x: index) -> index attributes {isInterface} {
fn func_interface2[type: DType](x: index) -> index:
  ...

@implements(func_interface2)
#CHECK: lit.func @func_impl<type: !kgen.ref<@DType>>(%x: index) -> index
#CHECK:    implements @func_interface2 {
fn func_impl[type: DType](x: index) -> index:
  return x

# CHECK: lit.func @byval_byref_function(%a: !kgen.ref<@Int>, %b: !pop.pointer<@Int>) -> !lit.none
fn byval_byref_function(a: Int, &b: Int):
  # CHECK-NEXT: pop.store %a, %b
  b = a

  # CHECK-NEXT: %x = lit.var.decl "x"
  var x : Int
  # This needs to load 'b' to pass it by value for the first arg, but pass its
  # address in directly for the second.
  # CHECK: %0 = pop.load %b : !pop.pointer<@Int>
  # CHECK: %1 = kgen.call_param[(!kgen.ref<@Int>, !pop.pointer<@Int>) -> !lit.none: @byval_byref_function](%0, %b)
  byval_byref_function(b, b)

# CHECK: lit.func @lvaluesAndRValues()
fn lvaluesAndRValues() -> index:
  # CHECK: [[FOUR:%.*]] = index.constant 4
  # CHECK: [[INT:%.*]] = kgen.call_param[(index) -> !kgen.ref<@Int>: @Int::@__new__]([[FOUR]])
  # CHECK: [[VALUE:%.*]] = lit.struct.extract [[INT]][value] : index from <@Int>
  # CHECK: kgen.return [[VALUE]] : index
  return Int(4).value

# CHECK: lit.func @defTests
def defTests(a: Int, b: Int):
  # CHECK: %[[TMP:.*]] = pop.load %b_1
  # CHECK-NEXT: pop.store %[[TMP]], %a_0
  a = b # Parameters are mutable!

# CHECK: lit.func @mlirMagicTest(%x: bf16, %y: f8E5M2)
fn mlirMagicTest(x: __mlir_type.bf16, y: __mlir_type.f8E5M2):
  # CHECK: %a = lit.var.decl "a" : <index>
  var a : __mlir_type.index
  # CHECK: %b = lit.var.decl "b" : <f64>
  var b : __mlir_type.f64
  # CHECK: %c = lit.var.decl "c" : <pointer<pointer<f32>>>
  var c : __mlir_type.`!pop.pointer<!pop.pointer<f32>>`
