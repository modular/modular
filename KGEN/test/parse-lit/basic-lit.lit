# RUN: kgen-translate -import-lit %s -verify-diagnostics -I %stdlibdir | FileCheck %s

__include "../lit-examples/prolog.lit"

# CHECK-LABEL: kgen.struct.decl @OurSIMD<size, dt: !kgen.declref<@"$basic-lit"::@DType>> {
struct OurSIMD[size: __mlir_type.index, dt: DType]:
  pass

# CHECK-LABEL: lit.func @"patterns()
fn patterns():
  # CHECK: %z2 = lit.var.decl "z2" : <index>
  var z2: __mlir_type.index

  (((z2))) = 42  # Paren patterns
  # CHECK: [[TMP:%.*]] = index.constant 42
  # CHECK: pop.store [[TMP]], %z2

  var someInt : Int
  (someInt) += someInt
  # CHECK: %someInt = lit.var.decl "someInt" : <@"$Int"::@Int>
  # CHECK:  %0 = pop.load %someInt : !pop.pointer<@"$Int"::@Int>
  # CHECK:  %1 = kgen.call @"$Int"::@Int::@"__iadd__{{.*}}(%someInt, %0)

  # Discard pattern with different types.
  (_) = someInt
  # CHECK: %_ = lit.var.decl "_" : <@"$Int"::@Int>
  # CHECK: pop.store {{.*}}, %_ : !pop.pointer<@"$Int"::@Int>

  (_) = 1.0
  # CHECK: %__0 = lit.var.decl "_" : <f64>
  # CHECK: pop.store {{.*}}, %__0 : !pop.pointer<f64>

  # CHECK: %someF32 = lit.var.decl "someF32" : <@"$F32"::@F32>
  # CHECK: [[F32:%.*]] = pop.load %someF32 : !pop.pointer<@"$F32"::@F32>
  # CHECK: {{%.*}} = kgen.call @"$F32"::@F32::@"__iadd__{{.*}}(%someF32, [[F32]])
  var someF32 : F32
  (someF32) += someF32

  # CHECK: %someSIMD = lit.var.decl "someSIMD" : <@"$SIMD"::@SIMD<size = 4, type: dtype = f64>>
  # CHECK: [[SIMD:%.*]] = pop.load %someSIMD : !pop.pointer<@"$SIMD"::@SIMD<size = 4, type: dtype = f64>>
  # CHECK: {{%.*}} = kgen.call @"$SIMD"::@SIMD::@"__iadd__{{.*}}(%someSIMD, [[SIMD]])
  var someSIMD : SIMD[4, __mlir_attr.`#kgen.dtype.constant<f64> : !kgen.dtype`]
  (someSIMD) += someSIMD


@interface
# CHECK: lit.func @"func_interface0{{.*}}<type: !kgen.declref<@"$basic-lit"::@DType>>(%x: index) -> index attributes {isInterface}
fn func_interface0[type: DType](x: __mlir_type.index) -> __mlir_type.index:

@interface
# CHECK: lit.func @"func_interface1{{.*}}<type: !kgen.declref<@"$basic-lit"::@DType>>(%x: index) -> index attributes {isInterface}
fn func_interface1[type: DType](x: __mlir_type.index) -> __mlir_type.index: pass

@interface
# CHECK: lit.func @"func_interface2{{.*}}<type: !kgen.declref<@"$basic-lit"::@DType>>(%x: index) -> index attributes {isInterface}
fn func_interface2[type: DType](x: __mlir_type.index) -> __mlir_type.index:
  ...

@implements(func_interface2)
# CHECK: lit.func @"func_impl{{.*}}<type: !kgen.declref<@"$basic-lit"::@DType>>(%x: index) -> index
# CHECK:    implements @"$basic-lit"::@"func_interface2(__mlir_type.index)" {
fn func_impl[type: DType](x: __mlir_type.index) -> __mlir_type.index:
  return x

@interface
# CHECK: lit.func @"my_evaluator{{.*}}(%funcs: !pop.pointer<(index) -> index>, %size: index) -> index attributes {isInterface}
fn my_evaluator(funcs: __mlir_type.`!pop.pointer<(index) -> index>`, size: __mlir_type.index) -> __mlir_type.index:
    ...

@interface
@evaluator(my_evaluator)
# CHECK: lit.func @"useEvaluator{{.*}} {isInterface}  evaluator (!pop.pointer<(index) -> index>, index) -> index = @"$basic-lit"::@"my_evaluator(__mlir_type.!pop.pointer<(index) -> index>,__mlir_type.index)"
fn useEvaluator(x:  __mlir_type.index) ->  __mlir_type.index:
  ...

# CHECK: lit.func @"byval_byref_function($Int::Int,$Int::Int&)"(%a: !kgen.declref<@"$Int"::@Int>, %b: !pop.pointer<@"$Int"::@Int> byref) -> !lit.none
fn byval_byref_function(a: Int, b&: Int):
  # CHECK-NEXT: pop.store %a, %b
  b = a

  # CHECK-NEXT: %x = lit.var.decl "x"
  var x : Int
  # This needs to load 'b' to pass it by value for the first arg, but pass its
  # address in directly for the second.
  # CHECK: %0 = pop.load %b : !pop.pointer<@"$Int"::@Int>
  # CHECK: %1 = kgen.call @"$basic-lit"::@"byval_byref_function{{.*}}(%0, %b)
  byval_byref_function(b, b)

# CHECK: lit.func @"lvaluesAndRValues()
fn lvaluesAndRValues() -> __mlir_type.`!pop.scalar<index>`:
  # CHECK: [[FOUR:%.*]] = index.constant 4
  # CHECK: [[INT:%.*]] = kgen.call @"$Int"::@Int::@"__new__{{.*}}([[FOUR]])
  # CHECK: [[VALUE:%.*]] = kgen.struct.extract [[INT]][value] : !pop.scalar<index> from
  # CHECK: kgen.return [[VALUE]] : !pop.scalar<index>
  return Int(4).value

# CHECK: lit.func @"defTests({{.*}}, %untyped: !kgen.declref<@"$basic-lit"::@object>)
def defTests(a: Int, b: Int, untyped):
  # CHECK: [[TMP:%.*]] = pop.load %b_1
  # CHECK-NEXT: pop.store [[TMP]], %a_0
  a = b # Parameters are mutable!

# CHECK: lit.func @"pleaseInline()"() force_inline -> index attributes {alwaysInline} {
@always_inline
fn pleaseInline() -> __mlir_type.index:
  return 1
