  (x: SIMD[size, dt], exp: SIMD[size, dt]) -> SIMD[size, dt]:
  z = 42
  noop()(42)
  return z #x*4 + x + 1
# CHECK-NEXT: kgen.return

# CHECK-LABEL: kgen.func public @noop() {

def noop():
  pass

# CHECK-NEXT : kgen.return
