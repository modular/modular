# RUN: kgen-translate -import-lit %s | FileCheck %s

# CHECK: module {

# CHECK-LABEL: lit.func @empty_def() -> !lit.none {
# CHECK: %0 = kgen.param.constant: !lit.none = <#lit.none>
# CHECK: kgen.return %0 : !lit.none
def empty_def():
  # Pass isn't required.

# CHECK-LABEL: lit.func @test_if_cond(%a: index) -> !lit.none {
def test_if_cond(a: index):
    # CHECK:      %[[ONE0:.*]] = index.constant 1
    # CHECK-NEXT: %[[ONE1:.*]] = index.constant 1
    # CHECK-NEXT: %[[CMP:.*]] = index.cmp eq(%[[ONE0]], %[[ONE1]])
    # CHECK-NEXT: %[[IF_RES:.*]] = scf.if %[[CMP]] -> (index) {
    # CHECK-NEXT:   %[[TWO:.*]] = index.constant 2
    # CHECK-NEXT:   scf.yield %[[TWO]] : index
    # CHECK-NEXT: } else {
    # CHECK-NEXT:   %[[THREE:.*]] = index.constant 3
    # CHECK-NEXT:   scf.yield %[[THREE]] : index
    # CHECK-NEXT: }
    # CHECK-NEXT: pop.store %[[IF_RES:.*]], %a_0 : !pop.pointer<index>
    a = 2 if 1 else 3

# CHECK-LABEL: lit.func @precedence_associativity(%a: index)
def precedence_associativity(a: index):
  z = 0
  # CHECK:      %[[A:.*]] = pop.load %a_0 : !pop.pointer<index>
  # CHECK-NEXT: %[[Z:.*]] = pop.load %z : !pop.pointer<index>
  # CHECK-NEXT: %[[POW0:.*]] = index.rems %[[A]], %[[Z]]
  # CHECK-NEXT: %[[TWO:.*]] = index.constant 2
  # CHECK-NEXT: %[[POW1:.*]] = index.rems %[[TWO]], %[[POW0]]
  # CHECK-NEXT: pop.store %[[POW1]], %z : !pop.pointer<index>
  z = 2**(a**z)
  # CHECK-NEXT: %[[A:.*]] = pop.load %a_0 : !pop.pointer<index>
  # CHECK-NEXT: %[[Z:.*]] = pop.load %z : !pop.pointer<index>
  # CHECK-NEXT: %[[POW0:.*]] = index.rems %[[A]], %[[Z]]
  # CHECK-NEXT: %[[TWO:.*]] = index.constant 2
  # CHECK-NEXT: %[[POW1:.*]] = index.rems %[[TWO]], %[[POW0]]
  # CHECK-NEXT: pop.store %[[POW1]], %z : !pop.pointer<index>
  z = 2**a**z
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z : !pop.pointer<index>
  # CHECK-NEXT:  %[[TWO:.*]] = index.constant 2
  # CHECK-NEXT:  %[[ZERO:.*]] = index.constant 0
  # CHECK-NEXT:  %[[SUB:.*]] = index.sub %[[ZERO]], %[[TWO]]
  # CHECK-NEXT:  %[[THREE:.*]] = index.constant 3
  # CHECK-NEXT:  %[[MUL:.*]] = index.mul %[[THREE]], %[[SUB]]
  # CHECK-NEXT:  %[[ADD:.*]] = index.add %[[Z]], %[[MUL]]
  # CHECK-NEXT:  pop.store %[[ADD]], %z : !pop.pointer<index>
  z = z + 3 * -2
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z : !pop.pointer<index>
  # CHECK-NEXT:  %[[TWO:.*]] = index.constant 2
  # CHECK-NEXT:  %[[ZERO:.*]] = index.constant 0
  # CHECK-NEXT:  %[[SUB:.*]] = index.sub %[[ZERO]], %[[TWO]]
  # CHECK-NEXT:  %[[THREE:.*]] = index.constant 3
  # CHECK-NEXT:  %[[MATRIX_MUL:.*]] = index.mul %[[THREE]], %[[SUB]]
  # CHECK-NEXT:  %[[ADD:.*]] = index.add %[[Z]], %[[MATRIX_MUL]]
  # CHECK-NEXT:  pop.store %[[ADD]], %z : !pop.pointer<index>
  z = z + 3 @ -2
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z : !pop.pointer<index>
  # CHECK-NEXT:  %[[TWO:.*]] = index.constant 2
  # CHECK-NEXT:  %[[ZERO:.*]] = index.constant 0
  # CHECK-NEXT:  %[[SUB:.*]] = index.sub %[[ZERO]], %[[TWO]]
  # CHECK-NEXT:  %[[THREE:.*]] = index.constant 3
  # CHECK-NEXT:  %[[FLOOR_DIV:.*]] = index.divs %[[THREE]], %[[SUB]]
  # CHECK-NEXT:  %[[ADD:.*]] = index.add %[[Z]], %[[FLOOR_DIV]]
  # CHECK-NEXT:  pop.store %[[ADD]], %z : !pop.pointer<index>
  z = z + 3 // -2
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z : !pop.pointer<index>
  # CHECK-NEXT:  %[[TWO:.*]] = index.constant 2
  # CHECK-NEXT:  %[[ZERO:.*]] = index.constant 0
  # CHECK-NEXT:  %[[SUB:.*]] = index.sub %[[ZERO]], %[[TWO]]
  # CHECK-NEXT:  %[[THREE:.*]] = index.constant 3
  # CHECK-NEXT:  %[[REMINDER:.*]] = index.rems %[[THREE]], %[[SUB]]
  # CHECK-NEXT:  %[[ADD:.*]] = index.add %[[Z]], %[[REMINDER]]
  # CHECK-NEXT:  pop.store %[[ADD]], %z : !pop.pointer<index>
  z = z + 3 % -2
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z : !pop.pointer<index>
  # CHECK-NEXT:  %[[THREE:.*]] = index.constant 3
  # CHECK-NEXT:  %[[ADD:.*]] = index.add %[[Z]], %[[THREE]]
  # CHECK-NEXT:  %[[TWO:.*]] = index.constant 2
  # CHECK-NEXT:  %[[ZERO:.*]] = index.constant 0
  # CHECK-NEXT:  %[[TWOPLUSZERO:.*]] = index.add %[[ZERO]], %[[TWO]]
  # CHECK-NEXT:  %[[ZERO:.*]] = index.constant 0
  # CHECK-NEXT:  %[[SUB:.*]] = index.sub %[[ZERO]], %[[TWOPLUSZERO]]
  # CHECK-NEXT:  %[[MUL:.*]] = index.mul %[[ADD]], %[[SUB]]
  # CHECK-NEXT:  pop.store %[[MUL]], %z : !pop.pointer<index>
  z = (z + 3) * -+2
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z : !pop.pointer<index>
  # CHECK-NEXT:  %[[TWO:.*]] = index.constant 2
  # CHECK-NEXT:  %[[POW:.*]] = index.rems %[[TWO]], %[[Z]]
  # CHECK-NEXT:  %[[ZERO:.*]] = index.constant 0
  # CHECK-NEXT:  %[[SUB:.*]] = index.sub %[[ZERO]], %[[POW]]
  # CHECK-NEXT:  pop.store %[[SUB]], %z : !pop.pointer<index>
  z = -2**z

# CHECK-LABEL: lit.func @precedence_bitwise(%a: index, %b: index, %c: index) -> !lit.none {
def precedence_bitwise(a: index, b: index, c: index):
  # CHECK:      %[[A:.*]] = pop.load %a_0 : !pop.pointer<index>
  # CHECK-NEXT: %[[TWO:.*]] = index.constant 2
  # CHECK-NEXT: %[[MUL:.*]] = index.mul %[[A]], %[[TWO]]
  # CHECK-NEXT: %[[B:.*]] = pop.load %b_1 : !pop.pointer<index>
  # CHECK-NEXT: %[[AND:.*]] = index.add %[[MUL]], %[[B]]
  # CHECK-NEXT: %[[C:.*]] = pop.load %c_2 : !pop.pointer<index>
  # CHECK-NEXT: %[[FOUR:.*]] = index.constant 4
  # CHECK-NEXT: %[[XOR:.*]] = index.divs %[[FOUR]], %[[C]]
  # CHECK-NEXT: %[[OR:.*]] = index.sub %[[AND]], %[[XOR]]
  # CHECK-NEXT: pop.store %[[OR]], %a_0 : !pop.pointer<index>
  a = a * 2 & b | 4 ^ c

# CHECK-LABEL: lit.func @precedence_comparison(%a: index, %b: index, %c: index, %d: index) -> !lit.none {
def precedence_comparison(a: index, b: index, c: index, d: index):
  # CHECK:      %[[A:.*]] = pop.load %a_0 : !pop.pointer<index>
  # CHECK-NEXT: %[[B:.*]] = pop.load %b_1 : !pop.pointer<index>
  # CHECK-NEXT: %[[EQUAL:.*]] = index.remu %[[A]], %[[B:.*]]
  # CHECK-NEXT: %[[C:.*]] = pop.load %c_2 : !pop.pointer<index>
  # CHECK-NEXT: %[[ZERO:.*]] = index.constant 0
  # CHECK-NEXT: %[[NOT:.*]] = index.sub %[[ZERO]], %[[C]]
  # CHECK-NEXT: %[[AND:.*]] = index.add %[[EQUAL]], %[[NOT]]
  # CHECK-NEXT: %[[D:.*]] = pop.load %d_3 : !pop.pointer<index>
  # CHECK-NEXT: %[[OR:.*]] = index.sub %[[AND]], %[[D]]
  a = ((a == b) and (not c)) or d
  # CHECK:      %[[A:.*]] = pop.load %a_0 : !pop.pointer<index>
  # CHECK-NEXT: %[[B:.*]] = pop.load %b_1 : !pop.pointer<index>
  # CHECK-NEXT: %[[EQUAL:.*]] = index.remu %[[A]], %[[B:.*]]
  # CHECK-NEXT: %[[C:.*]] = pop.load %c_2 : !pop.pointer<index>
  # CHECK-NEXT: %[[ZERO:.*]] = index.constant 0
  # CHECK-NEXT: %[[NOT:.*]] = index.sub %[[ZERO]], %[[C]]
  # CHECK-NEXT: %[[AND:.*]] = index.add %[[EQUAL]], %[[NOT]]
  # CHECK-NEXT: %[[D:.*]] = pop.load %d_3 : !pop.pointer<index>
  # CHECK-NEXT: %[[OR:.*]] = index.sub %[[AND]], %[[D]]
  a = a == b and not c or d

# CHECK-LABEL: lit.func @do_math(%a: index, %b: index, %c: index) -> index {
def do_math(a: index, b: index, c: index) -> index:
  # CHECK-NEXT: %a_0 = lit.var.decl "a"
  # CHECK-NEXT: pop.store %a, %a_0
  # CHECK-NEXT: %b_1 = lit.var.decl "b"
  # CHECK-NEXT: pop.store %b, %b_1
  # CHECK-NEXT:  %c_2 = lit.var.decl "c"
  # CHECK-NEXT: pop.store %c, %c_2
  # CHECK-NEXT: %z = lit.var.decl "z" : <index>
  # CHECK-NEXT: %x = lit.var.decl "x" : <index>

  # CHECK-NEXT: %[[TMP:.*]] = pop.load %b_1
  # CHECK-NEXT: pop.store %[[TMP]], %c_2
  c = b # Parameters are mutable!

  # CHECK-NEXT: %[[A:.*]] = pop.load %a_0
  # CHECK-NEXT: %[[I5:.*]] = index.constant 5
  # CHECK-NEXT: %[[MUL:.*]] = index.mul %[[I5]], %[[A]]
  # CHECK-NEXT: %[[I42:.*]] = index.constant 42
  # CHECK-NEXT: %[[ADD:.*]] = index.add %[[I42]], %[[MUL]]
  # CHECK-NEXT: pop.store %[[ADD]], %z : !pop.pointer<index>
  z = 42 + 5*a

  # CHECK-NEXT: %[[C:.*]] = pop.load %c_2
  # CHECK-NEXT: %[[MUL:.*]] = index.constant 210
  # CHECK-NEXT: %[[ADD:.*]] = index.add %[[MUL]], %[[C]]
  # CHECK-NEXT: pop.store %[[ADD]], %z : !pop.pointer<index>
  z = 42 * 5 + c

  # CHECK-NEXT: %[[A:.*]] = pop.load %a_0
  # CHECK-NEXT: %[[ADD:.*]] = index.constant 11
  # CHECK-NEXT: %[[MUL:.*]] = index.mul %[[A]], %[[ADD]]
  # CHECK-NEXT: pop.store %[[MUL]], %z : !pop.pointer<index>
  z = a * (5 + 6)

  # CHECK-NEXT: %[[TMP:.*]] = pop.load %z : !pop.pointer<index>
  # CHECK-NEXT: pop.store %[[TMP]], %x : !pop.pointer<index>
  # This is checking the lexer handles \ at end of line correctly.
  x = \
z

  # CHECK-NEXT: kgen.call_param[() -> !lit.none: @noop]()
  noop()

  # CHECK-NEXT: %[[TMP:.*]] = pop.load %x
  # CHECK-NEXT: kgen.return %[[TMP]]
  return x

# CHECK-LABEL: lit.func @fancy_signature
# CHECK-SAME: <dt: !kgen.ref<@DType>, size>
# CHECK-SAME: (%x: !kgen.ref<@SIMD<size = size, dt: !kgen.ref<@DType> = dt>>,
# CHECK-SAME:  %exp: !kgen.ref<@SIMD<size = size, dt: !kgen.ref<@DType> = dt>>) -> index {
def fancy_signature[dt: DType, size: index]
  (x: SIMD[size, dt], exp: (SIMD)[size, dt]) -> index:

  # CHECK: %local = lit.var.decl "local" : <index>
  # CHECK: %[[TMP1:.*]] = kgen.param.constant = <size>
  # CHECK: %[[TMP2:.*]] = kgen.param.constant = <size>
  # CHECK: %[[TMP3:.*]] = kgen.param.constant = <size>
  # CHECK: %[[RES:.*]] = kgen.call_param[(index, index, index) -> index: @do_math](%[[TMP1]], %[[TMP2]], %[[TMP3]])
  # CHECK: pop.store %[[RES]], %local : !pop.pointer<index>
  local = do_math(size, size, size)

  # CHECK: %[[TMP:.*]] = kgen.param.constant = <add(size, 42)>
  # CHECK: kgen.return %[[TMP]] : index
  return size+42

# CHECK-LABEL: lit.func @noop()
def noop():
  pass
  # CHECK-NEXT : kgen.return

# CHECK-LABEL: lit.struct.decl @EmptyStruct {
struct EmptyStruct:
  # No body
# CHECK-NEXT: }

# CHECK-LABEL: lit.struct.decl @OneLineStruct<size: !kgen.ref<@Int>> {
struct OneLineStruct[size: Int]: pass; pass
# CHECK-NEXT: }

# CHECK-LABEL: lit.struct.decl @Int {
struct Int:
  # CHECK-NEXT: %value = lit.var.decl "value" : <index>
  var value : index

  # CHECK-NEXT: lit.func @"Int::__init__"(%self: !pop.pointer<@Int>, %value_0: index) -> !lit.none
  # CHECK:      %value_1 = lit.var.decl "value" : <index>
  # CHECK:      pop.store %value_0, %value_1 : !pop.pointer<index>
  # CHECK:      %0 = pop.load %value_1 : !pop.pointer<index>
  # CHECK:      %1 = lit.struct.gep %self[value] : <index> from <@Int>
  # CHECK:      pop.store %0, %1 : !pop.pointer<index>
  # CHECK:      %2 = kgen.param.constant: !lit.none = <#lit.none>
  # CHECK-NEXT:  kgen.return %2
  # CHECK-NEXT: }
  def __init__(self: &Int, value: index) -> None:
    self.value = value
    return None

  # CHECK: lit.func @"Int::__add__"(%self: !pop.pointer<@Int>, %rhs: !kgen.ref<@Int>) -> !kgen.ref<@Int>
  def __add__(self, rhs: Int) -> Int:
    # CHECK: %rhs_0 = lit.var.decl "rhs" : <@Int>
    # CHECK: pop.store %rhs, %rhs_0
    # CHECK: %0 = lit.struct.gep %rhs_0[value]
    # CHECK: %1 = pop.load %rhs_0
    rhs.value      # TODO: Use this somehow. :)
    return rhs
  # CHECK: }
# CHECK: }

# CHECK-LABEL: lit.struct.decl @Pair<dt: !kgen.ref<@DType>> {
struct Pair[dt: DType]:
 # CHECK: %a = lit.var.decl "a" : <@SIMD<size = 42, dt: !kgen.ref<@DType> = dt>>
 # CHECK: %b = lit.var.decl "b" : <@Int>
  var a : SIMD[42, dt]
  var b : Int

  # CHECK: lit.func @"Pair::__init__"(%self: !pop.pointer<@Pair<dt: !kgen.ref<@DType> = dt>>)
  def __init__(self): pass
  # CHECK: }

# CHECK: }

# CHECK-LABEL:  lit.func @var_decls(%untyped: !kgen.ref<@object>)
def var_decls(untyped):
  # CHECK: %x = lit.var.decl "x" : <index>
  # CHECK: %y = lit.var.decl "y" : <@Int>
  # CHECK: %z = lit.var.decl "z" : <index>
  x = 123
  var y : Int
  y = y #+1
  # CHECK: [[TMP:%.*]] = pop.load %y : !pop.pointer<@Int>
  # CHECK: pop.store [[TMP]], %y : !pop.pointer<@Int>

  var z : index
  z = 42
  # CHECK: [[TMP:%.*]] = index.constant 42
  # CHECK: pop.store [[TMP]], %z


def patterns():
  (((z2))) = 42  # Paren patterns
  # CHECK: [[TMP:%.*]] = index.constant 42
  # CHECK: pop.store [[TMP]], %z2

# CHECK-LABEL: lit.struct.decl @SIMD<size, dt: !kgen.ref<@DType>> {
struct SIMD[size: index, dt: DType]:
  pass


struct DType:
  pass

def generic_fn[a: DType, b: index, c: type](d : index):

# CHECK: @call_generic<dt: !kgen.ref<@DType>>()
def call_generic[dt: DType]():
  # CHECK: %0 = index.constant 57
  # CHECK: kgen.call_param[(index) -> !lit.none: @generic_fn<a: !kgen.ref<@DType> = dt, b = 42, c: type = !kgen.ref<@DType>>](%0)
  generic_fn[dt, 42, DType](57)

  # CHECK: [[TMP:%.*]] = index.constant 57
  # CHECK: kgen.call_param[(index) -> !lit.none: @generic_fn<a: !kgen.ref<@DType> = dt, b = 13, c: type = !kgen.ref<@SIMD<size = 4, dt: !kgen.ref<@DType> = dt>>>]([[TMP]])
  generic_fn[dt, 13, SIMD[4, dt]](57)

@interface
#CHECK: kgen.generator.interface @func_interface0<type: !kgen.ref<@DType>>(index) -> index
def func_interface0[type: DType](x: index) -> index:

@interface
#CHECK: kgen.generator.interface @func_interface1<type: !kgen.ref<@DType>>(index) -> index
def func_interface1[type: DType](x: index) -> index: pass

@interface
#CHECK: kgen.generator.interface @func_interface2<type: !kgen.ref<@DType>>(index) -> index
def func_interface2[type: DType](x: index) -> index:
  ...
