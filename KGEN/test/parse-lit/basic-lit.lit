# RUN: kgen-translate -import-lit %s -verify-diagnostics | FileCheck %s

__include "../lit-examples/prolog.lit"

# CHECK: module {

# CHECK-LABEL: lit.func @paramArith<x>(%y: index) -> !lit.none {
fn paramArith[x: __mlir_type.index](y : __mlir_type.index):
  # CHECK: kgen.call @assertParam<condVal: i1 = eq(x, -99)>
  assertParam[x == -100+1]()

# CHECK-LABEL: kgen.struct.decl @OurSIMD<size, dt: !kgen.declref<@DType>> {
struct OurSIMD[size: __mlir_type.index, dt: DType]:
  pass

# CHECK-LABEL: lit.func @empty_def() -> !lit.none {
# CHECK: %0 = kgen.param.constant: !lit.none = <#lit.none>
# CHECK: kgen.return %0 : !lit.none
fn empty_def():
  # Pass isn't required.

fn take_3index(a: __mlir_type.index, b: __mlir_type.index, c: __mlir_type.index) -> __mlir_type.index:
  return a

# CHECK-LABEL: lit.func @fancy_signature
# CHECK-SAME: <dt: !kgen.declref<@DType>, size>
# CHECK-SAME: (%x: !kgen.declref<@OurSIMD<size = size, dt: !kgen.declref<@DType> = dt>>,
# CHECK-SAME:  %exp: !kgen.declref<@OurSIMD<size = size, dt: !kgen.declref<@DType> = dt>>) -> index {
fn fancy_signature[dt: DType, size: __mlir_type.index]
  (x: OurSIMD[size, dt], exp: (OurSIMD)[size, dt]) -> __mlir_type.index:

  # CHECK: %local = lit.var.decl "local" : <index>
  # CHECK: %[[TMP1:.*]] = kgen.param.constant = <size>
  # CHECK: %[[TMP2:.*]] = kgen.param.constant = <size>
  # CHECK: %[[TMP3:.*]] = kgen.param.constant = <size>
  # CHECK: %[[RES:.*]] = kgen.call @take_3index(%[[TMP1]], %[[TMP2]], %[[TMP3]]) : (index, index, index) -> index
  # CHECK: pop.store %[[RES]], %local : !pop.pointer<index>
  var local = take_3index(size, size, size)

  # CHECK: %[[TMP:.*]] = kgen.param.constant = <add(size, 42)>
  # CHECK: kgen.return %[[TMP]] : index
  return size+42

# CHECK-LABEL: lit.func @noop()
def noop():
  pass
  # CHECK-NEXT : kgen.return

# CHECK-LABEL: kgen.struct.decl @EmptyStruct {
struct EmptyStruct:
  # No body
# CHECK-NEXT: }

# CHECK-LABEL: kgen.struct.decl @OneLineStruct<size: !kgen.declref<@Int>> {
struct OneLineStruct[size: Int]: pass; pass
# CHECK-NEXT: }

# CHECK-LABEL: kgen.struct.decl @StructExample {
struct StructExample:
  fn __new__() -> StructExample:
    var result : StructExample
    return result

  # CHECK: lit.func @static(%x: !kgen.declref<@Int>) -> !lit.none attributes {isStatic} {
  @staticmethod
  fn static(x: Int):
    # CHECK: %idx4 = index.constant 4
    # CHECK: %0 = kgen.call @Int::@__new__(%idx4) : (index) -> !kgen.declref<@Int>
    # CHECK: %1 = kgen.call @StructExample::@static(%0) : (!kgen.declref<@Int>) -> !lit.none
    StructExample.static(Int(4))
    pass

  # CHECK: lit.func @mutatingMethod(%self: !pop.pointer<@StructExample>) -> !lit.none
  fn mutatingMethod(self&):

# CHECK: }
# CHECK-NEXT: }

# CHECK: lit.func @callStatic(%a: !kgen.declref<@Int>) -> !lit.none
fn callStatic(a: Int):
  # CHECK: kgen.call @StructExample::@static(%a)
  StructExample.static(a)

  # CHECK: kgen.call @StructExample::@__new__()
  # CHECK: kgen.call @StructExample::@static(%a) : (!kgen.declref<@Int>) -> !lit.none
  StructExample().static(a)

# CHECK-LABEL: lit.func @simpleMath
fn simpleMath(a: Int, b: Int) -> Int:
  # CHECK: %0 = kgen.call @Int::@__mul__(%b, %a)
  # CHECK: %1 = kgen.call @Int::@__add__(%a, %0)
  # CHECK: kgen.return %1 : !kgen.declref<@Int>
  return a+b*a


# CHECK-LABEL: kgen.struct.decl @Pair<dt: !kgen.declref<@DType>> {
struct Pair[dt: DType]:
 # CHECK: kgen.struct.field a : !kgen.declref<@OurSIMD<size = 42, dt: !kgen.declref<@DType> = dt>>
 # CHECK: kgen.struct.field b : !kgen.declref<@Int>
  var a : OurSIMD[42, dt]
  var b : Int

  # CHECK: lit.func @__new__() -> !kgen.declref<@Pair<dt: !kgen.declref<@DType> = dt>> attributes {isStatic}
  fn __new__() -> Pair[dt]:
    var result : Pair[dt]
    # TODO: Fill this in.
    return result
  # CHECK: }

# CHECK: }

# CHECK-LABEL:  lit.func @var_decls()
def var_decls():
  # CHECK: %x = lit.var.decl "x"
  x = 123
  # CHECK: %y = lit.var.decl "y"
  var y : Int
  y = y #+1
  # CHECK: [[TMP:%.*]] = pop.load %y : !pop.pointer<@Int>
  # CHECK: pop.store [[TMP]], %y : !pop.pointer<@Int>

  # CHECK: %z = lit.var.decl "z" : <index>
  # CHECK-NEXT: [[TMP:%.*]] = pop.load %x : !pop.pointer<index>
  # CHECK-NEXT: pop.store [[TMP]], %z
  var z = x
  z = 42
  # CHECK-NEXT: [[TMP:%.*]] = index.constant 42
  # CHECK-NEXT: pop.store [[TMP]], %z


# CHECK-LABEL: lit.func @patterns()
def patterns():
  # CHECK: %z2 = lit.var.decl "z2" : <index>

  (((z2))) = 42  # Paren patterns
  # CHECK: [[TMP:%.*]] = index.constant 42
  # CHECK: pop.store [[TMP]], %z2

  var someInt : Int
  (someInt) += someInt
  # CHECK: %someInt = lit.var.decl "someInt" : <@Int>
  # CHECK:  %0 = pop.load %someInt : !pop.pointer<@Int>
  # CHECK:  %1 = kgen.call @Int::@__iadd__(%someInt, %0)

  # Discard pattern with different types.
  (_) = someInt
  # CHECK: %_ = lit.var.decl "_" : <@Int>
  # CHECK: pop.store {{.*}}, %_ : !pop.pointer<@Int>

  (_) = 1.0
  # CHECK: %__0 = lit.var.decl "_" : <f64>
  # CHECK: pop.store {{.*}}, %__0 : !pop.pointer<f64>


fn generic_fn[a: DType, b: __mlir_type.index, c: __mlir_type.`!kgen.mlirtype`](d : __mlir_type.index):

# CHECK: @call_generic<dt: !kgen.declref<@DType>>()
fn call_generic[dt: DType]():
  # CHECK: %idx57 = index.constant 57
  # CHECK: kgen.call @generic_fn<a: !kgen.declref<@DType> = dt, b = 42, c: type = !kgen.declref<@DType>>(%idx57)
  generic_fn[dt, 42, DType](57)

  # CHECK: [[TMP:%.*]] = index.constant 57
  # CHECK: kgen.call @generic_fn<a: !kgen.declref<@DType> = dt, b = 13, c: type = !kgen.declref<@OurSIMD<size = 4, dt: !kgen.declref<@DType> = dt>>>([[TMP]])
  generic_fn[dt, 13, OurSIMD[4, dt]](57)

@interface
#CHECK: lit.func @func_interface0<type: !kgen.declref<@DType>>(%x: index) -> index attributes {isInterface} {
fn func_interface0[type: DType](x: __mlir_type.index) -> __mlir_type.index:

@interface
#CHECK: lit.func @func_interface1<type: !kgen.declref<@DType>>(%x: index) -> index attributes {isInterface} {
fn func_interface1[type: DType](x: __mlir_type.index) -> __mlir_type.index: pass

@interface
#CHECK: lit.func @func_interface2<type: !kgen.declref<@DType>>(%x: index) -> index attributes {isInterface} {
fn func_interface2[type: DType](x: __mlir_type.index) -> __mlir_type.index:
  ...

@implements(func_interface2)
#CHECK: lit.func @func_impl<type: !kgen.declref<@DType>>(%x: index) -> index
#CHECK:    implements @func_interface2 {
fn func_impl[type: DType](x: __mlir_type.index) -> __mlir_type.index:
  return x

# CHECK: lit.func @byval_byref_function(%a: !kgen.declref<@Int>, %b: !pop.pointer<@Int>) -> !lit.none
fn byval_byref_function(a: Int, b&: Int):
  # CHECK-NEXT: pop.store %a, %b
  b = a

  # CHECK-NEXT: %x = lit.var.decl "x"
  var x : Int
  # This needs to load 'b' to pass it by value for the first arg, but pass its
  # address in directly for the second.
  # CHECK: %0 = pop.load %b : !pop.pointer<@Int>
  # CHECK: %1 = kgen.call @byval_byref_function(%0, %b)
  byval_byref_function(b, b)

# CHECK: lit.func @lvaluesAndRValues()
fn lvaluesAndRValues() -> __mlir_type.index:
  # CHECK: [[FOUR:%.*]] = index.constant 4
  # CHECK: [[INT:%.*]] = kgen.call @Int::@__new__([[FOUR]])
  # CHECK: [[VALUE:%.*]] = kgen.struct.extract [[INT]][value] : index from
  # CHECK: kgen.return [[VALUE]] : index
  return Int(4).value

# CHECK: lit.func @defTests({{.*}}, %untyped: !kgen.declref<@object>)
def defTests(a: Int, b: Int, untyped):
  # CHECK: [[TMP:%.*]] = pop.load %b_1
  # CHECK-NEXT: pop.store [[TMP]], %a_0
  a = b # Parameters are mutable!

# CHECK: lit.func @mlirMagicTest(%x: bf16, %y: f8E5M2)
fn mlirMagicTest(x: __mlir_type.bf16, y: __mlir_type.f8E5M2) -> __mlir_type.index:
  # CHECK: kgen.param.declare a = <1>
  alias a : __mlir_type.index = 1
  # CHECK: %b = lit.var.decl "b" : <f64>
  var b : __mlir_type.f64
  # CHECK: %c = lit.var.decl "c" : <pointer<pointer<f32>>>
  var c : __mlir_type.`!pop.pointer<!pop.pointer<f32>>`

  # CHECK: %d = lit.var.decl "d" : <i17>
  # CHECK: [[TMP:%.*]] = kgen.param.constant: i17 = <4>
  # CHECK: pop.store [[TMP]], %d : !pop.pointer<i17>
  var d = __mlir_attr.`4: i17`

  # CHECK: %dt = lit.var.decl "dt" : <dtype>
  # CHECK: [[TMP:%.*]] = kgen.param.constant: dtype = <f32>
  # CHECK: pop.store [[TMP]], %dt  : !pop.pointer<dtype>
  var dt = __mlir_attr.`#kgen.dtype.constant<f32> : !kgen.dtype `

  # CHECK: %idxConstant = lit.var.decl
  # CHECK-NEXT: index.constant 42
  var idxConstant = __mlir_op.`index.constant`[value: 42]()

  # CHECK: [[TMP:%.*]] = pop.load %idxConstant
  # CHECK: [[TMP2:%.*]] = index.castu [[TMP:%.*]] : index to i1
  var i1Cast = __mlir_op.`index.castu`[_type: __mlir_type.i1](idxConstant)

  # CHECK: kgen.param.declare new_lower = <max(a, 42)>
  alias new_lower = __mlir_attr.`#kgen.param.expr<max, #lit.placeholder : index, #lit.placeholder : index> : index`[a, 42]

  # CHECK: [[TMP1:%.*]] = kgen.param.constant = <new_lower>
  # CHECK: [[TMP2:%.*]] = index.constant 1
  # CHECK: [[SHRU:%.*]] = index.shru [[TMP1]], [[TMP2]]
  # CHECK: kgen.return [[SHRU]] : index
  return __mlir_op.`index.shru`(new_lower, 1)

# CHECK-LABEL: lit.func @mlirTypesAndAttrs
fn mlirTypesAndAttrs[dtype: __mlir_type.`!kgen.dtype`] ():
  # CHECK: %a = lit.var.decl "a" : <scalar<dtype>>
  var a : __mlir_type.`!pop.scalar<#lit.placeholder : !kgen.dtype>`[dtype]
  # CHECK: %b = lit.var.decl "b" : <simd<4, dtype>>
  var b : __mlir_type.`!pop.simd<#lit.placeholder: index, #lit.placeholder : !kgen.dtype>`[4, dtype]


# CHECK-LABEL: lit.func @testSIMD(
fn testSIMD(a: SIMD[1, __mlir_attr.`#kgen.dtype.constant<f64> : !kgen.dtype`],
            b: SIMD[1, __mlir_attr.`#kgen.dtype.constant<si32> : !kgen.dtype`],
            ref&: SIMD[1, __mlir_attr.`#kgen.dtype.constant<si32> : !kgen.dtype`]):
  # CHECK: %field1 = lit.var.decl "field1" : <scalar<f64>>
  var field1 = a.value
  # CHECK: %field2 = lit.var.decl "field2" : <scalar<si32>>
  var field2 = ref.value

  # Test calls to methods and operators on parameterized type.
  a.fma(a, a)
  b.fma(b, b)
  # CHECK: kgen.call @SIMD::@__add__<size = 1, type: dtype = f64>(%a, %a)
  var x = a+a
  # CHECK: kgen.call @SIMD::@__add__<size = 1, type: dtype = si32>(%b, %b)
  var y = b+b

# CHECK-LABEL: kgen.struct.decl @TestParamStruct<A>
struct TestParamStruct[A: __mlir_type.index]:
  fn __new__() -> TestParamStruct[A]:
    var result: TestParamStruct[A]
    return result

  # CHECK: lit.func @method<B>(%self: !kgen.declref<@TestParamStruct<A = A>>, %other: !kgen.declref<@TestParamStruct<A = add(A, B)>>) -> !lit.none {
  fn method[B: __mlir_type.index](self: TestParamStruct[A], other: TestParamStruct[A+B]):
    pass

  # CHECK-LABEL: lit.func @aliases{{.*}}%x: !kgen.declref<@TestParamStruct<A = TypeLevelAlias>>
  fn aliases(self, x: TestParamStruct[TypeLevelAlias]):
    # CHECK: kgen.param.declare B = <add(mul(A, A), 1)>
    alias B = A*A+1
    # CHECK: kgen.param.declare C = <mul(A, B)>
    alias C = B*A
    # CHECK: %temp = lit.var.decl "temp" : <@TestParamStruct<A = C>>
    var temp: TestParamStruct[C]

  # CHECK: kgen.param.declare TypeLevelAlias = <mul(A, A)>
  alias TypeLevelAlias = A*A

# Test that we support partially bound parameters.
fn testTestParamStruct(a: TestParamStruct[4]):
  # CHECK: %arg11 = lit.var.decl "arg11" : <@TestParamStruct<A = 11>>
  # CHECK: %0 = kgen.call @TestParamStruct::@__new__<A = 11>() : () -> !kgen.declref<@TestParamStruct<A = 11>>
  # CHECK: pop.store %0, %arg11 : !pop.pointer<@TestParamStruct<A = 11>>
  var arg11 = TestParamStruct[11]()

  # CHECK: %1 = pop.load %arg11 : !pop.pointer<@TestParamStruct<A = 11>>
  # CHECK: %2 = kgen.call @TestParamStruct::@method<A = 4, B = 7>(%a, %1) : (!kgen.declref<@TestParamStruct<A = 4>>, !kgen.declref<@TestParamStruct<A = 11>>) -> !lit.none
  a.method[7](arg11)


# CHECK-LABEL: lit.func @testPointerArgs(%ptr: !pop.pointer<si32>) -> si32 {
fn testPointerArgs(ptr: __mlir_type.`!pop.pointer<si32>`) -> __mlir_type.si32:
  # CHECK-NEXT: %0 = pop.load %ptr : !pop.pointer<si32>
  return __mlir_op.`pop.load`[_type: __mlir_type.si32](ptr)
