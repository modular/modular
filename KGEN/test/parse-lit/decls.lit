# RUN: kgen-translate %s -import-lit -I %stdlibdir -I %S/../lit-examples/ | FileCheck %s

from prolog import Error, F32, Int


##===----------------------------------------------------------------------===##
# let
##===----------------------------------------------------------------------===##

# CHECK-LABEL:  lit.func @"let_decls()
def let_decls():
  # CHECK: %x = lit.let.decl "x" = %idx123 : index
  let x = 123
  # CHECK: %0 = kgen.param.constant: f64 = <1.000000e+00>
  # CHECK: %y = lit.let.decl "y" = %0 : f64
  let y = 1.0

  # CHECK: [[TMP:%.*]] = pop.cast_from_builtin %x : index to !pop.scalar<index>
  # CHECK: [[TMP2:%.*]] = kgen.struct.create([[TMP]])
  # CHECK: %z = lit.let.decl "z" = [[TMP2]]
  let z = Int(x)

##===----------------------------------------------------------------------===##
# var
##===----------------------------------------------------------------------===##

# CHECK-LABEL:  lit.func @"var_decls()
def var_decls():
  # Implicit declaration is mutable.
  # CHECK: %x = lit.var.decl "x"
  x = 123
  # CHECK: %y = lit.var.decl "y"
  var y : Int

  # CHECK: [[Y:%.*]] = pop.load %y : !pop.pointer<@"$Int"::@Int>
  # CHECK: kgen.param.constant: !pop.scalar<index> = <#pop.simd<1>>
  # CHECK: [[ONE:%.*]] = kgen.struct.create(
  # CHECK: [[ADD:%.*]] = kgen.call @"$Int"::@Int::@"__add__($Int::Int,$Int::Int)"([[Y]], [[ONE]])
  # CHECK: pop.store [[ADD]], %y : !pop.pointer<@"$Int"::@Int>
  y = y + 1

  # CHECK: kgen.param.constant: string = <"hello">
  let const_str = "hello"

  # CHECK: %str = lit.var.decl "str" : <!kgen.string>
  # CHECK: [[CONST:%.*]] = kgen.param.constant: string = <"hello">
  # CHECK: pop.store [[CONST]], %str : !pop.pointer<!kgen.string>
  var str = "hello"

  # CHECK: %z = lit.var.decl "z" : <index>
  # CHECK-NEXT: [[TMP:%.*]] = pop.load %x : !pop.pointer<index>
  # CHECK-NEXT: pop.store [[TMP]], %z
  var z = x
  z = 42
  # CHECK-NEXT: [[TMP:%.*]] = index.constant 42
  # CHECK-NEXT: pop.store [[TMP]], %z

##===----------------------------------------------------------------------===##
# fn/def
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"empty_def()"() -> !lit.none {
# CHECK-NEXT: lit.end_func
fn empty_def():
  # Pass isn't required.

# Method overloading.
# CHECK-LABEL: lit.func @"testThing($Int::Int)"
fn testThing(a: Int) -> F32: return 1.0
# CHECK-LABEL: lit.func @"testThing($Int::Int,$Int::Int)"
fn testThing(a: Int, b: Int) -> Int: return 1

# CHECK-LABEL: lit.func @"callOverload
fn callOverload(a: Int):
  # CHECK: %0 = kgen.call @"$decls"::@"testThing($Int::Int)"(%a)
  testThing(a)
  # CHECK:  %1 = kgen.call @"$decls"::@"testThing($Int::Int,$Int::Int)"(%a, %a)
  testThing(a, a)

# Test that pointers don't get confused with by-ref arguments.
# CHECK-LABEL: lit.func @"testPointerArgs{{.*}}(%ptr: !pop.pointer<si32>) -> si32 {
fn testPointerArgs(ptr: __mlir_type.`!pop.pointer<si32>`) -> __mlir_type.si32:
  # CHECK-NEXT: %0 = pop.load %ptr : !pop.pointer<si32>
  return __mlir_op.`pop.load`[_type: __mlir_type.si32](ptr)


struct NoDebugInlineTest:
  # Two decorators stacked up
  @nodebug_inline
  @staticmethod
  fn test():
    return


# CHECK-LABEL: lit.func @"math{{.*}} attributes {noDebugInline}
@nodebug_inline
fn math(a: __mlir_type.index, b: __mlir_type.index) -> __mlir_type.index:
  return __mlir_op.`index.add`(a, b)

# CHECK-LABEL: lit.func @"useIt
fn useIt(a: __mlir_type.index) -> __mlir_type.index:
  # CHECK: %0 = kgen.param.constant = <3>
  # CHECK: %1 = index.add %a, %0
  # CHECK: lit.return %1 : index
  return math(a, math(1, 2))

# CHECK: lit.func @"pleaseInline()"() force_inline -> index {
@always_inline
fn pleaseInline() -> __mlir_type.index:
  return 1

##===----------------------------------------------------------------------===##
# Default arguments.
##===----------------------------------------------------------------------===##

# CHECK: lit.func @"defaultArgument{{.*}}{defaults = #lit<default.arguments[<1 : index = #kgen.param.expr<apply, #kgen.symbol.constant<@"$Int"::@Int::@"__new__(__mlir_type.index)" > : !kgen.signature<[], [],  (index) -> !kgen.declref<@"$Int"::@Int>>, 42 : index> : !kgen.declref<@"$Int"::@Int>>]>}
fn defaultArgument(a: Int, b: Int = 42) -> Int:
  return a + b

# CHECK: lit.func @"defaultArgumentReferencesParameter{{.*}}{defaults = #lit<default.arguments[<0 : index = #kgen.param.expr<apply, #kgen.symbol.constant<@"$Int"::@Int::@"__add__($Int::Int,$Int::Int)" > : !kgen.signature<[], [],  (!kgen.declref<@"$Int"::@Int>, !kgen.declref<@"$Int"::@Int>) -> !kgen.declref<@"$Int"::@Int>>, #kgen.param.decl.ref<"p"> : !kgen.declref<@"$Int"::@Int>, #kgen.param.expr<apply, #kgen.symbol.constant<@"$Int"::@Int::@"__new__(__mlir_type.index)" > : !kgen.signature<[], [],  (index) -> !kgen.declref<@"$Int"::@Int>>, 87 : index> : !kgen.declref<@"$Int"::@Int>> : !kgen.declref<@"$Int"::@Int>>]>
fn defaultArgumentReferencesParameter[p: Int](a: Int = p + 87) -> Int:
  return a

##===----------------------------------------------------------------------===##
# @raises decorator.
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"defAlwaysRaises()"() throws -> !kgen.declref<@"$Int"::@Int> attributes {isDef}
def defAlwaysRaises() -> Int:
    # CHECK: %[[RESULT:.*]] = kgen.struct.create(%{{.*}})
    # CHECK-NEXT: lit.return %[[RESULT]] : !kgen.declref<@"$Int"::@Int>
    return Int(0)

# CHECK-LABEL: lit.func @"fnThatRaises()"() throws -> !kgen.declref<@"$Int"::@Int>
@raises
fn fnThatRaises() -> Int:
    # CHECK: %[[RESULT:.*]] = kgen.struct.create(%{{.*}})
    # CHECK-NEXT: lit.return %[[RESULT]] : !kgen.declref<@"$Int"::@Int>
    return Int(0)

# CHECK-LABEL: lit.func @"raisesReturnsNone()"() throws -> !lit.none
@raises
fn raisesReturnsNone():
    # CHECK-NEXT: lit.end_func
    pass

# COM: We can return an variant of error and index in a non-throwing function.
# CHECK-LABEL: lit.func @"raisesReturnsVariant()"() -> !pop.variant<@"$prolog"::@Error, index>
fn raisesReturnsVariant() -> __mlir_type.`!pop.variant<@"$prolog"::@Error, index>`:
    return __mlir_op.`pop.variant.create`[_type: __mlir_type.`!pop.variant<@"$prolog"::@Error, index>`](1)

# CHECK-LABEL: lit.func @"return_impl_convert_raises
@raises
fn return_impl_convert_raises(a: Error) -> Error:
  # CHECK-NEXT: lit.return %a
  return a

##===----------------------------------------------------------------------===##
# Structs
##===----------------------------------------------------------------------===##

# CHECK-LABEL: kgen.struct.decl @EmptyStruct {
struct EmptyStruct:
  # No body
# CHECK-NEXT: }

# CHECK-LABEL: kgen.struct.decl @OneLineStruct<size: !kgen.declref<@"$Int"::@Int>> {
struct OneLineStruct[size: Int]: pass; pass
# CHECK-NEXT: }

# CHECK-LABEL: kgen.struct.decl @StructExample {
struct StructExample:
  fn __new__() -> StructExample:
    var result : StructExample
    return result

  # CHECK: lit.func @"static($Int::Int)"(%x: !kgen.declref<@"$Int"::@Int>) -> !lit.none attributes {isStatic} {
  @staticmethod
  fn static(x: Int):
    # CHECK: %0 = kgen.param.constant: !pop.scalar<index> = <#pop.simd<4>>
    # CHECK: %1 = kgen.struct.create(%0) : (!pop.scalar<index>) -> !kgen.declref<@"$Int"::@Int>
    # CHECK: %2 = kgen.call @"$decls"::@StructExample::@"static{{.*}}"(%1) : (!kgen.declref<@"$Int"::@Int>) -> !lit.none
    StructExample.static(Int(4))
    pass

  # CHECK: lit.func @"mutatingMethod($decls::StructExample&)"(%self: !pop.pointer<@"$decls"::@StructExample> byref) -> !lit.none
  fn mutatingMethod(self&):

# CHECK: }
# CHECK-NEXT: }

# CHECK: lit.func @"callStatic{{.*}}(%a: !kgen.declref<@"$Int"::@Int>) -> !lit.none
fn callStatic(a: Int):
  # CHECK: kgen.call @"$decls"::@StructExample::@"static{{.*}}(%a)
  StructExample.static(a)

  # CHECK: kgen.call @"$decls"::@StructExample::@"__new__{{.*}}()
  # CHECK: kgen.call @"$decls"::@StructExample::@"static{{.*}}(%a) : (!kgen.declref<@"$Int"::@Int>) -> !lit.none
  StructExample().static(a)

# CHECK-LABEL: lit.func @"coroutine()"() async -> index
async fn coroutine() -> __mlir_type.index:
  # CHECK: lit.return %idx0 : index
  return 0

# CHECK-LABEL: kgen.struct.decl @StructWithAsync
struct StructWithAsync:
  # CHECK-LABEL: lit.func @"do_something{{.*}}"({{.*}}) async -> !lit.none
  async fn do_something(self: StructWithAsync):
    # CHECK-NEXT: %[[CORO:.*]] = lit.async_call[<>() async -> index: @"$decls"::@"coroutine()"]()
    # CHECK-NEXT: lit.let.decl "a" = %[[CORO]] : !pop.coroutine<() -> index>
    let a = coroutine()

# CHECK-LABEL: lit.func @"call_struct_async{{.*}}"({{.*}}) async -> !lit.none
async fn call_struct_async(f: StructWithAsync):
    # CHECK-NEXT: lit.async_call[<>({{.*}}) async -> !lit.none: @{{.*}}](%f)
    f.do_something()

# CHECK-LABEL: lit.func @"await_coroutine()"
async fn await_coroutine():
  # CHECK-NEXT: %[[CORO:.*]] = lit.async_call[<>() async -> index: @{{.*}}]()
  # CHECK-NEXT: %[[RESULT:.*]] = lit.async_await %[[CORO]] : <() -> index>
  # CHECK-NEXT: lit.let.decl "a" = %[[RESULT]] : index
  let a = await coroutine()
