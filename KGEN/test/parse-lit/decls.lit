# RUN: kgen-translate %s -import-lit -I %S/../lit-examples/ | FileCheck %s

from prolog import Error, F32, Int


##===----------------------------------------------------------------------===##
# let
##===----------------------------------------------------------------------===##

# CHECK-LABEL:  lit.func @"let_decls()
def let_decls():
  # CHECK: %x = lit.let.decl "x" = %idx123 : index
  let x = 123
  # CHECK: %0 = kgen.param.constant: f64 = <1.000000e+00>
  # CHECK: %y = lit.let.decl "y" = %0 : f64
  let y = 1.0

  # CHECK: [[TMP:%.*]] = kgen.call @"$Int"::@Int::@"__new__{{.*}}(%x)
  # CHECK: %z = lit.let.decl "z" = [[TMP]]
  let z = Int(x)

##===----------------------------------------------------------------------===##
# var
##===----------------------------------------------------------------------===##

# CHECK-LABEL:  lit.func @"var_decls()
def var_decls():
  # Implicit declaration is mutable.
  # CHECK: %x = lit.var.decl "x"
  x = 123
  # CHECK: %y = lit.var.decl "y"
  var y : Int

  # CHECK: [[Y:%.*]] = pop.load %y : !pop.pointer<@"$Int"::@Int>
  # CHECK: [[ONE:%.*]] = kgen.param.constant: @"$Int"::@Int {{.*}} 1
  # CHECK: [[ADD:%.*]] = kgen.call @"$Int"::@Int::@"__add__($Int::Int,$Int::Int)"([[Y]], [[ONE]])
  # CHECK: pop.store [[ADD]], %y : !pop.pointer<@"$Int"::@Int>
  y = y + 1

  # CHECK: kgen.param.constant: string = <"hello">
  let const_str = "hello"

  # CHECK: %str = lit.var.decl "str" : <!kgen.string>
  # CHECK: [[CONST:%.*]] = kgen.param.constant: string = <"hello">
  # CHECK: pop.store [[CONST]], %str : !pop.pointer<!kgen.string>
  var str = "hello"

  # CHECK: %z = lit.var.decl "z" : <index>
  # CHECK-NEXT: [[TMP:%.*]] = pop.load %x : !pop.pointer<index>
  # CHECK-NEXT: pop.store [[TMP]], %z
  var z = x
  z = 42
  # CHECK-NEXT: [[TMP:%.*]] = index.constant 42
  # CHECK-NEXT: pop.store [[TMP]], %z

##===----------------------------------------------------------------------===##
# fn/def
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"empty_def()"() -> !lit.none {
# CHECK-NEXT: lit.end_func
fn empty_def():
  # Pass isn't required.

# Method overloading.
# CHECK-LABEL: lit.func @"testThing($Int::Int)"
fn testThing(a: Int) -> F32: return 1.0
# CHECK-LABEL: lit.func @"testThing($Int::Int,$Int::Int)"
fn testThing(a: Int, b: Int) -> Int: return 1

# CHECK-LABEL: lit.func @"callOverload
fn callOverload(a: Int):
  # CHECK: %0 = kgen.call @"$decls"::@"testThing($Int::Int)"(%a)
  _ = testThing(a)
  # CHECK:  %1 = kgen.call @"$decls"::@"testThing($Int::Int,$Int::Int)"(%a, %a)
  _ = testThing(a, a)

# Test that pointers don't get confused with by-ref arguments.
# CHECK-LABEL: lit.func @"testPointerArgs{{.*}}(%ptr: !pop.pointer<si32>) -> si32 {
fn testPointerArgs(ptr: __mlir_type.`!pop.pointer<si32>`) -> __mlir_type.si32:
  # CHECK-NEXT: %0 = pop.load %ptr : !pop.pointer<si32>
  return __mlir_op.`pop.load`[_type: __mlir_type.si32](ptr)


struct NoDebugInlineTest:
  # Two decorators stacked up
  @nodebug_inline
  @staticmethod
  fn test():
    return

# CHECK-LABEL: lit.func @"testAlwaysInlineNoDebug
# CHECK-SAME: always_inline_no_debug {
@always_inline("nodebug")
fn testAlwaysInlineNoDebug():

# CHECK-LABEL: lit.func @"math{{.*}} attributes {noDebugInline}
@nodebug_inline
fn math(a: __mlir_type.index, b: __mlir_type.index) -> __mlir_type.index:
  return __mlir_op.`index.add`(a, b)

# CHECK-LABEL: lit.func @"useIt
fn useIt(a: __mlir_type.index) -> __mlir_type.index:
  # CHECK: %0 = kgen.param.constant = <3>
  # CHECK: %1 = index.add %a, %0
  # CHECK: lit.return %1 : index
  return math(a, math(1, 2))

@nodebug_inline
fn returnParameter[a: __mlir_type.index]() -> __mlir_type.index:
  return a

# CHECK-LABEL: lit.func @"callReturnParam
fn callReturnParam() -> __mlir_type.index:
  # CHECK-NEXT: %idx3 = index.constant 3
  # CHECK-NEXT: return %idx3
  return returnParameter[3]()

# CHECK: lit.func @"pleaseInline()"() -> index always_inline {
@always_inline
fn pleaseInline() -> __mlir_type.index:
  return 1

##===----------------------------------------------------------------------===##
# Default arguments and variadics.
##===----------------------------------------------------------------------===##

# CHECK: lit.func @"defaultArgument{{.*}}{defaults =
# CHECK-SAME: #lit<default.arguments[<1 : index =
# CHECK-SAME: #lit.struct<{value: scalar<index> = 42}> :
# CHECK-SAME: !kgen.declref<@"$Int"::@Int>>]>}
fn defaultArgument(a: Int, b: Int = 42) -> Int:
  return a + b

# CHECK: lit.func @"defaultArgumentReferencesParameter{{.*}}{defaults = #lit<default.arguments[<0 : index = #kgen.param.expr<apply, #kgen.symbol.constant<@"$Int"::@Int::@"__add__($Int::Int,$Int::Int)" > : !kgen.signature<(!kgen.declref<@"$Int"::@Int>, !kgen.declref<@"$Int"::@Int>) -> !kgen.declref<@"$Int"::@Int>>, #kgen.param.decl.ref<"p"> : !kgen.declref<@"$Int"::@Int>, #lit.struct<{value: scalar<index> = 87}> : !kgen.declref<@"$Int"::@Int>> : !kgen.declref<@"$Int"::@Int>>]>}
fn defaultArgumentReferencesParameter[p: Int](a: Int = p + 87) -> Int:
  return a

struct VaList[EltType: __mlir_type.`!kgen.mlirtype`]:
  alias StorageType =  __mlir_type[`!pop.variadic<`, EltType, `>`]
  var value: StorageType
  fn __new__(value: StorageType) -> VaList[EltType]:
    return VaList[EltType]{value: value}

  fn size(self) -> __mlir_type.index:
    return __mlir_op.`pop.variadic.size`(self.value)

  fn __getitem__(self, index: Int) -> EltType:
    # TODO: Should assert the index is in-range.
    return __mlir_op.`pop.variadic.get`(self.value, index.__as_mlir_index())


# CHECK: lit.func @"variadics($Int::Int*)"(%a: !pop.variadic<@"$Int"::@Int> vararg)
fn variadics(*a: Int):
  let vaArgs = VaList[Int](a)
  let size = vaArgs.size()
  let elt0 = vaArgs.__getitem__(0)
  let elt1 = vaArgs.__getitem__(1)

# CHECK: lit.func @"callVariadic
fn callVariadic[p: Int](x: Int):
  # CHECK: %0 = kgen.param.constant: !pop.variadic<@"$Int"::@Int> = <#pop.variadic<>>
  # CHECK: %1 = kgen.call @"$decls"::@"variadics($Int::Int*)"(%0)
  variadics()
  # CHECK: %2 = kgen.param.constant: !pop.variadic<@"$Int"::@Int> = <#pop.variadic<{{.*}}7{{.*}}11{{.*}}13{{.*}}>>
  # CHECK: %3 = kgen.call @"$decls"::@"variadics($Int::Int*)"(%2)
  variadics(7, 11, 13)
  # CHECK: %4 = pop.variadic.create [%x]
  # CHECK: %5 = kgen.call @"$decls"::@"variadics($Int::Int*)"(%4)
  variadics(x)
  # CHECK: %6 = kgen.param.constant: @"$Int
  # CHECK: %7 = pop.variadic.create [%x, %6]
  # CHECK: %8 = kgen.call @"$decls"::@"variadics($Int::Int*)"(%7)
  variadics(x, 1)

  # CHECK: @"variadics($Int::Int*)", #pop.variadic<>
  alias EmptyVariadic = variadics()
  # CHECK: @"variadics($Int::Int*)", #pop.variadic<p, {{.*}}scalar<index> = 1{{.*}}>
  alias NonEmptyVariadic = variadics(p, 1)

##===----------------------------------------------------------------------===##
# @raises decorator.
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"defAlwaysRaises()"() throws -> !kgen.declref<@"$Int"::@Int> attributes {isDef}
def defAlwaysRaises() -> Int:
    # CHECK: %[[RESULT:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 0}>
    # CHECK-NEXT: lit.return %[[RESULT]] : !kgen.declref<@"$Int"::@Int>
    return Int(0)

# CHECK-LABEL: lit.func @"fnThatRaises()"() throws -> !kgen.declref<@"$Int"::@Int>
@raises
fn fnThatRaises() -> Int:
    # CHECK: %[[RESULT:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 0}>
    # CHECK-NEXT: lit.return %[[RESULT]] : !kgen.declref<@"$Int"::@Int>
    return Int(0)

# CHECK-LABEL: lit.func @"raisesReturnsNone()"() throws -> !lit.none
@raises
fn raisesReturnsNone():
    # CHECK-NEXT: lit.end_func
    pass

# COM: We can return an variant of error and index in a non-throwing function.
# CHECK-LABEL: lit.func @"raisesReturnsVariant()"() -> !pop.variant<@"$prolog"::@Error, index>
fn raisesReturnsVariant() -> __mlir_type.`!pop.variant<@"$prolog"::@Error, index>`:
    return __mlir_op.`pop.variant.create`[_type: __mlir_type.`!pop.variant<@"$prolog"::@Error, index>`](1)

# CHECK-LABEL: lit.func @"return_impl_convert_raises
@raises
fn return_impl_convert_raises(a: Error) -> Error:
  # CHECK-NEXT: lit.return %a
  return a

##===----------------------------------------------------------------------===##
# Structs
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.struct.decl @EmptyStruct {
struct EmptyStruct:
  # No body
# CHECK-NEXT: }

# CHECK-LABEL: lit.struct.decl @OneLineStruct<size: @"$Int"::@Int> {
struct OneLineStruct[size: Int]: pass; pass
# CHECK-NEXT: }

# CHECK-LABEL: lit.struct.decl @StructExample {
struct StructExample:
  fn __new__() -> StructExample:
    var result : StructExample
    return result

  # CHECK: lit.func @"static($Int::Int)"(%x: !kgen.declref<@"$Int"::@Int>) -> !lit.none attributes {isStatic} {
  @staticmethod
  fn static(x: Int):
    # CHECK: %0 = {{.*}}#lit.struct<{value: scalar<index> = 4}>
    # CHECK: %1 = kgen.call @"$decls"::@StructExample::@"static{{.*}}"(%0) : (!kgen.declref<@"$Int"::@Int>) -> !lit.none
    StructExample.static(Int(4))
    pass

  # CHECK: lit.func @"mutatingMethod($decls::StructExample&)"(%self: !pop.pointer<@"$decls"::@StructExample> byref) -> !lit.none
  fn mutatingMethod(self&):

# CHECK: }
# CHECK-NEXT: }

# CHECK: lit.func @"callStatic{{.*}}(%a: !kgen.declref<@"$Int"::@Int>) -> !lit.none
fn callStatic(a: Int):
  # CHECK: kgen.call @"$decls"::@StructExample::@"static{{.*}}(%a)
  StructExample.static(a)

  # CHECK: kgen.call @"$decls"::@StructExample::@"__new__{{.*}}()
  # CHECK: kgen.call @"$decls"::@StructExample::@"static{{.*}}(%a) : (!kgen.declref<@"$Int"::@Int>) -> !lit.none
  StructExample().static(a)

##===----------------------------------------------------------------------===##
# async/await
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"coroutine()"() async -> index
async fn coroutine() -> __mlir_type.index:
  # CHECK: lit.return %idx0 : index
  return 0

# CHECK-LABEL: lit.struct.decl @StructWithAsync
struct StructWithAsync:
  # CHECK-LABEL: lit.func @"do_something{{.*}}"({{.*}}) async -> !lit.none
  async fn do_something(self: StructWithAsync):
    # CHECK-NEXT: %[[CORO:.*]] = lit.async_call[<>() async -> index: @"$decls"::@"coroutine()"]()
    # CHECK-NEXT: lit.let.decl "a" = %[[CORO]] : !pop.coroutine<() -> index>
    let a = coroutine()

# CHECK-LABEL: lit.func @"call_struct_async{{.*}}"({{.*}}) async -> !lit.none
async fn call_struct_async(f: StructWithAsync):
    # CHECK-NEXT: lit.async_call[<>({{.*}}) async -> !lit.none: @{{.*}}](%f)
    f.do_something()

struct Awaitable:
  fn __new__() -> Awaitable:
    return Awaitable{}

  fn __await__(self&) -> __mlir_type.index:
    return 0

# CHECK-LABEL: lit.func @"awaitable()"
async fn awaitable() -> __mlir_type.index:
  # CHECK: call @"$decls"::@Awaitable::@"__await__($decls::Awaitable&)"(%aw)
  var aw = Awaitable()
  return await aw

##===----------------------------------------------------------------------===##
# Nested Functions
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"topLevelFunction()"
fn topLevelFunction() -> __mlir_type.index:
  var a = 0
  # CHECK: lit.func @"nestedFunction()"
  fn nestedFunction() -> __mlir_type.index:
    # CHECK-NEXT: pop.load %a
    return a
  # CHECK: declare b: () -> index = <@"$decls"::@"topLevelFunction()"::@"nestedFunction()">
  alias b = nestedFunction
  # CHECK: call @"$decls"::@"topLevelFunction()"::@"nestedFunction()"()
  return nestedFunction()

# CHECK-LABEL: lit.struct.decl @SomeStruct
struct SomeStruct:
  # CHECK-LABEL: @"someMethod({{.*}})"
  fn someMethod(self) -> __mlir_type.index:
    var a = 0
    # CHECK: lit.func @"nestedFunction()"
    fn nestedFunction() -> __mlir_type.index:
      # CHECK-NEXT: pop.load %a
      return a
    # CHECK: declare b: () -> index = <@"$decls"::@SomeStruct::@"someMethod({{.*}})"::@"nestedFunction()">
    alias b = nestedFunction
    # CHECK: call @"$decls"::@SomeStruct::@"someMethod({{.*}})"::@"nestedFunction()"()
    return nestedFunction()

# CHECK-LABEL: lit.func @"topLevelParamFn()"<a_param>
fn topLevelParamFn[a_param: __mlir_type.index]():
  # CHECK: lit.func @"nestedFunction()"<b_param>
  fn nestedFunction[b_param: __mlir_type.index]():
    return
  # CHECK: declare ref: <b_param>() -> !lit.none = <@"$decls"::@"topLevelParamFn()"::@"nestedFunction()">
  alias ref = nestedFunction
  # CHECK: call @"$decls"::@"topLevelParamFn()"::@"nestedFunction()"<b_param = 2>
  nestedFunction[2]()

# CHECK-LABEL: lit.struct.decl @SomeParamStruct<c_param>
struct SomeParamStruct[c_param: __mlir_type.index]:
  # CHECK-LABEL: lit.func @"topLevelParamFn({{.*}})"<a_param>
  fn topLevelParamFn[a_param: __mlir_type.index](self):
    # CHECK: lit.func @"nestedFunction()"<b_param>
    fn nestedFunction[b_param: __mlir_type.index]():
      return
    # CHECK: declare ref: <b_param>() -> !lit.none = <@"$decls"::@SomeParamStruct::@"topLevelParamFn({{.*}})"::@"nestedFunction()"
    alias ref = nestedFunction
    # CHECK: call @"$decls"::@SomeParamStruct::@"topLevelParamFn({{.*}})"::@"nestedFunction()"<b_param = 2>()
    nestedFunction[2]()


