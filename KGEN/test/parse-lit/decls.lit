# CHECK-LABEL: lit.func @"defAlwaysRaises()"() throws -> !kgen.declref<@"$Int"::@Int> attributes {isDef}
def defAlwaysRaises() -> Int:
    # CHECK: %[[RESULT:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 0}>
    # CHECK-NEXT: lit.return %[[RESULT]] : !kgen.declref<@"$Int"::@Int>
    return Int(0)

# CHECK-LABEL: lit.func @"fnThatRaises()"() throws -> !kgen.declref<@"$Int"::@Int>
@raises
fn fnThatRaises() -> Int:
    # CHECK: %[[RESULT:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 0}>
    # CHECK-NEXT: lit.return %[[RESULT]] : !kgen.declref<@"$Int"::@Int>
    return Int(0)

# CHECK-LABEL: lit.func @"raisesReturnsNone()"() throws -> !lit.none
@raises
fn raisesReturnsNone():
    # CHECK-NEXT: lit.end_func
    pass

# COM: We can return an variant of error and index in a non-throwing function.
# CHECK-LABEL: lit.func @"raisesReturnsVariant()"() -> !pop.variant<@"$prolog"::@Error, index>
fn raisesReturnsVariant() -> __mlir_type.`!pop.variant<@"$prolog"::@Error, index>`:
  return __mlir_op.`pop.variant.create`[_type: __mlir_type.`!pop.variant<@"$prolog"::@Error, index>`](1)

# CHECK-LABEL: lit.func @"return_impl_convert_raises
@raises
fn return_impl_convert_raises(a: Error) -> Error:
  # CHECK: [[TMP:%.*]] = kgen.call {{.*}}__copy__{{.*}}(%a)
  # CHECK-NEXT: lit.return [[TMP]]
  return a

##===----------------------------------------------------------------------===##
# Structs
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.struct.decl @EmptyStruct attributes {registerPassable = 1 : i8} {
@register_passable
struct EmptyStruct:
  pass
# CHECK-NEXT: }

# CHECK-LABEL: lit.struct.decl @OneLineStruct<size: @"$Int"::@Int> {
struct OneLineStruct[size: Int]: pass; pass
# CHECK-NEXT: }

# CHECK-LABEL: lit.struct.decl @StructWithInit
struct StructWithInit:
  var x: Int
  var y: Int

  # CHECK: lit.func @"__init__($decls::StructWithInit=&,$Int::Int)"
  # CHECK-SAME: (%self: !pop.pointer<@"$decls"::@StructWithInit> byref_result,
  fn __init__(self, a: Int):
    # CHECK: %0 = lit.struct.gep %self[x]
    # CHECK: pop.store %a, %0
    self.x = a
    # CHECK: [[XP:%.*]] = lit.struct.gep %self[x]
    # CHECK: [[YP:%.*]] = lit.struct.gep %self[y]
    # CHECK: [[XT:%.*]] = pop.load [[XP]]
    # CHECK: pop.store [[XT]], [[YP]]
    self.y = self.x
    # CHECK-NEXT: lit.end_func
    return

  # Not very useful, but this form also works, so test it.
  # CHECK: lit.func @"__init__
  # CHECK-SAME: (%__result__: !pop.pointer<@"$decls"::@StructWithInit> byref_result
  fn __init__(a: Int, b: Int) -> Self:
    # CHECK: hlcf.if
    if a == b:
      # CHECK:  kgen.call {{.*}}__init__{{.*}}(%__result__, %a)
      # CHECK: lit.return %3
      return StructWithInit(a)
    else:

      # CHECK: [[XP:%.*]] = lit.struct.gep %__result__[x]
      # CHECK: pop.store %a, [[XP]]
      # CHECK: [[YP:%.*]] = lit.struct.gep %__result__[y]
      # CHECK: pop.store %b, [[YP]]
      return StructWithInit{x: a, y: b}

  fn __init__() -> Self:
    return Self(0)

# CHECK-LABEL: lit.struct.decl @StructExample
@register_passable
struct StructExample:
  fn __copy__(self) -> Self:
    return Self{}

  fn __init__() -> StructExample:
    return Self {}

  # CHECK: lit.func @"static($Int::Int)"(%x: !kgen.declref<@"$Int"::@Int> borrow) -> !lit.none attributes {isStatic} {
  @staticmethod
  fn static(x: Int):
    # CHECK: %0 = {{.*}}#lit.struct<{value: scalar<index> = 4}>
    # CHECK: %1 = kgen.call @"$decls"::@StructExample::@"static{{.*}}"(%0)
    StructExample.static(Int(4))
    pass

  # CHECK: lit.func @"mutatingMethod($decls::StructExample&)"(%self: !pop.pointer<@"$decls"::@StructExample> byref) -> !lit.none
  fn mutatingMethod(self&):
    pass
# CHECK: }
# CHECK-NEXT: }

# CHECK: lit.func @"callStatic{{.*}}(%a: !kgen.declref<@"$Int"::@Int> borrow)
fn callStatic(a: Int):
  # CHECK: kgen.call @"$decls"::@StructExample::@"static{{.*}}(%a)
  StructExample.static(a)

  # CHECK: kgen.call @"$decls"::@StructExample::@"__init__{{.*}}()
  # CHECK: kgen.call @"$decls"::@StructExample::@"static{{.*}}(%a)
  StructExample().static(a)

##===----------------------------------------------------------------------===##
# async/await
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"coroutine()"() async -> index
async fn coroutine() -> __mlir_type.index:
  # CHECK: lit.return %idx0 : index
  return 0

# CHECK-LABEL: lit.struct.decl @StructWithAsync
struct StructWithAsync:
  # CHECK-LABEL: lit.func @"do_something{{.*}}"({{.*}}) async -> !lit.none
  async fn do_something(self: StructWithAsync):
    # CHECK-NEXT: %[[CORO:.*]] = lit.async.call[<>() async -> index: @"$decls"::@"coroutine()"]()
    # CHECK-NEXT: lit.letreg.decl "a" = %[[CORO]] : !pop.coroutine<() -> index>
    let a = coroutine()

# CHECK-LABEL: lit.func @"call_struct_async{{.*}}"({{.*}}) async -> !lit.none
async fn call_struct_async(f: StructWithAsync):
    # CHECK-NEXT: lit.async.call[<>({{.*}}) async -> !lit.none: @{{.*}}](%f)
    _ = f.do_something()

struct Awaitable:
  fn __init__() -> Awaitable:
    return Awaitable{}

  fn __await__(self&) -> __mlir_type.index:
    return 0

# CHECK-LABEL: lit.func @"awaitable()"
async fn awaitable() -> __mlir_type.index:
  # CHECK: call @"$decls"::@Awaitable::@"__await__($decls::Awaitable&)"(%aw)
  var aw = Awaitable()
  return await aw

##===----------------------------------------------------------------------===##
# Nested Functions
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"topLevelFunction()"
fn topLevelFunction() -> __mlir_type.index:
  var a = 0
  # CHECK: lit.func *"nestedFunction()"
  fn nestedFunction() -> __mlir_type.index:
    # CHECK-NEXT: pop.load %a
    return a
  # CHECK: declare b: () -> index = <*"nestedFunction()">
  alias b = nestedFunction
  # CHECK: call_param[{{.*}}: *"nestedFunction()"]()
  return nestedFunction()

# CHECK-LABEL: lit.struct.decl @SomeStruct
struct SomeStruct:
  # CHECK-LABEL: @"someMethod({{.*}})"
  fn someMethod(self) -> __mlir_type.index:
    var a = 0
    # CHECK: lit.func *"nestedFunction()"
    fn nestedFunction() -> __mlir_type.index:
      # CHECK-NEXT: pop.load %a
      return a
    # CHECK: declare b: () -> index = <*"nestedFunction()">
    alias b = nestedFunction
    # CHECK: call_param[{{.*}}: *"nestedFunction()"]()
    return nestedFunction()

# CHECK-LABEL: lit.func @"topLevelParamFn()"<a_param>
fn topLevelParamFn[a_param: __mlir_type.index]():
  # CHECK: lit.func *"nestedFunction()"<b_param>
  fn nestedFunction[b_param: __mlir_type.index]():
    return
  # CHECK: declare ref: <b_param>() -> !lit.none = <*"nestedFunction()">
  alias ref = nestedFunction
  # CHECK: call_param[{{.*}}: bind_signature(:<b_param>() -> !lit.none *"nestedFunction()", 2)]()
  nestedFunction[2]()

# CHECK-LABEL: lit.struct.decl @SomeParamStruct<c_param>
struct SomeParamStruct[c_param: __mlir_type.index]:
  # CHECK-LABEL: lit.func @"topLevelParamFn({{.*}})"<a_param>
  fn topLevelParamFn[a_param: __mlir_type.index](self):
    # CHECK: lit.func *"nestedFunction()"<b_param>
    fn nestedFunction[b_param: __mlir_type.index]():
      return
    # CHECK: declare ref: <b_param>() -> !lit.none = <*"nestedFunction()">
    alias ref = nestedFunction
    # CHECK: call_param[{{.*}}: bind_signature(:<b_param>() -> !lit.none *"nestedFunction()", 2)]()
    nestedFunction[2]()


