# RUN: kgen-translate -import-lit -verify-diagnostics %s -I %S/../lit-examples/

from prolog import DType, Error, F32, Int, object

##===----------------------------------------------------------------------===##
# Conversions
##===----------------------------------------------------------------------===##

def invalid_conversion(a: Int, b: __mlir_type.index):
  b = a # expected-error {{'$Int::Int' value cannot be converted to '__mlir_type.index' in assignment}}

struct NotBoolConvertible:

# Issue #6600
fn negBuiltinType(x: __mlir_type.f64) :
    # expected-error @+1 {{'__mlir_type.f64' does not implement the '__neg__' method}}
    _ = -x

##===----------------------------------------------------------------------===##
# LValue and RValues
##===----------------------------------------------------------------------===##

42 = 17 # expected-error {{cannot assign to immutable expression}}

struct LValuesRvalues:
  fn __new__() -> LValuesRvalues:
    return LValuesRvalues{}

  fn __clone__(self&) -> Self:
      return LValuesRvalues{}

  def normalMethod(self):
  # expected-note @+1 {{function declared here}}
  def mutatingMethod(self&):
  # expected-note @+1 {{function declared here}}
  def takesByRef(self, x&: LValuesRvalues):

  def normalMethod3(self, a: F32):

struct NonCopyable: # expected-note {{type declared here}}
  fn __new__() -> Self: return Self {}

def testLValuesRvalues():
  # Test with lvalues
  var lv: LValuesRvalues
  lv.normalMethod()
  lv.mutatingMethod()

  # Partial application.
  # expected-error @+1 {{TODO: partial application to mutable base isn't supportable without a lifetime model}}
  lv.mutatingMethod

  # Test with rvalues
  LValuesRvalues().normalMethod()
  LValuesRvalues().mutatingMethod()  # expected-error {{invalid use of mutating method on rvalue of type '$expressions-errors::LValuesRvalues'}}

  # expected-error @+1 {{argument #1 must be mutable in order to pass as a by-ref argument}}
  LValuesRvalues().takesByRef(LValuesRvalues())

  # We can not implicitly declare things on the RHS
  lv += unknown2 # expected-error {{use of unknown declaration 'unknown2'}}

  lv.normalMethod3(1.0)

  var nc1 = NonCopyable()
  let nc2 = NonCopyable()

  let nc3 = nc1 # expected-error {{cannot clone this value: '$expressions-errors::NonCopyable' doesn't implement '__clone__'}}
  let nc4 = nc2 # expected-error {{cannot clone this value: '$expressions-errors::NonCopyable' doesn't implement '__clone__'}}


# expected-note @+1 {{function declared here}}
fn badRef(val&: Int):
  var x = F32(1.0)
  # expected-error @+1 {{invalid call to 'badRef': l-value of type '$F32::F32' cannot be converted to reference of type '$Int::Int'}}
  badRef(x)

fn unused_values():
  var x : Int = 42

  _ = 4+4 # OK: Explicitly ignored.
  # expected-warning @+1 {{'__mlir_type.index' value is unused}}
  4+4  # MValue

  _ = x # OK: Explicitly ignored.
  # expected-warning @+1 {{'$Int::Int' value is unused}}
  x  # LValue

  _ = x+1 # OK: Explicitly ignored.
  # expected-warning @+1 {{'$Int::Int' value is unused}}
  x+1 # DRValue

  # expected-warning @+1 {{function pointer was formed but not called, did you forget '()'s?}}
  testLValuesRvalues
  _ = testLValuesRvalues # OK


def no_unused_values_in_def():
  var x : Int = 42
  4+4  # MValue
  x  # LValue
  x+1 # DRValue
  testLValuesRvalues

##===----------------------------------------------------------------------===##
# Tuples
##===----------------------------------------------------------------------===##

fn bad_tuple(a: Int):
  _ = ()  # expected-error {{FIXME: Cannot emit tuple expressions yet}}
  _ = (a, a)  # expected-error {{FIXME: Cannot emit tuple expressions yet}}
  _ = (a,)  # expected-error {{FIXME: Cannot emit tuple expressions yet}}
  _ = (a, a, b)  # expected-error {{use of unknown declaration 'b'}}

def tuple_return():
  return 32, 17 # expected-error {{tuple return not supported yet}}


##===----------------------------------------------------------------------===##
# Other Specific expression forms
##===----------------------------------------------------------------------===##

struct WeirdBoolish:
  fn __bool__(self) -> Int: return Int(0)

fn badAnd(a: Bool, b: WeirdBoolish):
  _ = a and b # expected-error {{cannot find common type between '$_CompilerBuiltin::Bool' and '$expressions-errors::WeirdBoolish'}}

# expected-error @+1 {{'Self' type may only be used inside a type}}
fn badSelf(a: Self):
  # expected-error @+1 {{'Self' type may only be used inside a type}}
  var x: Self.field


struct MyIntPair:
  var a: Int
  var b: Int

fn dict_expression(a: Int):
  # expected-error @+1 {{TODO: cannot emit dictionary literals yet}}
  _ = {}
  # expected-error @+1 {{TODO: cannot emit dictionary literals yet}}
  _ = {a: 4}
  # expected-error @+1 {{TODO: cannot emit dictionary literals yet}}
  let dict = {a: 4, "b": 17}
  # expected-error @+1 {{TODO: cannot emit dictionary literals yet}}
  _ = {a: 4, **dict, "b": 17}

  # expected-error @+1 {{TODO: dictionary comprehension parsing}}
  let comprehension = {key:value for (key,value) in dict.items()}

  # Dictionary subscripts.

  # expected-error @+1 {{TODO: cannot emit dictionary subscripts yet}}
  _ = a{1: 2, **dict}


  # expected-error @+1 {{MLIR types may not be initialized with this syntax}}
  _ = __mlir_type.index{value: 4}

  # expected-error @+1 {{type initializer requires keys to be bare field names}}
  _ = MyIntPair{"a": 4}

  # expected-error @+1 {{field 'a' specified multiple times}}
  _ = MyIntPair{a: 4, a: 4}
  # expected-error @+1 {{cannot expand into initializer list}}
  _ = MyIntPair{a: a, **a}
  # expected-error @+1 {{no value for field 'b' specified}}
  _ = MyIntPair{a: 4}
  # expected-error @+1 {{'__mlir_type.f64' value cannot be converted to '$Int::Int' in field initialization}}
  _ = MyIntPair{a: 4.0, b: 4}
  _ = MyIntPair{a: 4, b: 4}

fn dict_parse_errors(a: Int):
  # expected-error @+1 {{dictionary comprehension must start with single key:value pair}}
  _ = {key:value, key:value for (key,value) in dict.items()}

fn slice_expression(a: Int):
  # expected-note @+1 {{keyword arguments aren't supported yet}}
  a[:]    # expected-error {{TODO: SliceNode::emitIR not implemented yet}}
  # expected-note @+1 {{keyword arguments}}
  a[::]   # expected-error {{TODO: SliceNode::emitIR not implemented yet}}
  # expected-note @+1 {{keyword arguments}}
  a[1:2]  # expected-error {{TODO: SliceNode::emitIR not implemented yet}}
  # expected-note @+1 {{keyword arguments}}
  a[:2:3] # expected-error {{TODO: SliceNode::emitIR not implemented yet}}



def bad_exprs(aaaa: Bool, bbbb: F32, cccc: Int):
  # expected-error @+1 {{true value of type '$F32::F32' is not compatible with false value '$Int::Int' in conditional}}
  _ = bbbb if aaaa else cccc

  alias idx : __mlir_type.index = 4
  # expected-error @+1 {{cannot emit this binary operator in parameter context yet}}
  _ = idx/idx

def bad_assignment0(a: Int, b: Int):
   # expected-error @+1 {{cannot assign to immutable expression}}
   a = b += b

def bad_assignment1(a: Int, b: Int):
   # expected-error @+1 {{expected ')' in parenthesized expression}}
   a = (b += b)

##===----------------------------------------------------------------------===##
# Computed Properties and Subscripts
##===----------------------------------------------------------------------===##

struct WeirdArray:
  # expected-note @+1 {{function declared here}}
  fn __getitem__(self, x: Int) -> Int:
    return 1

fn testWeirdArray(a: WeirdArray, idx: Int):
  # expected-error @+1 {{invalid call to '__getitem__': index cannot be converted from '__mlir_type.f64' to '$Int::Int'}}
  _ = a[1.0]

  # expected-error @+1 {{invalid call to '__getitem__': callee expects 2 arguments, but 3 specified}}
  _ = a[1, 2]

##===----------------------------------------------------------------------===##
# __adaptive_set errors
##===----------------------------------------------------------------------===##

# expected-note @+1 {{declared here}}
fn bar[x: __mlir_type.index]() -> __mlir_type.index:
        return 1

fn test_adaptive_set():
    # expected-error @+1 {{cannot form a reference to non @adaptive declaration of 'bar'}}
    alias bad = bar.__adaptive_set
    # expected-error @+1 {{'$Int::Int' value has no attribute '__adaptive_set'}}
    alias bad_int= Int(5).__adaptive_set
