# CHECK-LABEL: lit.func @"tmp
def tmp():
    a = 5             # CHECK: 5
    a = 55            # CHECK: 55
    a = 10500         # CHECK: 10500
    a = 12_500        # CHECK: 12500
    a = 0             # CHECK: 0
    a = 00            # CHECK: 0
    a = 0____0__0_0   # CHECK: 0
    a = 00__0_0       # CHECK: 0
    a = 1__9_         # CHECK: 19
    a = 0x123         # CHECK: 291
    a = 0X123         # CHECK: 291
    a = 0b10101       # CHECK: 21
    a = 0B10101       # CHECK: 21
    a = 0o711         # CHECK: 457
    a = 0O711         # CHECK: 457
    b = 1.1           # CHECK: 1.100000e+00
    b = .1            # CHECK: 1.000000e-01
    b = 1.            # CHECK: 1.000000e+00
    b = 1e2           # CHECK: 1.000000e+02
    b = 1.1e2         # CHECK: 1.100000e+02
    b = .1e2          # CHECK: 1.000000e+01
    b = 1.e2          # CHECK: 1.000000e+02
    b = 1e+2          # CHECK: 1.000000e+02
    b = 1.1e-2        # CHECK: 1.100000e-02
    b = .1e+2         # CHECK: 1.000000e+01
    b = 1.e-2         # CHECK: 1.000000e-02
    b = 0.1           # CHECK: 1.000000e-01
    b = 0.            # CHECK: 0.000000e+00
    b = 0e2           # CHECK: 0.000000e+00
    b = 0.1e2         # CHECK: 1.000000e+01
    b = 0.e2          # CHECK: 0.000000e+00
    b = 0e+2          # CHECK: 0.000000e+00
    b = 0.1e-2        # CHECK: 1.000000e-03
    b = 0.e-2         # CHECK: 0.000000e+00
    b = 12.31e+11     # CHECK: 1.231000e+12
    b = 1_2.3__1e+1_1 # CHECK: 1.231000e+12
    b = 12.31E-3      # CHECK: 1.231000e-02
    c = False         # CHECK: @BoolLiteral = <#lit.struct<{value: scalar<bool> = false}>>
    c = True          # CHECK: @BoolLiteral = <#lit.struct<{value: scalar<bool> = true}>>

fn strings():
   """
      Various tests on strings
   """

    var a = ""                 # CHECK: ""
    # CHECK: "hello world"
    a = "hello \
world"

    # COM: match newline hex values via regex since they vary between OSs
    # CHECK: "hello \\\{{[0-9A-Z]+}}world"
    a = r"hello \
world"

    # CHECK:  "1'\0A2"
    a = """1'
2"""

    # CHECK:  "1\222"
    a = '''1"\
2'''

    # CHECK:   "1\22\0A2"
    a = '''1"
2'''

    # CHECK:   "1\22\0A2"
    a = '1"\n2'

    # CHECK: "hello concat world"
    a = "hello " "concat " "world"

    a = "Hello"            # CHECK: "Hello"
    a = "Hello 'world'"    # CHECK: "Hello 'world'"
    a = "A\x42"            # CHECK: "AB"
    a = "A\x423"           # CHECK: "AB3"
    a = "A\102"            # CHECK: "AB"
    a = "A\1023"           # CHECK: "AB3"

    # COM: the MLIR textual representation escapes strings, so below \ is \\ and " is \"
    a = 'Hello "world"'    # CHECK: "Hello \22world\22"
    a = r"A\x42"           # CHECK: "A\\x42"
    a = R"A\x42"           # CHECK: "A\\x42"
    a = r"AB\\"            # CHECK: "AB\\\\"
    a = r"A\x"             # CHECK: "A\\x"
    a = "AB\\"             # CHECK: "AB\\"
    a = r"A\"B"            # CHECK: "A\\\22B"
    a = r'A\'B'            # CHECK: "A\\'B"
    a = "A\"B"             # CHECK: "A\22B"
    a = 'A\'B'             # CHECK: "A'B"
    a = r"A\zB"            # CHECK: "A\\zB"

##===----------------------------------------------------------------------===##
# Computed Properties and Subscripts
##===----------------------------------------------------------------------===##

struct WeirdArray:
  fn __getitem__(self, x: Int) -> Int:
    return 1
  fn __getitem__(self, x: Int, y: Int) -> Int:
    return 2
  fn __getitem__(self, x: Int, y: Int, z: Int) -> Int:
    return 3
  fn __getitem__(self, x: F32, *ints: Int) -> F32:
    return x

 fn __setitem__(self, x: Int, y: Int, value: Int): pass

# CHECK-LABEL: lit.func @"testWeirdArray
fn testWeirdArray(a: WeirdArray, idx: Int, f: F32):
  # CHECK: kgen.call {{.*}}@WeirdArray::@"__getitem__{{.*}}(%a, %idx)
  _ = a[idx]
  # CHECK: kgen.call {{.*}}@WeirdArray::@"__getitem__{{.*}}(%a, %idx, %idx)
  _ = a[idx, idx]
  # CHECK: kgen.call {{.*}}@WeirdArray::@"__getitem__{{.*}}(%a, %idx, %idx, %idx)
  _ = a[idx, idx, idx]
  # CHECK: [[VARIADIC:%.*]] = pop.variadic.create [%idx, %idx, %idx, %idx]
  # CHECK: kgen.call {{.*}}@WeirdArray::@"__getitem__{{.*}}(%a, %f, [[VARIADIC]])
  _ = a[f, idx, idx, idx, idx]

  # CHECK: [[SEVENTEEN:%.*]] = kgen.param.constant: {{.*}} = 17
  # CHECK: kgen.call {{.*}}__setitem__{{.*}}(%a, %idx, %idx, [[SEVENTEEN]])
  a[idx, idx] = 17

# This is an array that has elements of MemoryOnlyInt.
struct MemoryOnlyIntArray:
  fn __getitem__(self&, x: Int) -> MemoryOnlyInt: pass
  fn __setitem__(self&, x: Int, value: MemoryOnlyInt): pass

# CHECK-LABEL: lit.func @"testMemoryOnlyIntArray
fn testMemoryOnlyIntArray(arr&: MemoryOnlyIntArray, x: Int, moi: MemoryOnlyInt):
  # CHECK: kgen.call {{.*}}__setitem__{{.*}}(%arr, %x, %moi)
  arr[x] = moi
  # CHECK: [[ANON:%.*]] = lit.varlet.decl "anonymous*"
  # CHECK: kgen.call {{.*}}__getitem__{{.*}}([[ANON]], %arr, %x)
  # CHECK: kgen.call {{.*}}"__setitem__{{.*}}(%arr, %x, [[ANON]])
  arr[x] = arr[x]

  # Initialize in memory through a temp + setitem.
  # CHECK: [[ANON:%.*]] = lit.varlet.decl "anonymous*"
  # CHECK: [[TMP:%.*]] = lit.struct.gep %anonymous2A_0[x]
  # CHECK: %idx42 = index.constant 42
  # CHECK: pop.store %idx42, [[TMP]]
  # CHECK: kgen.call {{.*}}"__setitem__{{.*}}(%arr, %x, [[ANON]])
  arr[x] = MemoryOnlyInt{x: 42}


struct MyInlineIntInit:
    var intVal: MemoryOnlyInt
    # CHECK-LABEL: lit.func @"__init__($expressions::MyInlineIntInit=&,$expressions::MemoryOnlyInt)"
    # CHECK-SAME: (%__result__: !pop.pointer<{{.*}}> byref_result, %intVal: {{.*}}borrow_in_mem)
    fn __init__(intVal: MemoryOnlyInt) -> Self:
        # CHECK: %0 = lit.struct.gep %__result__[intVal]
        # CHECK: kgen.call {{.*}}__copy__{{.*}}(%0, %intVal)
        return Self{intVal: intVal}

struct IndexArray:
  fn __getitem__(self&, x: __mlir_type.index) -> __mlir_type.index: pass
  fn __setitem__(self&, x: __mlir_type.index, value: __mlir_type.index): pass

struct IndexArrayArray:
  fn __getitem__(self&, x: __mlir_type.index) -> IndexArray: pass
  fn __setitem__(self&, x: __mlir_type.index, value: IndexArray): pass

fn takeInOutInt(a&: __mlir_type.index): pass

 # CHECK-LABEL: lit.func @"testWritebacks
fn testWritebacks(a&: IndexArray, b&: IndexArrayArray):
  # CHECK: %anonymous2A = lit.varlet.decl "anonymous*", var = false : <index>
  # CHECK: %idx0 = index.constant 0
  # CHECK: %0 = kgen.call {{.*}}__getitem__{{.*}}(%a, %idx0)
  # CHECK: pop.store %0, %anonymous2A
  # CHECK: %1 = kgen.call {{.*}}takeInOutInt{{.*}}(%anonymous2A)
  # CHECK: %2 = pop.load %anonymous2A
  # CHECK: %idx0_0 = index.constant 0
  # CHECK: %3 = kgen.call {{.*}}__setitem__{{.*}}(%a, %idx0_0, %2)
  takeInOutInt(a[0]);

  # CHECK: %anonymous2A_1 = lit.varlet.decl "anonymous*", var = false : <index>
  # CHECK: %anonymous2A_2 = lit.varlet.decl "anonymous*", var = false : <@"$expressions"::@IndexArray>
  # CHECK: %idx1 = index.constant 1
  # CHECK: %4 = {{.*}}__getitem__{{.*}}(%anonymous2A_2, %b, %idx1)
  # CHECK: %idx2 = index.constant 2
  # CHECK: %5 = kgen.call {{.*}}__getitem__{{.*}}(%anonymous2A_2, %idx2)
  # CHECK: %idx1_3 = index.constant 1
  # CHECK: %6 = kgen.call {{.*}}__setitem__{{.*}}(%b, %idx1_3, %anonymous2A_2)
  # CHECK: pop.store %5, %anonymous2A_1
  # CHECK: %7 = kgen.call {{.*}}takeInOutInt{{.*}}(%anonymous2A_1)
  # CHECK: %8 = pop.load %anonymous2A_1
  # CHECK: %anonymous2A_4 = lit.varlet.decl "anonymous*", var = false
  # CHECK: %idx1_5 = index.constant 1
  # CHECK: %9 = kgen.call {{.*}}__getitem__{{.*}}(%anonymous2A_4, %b, %idx1_5)
  # CHECK: %idx2_6 = index.constant 2
  # CHECK: %10 = kgen.call {{.*}}__setitem__{{.*}}(%anonymous2A_4, %idx2_6, %8)
  # CHECK: %idx1_7 = index.constant 1
  # CHECK: %11 = kgen.call {{.*}}__setitem__{{.*}}(%b, %idx1_7, %anonymous2A_4)
  takeInOutInt(b[1][2])


# CHECK-LABEL: lit.func @"chained_cmp
fn chained_cmp(a: Int, b: Int, c: Int, d: Int, e: Int):
    # CHECK:      [[CMP_A_B:%.*]] = kgen.call @{{.*}}__lt__{{.*}}(%a, %b)
    # CHECK-NEXT: [[B2:%.*]] = kgen.call {{.*}}__copy__{{.*}}(%b)
    # CHECK-NEXT: %[[CMP_A_B_I1:.*]] = kgen.call @{{.*}}__mlir_i1__{{.*}}([[CMP_A_B]])
    # CHECK-NEXT: %[[IF_A_B:.*]] = hlcf.if %[[CMP_A_B_I1]]
    # CHECK-NEXT:   [[C2:%.*]] = kgen.call {{.*}}__copy__{{.*}}(%c)
    # CHECK-NEXT:   %[[CMP_B_C:.*]] = kgen.call @{{.*}}__lt__{{.*}}([[B2]], [[C2]])
    # CHECK:        %[[IF_B_C:.*]] = hlcf.if
    # CHECK-NEXT:     [[D2:%.*]] = kgen.call {{.*}}__copy__{{.*}}(%d)
    # CHECK-NEXT:     %[[CMP_C_D:.*]] = kgen.call @{{.*}}__lt__{{.*}}([[C2]], [[D2]])
    # CHECK-NEXT:     hlcf.yield %[[CMP_C_D]]
    # CHECK-NEXT:   } else {
    # CHECK-NEXT:     hlcf.yield %[[CMP_B_C]]
    # CHECK-NEXT:   }
    # CHECK-NEXT:   hlcf.yield %[[IF_B_C]]
    # CHECK-NEXT: } else {
    # CHECK-NEXT:   hlcf.yield [[CMP_A_B]]
    # CHECK-NEXT: }
    # CHECK-NEXT: pop.store %[[IF_A_B]], %res : !pop.pointer<@"$_CompilerBuiltin"::@Bool>
    var res = a < b < c < d

    # COM: This checks the parsing precedence between `<` and `and`.
    # CHECK:      %[[CMP_A_B:.*]] = kgen.call @{{.*}}__lt__{{.*}}(%a, %b)
    # CHECK:       %[[CMP_A_B_I1:.*]] = kgen.call @{{.*}}__mlir_i1__{{.*}}(%[[CMP_A_B]])
    # CHECK-NEXT: %[[IF_A_B:.*]] = hlcf.if %[[CMP_A_B_I1]]
    # CHECK:   %[[CMP_B_C:.*]] = kgen.call @{{.*}}__lt__{{.*}}(
    # CHECK-NEXT:   hlcf.yield %[[CMP_B_C]]
    # CHECK-NEXT: } else {
    # CHECK-NEXT:   hlcf.yield %[[CMP_A_B]]
    # CHECK-NEXT: }
    # CHECK-NEXT: %[[CMP_I1:.*]] = kgen.call @{{.*}}__mlir_i1__{{.*}}(%[[IF_A_B]])
    # CHECK-NEXT: %[[IF:.*]] = hlcf.if %[[CMP_I1]]
    # CHECK-NEXT:   %[[CMP_D_E:.*]] = kgen.call @{{.*}}__lt__{{.*}}(%d, %e)
    # CHECK-NEXT:   hlcf.yield %[[CMP_D_E]]
    # CHECK-NEXT: } else {
    # CHECK-NEXT:   hlcf.yield %[[IF_A_B]]
    # CHECK-NEXT: }
    # CHECK-NEXT: pop.store %[[IF]], %res : !pop.pointer<@"$_CompilerBuiltin"::@Bool>
    res = a < b < c and d < e

# CHECK-LABEL: lit.func @"foo_adaptive(){{.*}} {isAdaptive}
@adaptive
fn foo_adaptive[x: __mlir_type.index]() -> __mlir_type.index:
   return 0

# CHECK-LABEL: lit.func @"foo_adaptive()_0{{.*}} {isAdaptive}
@adaptive
fn foo_adaptive[x: __mlir_type.index]() -> __mlir_type.index:
  return 1

# CHECK-LABEL: lit.func @"test_adaptive_set
fn test_adaptive_set():
    #CHECK: kgen.param.declare not_bound: variadic<!kgen.signature<<x>() -> index>> =
    #CHECK-SAME: <[@"{{.*}}foo_adaptive()", @"{{.*}}foo_adaptive()_0"]>
    alias not_bound = foo_adaptive.__adaptive_set
    #CHECK-NEXT: kgen.param.declare bound: variadic<!kgen.signature<() -> index>> =
    #CHECK-SAME: <[@"{{.*}}foo_adaptive()"<x = 1>, @"{{.*}}foo_adaptive()_0"<x = 1>]>
    alias bound = foo_adaptive[1].__adaptive_set
