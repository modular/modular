# RUN: kgen-translate -import-lit %s | FileCheck %s

# CHECK: module {

__include "../lit-examples/prolog.lit"

fn noop():

# CHECK-LABEL: lit.func @precedence_associativity(%a: !kgen.litdeclref<@Int>) -> !lit.none
fn precedence_associativity(a: Int):
  # CHECK-NEXT: %z = lit.var.decl "z"
  var z: Int = Int(0)
  # CHECK:      %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT: %[[INT_TWO:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[TWO]])
  # CHECK-NEXT: %[[Z:.*]] = pop.load %z
  # CHECK-NEXT: %[[POW0:.*]] = kgen.call_param{{.*}} @Int::@__pow__](%a, %[[Z]])
  # CHECK-NEXT: %[[POW1:.*]] = kgen.call_param{{.*}} @Int::@__pow__](%[[INT_TWO]], %[[POW0]])
  # CHECK-NEXT: pop.store %[[POW1]], %z
  z = Int(2)**(a**z)
  # CHECK-NEXT: %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT: %[[INT_TWO:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[TWO]])
  # CHECK-NEXT: %[[Z:.*]] = pop.load %z
  # CHECK-NEXT: %[[POW0:.*]] = kgen.call_param{{.*}} @Int::@__pow__](%a, %[[Z]])
  # CHECK-NEXT: %[[POW1:.*]] = kgen.call_param{{.*}} @Int::@__pow__](%[[INT_TWO]], %[[POW0]])
  # CHECK-NEXT: pop.store %[[POW1]], %z
  z = Int(2)**a**z
  # CHECK-NEXT:  %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT:  %[[INT_THREE:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[THREE]])
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[TWO]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call_param{{.*}} @Int::@__neg__](%[[INT_TWO]])
  # CHECK-NEXT:  %[[MUL:.*]] = kgen.call_param{{.*}} @Int::@__mul__](%[[INT_THREE]], %[[NEG]])
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call_param{{.*}} @Int::@__add__](%[[Z]], %[[MUL]])
  # CHECK-NEXT:  pop.store %[[ADD]], %z
  z = z + Int(3) * -Int(2)
  # CHECK-NEXT:  %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT:  %[[INT_THREE:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[THREE]])
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[TWO]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call_param{{.*}} @Int::@__neg__](%[[INT_TWO]])
  # CHECK-NEXT:  %[[FLOOR_DIV:.*]] = kgen.call_param{{.*}} @Int::@__floordiv__](%[[INT_THREE]], %[[NEG]])
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call_param{{.*}} @Int::@__add__](%[[Z]], %[[FLOOR_DIV]])
  # CHECK-NEXT:  pop.store %[[ADD]], %z
  z = z + Int(3) // -Int(2)
  # CHECK-NEXT:  %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT:  %[[INT_THREE:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[THREE]])
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[TWO]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call_param{{.*}} @Int::@__neg__](%[[INT_TWO]])
  # CHECK-NEXT:  %[[MOD:.*]] = kgen.call_param{{.*}} @Int::@__mod__](%[[INT_THREE]], %[[NEG]])
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call_param{{.*}} @Int::@__add__](%[[Z]], %[[MOD]])
  # CHECK-NEXT:  pop.store %[[ADD]], %z
  z = z + Int(3) % -Int(2)
  # CHECK-NEXT:  %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT:  %[[INT_THREE:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[THREE]])
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call_param{{.*}} @Int::@__add__](%[[Z]], %[[INT_THREE]])
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[TWO]])
  # CHECK-NEXT:  %[[POS:.*]] = kgen.call_param{{.*}} @Int::@__pos__](%[[INT_TWO]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call_param{{.*}} @Int::@__neg__](%[[POS]])
  # CHECK-NEXT:  %[[MUL:.*]] =  kgen.call_param{{.*}} @Int::@__mul__](%[[ADD]], %[[NEG]])
  # CHECK-NEXT:  pop.store %[[MUL]], %z
  z = (z + Int(3)) * -+Int(2)
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[TWO]])
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z
  # CHECK-NEXT:  %[[POW:.*]] = kgen.call_param{{.*}} @Int::@__pow__](%[[INT_TWO]], %[[Z]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call_param{{.*}} @Int::@__neg__](%[[POW]])
  # CHECK-NEXT:  pop.store %[[NEG]], %z
  z = -Int(2)**z

struct M:
  var value : __mlir_type.index
  fn __new__(value: __mlir_type.index) -> M:
    return M(0)
  fn __neg__(self) -> M:
    return M(0)
  fn __add__(self, rhs: M) -> M:
    return M(0)
  fn __matmul__(self, rhs: M) -> M:
    return M(0)

# CHECK-LABEL: lit.func @precedence_matmul(%z: !kgen.litdeclref<@M>) -> !kgen.litdeclref<@M>
fn precedence_matmul(z: M) -> M:
  # CHECK-NEXT:  %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT:  %[[INT_THREE:.*]] = kgen.call_param{{.*}} @M::@__new__](%[[THREE]])
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call_param{{.*}} @M::@__new__](%[[TWO]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call_param{{.*}} @M::@__neg__](%[[INT_TWO]])
  # CHECK-NEXT:  %[[MATMUL:.*]] = kgen.call_param{{.*}}@M::@__matmul__](%[[INT_THREE]], %[[NEG]])
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call_param{{.*}} @M::@__add__](%z, %[[MATMUL]])
  # CHECK-NEXT:  kgen.return %[[ADD]] : !kgen.litdeclref<@M>
  return z + M(3) @ -M(2)

# CHECK-LABEL: lit.func @precedence_bitwise(%a: !kgen.litdeclref<@Int>, %b: !kgen.litdeclref<@Int>, %c: !kgen.litdeclref<@Int>) -> !kgen.litdeclref<@Int> {
fn precedence_bitwise(a: Int, b: Int, c: Int) -> Int:
  # CHECK-NEXT: %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT: %[[INT_TWO:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[TWO]])
  # CHECK-NEXT: %[[MUL:.*]] = kgen.call_param{{.*}} @Int::@__mul__](%a, %[[INT_TWO]])
  # CHECK-NEXT: %[[AND:.*]] = kgen.call_param{{.*}} @Int::@__and__](%[[MUL]], %b)
  # CHECK-NEXT: %[[FOUR:.*]] = {{.*}} 4
  # CHECK-NEXT: %[[INT_FOUR:.*]] = kgen.call_param{{.*}} @Int::@__new__](%[[FOUR]])
  # CHECK-NEXT: %[[XOR:.*]] = kgen.call_param{{.*}} @Int::@__xor__](%[[INT_FOUR]], %c)
  # CHECK-NEXT: %[[OR:.*]] = kgen.call_param{{.*}} @Int::@__or__](%[[AND]], %[[XOR]])
  # CHECK-NEXT: kgen.return %[[OR]]
  return a * Int(2) & b | Int(4) ^ c

fn comparisons(a: Int, b: Int):
   var res: Bool
   # CHECK: kgen.call_param{{.*}} @Int::@__lt__](%a, %b)
   res = a < b
   # CHECK: kgen.call_param{{.*}} @Int::@__le__](%a, %b)
   res = a <= b
   # CHECK: kgen.call_param{{.*}} @Int::@__gt__](%a, %b)
   res = a > b
   # CHECK: kgen.call_param{{.*}} @Int::@__ge__](%a, %b)
   res = a >= b
   # CHECK: kgen.call_param{{.*}} @Int::@__eq__](%a, %b)
   res = a == b
   # CHECK: kgen.call_param{{.*}} @Int::@__ne__](%a, %b)
   res = a != b

