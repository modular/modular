# COM: # CHECK-LABEL: lit.func @"precedence_comparison
# COM: fn precedence_comparison(a: index, b: index, c: index, d: index):
# COM:   # CHECK-NEXT: %tmp = lit.var.decl "tmp"
# COM:   var tmp : index
# COM:   # CHECK-NEXT: %[[EQUAL:.*]] = index.remu %a, %b
# COM:   # CHECK-NEXT: %[[ZERO:.*]] = {{.*}} 0
# COM:   # CHECK-NEXT: %[[NOT:.*]] = index.sub %[[ZERO]], %c
# COM:   # CHECK-NEXT: %[[AND:.*]] = index.add %[[EQUAL]], %[[NOT]]
# COM:   # CHECK-NEXT: %[[OR:.*]] = index.sub %[[AND]], %d
# COM:   # CHECK-NEXT: store %[[OR]], %tmp
# COM:   tmp = ((a == b) and (not c)) or d
# COM:   # CHECK-NEXT: %[[EQUAL:.*]] = index.remu %a, %b
# COM:   # CHECK-NEXT: %[[ZERO:.*]] = {{.*}} 0
# COM:   # CHECK-NEXT: %[[NOT:.*]] = index.sub %[[ZERO]], %c
# COM:   # CHECK-NEXT: %[[AND:.*]] = index.add %[[EQUAL]], %[[NOT]]
# COM:   # CHECK-NEXT: %[[OR:.*]] = index.sub %[[AND]], %d
# COM:   # CHECK-NEXT: store %[[OR]], %tmp
# COM:   tmp = a == b and not c or d

# CHECK-LABEL: lit.func @"do_math
fn do_math(a: Int, b: Int, c: Int) -> Int:
  # CHECK-NEXT: %z = lit.var.decl "z"
  var z : Int
  # CHECK-NEXT:  %[[I42:.*]] = {{.*}} 42
  # CHECK-NEXT:  %[[INT_42:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[I42]])
  # CHECK-NEXT:  %[[I5:.*]] = {{.*}} 5
  # CHECK-NEXT:  %[[INT_5:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[I5]])
  # CHECK-NEXT: %[[MUL:.*]] = kgen.call @Int::@"__mul__{{.*}}(%[[INT_5]], %a)
  # CHECK-NEXT: %[[ADD:.*]] = kgen.call @Int::@"__add__{{.*}}(%[[INT_42]], %[[MUL]])
  # CHECK-NEXT: pop.store %[[ADD]], %z
  z = Int(42) + Int(5)*a

  # CHECK-NEXT: %x = lit.var.decl "x"
  # CHECK-NEXT: %[[TMP:.*]] = pop.load %z
  # CHECK-NEXT: pop.store %[[TMP]], %x
  # This is checking the lexer handles \ at end of line correctly.
  var x : Int
  x = \
z

  # CHECK-NEXT: kgen.call @"noop()"()
  noop()

  # CHECK-NEXT: %[[TMP:.*]] = pop.load %x
  # CHECK-NEXT: kgen.return %[[TMP]]
  return x

# CHECK-LABEL: lit.func @"listValues()"() -> index
fn listValues() -> __mlir_type.index:
  # CHECK: %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT: pop.store %[[THREE:.*]], %a
  var a = [1, 2, 2+1]
  # CHECK: %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT: pop.store %[[THREE:.*]], %a
  a = [1, 2, 2+1,]
  # CHECK: %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT: pop.store %[[THREE:.*]], %a
  a = [1, 2,
            2+1]
  # CHECK:      %[[NONE:.*]] = kgen.param.constant: !lit.none = <#lit.none>
  # CHECK-NEXT: pop.store %[[NONE:.*]], %b
  var b = []
  return a

# CHECK-LABEL: lit.func @"test_if_cond
def test_if_cond(cond: Bool):
    # CHECK:      %[[I:.*]] = lit.var.decl "i" : <@Int>
    # CHECK-NEXT: %[[COND:.*]] = pop.load %cond_0
    # CHECK-NEXT: %[[BOOL:.*]] = kgen.call @Bool::@"__bool__{{.*}}(%[[COND]])
    # CHECK-NEXT: %[[LIT_BOOL:.*]] = kgen.call @Bool::@"__lit_bool{{.*}}(%[[BOOL]])
    # CHECK-NEXT: %[[IF_RES:.*]] = scf.if %[[LIT_BOOL]]
    # CHECK-NEXT:   %[[TWO:.*]] = {{.*}} 2
    # CHECK-NEXT:   %[[INT_TWO:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[TWO]])
    # CHECK-NEXT:   scf.yield %[[INT_TWO]]
    # CHECK-NEXT: } else {
    # CHECK-NEXT:   %[[THREE:.*]] = {{.*}} 3
    # CHECK-NEXT:   %[[INT_THREE:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[THREE]])
    # CHECK-NEXT:   scf.yield %[[INT_THREE]]
    # CHECK-NEXT: }
    # CHECK-NEXT: pop.store %[[IF_RES]], %i
    var i: Int = Int(2) if cond else Int(3)

    # CHECK:      %[[TRUE:.+]] = kgen.call @Bool::@"true{{.*}}()
    # CHECK-NEXT: pop.store %[[TRUE]], %cond
    cond = Bool.true()
    i += i
    if cond:     # 'if' stmt, not an 'if' expression.
        i = i+i
