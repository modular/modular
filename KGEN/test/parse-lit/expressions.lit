# RUN: kgen-translate -import-lit %s | FileCheck %s

# CHECK: module {

__include "../lit-examples/prolog.lit"

fn noop():

# CHECK-LABEL: lit.func @"simpleMath
fn simpleMath(a: Int, b: Int) -> Int:
  # CHECK: %0 = kgen.call @Int::@"__mul__{{.*}}(%b, %a)
  # CHECK: %1 = kgen.call @Int::@"__add__{{.*}}(%a, %0)
  # CHECK: kgen.return %1 : !kgen.declref<@Int>
  return a+b*a

# CHECK-LABEL: lit.func @"precedence_associativity
fn precedence_associativity(a: Int):
  # CHECK-NEXT: %z = lit.var.decl "z"
  var z: Int = Int(0)
  # CHECK:      %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT: %[[INT_TWO:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[TWO]])
  # CHECK-NEXT: %[[Z:.*]] = pop.load %z
  # CHECK-NEXT: %[[POW0:.*]] = kgen.call @Int::@"__pow__{{.*}}(%a, %[[Z]])
  # CHECK-NEXT: %[[POW1:.*]] = kgen.call @Int::@"__pow__{{.*}}(%[[INT_TWO]], %[[POW0]])
  # CHECK-NEXT: pop.store %[[POW1]], %z
  z = Int(2)**(a**z)
  # CHECK-NEXT: %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT: %[[INT_TWO:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[TWO]])
  # CHECK-NEXT: %[[Z:.*]] = pop.load %z
  # CHECK-NEXT: %[[POW0:.*]] = kgen.call @Int::@"__pow__{{.*}}(%a, %[[Z]])
  # CHECK-NEXT: %[[POW1:.*]] = kgen.call @Int::@"__pow__{{.*}}(%[[INT_TWO]], %[[POW0]])
  # CHECK-NEXT: pop.store %[[POW1]], %z
  z = Int(2)**a**z
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z
  # CHECK-NEXT:  %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT:  %[[INT_THREE:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[THREE]])
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[TWO]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call @Int::@"__neg__{{.*}}(%[[INT_TWO]])
  # CHECK-NEXT:  %[[MUL:.*]] = kgen.call @Int::@"__mul__{{.*}}(%[[INT_THREE]], %[[NEG]])
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call @Int::@"__add__{{.*}}(%[[Z]], %[[MUL]])
  # CHECK-NEXT:  pop.store %[[ADD]], %z
  z = z + Int(3) * -Int(2)
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z
  # CHECK-NEXT:  %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT:  %[[INT_THREE:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[THREE]])
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[TWO]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call @Int::@"__neg__{{.*}}(%[[INT_TWO]])
  # CHECK-NEXT:  %[[FLOOR_DIV:.*]] = kgen.call @Int::@"__floordiv__{{.*}}(%[[INT_THREE]], %[[NEG]])
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call @Int::@"__add__{{.*}}(%[[Z]], %[[FLOOR_DIV]])
  # CHECK-NEXT:  pop.store %[[ADD]], %z
  z = z + Int(3) // -Int(2)
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z
  # CHECK-NEXT:  %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT:  %[[INT_THREE:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[THREE]])
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call @Int::@"__add__{{.*}}(%[[Z]], %[[INT_THREE]])
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[TWO]])
  # CHECK-NEXT:  %[[POS:.*]] = kgen.call @Int::@"__pos__{{.*}}(%[[INT_TWO]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call @Int::@"__neg__{{.*}}(%[[POS]])
  # CHECK-NEXT:  %[[MUL:.*]] =  kgen.call @Int::@"__mul__{{.*}}(%[[ADD]], %[[NEG]])
  # CHECK-NEXT:  pop.store %[[MUL]], %z
  z = (z + Int(3)) * -+Int(2)
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[TWO]])
  # CHECK-NEXT:  %[[Z:.*]] = pop.load %z
  # CHECK-NEXT:  %[[POW:.*]] = kgen.call @Int::@"__pow__{{.*}}(%[[INT_TWO]], %[[Z]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call @Int::@"__neg__{{.*}}(%[[POW]])
  # CHECK-NEXT:  pop.store %[[NEG]], %z
  z = -Int(2)**z

struct M:
  var value : __mlir_type.index
  fn __new__(value: __mlir_type.index) -> M:
    return M(0)
  fn __neg__(self) -> M:
    return M(0)
  fn __add__(self, rhs: M) -> M:
    return M(0)
  fn __matmul__(self, rhs: M) -> M:
    return M(0)

# CHECK-LABEL: lit.func @"precedence_matmul
fn precedence_matmul(z: M) -> M:
  # CHECK-NEXT:  %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT:  %[[INT_THREE:.*]] = kgen.call @M::@"__new__{{.*}}(%[[THREE]])
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call @M::@"__new__{{.*}}(%[[TWO]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call @M::@"__neg__{{.*}}(%[[INT_TWO]])
  # CHECK-NEXT:  %[[MATMUL:.*]] = kgen.call @M::@"__matmul__{{.*}}(%[[INT_THREE]], %[[NEG]])
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call @M::@"__add__{{.*}}(%z, %[[MATMUL]])
  # CHECK-NEXT:  kgen.return %[[ADD]] : !kgen.declref<@M>
  return z + M(3) @ -M(2)

# CHECK-LABEL: lit.func @"precedence_bitwise
fn precedence_bitwise(a: Int, b: Int, c: Int) -> Int:
  # CHECK-NEXT: %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT: %[[INT_TWO:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[TWO]])
  # CHECK-NEXT: %[[MUL:.*]] = kgen.call @Int::@"__mul__{{.*}}(%a, %[[INT_TWO]])
  # CHECK-NEXT: %[[AND:.*]] = kgen.call @Int::@"__and__{{.*}}(%[[MUL]], %b)
  # CHECK-NEXT: %[[FOUR:.*]] = {{.*}} 4
  # CHECK-NEXT: %[[INT_FOUR:.*]] = kgen.call @Int::@"__new__{{.*}}(%[[FOUR]])
  # CHECK-NEXT: %[[XOR:.*]] = kgen.call @Int::@"__xor__{{.*}}(%[[INT_FOUR]], %c)
  # CHECK-NEXT: %[[OR:.*]] = kgen.call @Int::@"__or__{{.*}}(%[[AND]], %[[XOR]])
  # CHECK-NEXT: kgen.return %[[OR]]
  return a * Int(2) & b | Int(4) ^ c

# CHECK-LABEL: @"comparisons
fn comparisons(a: Int, b: Int):
   var res: Bool
   # CHECK: kgen.call @Int::@"__lt__{{.*}}(%a, %b)
   res = a < b
   # CHECK: kgen.call @Int::@"__le__{{.*}}(%a, %b)
   res = a <= b
   # CHECK: kgen.call @Int::@"__gt__{{.*}}(%a, %b)
   res = a > b
   # CHECK: kgen.call @Int::@"__ge__{{.*}}(%a, %b)
   res = a >= b
   # CHECK: kgen.call @Int::@"__eq__{{.*}}(%a, %b)
   res = a == b
   # CHECK: kgen.call @Int::@"__ne__{{.*}}(%a, %b)
   res = a != b

struct Boolish:
  fn __bool__(self) -> Bool: return Bool.true()

# CHECK-LABEL: @"unary
fn unary(a: Bool, b: Int, c: Boolish):
  # CHECK: %0 = kgen.call @Bool::@"__bool__(Bool)"(%a)
  # CHECK: %1 = kgen.call @Bool::@"__invert__(Bool)"(%0)
  _ = not a

  # CHECK: [[EQ:%.*]] = kgen.call @Int::@"__eq__(Int,Int)"
  # CHECK: [[BOOL:%.*]] = kgen.call @Bool::@"__bool__(Bool)"([[EQ]])
  # CHECK:  = kgen.call @Bool::@"__invert__(Bool)"([[BOOL]])
  _ = not b == 0

  # CHECK: [[BOOL:%.*]] = kgen.call @Boolish::@"__bool__(Boolish)"(%c)
  # CHECK:  = kgen.call @Bool::@"__invert__(Bool)"([[BOOL]])
  _ = not c

# CHECK-LABEL: lit.func @"andOr
fn andOr(a: Boolish, b: Boolish, x: Bool):
  # Short circuiting AND returns second operand when the first is false-y, first
  # otherwise.

  # CHECK: %0 = kgen.call @Boolish::@"__bool__(Boolish)"(%a)
  # CHECK: %1 = kgen.call @Bool::@"__lit_bool(Bool)"(%0)
  # CHECK: %2 = scf.if %1 -> (!kgen.declref<@Boolish>) {
  # CHECK:   scf.yield %b
  # CHECK: } else {
  # CHECK:   scf.yield %a
  # CHECK: }
  _ = a and b

  # Short circuiting OR returns first operand when it is true-y, second
  # otherwise.

  # CHECK: %3 = kgen.call @Boolish::@"__bool__(Boolish)"(%a)
  # CHECK: %4 = kgen.call @Bool::@"__lit_bool(Bool)"(%3)
  # CHECK: %5 = scf.if %4 -> (!kgen.declref<@Boolish>) {
  # CHECK:   scf.yield %a
  # CHECK: } else {
  # CHECK:   scf.yield %b
  # CHECK: }
  _ = a or b

  # Testing two different logic'y types returns the common bool type if present.

  # CHECK: %6 = kgen.call @Boolish::@"__bool__(Boolish)"(%a)
  # CHECK: %7 = kgen.call @Bool::@"__lit_bool(Bool)"(%6)
  # CHECK: %8 = scf.if %7 -> (!kgen.declref<@Bool>) {
  # CHECK:   scf.yield %6
  # CHECK: } else {
  # CHECK:   %10 = kgen.call @Bool::@"__bool__(Bool)"(%x)
  # CHECK:   scf.yield %10
  # CHECK: }
   _ = a or x

