# RUN: kgen-translate -import-lit %s -I %S/../lit-examples/ | FileCheck %s

# CHECK: module {

from prolog import Error, F32, Int, SIMD, object

fn noop():

# CHECK-LABEL: lit.struct.decl @MemoryPrimaryType
@__memory_primary
struct MemoryPrimaryType:
  # CHECK: lit.func @"__clone__{{.*}}"(
  # CHECK-SAME: %__result__: !pop.pointer<@"$expressions"::@MemoryPrimaryType> byref-result,
  # CHECK-SAME: %self: !pop.pointer<@"$expressions"::@MemoryPrimaryType> byref) -> !lit.none {
  fn __clone__(self&: MemoryPrimaryType) -> MemoryPrimaryType:
    return MemoryPrimaryType {}

# CHECK-LABEL: lit.func @"memoryPrimaryOps
fn memoryPrimaryOps(a&: MemoryPrimaryType) -> MemoryPrimaryType:
  # CHECK-NEXT: %v1 = lit.var.decl "v1" : <@"$expressions"::@MemoryPrimaryType>
  # CHECK-NEXT: kgen.call @"$expressions"::@MemoryPrimaryType::@"__clone__($expressions::MemoryPrimaryType=&,$expressions::MemoryPrimaryType&)"(%v1, %a) : (!pop.pointer<@"$expressions"::@MemoryPrimaryType> byref-result, !pop.pointer<@"$expressions"::@MemoryPrimaryType> byref)
  var v1 = a

  # CHECK-NEXT: %v2 = lit.var.decl "v2" : <@"$expressions"::@MemoryPrimaryType>
  # CHECK-NEXT: kgen.call {{.*}}__clone__{{.*}}(%v2, %a)
  var v2 : MemoryPrimaryType = a

  # CHECK-NEXT: %_ = lit.var.decl "_"
  # CHECK-NEXT: kgen.call {{.*}}__clone__{{.*}}(%_, %a)
  _ = a

  # CHECK-NEXT: %3Canonymous3E = lit.var.decl "<anonymous>"
  # CHECK-NEXT: kgen.call {{.*}}__clone__{{.*}}(%3Canonymous3E, %a)
  a

  # CHECK-NEXT: kgen.call {{.*}}__clone__{{.*}}(%__result__, %v2)
  # CHECK-NEXT: [[NONEVAL:%.*]] = kgen.param.constant: !lit.none = <#lit.none>
  # CHECK-NEXT: lit.return [[NONEVAL]]
  return v2

# CHECK-LABEL: lit.struct.decl @M
struct M:
  var value : __mlir_type.index
  # CHECK-LABEL: lit.func @"__new__
  fn __new__(value: __mlir_type.index) -> M:
  # CHECK-NEXT: %0 = lit.struct.create(value=%value) : (index) -> !kgen.declref<@"$expressions"::@M>
    return M{value: value}
  fn __neg__(self) -> M:
    return M(0)
  fn __add__(self, rhs: M) -> M:
    return M(0)
  fn __matmul__(self, rhs: M) -> M:
    return M(0)
  fn __rmatmul__(lhs: M, self) -> M:
    return M(0)

# CHECK-LABEL: lit.func @"simpleMath
fn simpleMath(a: Int, b: Int) -> Int:
  # CHECK: %0 = kgen.call @"$Int"::@Int::@"__mul__{{.*}}(%b, %a)
  # CHECK: %1 = kgen.call @"$Int"::@Int::@"__sub__{{.*}}(%a, %0)
  # CHECK: lit.return %1 : !kgen.declref<@"$Int"::@Int>
  return a-b*a

# CHECK-LABEL: lit.func @"precedence_associativity
fn precedence_associativity(a: Int):
  # CHECK-NEXT: %z = lit.var.decl "z"
  var z: Int = 0

  # CHECK: [[SEVENTEENINT:%.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 17}>
  # CHECK-NEXT: pop.store [[SEVENTEENINT]], %z
  z = 17  # Implicit conversion

  # CHECK-NEXT: %[[Z:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%z)
  # CHECK-NEXT: %[[POW0:.*]] = kgen.call @"$Int"::@Int::@"__pow__{{.*}}(%a, %[[Z]])
  # CHECK-NEXT: %[[INT_TWO:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 2}>
  # CHECK-NEXT: %[[POW1:.*]] = kgen.call @"$Int"::@Int::@"__pow__{{.*}}(%[[INT_TWO]], %[[POW0]])
  # CHECK-NEXT: pop.store %[[POW1]], %z
  z = Int(2)**(a**z)
  # CHECK-NEXT: %[[Z:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%z)
  # CHECK-NEXT: %[[POW0:.*]] = kgen.call @"$Int"::@Int::@"__pow__{{.*}}(%a, %[[Z]])
  # CHECK-NEXT: %[[INT_TWO:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 2}>
  # CHECK-NEXT: %[[POW1:.*]] = kgen.call @"$Int"::@Int::@"__pow__{{.*}}(%[[INT_TWO]], %[[POW0]])
  # CHECK-NEXT: pop.store %[[POW1]], %z
  z = Int(2)**a**z
  # CHECK-NEXT:  %[[Z:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%z)
  # CHECK-NEXT:  %[[MUL:.*]] = kgen.param.constant: @"$Int"::@Int = <{{.*}} = -6}
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call @"$Int"::@Int::@"__add__{{.*}}(%[[Z]], %[[MUL]])
  # CHECK-NEXT:  pop.store %[[ADD]], %z
  z = z + Int(3) * -Int(2)
  # CHECK-NEXT:  %[[Z:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%z)
  # CHECK-NEXT:  %[[FLOOR_DIV:.*]] = kgen.param.constant: @"$Int"::@Int = <{{.*}} = -1}
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call @"$Int"::@Int::@"__add__{{.*}}(%[[Z]], %[[FLOOR_DIV]])
  # CHECK-NEXT:  pop.store %[[ADD]], %z
  z = z + Int(3) // -Int(2)
  # CHECK-NEXT:  %[[Z:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%z)
  # CHECK-NEXT:  %[[INT_THREE:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 3}>
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call @"$Int"::@Int::@"__add__{{.*}}(%[[Z]], %[[INT_THREE]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = -2}>
  # CHECK-NEXT:  %[[MUL:.*]] =  kgen.call @"$Int"::@Int::@"__mul__{{.*}}(%[[ADD]], %[[NEG]])
  # CHECK-NEXT:  pop.store %[[MUL]], %z
  z = (z + 3) * -+Int(2)
  # CHECK-NEXT:  %[[Z:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%z)
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 2}>
  # CHECK-NEXT:  %[[POW:.*]] = kgen.call @"$Int"::@Int::@"__pow__{{.*}}(%[[INT_TWO]], %[[Z]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call @"$Int"::@Int::@"__neg__{{.*}}(%[[POW]])
  # CHECK-NEXT:  pop.store %[[NEG]], %z
  z = -Int(2)**z
  # CHECK-NEXT: [[Z:%.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%z)
  # CHECK-NEXT: [[ONE:%.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 1}>
  # CHECK-NEXT: [[RES:%.*]] = kgen.call @"$Int"::@Int::@"__radd__($Int::Int,$Int::Int)"([[Z]], [[ONE]])
  # CHECK-NEXT: pop.store [[RES]], %z
  z = 1 + z

  # div tests
  # CHECK: kgen.call @"$F32"::@F32::@"__truediv__($F32::F32,$F32::F32)"
  var r0 = F32(33.0) / F32(42.0)

  # CHECK: kgen.call @"$F32"::@F32::@"__truediv__($F32::F32,$F32::F32)"
  var r1 = F32(33.0) / 42.0

# CHECK-LABEL: lit.func @"reverse_operators
fn reverse_operators(a: Int):
  # CHECK: [[RES:%.*]] = kgen.call @"$Int"::@Int::@"__radd__($Int::Int,$Int::Int)"
  var z = 1 + a

  # CHECK: [[RES:%.*]] = kgen.call @"$Int"::@Int::@"__rsub__($Int::Int,$Int::Int)"
  z = 2 - z

  # CHECK: [[RES:%.*]] = kgen.call @"$Int"::@Int::@"__rmul__($Int::Int,$Int::Int)"
  z = 3 * z

  # div tests
  # CHECK: kgen.call @"$F32"::@F32::@"__rtruediv__($F32::F32,$F32::F32)"
  # CHECK: kgen.call @"$Int"::@Int::@"__rfloordiv__($Int::Int,$Int::Int)"
  var r1 = 33.0 / F32(42.0)
  z = 33 // z

  # CHECK: kgen.call @"$Int"::@Int::@"__rmod__($Int::Int,$Int::Int)"
  var i0 = 10 % z

# CHECK: kgen.call @"$Int"::@Int::@"__rpow__($Int::Int,$Int::Int)"
  var i1 = 3 ** z

  # CHECK: kgen.call @"$Int"::@Int::@"__rlshift__($Int::Int,$Int::Int)"
  var i2 = 1 << z

  # CHECK: kgen.call @"$Int"::@Int::@"__rrshift__($Int::Int,$Int::Int)"
  var i3 = 1 >> z

  # CHECK: kgen.call @"$Int"::@Int::@"__rand__($Int::Int,$Int::Int)"
  z = 1 & z

  # CHECK: kgen.call @"$Int"::@Int::@"__ror__($Int::Int,$Int::Int)"
  z = 2 | z

  # CHECK: kgen.call @"$Int"::@Int::@"__rxor__($Int::Int,$Int::Int)"
  z = 3 ^ z

# CHECK-LABEL: lit.func @"precedence_matmul
fn precedence_matmul(z: M) -> M:
  # CHECK-NEXT:  %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT:  %[[INT_THREE:.*]] = kgen.call @"$expressions"::@M::@"__new__{{.*}}(%[[THREE]])
  # CHECK-NEXT:  %[[TWO:.*]] = {{.*}} 2
  # CHECK-NEXT:  %[[INT_TWO:.*]] = kgen.call @"$expressions"::@M::@"__new__{{.*}}(%[[TWO]])
  # CHECK-NEXT:  %[[NEG:.*]] = kgen.call @"$expressions"::@M::@"__neg__{{.*}}(%[[INT_TWO]])
  # CHECK-NEXT:  %[[MATMUL:.*]] = kgen.call @"$expressions"::@M::@"__matmul__{{.*}}(%[[INT_THREE]], %[[NEG]])
  # CHECK-NEXT:  %[[ADD:.*]] = kgen.call @"$expressions"::@M::@"__add__{{.*}}(%z, %[[MATMUL]])
  # CHECK-NEXT:  lit.return %[[ADD]] : !kgen.declref<@"$expressions"::@M>
  return z + M(3) @ -M(2)

# CHECK-LABEL: lit.func @"precedence_bitwise
fn precedence_bitwise(a: Int, b: Int, c: Int) -> Int:
  # CHECK-NEXT: %[[INT_TWO:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 2}>
  # CHECK-NEXT: %[[MUL:.*]] = kgen.call @"$Int"::@Int::@"__mul__{{.*}}(%a, %[[INT_TWO]])
  # CHECK-NEXT: %[[AND:.*]] = kgen.call @"$Int"::@Int::@"__and__{{.*}}(%[[MUL]], %b)
  # CHECK-NEXT: %[[INT_FOUR:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 4}>
  # CHECK-NEXT: %[[XOR:.*]] = kgen.call @"$Int"::@Int::@"__xor__{{.*}}(%[[INT_FOUR]], %c)
  # CHECK-NEXT: %[[OR:.*]] = kgen.call @"$Int"::@Int::@"__or__{{.*}}(%[[AND]], %[[XOR]])
  # CHECK-NEXT: lit.return %[[OR]]
  return a * Int(2) & b | Int(4) ^ c

# CHECK-LABEL: @"comparisons
fn comparisons(a: Int, b: Int):
   var res: Bool
   # CHECK: kgen.call @"$Int"::@Int::@"__lt__{{.*}}(%a, %b)
   res = a < b
   # CHECK: kgen.call @"$Int"::@Int::@"__le__{{.*}}(%a, %b)
   res = a <= b
   # CHECK: kgen.call @"$Int"::@Int::@"__gt__{{.*}}(%a, %b)
   res = a > b
   # CHECK: kgen.call @"$Int"::@Int::@"__ge__{{.*}}(%a, %b)
   res = a >= b
   # CHECK: kgen.call @"$Int"::@Int::@"__eq__{{.*}}(%a, %b)
   res = a == b
   # CHECK: kgen.call @"$Int"::@Int::@"__ne__{{.*}}(%a, %b)
   res = a != b

struct Boolish:
  fn __bool__(self) -> Bool: return Bool.true()

# CHECK-LABEL: @"unary
fn unary(a: Bool, b: Int, c: Boolish):
  # CHECK: %0 = kgen.call @"$_CompilerBuiltin"::@Bool::@"__bool__($_CompilerBuiltin::Bool)"(%a)
  # CHECK: %1 = kgen.call @"$_CompilerBuiltin"::@Bool::@"__invert__($_CompilerBuiltin::Bool)"(%0)
  # CHECK: %_ = lit.var.decl "_"
  # CHECK: pop.store %1, %_
  _ = not a

  # CHECK: [[EQ:%.*]] = kgen.call @"$Int"::@Int::@"__eq__($Int::Int,$Int::Int)"
  # CHECK: [[EQBOOL:%.*]] = kgen.call @"$_CompilerBuiltin"::@Bool::@"__bool__($_CompilerBuiltin::Bool)"([[EQ]])
  # CHECK:  = kgen.call @"$_CompilerBuiltin"::@Bool::@"__invert__($_CompilerBuiltin::Bool)"([[EQBOOL]])
  _ = not b == 0

  # CHECK: [[BOOL:%.*]] = kgen.call @"$expressions"::@Boolish::@"__bool__($expressions::Boolish)"(%c)
  # CHECK:  = kgen.call @"$_CompilerBuiltin"::@Bool::@"__invert__($_CompilerBuiltin::Bool)"([[BOOL]])
  _ = not c

# CHECK-LABEL: lit.func @"andOr
fn andOr(a: Boolish, b: Boolish, x: Bool):
  # Short circuiting AND returns second operand when the first is false-y, first
  # otherwise.

  # CHECK: %0 = kgen.call @"$expressions"::@Boolish::@"__bool__($expressions::Boolish)"(%a)
  # CHECK: %1 = kgen.call @"$_CompilerBuiltin"::@Bool::@"__lit_bool($_CompilerBuiltin::Bool)"(%0)
  # CHECK: %2 = hlcf.if %1 -> !kgen.declref<@"$expressions"::@Boolish> {
  # CHECK:   hlcf.yield %b
  # CHECK: } else {
  # CHECK:   hlcf.yield %a
  # CHECK: }
  _ = a and b

  # Short circuiting OR returns first operand when it is true-y, second
  # otherwise.

  # CHECK: %3 = kgen.call @"$expressions"::@Boolish::@"__bool__($expressions::Boolish)"(%a)
  # CHECK: %4 = kgen.call @"$_CompilerBuiltin"::@Bool::@"__lit_bool($_CompilerBuiltin::Bool)"(%3)
  # CHECK: %5 = hlcf.if %4 -> !kgen.declref<@"$expressions"::@Boolish> {
  # CHECK:   hlcf.yield %a
  # CHECK: } else {
  # CHECK:   hlcf.yield %b
  # CHECK: }
  _ = a or b

  # Testing two different logic'y types returns the common bool type if present.

  # CHECK: %6 = kgen.call @"$expressions"::@Boolish::@"__bool__($expressions::Boolish)"(%a)
  # CHECK: %7 = kgen.call @"$_CompilerBuiltin"::@Bool::@"__lit_bool($_CompilerBuiltin::Bool)"(%6)
  # CHECK: %8 = hlcf.if %7 -> !kgen.declref<@"$_CompilerBuiltin"::@Bool> {
  # CHECK:   hlcf.yield %6
  # CHECK: } else {
  # CHECK:   %9 = kgen.call @"$_CompilerBuiltin"::@Bool::@"__bool__($_CompilerBuiltin::Bool)"(%x)
  # CHECK:   hlcf.yield %9
  # CHECK: }
   _ = a or x


# CHECK-LABEL: lit.func @"do_math
fn do_math(a: Int, b: Int, c: Int) -> Int:
  # CHECK-NEXT: %z = lit.var.decl "z"
  var z : Int
  # CHECK-NEXT: %[[INT_5:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 5}>
  # CHECK-NEXT: %[[MUL:.*]] = kgen.call @"$Int"::@Int::@"__mul__{{.*}}(%[[INT_5]], %a)
  # CHECK-NEXT: %[[INT_42:.*]] = kgen{{.*}}#lit.struct<{value: scalar<index> = 42}>
  # CHECK-NEXT: %[[ADD:.*]] = kgen.call @"$Int"::@Int::@"__add__{{.*}}(%[[INT_42]], %[[MUL]])
  # CHECK-NEXT: pop.store %[[ADD]], %z
  z = Int(42) + Int(5)*a

  # CHECK-NEXT: %x = lit.var.decl "x"
  # CHECK-NEXT: %[[TMP:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%z)
  # CHECK-NEXT: pop.store %[[TMP]], %x
  # This is checking the lexer handles \ at end of line correctly.
  var x : Int
  x = \
z

  # CHECK-NEXT: kgen.call @"$expressions"::@"noop()"()
  noop()

  # CHECK-NEXT: %[[TMP:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%x)
  # CHECK-NEXT: lit.return %[[TMP]]
  return x

# CHECK-LABEL: lit.func @"listValues()"() -> index
fn listValues() -> __mlir_type.index:
  # CHECK: %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT: pop.store %[[THREE:.*]], %a
  var a = [1, 2, 2+1]
  # CHECK: %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT: pop.store %[[THREE:.*]], %a
  a = [1, 2, 2+1,]
  # CHECK: %[[THREE:.*]] = {{.*}} 3
  # CHECK-NEXT: pop.store %[[THREE:.*]], %a
  a = [1, 2,
            2+1]
  # CHECK:      %[[NONE:.*]] = kgen.param.constant: !lit.none = <#lit.none>
  # CHECK-NEXT: pop.store %[[NONE:.*]], %b
  var b = []
  return a

# CHECK-LABEL: lit.func @"initializers
fn initializers():
  # CHECK: %0 = kgen.param.constant: scalar<index> = <42>
  # CHECK: %1 = lit.struct.create(value=%0)
  _ = Int{value: Int(42).value}

  # Issue #7343: Trailing comma ok too.
  _ = Int{value: Int(42).value,}

# CHECK-LABEL: lit.func @"test_if_cond
def test_if_cond(cond: Bool):
    # CHECK:      %[[I:.*]] = lit.var.decl "i" : <@"$Int"::@Int>
    # CHECK-NEXT: %[[COND:.*]] = kgen.call @"$_CompilerBuiltin"::@Bool::@"__clone__($_CompilerBuiltin::Bool&)"(%cond_0)
    # CHECK: %[[LIT_BOOLI1:.*]] = kgen.call @"$_CompilerBuiltin"::@Bool::@"__lit_bool($_CompilerBuiltin::Bool)"(%[[COND]])
    # CHECK-NEXT: %[[IF_RES:.*]] = hlcf.if %[[LIT_BOOLI1]]
    # CHECK-NEXT:   %[[INT_TWO:.*]] = kgen{{.*}}= 2}
    # CHECK-NEXT:   hlcf.yield %[[INT_TWO]]
    # CHECK-NEXT: } else {
    # CHECK-NEXT:   %[[INT_THREE:.*]] = kgen{{.*}}= 3}
    # CHECK-NEXT:   hlcf.yield %[[INT_THREE]]
    # CHECK-NEXT: }
    # CHECK-NEXT: pop.store %[[IF_RES]], %i
    var i: Int = Int(2) if cond else Int(3)

    # CHECK: [[TRUEB:%.+]] = kgen{{.*}}= true}
    # CHECK-NEXT: pop.store [[TRUEB]], %cond
    cond = Bool.true()
    i += i
    if cond:     # 'if' stmt, not an 'if' expression.
        i = i+i

# CHECK-LABEL: lit.func @"callable_mv{{.*}}"<callable: (index) -> index>(%a: index) -> index
fn callable_mv[callable: __mlir_type.`!kgen.signature<(index) -> index>`](a: __mlir_type.index) -> __mlir_type.index:
  # CHECK-NEXT: kgen.call_param[(index) -> index: callable](%a)
  return callable(a)

# CHECK-LABEL: lit.func @"callable_mv_inputs{{.*}}"<callable: <M>(index) -> index, b>(%a: index) -> index
fn callable_mv_inputs[callable: __mlir_type.`!kgen.signature<<M>(index) -> index>`, b: __mlir_type.index](a: __mlir_type.index) -> __mlir_type.index:
  # CHECK-NEXT: kgen.call_param[(index) -> index: bind_signature(:<M>(index) -> index callable, b)](%a)
  return callable[b](a)

# CHECK-LABEL: lit.func @"takeIndexParam()"<a>() -> index
fn takeIndexParam[a: __mlir_type.index]() -> __mlir_type.index:
  return a + 1

# CHECK-LABEL: lit.func @"returnIndex()"() -> index
fn returnIndex() -> __mlir_type.index:
  return 0

# CHECK-LABEL: lit.func @"returnIndex2()"() -> index
fn returnIndex2() -> __mlir_type.index:
  # CHECK-NEXT: %0 = kgen.call @"$expressions"::@"takeIndexParam()"<a = apply(:() -> index @"$expressions"::@"returnIndex()")>() : () -> index
  # CHECK-NEXT: return %0
  return takeIndexParam[returnIndex()]()

# CHECK-LABEL: lit.func @"callInParam()"<callable: <a>(index) -> index>() -> index
fn callInParam[callable: __mlir_type.`!kgen.signature<<a>(index) -> index>`]() -> __mlir_type.index:
  # CHECK-NEXT: %0 = kgen.call @"$expressions"::@"takeIndexParam()"<a = apply(:(index) -> index bind_signature(:<a>(index) -> index callable, 1), 1)>() : () -> index
  # CHECK-NEXT: return %0
  return takeIndexParam[callable[1](1)]()

# CHECK-LABEL: parameterExprs
fn parameterExprs[a: __mlir_type.index, a2: __mlir_type.index]():
  # CHECK: kgen.param.declare b = <0>
  alias b = a-a
  # CHECK: kgen.param.declare c = <add(a, -42)>
  alias c = a-42
  # CHECK: kgen.param.declare d = <add(mul(a2, -1), a)>
  alias d = a-a2

##===----------------------------------------------------------------------===##
# Patterns, LValues and RValues
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"patterns()
fn patterns():
  # CHECK: %z2 = lit.var.decl "z2" : <index>
  var z2: __mlir_type.index

  (((z2))) = 42  # Paren patterns
  # CHECK: [[TMP:%.*]] = index.constant 42
  # CHECK: pop.store [[TMP]], %z2

  var someInt : Int
  (someInt) += someInt
  # CHECK: %someInt = lit.var.decl "someInt" : <@"$Int"::@Int>
  # CHECK:  %0 = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%someInt)
  # CHECK:  %1 = kgen.call @"$Int"::@Int::@"__iadd__{{.*}}(%someInt, %0)

  # Discard pattern with different types.
  (_) = someInt
  # CHECK:  %2 = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%someInt)

  (_) = 1.0
  # CHECK: %3 = kgen.param.constant: f64 = <1.0

  # CHECK: %someF32 = lit.var.decl "someF32" : <@"$F32"::@F32>
  # CHECK: [[F32:%.*]] = kgen.call @"$F32"::@F32::@"__clone__($F32::F32&)"(%someF32)
  # CHECK: {{%.*}} = kgen.call @"$F32"::@F32::@"__iadd__{{.*}}(%someF32, [[F32]])
  var someF32 : F32
  (someF32) += someF32

  # CHECK: %someSIMD = lit.var.decl "someSIMD" : <@"$SIMD"::@SIMD<size = 4, type: dtype = f64>>
  # CHECK: [[SIMD:%.*]] = kgen.call @"$SIMD"::@SIMD::@"__clone__($SIMD::SIMD[size, type]&)"<size = 4, type: dtype = f64>(%someSIMD)
  # CHECK: {{%.*}} = kgen.call @"$SIMD"::@SIMD::@"__iadd__{{.*}}(%someSIMD, [[SIMD]])
  var someSIMD : SIMD[4, __mlir_attr.`#kgen.dtype.constant<f64> : !kgen.dtype`]
  (someSIMD) += someSIMD

# CHECK-LABEL: lit.func @"byval_byref_function($Int::Int,$Int::Int&)"(%a: !kgen.declref<@"$Int"::@Int>, %b: !pop.pointer<@"$Int"::@Int> byref) -> !lit.none
fn byval_byref_function(a: Int, b&: Int):
  # CHECK-NEXT: pop.store %a, %b
  b = a

  # CHECK-NEXT: %x = lit.var.decl "x"
  var x : Int
  # This needs to load 'b' to pass it by value for the first arg, but pass its
  # address in directly for the second.
  # CHECK: %0 = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b)
  # CHECK: %1 = kgen.call @{{.*}}::@"byval_byref_function{{.*}}(%0, %b)
  byval_byref_function(b, b)

# CHECK-LABEL: lit.func @"lvaluesAndRValues()
fn lvaluesAndRValues() -> __mlir_type.`!pop.scalar<index>`:
  # CHECK: [[VALUE:%.*]] = kgen{{.*}} = <4>
  # CHECK: lit.return [[VALUE]] : !pop.scalar<index>
  return Int(4).value

# CHECK-LABEL: lit.func @"mvalueStructField()"
fn mvalueStructField():
  alias int = Int(4)
  # CHECK: value: scalar<index> = <
  # CHECK-SAME: #lit.struct.extract<:@"$Int"::@Int int, "value">>
  alias value = int.value
  alias foldToValue = Int(5).value

# CHECK-LABEL: lit.func @"defTests({{.*}}, %untyped: !kgen.declref<@"$prolog"::@object>)
def defTests(a: Int, b: Int, untyped):
  # CHECK: [[TMP:%.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # CHECK-NEXT: pop.store [[TMP]], %a_0
  a = b # Parameters are mutable!

##===----------------------------------------------------------------------===##
# Augmented Assignments
##===----------------------------------------------------------------------===##

def basic_assignments(a: Int, b: Int, c: M, d: M):
  # CHECK:      %a_0 = lit.var.decl "a"
  # CHECK:      %b_1 = lit.var.decl "b"
  # CHECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__iadd__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  a += b
  # CHECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__isub__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  a -= b
  # CHECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__imul__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  a *= b
  # HECK:      %[[LOAD_C:.*]] = pop.load %c_2  : !pop.pointer<@M>
  # HECK-NEXT: %[[RES:.*]] = kgen.call @M::@"__imatmul__($Int::Int&,$Int::Int)"(%d_3, %[[LOAD_C]])
  #d @= c
  # HECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # HECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__itruediv__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  #a /= b
  # CHECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__ifloordiv__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  a //= b
  # HECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # HECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__imod__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  # a %= b
  # CHECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__ipow__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  a **= b
  # CHECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__irshift__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  a >>= b
  # CHECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__ilshift__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  a <<= b
  # CHECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__iand__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  a &= b
  # CHECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__ixor__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  a ^= b
  # CHECK:      %[[LOAD_B:.*]] = kgen.call @"$Int"::@Int::@"__clone__($Int::Int&)"(%b_1)
  # CHECK-NEXT: %[[RES:.*]] = kgen.call @"$Int"::@Int::@"__ior__($Int::Int&,$Int::Int)"(%a_0, %[[LOAD_B]])
  a |= b

##===----------------------------------------------------------------------===##
# Literals
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"tmp
def tmp():
    a = 5             # CHECK: 5
    a = 55            # CHECK: 55
    a = 10500         # CHECK: 10500
    a = 12_500        # CHECK: 12500
    a = 0             # CHECK: 0
    a = 00            # CHECK: 0
    a = 0____0__0_0   # CHECK: 0
    a = 00__0_0       # CHECK: 0
    a = 1__9_         # CHECK: 19
    a = 0x123         # CHECK: 291
    a = 0X123         # CHECK: 291
    a = 0b10101       # CHECK: 21
    a = 0B10101       # CHECK: 21
    a = 0o711         # CHECK: 457
    a = 0O711         # CHECK: 457
    b = 1.1           # CHECK: 1.100000e+00
    b = .1            # CHECK: 1.000000e-01
    b = 1.            # CHECK: 1.000000e+00
    b = 1e2           # CHECK: 1.000000e+02
    b = 1.1e2         # CHECK: 1.100000e+02
    b = .1e2          # CHECK: 1.000000e+01
    b = 1.e2          # CHECK: 1.000000e+02
    b = 1e+2          # CHECK: 1.000000e+02
    b = 1.1e-2        # CHECK: 1.100000e-02
    b = .1e+2         # CHECK: 1.000000e+01
    b = 1.e-2         # CHECK: 1.000000e-02
    b = 0.1           # CHECK: 1.000000e-01
    b = 0.            # CHECK: 0.000000e+00
    b = 0e2           # CHECK: 0.000000e+00
    b = 0.1e2         # CHECK: 1.000000e+01
    b = 0.e2          # CHECK: 0.000000e+00
    b = 0e+2          # CHECK: 0.000000e+00
    b = 0.1e-2        # CHECK: 1.000000e-03
    b = 0.e-2         # CHECK: 0.000000e+00
    b = 12.31e+11     # CHECK: 1.231000e+12
    b = 1_2.3__1e+1_1 # CHECK: 1.231000e+12
    b = 12.31E-3      # CHECK: 1.231000e-02
    c = False         # CHECK: @BoolLiteral = <#lit.struct<{value: scalar<bool> = false}>>
    c = True          # CHECK: @BoolLiteral = <#lit.struct<{value: scalar<bool> = true}>>

fn strings():
   """
      Various tests on strings
   """

    var a = ""                 # CHECK: ""
    # CHECK: "hello world"
    a = "hello \
world"

    # COM: match newline hex values via regex since they vary between OSs
    # CHECK: "hello \\\{{[0-9A-Z]+}}world"
    a = r"hello \
world"

    # CHECK  "1'\0A2"
    a = """1'
2"""

    # CHECK  "1\222"
    a = '''1"\
2'''

    # CHECK   "1\22\0A2"
    a = '''1"
2'''

    # CHECK   "1\22\0A2"
    a = '1"\n2'

    a = "Hello"            # CHECK: "Hello"
    a = "Hello 'world'"    # CHECK: "Hello 'world'"
    a = "A\x42"            # CHECK: "AB"
    a = "A\x423"           # CHECK: "AB3"
    a = "A\102"            # CHECK: "AB"
    a = "A\1023"           # CHECK: "AB3"

    # COM: the MLIR textual representation escapes strings, so below \ is \\ and " is \"
    a = 'Hello "world"'    # CHECK: "Hello \22world\22"
    a = r"A\x42"           # CHECK: "A\\x42"
    a = R"A\x42"           # CHECK: "A\\x42"
    a = r"AB\\"            # CHECK: "AB\\\\"
    a = r"A\x"             # CHECK: "A\\x"
    a = "AB\\"             # CHECK: "AB\\"
    a = r"A\"B"            # CHECK: "A\\\22B"
    a = r'A\'B'            # CHECK: "A\\'B"
    a = "A\"B"             # CHECK: "A\22B"
    a = 'A\'B'             # CHECK: "A'B"
    a = r"A\zB"            # CHECK: "A\\zB"

##===----------------------------------------------------------------------===##
# Computed Properties and Subscripts
##===----------------------------------------------------------------------===##

struct WeirdArray:
  fn __getitem__(self, x: Int) -> Int:
    return 1
  fn __getitem__(self, x: Int, y: Int) -> Int:
    return 2
  fn __getitem__(self, x: Int, y: Int, z: Int) -> Int:
    return 3
  fn __getitem__(self, x: F32, *ints: Int) -> F32:
    return x


# CHECK-LABEL: lit.func @"testWeirdArray
fn testWeirdArray(a: WeirdArray, idx: Int, f: F32):
  # CHECK: kgen.call {{.*}}@WeirdArray::@"__getitem__{{.*}}(%a, %idx)
  _ = a[idx]
  # CHECK: kgen.call {{.*}}@WeirdArray::@"__getitem__{{.*}}(%a, %idx, %idx)
  _ = a[idx, idx]
  # CHECK: kgen.call {{.*}}@WeirdArray::@"__getitem__{{.*}}(%a, %idx, %idx, %idx)
  _ = a[idx, idx, idx]
  # CHECK: [[VARIADIC:%.*]] = pop.variadic.create [%idx, %idx, %idx, %idx]
  # CHECK: kgen.call {{.*}}@WeirdArray::@"__getitem__{{.*}}(%a, %f, [[VARIADIC]])
  _ = a[f, idx, idx, idx, idx]

# CHECK-LABEL: lit.func @"chained_cmp
fn chained_cmp(a: Int, b: Int, c: Int, d: Int, e: Int):
    # CHECK:      %[[CMP_A_B:.*]] = kgen.call @{{.*}}__lt__{{.*}}(%a, %b)
    # CHECK-NEXT: %[[CMP_A_B_I1:.*]] = kgen.call @{{.*}}__lit_bool{{.*}}(%[[CMP_A_B]])
    # CHECK-NEXT: %[[IF_A_B:.*]] = hlcf.if %[[CMP_A_B_I1]]
    # CHECK-NEXT:   %[[CMP_B_C:.*]] = kgen.call @{{.*}}__lt__{{.*}}(%b, %c)
    # CHECK:        %[[IF_B_C:.*]] = hlcf.if
    # CHECK-NEXT:     %[[CMP_C_D:.*]] = kgen.call @{{.*}}__lt__{{.*}}(%c, %d)
    # CHECK-NEXT:     hlcf.yield %[[CMP_C_D]]
    # CHECK-NEXT:   } else {
    # CHECK-NEXT:     hlcf.yield %[[CMP_B_C]]
    # CHECK-NEXT:   }
    # CHECK-NEXT:   hlcf.yield %[[IF_B_C]]
    # CHECK-NEXT: } else {
    # CHECK-NEXT:   hlcf.yield %[[CMP_A_B]]
    # CHECK-NEXT: }
    # CHECK-NEXT: pop.store %[[IF_A_B]], %res : !pop.pointer<@"$_CompilerBuiltin"::@Bool>
    var res = a < b < c < d

    # COM: This checks the parsing precedence between `<` and `and`.
    # CHECK:      %[[CMP_A_B:.*]] = kgen.call @{{.*}}__lt__{{.*}}(%a, %b)
    # CHECK-NEXT: %[[CMP_A_B_I1:.*]] = kgen.call @{{.*}}__lit_bool{{.*}}(%[[CMP_A_B]])
    # CHECK-NEXT: %[[IF_A_B:.*]] = hlcf.if %[[CMP_A_B_I1]]
    # CHECK-NEXT:   %[[CMP_B_C:.*]] = kgen.call @{{.*}}__lt__{{.*}}(%b, %c)
    # CHECK-NEXT:   hlcf.yield %[[CMP_B_C]]
    # CHECK-NEXT: } else {
    # CHECK-NEXT:   hlcf.yield %[[CMP_A_B]]
    # CHECK-NEXT: }
    # CHECK-NEXT: %[[CMP_I1:.*]] = kgen.call @{{.*}}__lit_bool{{.*}}(%[[IF_A_B]])
    # CHECK-NEXT: %[[IF:.*]] = hlcf.if %[[CMP_I1]]
    # CHECK-NEXT:   %[[CMP_D_E:.*]] = kgen.call @{{.*}}__lt__{{.*}}(%d, %e)
    # CHECK-NEXT:   hlcf.yield %[[CMP_D_E]]
    # CHECK-NEXT: } else {
    # CHECK-NEXT:   hlcf.yield %[[IF_A_B]]
    # CHECK-NEXT: }
    # CHECK-NEXT: pop.store %[[IF]], %res : !pop.pointer<@"$_CompilerBuiltin"::@Bool>
    res = a < b < c and d < e

# CHECK-LABEL: lit.func @"foo_adaptive(){{.*}} {isAdaptive}
@adaptive
fn foo_adaptive[x: __mlir_type.index]() -> __mlir_type.index:
   return 0

# CHECK-LABEL: lit.func @"foo_adaptive()_0{{.*}} {isAdaptive}
@adaptive
fn foo_adaptive[x: __mlir_type.index]() -> __mlir_type.index:
  return 1

# CHECK-LABEL: lit.func @"test_adaptive_set
fn test_adaptive_set():
    #CHECK: kgen.param.declare not_bound: variadic<!kgen.signature<<x>() -> index>> =
    #CHECK-SAME: <[@"{{.*}}foo_adaptive()", @"{{.*}}foo_adaptive()_0"]>
    alias not_bound = foo_adaptive.__adaptive_set
    #CHECK-NEXT: kgen.param.declare bound: variadic<!kgen.signature<() -> index>> =
    #CHECK-SAME: <[@"{{.*}}foo_adaptive()"<x = 1>, @"{{.*}}foo_adaptive()_0"<x = 1>]>
    alias bound = foo_adaptive[1].__adaptive_set
