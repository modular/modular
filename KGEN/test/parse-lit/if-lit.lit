# RUN: kgen-translate -import-lit %s | FileCheck %s

struct Int:
  pass

# CHECK-LABEL: lit.func @test_if(%a: index, %b: index, %c: index) -> index {
def test_if(a: index, b: index, c: index) -> index:
  # CHECK: %inside_a = lit.var.decl "inside_a" : <index>
  # CHECK-NEXT: %inside_c = lit.var.decl "inside_c" : <index>
  # CHECK-NEXT: %inside_else = lit.var.decl "inside_else" : <index>
  # CHECK-NEXT: %z = lit.var.decl "z" : <index>
  # CHECK:          hlcf.if
  if a:
    inside_a = 0
  # CHECK:          } else {
  # CHECK:            hlcf.if
  elif b:
    # CHECK-NEXT: %inside_b = lit.var.decl "inside_b" : <@Int>
    var inside_b : Int
  # CHECK:            } else {
  # CHECK:              hlcf.if
  elif c:
    inside_c = 2
  # CHECK:              } else {
  else:
    inside_else = 3
  # CHECK:                hlcf.yield
  # CHECK-NEXT:         }
  # CHECK-NEXT:         hlcf.yield
  # CHECK-NEXT:       }
  # CHECK-NEXT:       hlcf.yield
  # CHECK-NEXT:     }
  z = 4
  return a

# CHECK-LABEL: lit.func @test_if_nested(%a: index, %b: index, %c: index) -> index {
def test_if_nested(a: index, b: index, c: index) -> index:
  # CHECK: %inside_a = lit.var.decl "inside_a" : <index>
  # CHECK-NEXT: %inside_c = lit.var.decl "inside_c" : <index>
  # CHECK-NEXT: %inside_else = lit.var.decl "inside_else" : <index>
  # CHECK-NEXT: %z = lit.var.decl "z" : <index>
  # CHECK:                    hlcf.if
  if a:
    inside_a = 0
  # CHECK:                   } else {
  # CHECK:                     hlcf.if
  else:
    if b:
      # CHECK-NEXT: %inside_b = lit.var.decl "inside_b" : <@Int>
      var inside_b : Int
  # CHECK:                     } else {
  # CHECK:                       hlcf.if
    else:
      if c:
        inside_c = 2
  # CHECK:                       } else {
      else:
        inside_else = 3
  # CHECK:                         hlcf.yield
  # CHECK:                       }
  # CHECK:                       hlcf.yield
  # CHECK-NEXT:               }
  # CHECK:                    hlcf.yield
  # CHECK-NEXT:             }
  z = 4
  return a
