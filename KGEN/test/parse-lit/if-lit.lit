# RUN: kgen-translate -import-lit %s | FileCheck %s

struct Int:
  pass

# CHECK-LABEL: lit.func public @test_if(%a: index, %b: index, %c: index) -> index {
def test_if(a: index, b: index, c: index) -> index:
  # CHECK-NEXT: %z = lit.var.decl "z" : <index>
  # CHECK-NEXT: %inside_else = lit.var.decl "inside_else" : <index>
  # CHECK-NEXT: %inside_c = lit.var.decl "inside_c" : <index>
  # CHECK-NEXT: %inside_b = lit.var.decl "inside_b" : <!kgen.ref<@Int>>
  # CHECK-NEXT: %inside_a = lit.var.decl "inside_a" : <index>
  # CHECK:          scf.if
  if a:
    inside_a = 0
  # CHECK:          } else {
  # CHECK:            scf.if
  elif b:
    var inside_b : Int
  # CHECK:          } else {
  # CHECK:            scf.if
  elif c:
    inside_c = 2
  # CHECK:          } else {
  else:
    inside_else = 3
  # CHECK:                }
  # CHECK-NEXT:        }
  # CHECK-NEXT:     }
  z = 4
  return a

# CHECK-LABEL: lit.func public @test_if_nested(%a: index, %b: index, %c: index) -> index {
def test_if_nested(a: index, b: index, c: index) -> index:
  # CHECK-NEXT: %z = lit.var.decl "z" : <index>
  # CHECK-NEXT: %inside_else = lit.var.decl "inside_else" : <index>
  # CHECK-NEXT: %inside_c = lit.var.decl "inside_c" : <index>
  # CHECK-NEXT: %inside_b = lit.var.decl "inside_b" : <!kgen.ref<@Int>>
  # CHECK-NEXT: %inside_a = lit.var.decl "inside_a" : <index>
  # CHECK:                    scf.if
  if a:
    inside_a = 0
  # CHECK:                   } else {
  # CHECK:                     scf.if
  else:
    if b:
      var inside_b : Int
  # CHECK:                   } else {
  # CHECK:                     scf.if
    else:
      if c:
        inside_c = 2
  # CHECK:                   } else {
      else:
        inside_else = 3
  # CHECK:                         }
  # CHECK-NEXT:                 }
  # CHECK-NEXT:              }
  z = 4
  return a
