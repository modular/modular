# RUN: kgen-translate -import-lit %s -I %stdlibdir -I %S/../lit-examples/ | FileCheck %s

from prolog import Bool, Int

# CHECK-LABEL: lit.func @"test_if
fn test_if(a: Bool, b: Bool, c: Bool) -> Bool:
  # CHECK:          hlcf.if
  if a:
    # CHECK-NEXT: %inside_a = lit.var.decl "inside_a"
    var inside_a: Int
  # CHECK:          } else {
  # CHECK:            hlcf.if
  elif b:
    # CHECK-NEXT: %inside_b = lit.var.decl "inside_b"
    var inside_b : Int
  # CHECK:            } else {
  # CHECK:              hlcf.if
  elif c:
    # CHECK-NEXT: %inside_c = lit.var.decl "inside_c"
    var inside_c: Int
  # CHECK:              } else {
  else:
    # CHECK-NEXT: %inside_else = lit.var.decl "inside_else"
    var inside_else: Int
  # CHECK:                hlcf.yield
  # CHECK-NEXT:         }
  # CHECK-NEXT:         hlcf.yield
  # CHECK-NEXT:       }
  # CHECK-NEXT:       hlcf.yield
  # CHECK-NEXT:     }
  var z: Int = Int(4)
  return a


# CHECK-LABEL: lit.func @"test_if_nested
fn test_if_nested(a: Bool, b: Bool, c: Bool) -> Bool:
  # CHECK-NEXT:   %[[LIT_BOOL:.*]] = kgen.struct.extract %a[value]
  # CHECK-NEXT:   %[[I1:.*]] = pop.cast_to_builtin %[[LIT_BOOL]] : !pop.scalar<bool> to i1
  # CHECK-NEXT:              hlcf.if %[[I1]]
  if a:
    # CHECK-NEXT: %inside_a = lit.var.decl "inside_a"
    var inside_a: Int
  # CHECK:                   } else {
  # CHECK:                     hlcf.if
  else:
    if b:
      # CHECK-NEXT: %inside_b = lit.var.decl "inside_b"
      var inside_b : Int
  # CHECK:                     } else {
  # CHECK:                       hlcf.if
    else:
      if c:
        # CHECK-NEXT: %inside_c = lit.var.decl "inside_c"
        var inside_c: Int
  # CHECK:                       } else {
      else:
        # CHECK-NEXT: %inside_else = lit.var.decl "inside_else"
        var inside_else: Int
  # CHECK:                         hlcf.yield
  # CHECK:                       }
  # CHECK:                       hlcf.yield
  # CHECK-NEXT:               }
  # CHECK:                    hlcf.yield
  # CHECK-NEXT:             }
  var z: Int = Int(4)
  return a
