# RUN: kgen-translate -import-lit -verify-diagnostics %s -I %S/../lit-examples/

from prolog import Bool, DType, Error, F32, Int, object

##===----------------------------------------------------------------------===##
# KGEN Interfaces
##===----------------------------------------------------------------------===##

@interface
# expected-error @+1 {{interfaces must have no body}}
def bad_interface_with_body0(x: __mlir_type.index) -> __mlir_type.index:
  return 0

@interface
# expected-error @+1 {{interfaces must have no body}}
def bad_interface_with_body1(x: __mlir_type.index) -> __mlir_type.index:
  ...
  return 0

struct NoNestedInterface:
  @interface   # expected-error {{interfaces cannot be nested inside a struct}}
  def foo(self) -> __mlir_type.index:

@interface
def good_interface(x: __mlir_type.index) -> __mlir_type.index:
  ...

@implements(good_interface)
@interface # expected-error {{interfaces cannot implement other interfaces}}
# expected-error @+1 {{interfaces must have no body}}
def incompatible_decorators(x: __mlir_type.index) -> __mlir_type.index:
  return 1

# expected-error @+1 {{unsupported decorator}}
@impl(good_interface)
def func_impl0(x: __mlir_type.index) -> __mlir_type.index:
  return x

# expected-error @+1 {{@implements decorator must specify one interface by name}}
@implements(good_interface, good_interface)
def func_impl1(x: __mlir_type.index) -> __mlir_type.index:
  return x

@implements(good_interface)
# expected-error @+1 {{only one @implements decorator is allowed}}
@implements(good_interface)
def func_impl2(x: __mlir_type.index) -> __mlir_type.index:
  return x

@implements(xyz)  # expected-error {{unable to resolve interface named 'xyz'}}
def func_impl3(x: __mlir_type.index) -> __mlir_type.index:
  return x

struct struct_bar: # expected-note {{'struct_bar' declared here}}
  pass

@implements(struct_bar)  # expected-error {{'struct_bar' is not a kgen interface}}
def func_impl4(x: __mlir_type.index) -> __mlir_type.index:
  return x

##===----------------------------------------------------------------------===##
# KGEN Evalators
##===----------------------------------------------------------------------===##


@interface
fn my_evaluator0(funcs: __mlir_type.`!pop.pointer<(index) -> index>`, size: __mlir_type.index) -> __mlir_type.index:
    ...

@interface
@evaluator(my_evaluator0)
# expected-error @+1 {{only one @evaluator decorator is allowed}}
@evaluator(my_evaluator0)
fn useEvaluator0(x:  __mlir_type.index) ->  __mlir_type.index:
  ...

@interface
# expected-error @+1 {{unable to resolve function named 'my_evaluator1'}}
@evaluator(my_evaluator1)
fn useEvaluator1(x:  __mlir_type.index) ->  __mlir_type.index:
  ...

@interface
# expected-error @+1 {{@evaluator decorator must specify one function by name}}
@evaluator(my_evaluator0, my_evaluator0)
fn useEvaluator2(x:  __mlir_type.index) ->  __mlir_type.index:
  ...

struct my_struct: # expected-note {{'my_struct' declared here}}
  pass

@interface
# expected-error @+1 {{'my_struct' is not a valid function}}
@evaluator(my_struct)
fn useEvaluator3(x:  __mlir_type.index) ->  __mlir_type.index:
  ...

# expected-error @+1 {{only interfaces can have an evaluator}}
@evaluator(my_evaluator0)
fn useEvaluator4(x:  __mlir_type.index) ->  __mlir_type.index:
  ...
