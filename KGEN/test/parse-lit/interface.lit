# RUN: kgen-translate -import-lit %s -verify-diagnostics -I %stdlibdir -I %S/../lit-examples/ | FileCheck %s

from prolog import DType, Error, F32, Int, object, SIMD

@interface
# CHECK: lit.func @"func_interface0{{.*}}<type: @"$prolog"::@DType>(%x: index) -> index attributes {isInterface}
fn func_interface0[type: DType](x: __mlir_type.index) -> __mlir_type.index:

@interface
# CHECK: lit.func @"func_interface1{{.*}}<type: @"$prolog"::@DType>(%x: index) -> index attributes {isInterface}
fn func_interface1[type: DType](x: __mlir_type.index) -> __mlir_type.index: pass

@interface
# CHECK: lit.func @"func_interface2{{.*}}<type: @"$prolog"::@DType>(%x: index) -> index attributes {isInterface}
fn func_interface2[type: DType](x: __mlir_type.index) -> __mlir_type.index:
  ...

@implements(func_interface2)
# CHECK: lit.func @"func_impl{{.*}}<type: @"$prolog"::@DType>(%x: index) -> index
# CHECK:    implements @"{{.*}}"::@"func_interface2(__mlir_type.index)" {
fn func_impl[type: DType](x: __mlir_type.index) -> __mlir_type.index:
  return x

@interface
# CHECK: lit.func @"my_evaluator{{.*}}(%funcs: !pop.pointer<(index) -> index>, %size: index) -> index attributes {isInterface}
fn my_evaluator(funcs: __mlir_type.`!pop.pointer<(index) -> index>`, size: __mlir_type.index) -> __mlir_type.index:
    ...

@interface
@evaluator(my_evaluator)
# CHECK: lit.func @"useEvaluator{{.*}} {isInterface}  evaluator (!pop.pointer<(index) -> index>, index) -> index = @"${{.*}}::@"my_evaluator(__mlir_type.!pop.pointer<(index) -> index>,__mlir_type.index)"
fn useEvaluator(x:  __mlir_type.index) ->  __mlir_type.index:
  ...
