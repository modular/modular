# Issue #6879: Qualified lookup is looking up names wrong
fn unqualifiedNameLookup(a: ConvertibleFromInt):
  # expected-error @+1 {{ConvertibleFromInt' value has no attribute 'badPropertyError'}}
  a.badPropertyError
