struct Rec[param: Rec]:
  pass

struct ParametricOnInt[a: Int]:
fn Rec2[
  a: ParametricOnInt[b], # expected-note {{previously used here}}
  b: ParametricOnInt[a]](): # expected-error {{recursive reference to declaration}}
  pass


