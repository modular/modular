     pass

struct Thing[a: __mlir_type.index, b: __mlir_type.index]:

def GoodUseOfThing(a: Thing[4, 5]):
  pass

def MissingThingMetaParams(a: Thing):  # xpected-error {{'Thing' requires 2 meta parameters}}
  pass

# expected-error @+1 {{cannot apply more parameters to an already parameterized type 'Thing[1, 2]'}}
def MultipleThingMetaparams(a: Thing[1,2][1]):
  pass

def OneMissingThingMetaParam(a: Thing[1]):  # expected-error {{'Thing' requires 2 meta parameters}}
  pass

# expected-error @+1 {{parameter of type '__mlir_type.f64' cannot be converted to expected type '__mlir_type.index'}}
def WeirdMetaParams(a: Thing[1, 1.5]):
  pass

fn voidReturningFn(): pass
fn badCall():
  # expected-error @+1 {{value of type 'None' cannot be converted to expected type 'NotBoolConvertible'}}
  test_bool_context(voidReturningFn())


# expected-note @+1 {{function declared here}}
def generic_fn[a: DType, b: __mlir_type.index](c : __mlir_type.index):

def call_generic[dt: DType]():
  generic_fn[dt, 1, 42](57) # expected-error {{invalid call to 'generic_fn': callee expects 2 input parameters but 3 were provided}}
  generic_fn[1, dt](57) # expected-error {{parameter "a" has 'DType' type, but value has type '__mlir_type.index'}}

def field_indexes(a: Int):
  a.badField = 42 # expected-error {{object has no attribute 'badField'}}


# https://github.com/modularml/modular/issues/4181
struct Issue4181IndentWeirdness[dt: DType]:
  var b : Int
    # expected-error @+1 {{definition isn't on its own line at the correct indentation}}
    def f():
      pass

@decorator  # expected-error {{decorators not supported on this statement}}
struct DecoratedStruct:

@decorator # expected-error {{decorators not supported on this statement}}
var DecoratedVar: Int

@invalidDec # expected-error {{unsupported decorator: invalidDec}}
def BadDecorator(): pass

@staticmethod # expected-error @+1 {{only methods on structs may be declared static}}
def StaticMethod(): pass

# expected-error @+1 {{special function must have 2 operands}}
def __add__(): pass
# expected-error @+1 {{special function must be a method}}
def __sub__(self, a): pass

struct WrongType:
  # expected-error @+1 {{__init__ is not allowed on structs, use __new__ instead}}
  def __init__(self): pass

  # expected-error @+1 {{result type must be 'WrongType'}}
  def __new__() -> Int: pass

struct WrongSelfType[a: Int]:
  # expected-error @+1 {{'self' argument must have type 'WrongSelfType[a]'}}
  def badMethod(self: Int): pass
  def goodMethod(self&: WrongSelfType[a]): pass

  # expected-error @+1 {{special function must have 2 operands}}
  def __add__(self): pass


@interface
# expected-error @+1 {{interfaces must have no body}}
def bad_interface_with_body0(x: __mlir_type.index) -> __mlir_type.index:
  return 0

@interface
# expected-error @+1 {{interfaces must have no body}}
def bad_interface_with_body1(x: __mlir_type.index) -> __mlir_type.index:
  ...
  return 0

struct NoNestedInterface:
  @interface   # expected-error {{interfaces cannot be nested inside a struct}}
  def foo(self) -> __mlir_type.index:

@interface
def good_interface(x: __mlir_type.index) -> __mlir_type.index:
  ...

@implements(good_interface)
@interface # expected-error {{interfaces cannot implement other interfaces}}
# expected-error @+1 {{interfaces must have no body}}
def incompatible_decorators(x: __mlir_type.index) -> __mlir_type.index:
  return 1

# expected-error @+1 {{unsupported decorator}}
@impl(good_interface)
def func_impl0(x: __mlir_type.index) -> __mlir_type.index:
  return x

# expected-error @+1 {{@implements decorator must specify one interface by name}}
@implements(good_interface, good_interface)
def func_impl1(x: __mlir_type.index) -> __mlir_type.index:
  return x

@implements(good_interface)
# expected-error @+1 {{only one @implements decorator is allowed}}
@implements(good_interface)
def func_impl2(x: __mlir_type.index) -> __mlir_type.index:
  return x

@implements(xyz)  # expected-error {{unable to resolve interface named 'xyz'}}
def func_impl3(x: __mlir_type.index) -> __mlir_type.index:
  return x

struct struct_bar: # expected-note {{'struct_bar' declared here}}
  pass

@implements(struct_bar)  # expected-error {{'struct_bar' is not a kgen interface}}
def func_impl4(x: __mlir_type.index) -> __mlir_type.index:
  return x


struct LValuesRvalues:
  fn __new__() -> LValuesRvalues:
    var result : LValuesRvalues
    return result

  def normalMethod(self):
  # expected-note @+1 {{function declared here}}
  def mutatingMethod(self&):
  # expected-note @+1 {{function declared here}}
  def takesByRef(self, x&: LValuesRvalues):

def testLValuesRvalues():
  # Test with lvalues
  var lv: LValuesRvalues
  lv.normalMethod()
  lv.mutatingMethod()

  # Test with rvalues
  LValuesRvalues().normalMethod()
  LValuesRvalues().mutatingMethod()  # expected-error {{invalid use of mutating method on rvalue of type 'LValuesRvalues'}}

  # expected-error @+1 {{operand must be mutable in order to pass as a by-ref argument}}
  LValuesRvalues().takesByRef(LValuesRvalues())

  # We can implicitly declare things on the LHS but not on the RHS.
  unknown1 += unknown2 # expected-error {{use of unknown declaration "unknown2"}}

# Test differences between fn and def.
fn testFn(a: Int, b): # expected-error {{'fn' parameter type must be specified}}
  a = a  # expected-error {{cannot assign to immutable expression}}
  c = a  # expected-error {{use of unknown declaration "c", `fn` declarations require explicit variable declarations}}


fn testMLIR():
  var a : __mlir_type


__include "non-existant-file.lit" # expected-error {{could not find file 'non-existant-file.lit'}}

struct SpecialFunctions:
  # expected-error @+1 {{special function must have 2 operands}}
  fn __add__(self):

  # expected-error @+1 {{self argument must be passed by reference}}
  fn __iadd__(a: SpecialFunctions, b: SpecialFunctions) -> SpecialFunctions:
    return a

  fn failures(self):
    self+self # Supports this, even though it isn't valid.  Shouldn't crash.
    self*self # expected-error {{'SpecialFunctions' does not implement the '__mul__' method}}

fn expr_errors():
  var x: __mlir_type.index
  x += x # expected-error {{'__mlir_type.index' does not implement the '__iadd__' method}}

  # expected-error @+1 {{'index.add' op expected 2 operands, but found 0}}
  __mlir_op.`index.add`()

  # expected-error @+1 {{MLIR type '__mlir_type.index' has no attributes}}
  __mlir_op.`index.add`(x, x).x

  # expected-error @+1 {{operation already has attributes}}
  __mlir_op.`op`[value1: 42][value2: 42]

  # expected-error @+1 {{attribute "value" redundantly specified}}
  __mlir_op.`op`[value: 42, value: 42]

  # expected-error @+1 {{unknown MLIR type: kgen.dtype}}
  var y : __mlir_type.`kgen.dtype`  # should be !kgen.dtype

  # expected-error @+1 {{unable to infer result type from MLIR operation "index.castu"}}
  __mlir_op.`index.castu`(x, __mlir_type.i1)
  # expected-error @+1 {{unable to infer result type from MLIR operation "index.castu"}}
  __mlir_op.`index.castu`(x)
  # expected-error @+1 {{'index.castu' op result #0 must be integer or index, but got 'f32'}}
  __mlir_op.`index.castu`[_type: __mlir_type.f32](x)

  # expected-error @+1 {{'index.constant' op attribute 'value' failed to satisfy constraint: index attribute}}
  var c42e = __mlir_op.`index.constant`[value : 42.0]()
  var c42 = __mlir_op.`index.constant`[value : 42]() # Good

  # expected-error @+1 {{invalid MLIR attribute:}}
  __mlir_attr.`#index<cmp_predicate xeq>`

  # expected-error @+1 {{MLIR attribute has no type: #index<cmp_predicate eq>}}
  __mlir_attr.`#index<cmp_predicate eq>`

  # expected-error @+1 {{parameter of type '__mlir_type.index' cannot be converted to expected type '__mlir_type.!kgen.dtype'}}
  var a : __mlir_type.`!pop.scalar<#lit.placeholder : !kgen.dtype>`[1]

  # expected-error @+1 {{unused parameter substitution}}
  var b : __mlir_type.`!pop.simd<#lit.placeholder : index, f32>`[4, 57]

  # expected-error @+1 {{'__mlir_type.index' does not implement the '__new__' method}}
  _ = __mlir_type.index(42)


fn slice_expression(a: Int):
  a[:]    # expected-error {{slice values not implemented yet}}
  a[::]   # expected-error {{slice values not implemented yet}}
  a[1:2]  # expected-error {{slice values not implemented yet}}
  a[:2:3] # expected-error {{slice values not implemented yet}}


# expected-note @+1 {{previous definition here}}
struct Parameterized[p1: __mlir_type.index]:
  # expected-error @+1 {{invalid redefinition of "p1"}}
  fn a[p1: Int](self):  # Cannot shadow parameter names.

  # expected-error @+2 {{invalid redefinition of "p2"}}
  # expected-note @+1 {{previous definition here}}
  fn b[p2: Int, p2: Int, p3: Int](self):  # Cannot shadow parameter names.

  fn __new__() -> Parameterized[p1]:
    var result: Parameterized[p1]
    return result

  # expected-note @+1 {{function declared here}}
  fn method[B: __mlir_type.index](self, other: Parameterized[p1+B]):
    pass


# Test that we support partially bound parameters and diagnose incorrect uses
# of parameters.
fn testTestParamStruct(a: Parameterized[4]):
  a.method[7](Parameterized[11]())
  # expected-error @+1 {{invalid call to 'method': in argument #0, value of type 'Parameterized[4]' cannot be converted to expected type 'Parameterized[11]'}}
  a.method[7](Parameterized[12]())
  a.method[2](Parameterized[6]())
  a.method[2, 7] # expected-error {{'method' expects 2 input parameters but 3 were provided}}


struct MySIMD[size: __mlir_type.index, type: __mlir_type.`!kgen.dtype`]:
  # expected-note @below {{function declared here}}
  fn __add__(self, rhs: MySIMD[size, type]):

fn testSIMD(a: MySIMD[1, __mlir_attr.`#kgen.dtype.constant<f64> : !kgen.dtype`],
            b: MySIMD[2, __mlir_attr.`#kgen.dtype.constant<si32> : !kgen.dtype`]):
  var x = a+a
  var y = b+b
  var z = b+a  # expected-error {{invalid call to '__add__': in argument #1, value of type 'MySIMD[1, f64]' cannot be converted to expected type 'MySIMD[2, si32]'}}

fn method(variable: Int):
  # expected-error @+1 {{declaration must have either a type or an initializer}}
  alias MissingInit

  # expected-error @+1 {{context only permits a meta value, not a dynamic one}}
  alias NotConstant = variable*2

  # TODO: Should reject as not initialized.
  alias NotInitialized : __mlir_type.index

def raisingMethod():
    pass

fn callRaisingMethod():
    raisingMethod() # expected-error {{cannot call raising method within an 'fn' that does not raise}}

fn cannotReRaise():
    raise # expected-error {{no contextual exception to reraise}}

fn cannotRaise(err: Error):
    raise err # expected-error {{cannot raise error inside method that does not raise}}

# expected-note @+1 {{function declared here}}
fn badRef(val&: Int):
  var x = F32(1.0)
  # TODO(QoI): expected-error @+1 {{l-value of type 'F32' cannot be converted to reference to expected type #kgen.concretetype.constant<!kgen.declref<@Int>> : !kgen.mlirtype}}
  badRef(x)

fn missingColon()  # expected-error {{expected ':' in function definition}}
  # Don't get confused by comments or blank lines!

  var x = 1

struct WeirdBoolish:
  fn __bool__(self) -> Int: return Int(0)

fn badAnd(a: Bool, b: WeirdBoolish):
  _ = a and b # expected-error {{cannot find common type between 'Bool' and 'WeirdBoolish'}}

# expected-note @below {{candidate declared here}}
# expected-note @below {{in argument #0, value of type 'TestOverloading' cannot be converted to expected type 'Int'}}
# expected-note @below {{candidate not viable: callee expects 1 argument}}
fn overloadIntF32(a: Int):

# expected-note @below {{candidate declared here}}
# expected-note @below {{in argument #0, value of type 'TestOverloading' cannot be converted to expected type 'F32'}}
# expected-note @below {{candidate not viable: callee expects 1 argument}}
fn overloadIntF32(a: F32):

# expected-note @below {{candidate declared here}}
# expected-note @below {{candidate not viable: callee expects 2 arguments}}
# expected-note @below {{candidate not viable: in argument #1, value of type 'F32' cannot be converted to expected type 'Int'}}
fn overloadIntF32(a: Int, b: Int):

# expected-note @below {{candidate declared here}}
# expected-note @below {{candidate not viable: callee expects 2 arguments}}
# expected-note @below {{candidate not viable: operand must be mutable in order to pass as a by-ref argument}}
fn overloadIntF32(a: Int, b&: F32):

struct TestOverloading:
  var a: Int   # expected-note {{cannot overload with this non-function definition}}
  fn a(self):  # expected-error {{invalid redefinition of "a"}}

  fn test(self, a: Int, b: F32):
    # expected-error @+1 {{cannot form a reference to overloaded declaration}}
    var bad = overloadIntF32

    # expected-error @+1 {{no matching function in call}}
    overloadIntF32(self)
    # expected-error @+1 {{no matching function in call}}
    overloadIntF32(a, b)

struct ConvertibleFromInt:
  fn __new__(value: Int) -> ConvertibleFromInt:
    var result: ConvertibleFromInt
    return result

# expected-note @below {{candidate declared here}}
# expected-note @below {{candidate not viable: in argument #1, value of type 'ConvertibleFromInt' cannot be converted to expected type 'Int'}}
fn ambiguousConversions(a: ConvertibleFromInt, b: Int):
# expected-note @below {{candidate declared here}}
# expected-note @below {{candidate not viable: in argument #0, value of type 'ConvertibleFromInt' cannot be converted to expected type 'Int'}}
fn ambiguousConversions(a: Int, b: ConvertibleFromInt):

fn testAmbiguousConversions(a: Int, b: ConvertibleFromInt):
  ambiguousConversions(a, b) # ok
  ambiguousConversions(b, a) # ok
  # expected-error @+1 {{ambiguous call to 'ambiguousConversions', each candidate requires 1 implicit conversion, disambiguate with an explicit cast}}
  ambiguousConversions(a, a)
  # expected-error @+1 {{no matching function in call}}
  ambiguousConversions(b, b)

  var localFn = testAmbiguousConversions  # ok
  localFn(a, b)
  localFn(a, a)
  localFn(1, b)
  # expected-error @+1 {{invalid indirect call: in argument #0, value of type 'ConvertibleFromInt' cannot be converted to expected type 'Int'}}
  localFn(b, b)
