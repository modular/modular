# RUN: kgen-translate -import-lit -verify-diagnostics %s

__include "../lit-examples/prolog.lit"

# Tests

def foo():
# expected-error @+1 {{unexpected token in expression}}
  return pass

# expected-note @+1 {{previous definition here}}
def fn_redecl():
  pass

# expected-error @+1 {{invalid redefinition of "fn_redecl"}}
def fn_redecl():
  pass

def func():
  never_declared_fn() # expected-error {{use of unknown declaration "never_declared_fn"}}
  pass

def bad_assignment0(a: Int, b: Int):
   # expected-error @+1 {{cannot assign to immutable expression}}
   a = b += b

def bad_assignment1(a: Int, b: Int):
   # expected-error @+1 {{expected ')' in parenthesized expression}}
   a = (b += b)


def elif_parse_error(a: Bool):
  if a:
    pass
 elif a: # expected-error {{unexpected token in expression}}
    pass
  else:
    pass

42 = 17 # expected-error {{cannot assign to immutable expression}}

return 32 # expected-error {{cannot return from this context}}

def tuple_return():
  return 32, 17 # expected-error {{tuple return not supported yet}}

def missing_ret_val() -> index:
  return # expected-error {{returned value has type 'None' but 'def' expected '!builtin.index'}}

def ret_type_mismatch() -> index:
  return 4.0 # expected-error {{returned value has type 'FloatLiteralType' but 'def' expected '!builtin.index'}}

def meta_param_then_param_redef[
      dt: index # expected-note {{previous definition here}}
    ](dt: index):    # expected-error {{invalid redefinition of "dt"}}
  pass

# expected-note @below {{previous definition here}}
# expected-error @below {{invalid redefinition of "x"}}
def param_redef(x: index, x: index):
  pass

# expected-error @+1 {{'def' statement must be on its own line}}
struct Struct: def foo(): pass

struct ReturnFromStruct:
  # expected-error @+1 {{cannot return from this context}}
  return 42

def var_decl_without_type():
  # expected-error @+1 {{initializer has type 'FloatLiteralType' but declared type is 'Int'}}
  var y : Int = 1.0

  # expected-error @+1 {{declaration must have either a type or an initializer}}
  var x

struct StructMemberRedefinition:
  var x : index  # expected-note {{previous definition here}}
  var x : index  # expected-error {{invalid redefinition of "x"}}

def var_decl():
  x = 123        # expected-note {{previous definition here}}
  var x : Int  # expected-error {{invalid redefinition of "x"}}
  x+4   # no follow-on error.

var globalvar : index
def err():
  var y : globalvar  # expected-error {{expected a type}}

struct Rec[param:
                Rec  # expected-error {{recursive reference to declaration}}
           ]:
  pass

def missing_type_on_var_decl():
  var abc :
  pass # expected-error {{unexpected token in expression}}
  abc+abc


def invalid_conversion(a: Int, b: index):
  a = b+1 # expected-error {{cannot convert value of type '!builtin.index' to 'Int'}}

struct NotBoolConvertible:

def test_bool_context(a: NotBoolConvertible):
  if a: # expected-error {{'NotBoolConvertible' does not implement the "__bool__" special method}}
     pass

struct Thing[a: index, b: index]:

def GoodUseOfThing(a: Thing[4, 5]):
  pass

def MissingThingMetaParams(a: Thing):  # expected-error {{'Thing' requires 2 meta parameters}}
  pass

# expected-error @+1 {{cannot apply more parameters to an already parameterized type 'Thing[1, 2]'}}
def MultipleThingMetaparams(a: Thing[1,2][1]):
  pass

def OneMissingThingMetaParam(a: Thing[1]):  # expected-error {{'Thing' requires 2 meta parameters}}
  pass

# expected-error @+1 {{parameter of type 'StringLiteralType' cannot be converted to expected type 'index'}}
def WeirdMetaParams(a: Thing[1, "foo"]):
  pass

def voidReturningFn(): pass
def badCall():
  # expected-error @+1 {{value of type 'None' cannot be converted to expected type '!kgen.ref<@NotBoolConvertible>'}}
  test_bool_context(voidReturningFn())


def generic_fn[a: DType, b: index](c : index):

def call_generic[dt: DType]():
  generic_fn[1, dt, 42](57) # expected-error {{signature expects 2 parameter values}}
  generic_fn[1, dt](57) # expected-error {{index has type '!builtin.index' but declaration expects '!kgen.ref<@DType>'}}

def field_indexes(a: Int):
  a.badField = 42 # expected-error {{object has no attribute 'badField'}}


# https://github.com/modularml/modular/issues/4181
struct Issue4181IndentWeirdness[dt: DType]:
  var b : Int
    # expected-error @+1 {{definition isn't on its own line at the correct indentation}}
    def f():
      pass

@decorator # expected-error {{no struct decorators supported yet}}
struct DecoratedStruct:

@decorator # expected-error {{no var decorators supported yet}}
var DecoratedVar: Int

@invalidDec # expected-error {{unsupported decorator: invalidDec}}
def BadDecorator(): pass

@staticmethod # expected-error @+1 {{only methods on structs may be declared static}}
def StaticMethod(): pass

# expected-error @+1 {{special function must be a method}}
def __new__(): pass

struct WrongType:
  # expected-error @+1 {{__init__ is not allowed on structs, use __new__ instead}}
  def __init__(self): pass

  # expected-error @+1 {{result type must be 'WrongType'}}
  def __new__() -> Int: pass

struct WrongSelfType[a: Int]:
  # expected-error @+1 {{'self' argument must have type 'WrongSelfType[a]'}}
  def badMethod(self: Int): pass
  def goodMethod(&self: WrongSelfType[a]): pass


@interface
# expected-error @+1 {{interfaces must have no body}}
def bad_interface_with_body0(x: index) -> index:
  return 0

@interface
# expected-error @+1 {{interfaces must have no body}}
def bad_interface_with_body1(x: index) -> index:
  ...
  return 0

struct NoNestedInterface:
  @interface
  # expected-error @+1 {{interfaces cannot be nested inside a struct}}
  def foo(self) -> index:

@interface
def good_interface(x: index) -> index:
  ...

@implements(good_interface)
@interface
# expected-error @+2 {{interfaces cannot implement other interfaces}}
# expected-error @+1 {{interfaces must have no body}}
def incompatible_decorators(x: index) -> index:
  return 1

# expected-error @+1 {{unsupported decorator}}
@impl(good_interface)
def func_impl0(x: index) -> index:
  return x

# expected-error @+1 {{@implements decorator must specify one interface by name}}
@implements(good_interface, good_interface)
def func_impl1(x: index) -> index:
  return x

@implements(good_interface)
# expected-error @+1 {{only one @implements decorator is allowed}}
@implements(good_interface)
def func_impl2(x: index) -> index:
  return x

@implements(xyz)
# expected-error @+1 {{this function implements an unknown interface: xyz}}
def func_impl3(x: index) -> index:
  return x

struct struct_bar:
  pass

@implements(struct_bar)
# expected-error @+1 {{not an interface: struct_bar}}
def func_impl4(x: index) -> index:
  return x


struct LValuesRvalues:
  def __new__() -> LValuesRvalues:
    var result : LValuesRvalues
    return result

  def normalMethod(self):
  def mutatingMethod(&self):
  def takesByRef(self, &x: LValuesRvalues):

def testLValuesRvalues():
  # Test with lvalues
  var lv: LValuesRvalues
  lv.normalMethod()
  lv.mutatingMethod()

  # Test with rvalues
  LValuesRvalues().normalMethod()
  LValuesRvalues().mutatingMethod()  # expected-error {{invalid use of mutating method on rvalue of type 'LValuesRvalues'}}

  # expected-error @+1 {{operand must be mutable in order to pass as a by-ref argument}}
  LValuesRvalues().takesByRef(LValuesRvalues())

  # We can implicitly declare things on the LHS but not on the RHS.
  unknown1 += unknown2 # expected-error {{use of unknown declaration "unknown2"}}

# Test differences between fn and def.
fn testFn(a: Int, b): # expected-error {{'fn' parameter type must be specified}}
  a = a  # expected-error {{cannot assign to immutable expression}}
  c = a  # expected-error {{use of unknown declaration "c"}}


fn testMLIR():
  var a : __mlir_type # expected-error {{cannot use __mlir_type directly, use properties of it instead}}


__include "non-existant-file.lit" # expected-error {{could not find file 'non-existant-file.lit'}}

struct SpecialFunctions:
  # expected-error @+1 {{special function must have 2 operands}}
  fn __add__():

  # expected-error @+1 {{self parameter must be passed by reference}}
  fn __iadd__(a: SpecialFunctions, b: SpecialFunctions) -> SpecialFunctions:
    return a

  fn failures(self):
    self+self # Supports this, even though it isn't valid.  Shouldn't crash.
    self*self # expected-error {{'SpecialFunctions' does not implement the "__mul__" special method}}

fn expr_crash():
  var x: __mlir_type.index
  x += x # expected-error {{cannot emit binary operator on this index value yet}}

  # expected-error @+1 {{'index.add' op expected 2 operands, but found 0}}
  __mlir_op.`index.add`()

  # expected-error @+1 {{cannot access fields in type '!builtin.index'}}
  __mlir_op.`index.add`(x, x).x

  # expected-error @+1 {{unknown MLIR type: kgen.dtype}}
  var y : __mlir_type.`kgen.dtype`  # should be !kgen.dtype

fn slice_expression(a: Int):
  a[:]    # expected-error {{slice values not implemented yet}}
  a[::]   # expected-error {{slice values not implemented yet}}
  a[1:2]  # expected-error {{slice values not implemented yet}}
  a[:2:3] # expected-error {{slice values not implemented yet}}
