# RUN: kgen-translate -import-lit -verify-diagnostics -split-input-file %s

# expected-error @+1 {{unexpected character}}
`

# // -----

# expected-error @+1 {{unexpected character}}
!

# // -----

# expected-error @+1 {{leading zeros in decimal integer literals are not permitted; use an 0o prefix for octal integers}}
0123

# // -----

# expected-error @+1 {{no digits specified for octal literal}}
0o_

# // -----

# expected-error @+1 {{expecting a digit after the exponent}}
1e+*

# // -----

# expected-error @+1 {{expecting a digit after the exponent}}
1e*

# // -----

def foo():
# expected-error @+1 {{unexpected token in expression}}
  return pass

# // -----

# expected-note @+1 {{previous definition here}}
def redecl():
  pass

# expected-error @+1 {{invalid redefinition of function "redecl"}}
def redecl():
  pass


# // -----

def fn():
  foo() # expected-error {{use of unknown declaration "foo"}}
  pass


# // -----

42 = 17 # expected-error {{cannot assign to expression}}

# // -----

return 32 # expected-error {{cannot know how to return out of this scope}}

# // -----

def a():
  return 32, 17 # expected-error {{tuple return not supported yet}}

# // -----

def a() -> Int:
  return # expected-error {{expected a return value from 'def' with return type 'index'}}

# // -----

def a() -> Int:
  return 4.0 # expected-error {{don't support non-index types yet}}
