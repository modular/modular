# RUN: kgen-translate -import-lit -verify-diagnostics -split-input-file %s

# expected-error @+1 {{unexpected character}}
`

# // -----

# expected-error @+1 {{unexpected character}}
!

# // -----

# expected-error @+1 {{leading zeros in decimal integer literals are not permitted; use an 0o prefix for octal integers}}
0123

# // -----

# expected-error @+1 {{no digits specified for octal literal}}
0o_

# // -----

# expected-error @+1 {{expecting a digit after the exponent}}
1e+*

# // -----

# expected-error @+1 {{expecting a digit after the exponent}}
1e*

# // -----

# expected-error @+1 {{unterminated string}}
"Hello'

# // -----

# expected-error @+1 {{unterminated string}}
'Hello"

# // -----

# expected-error @+1 {{unterminated string}}
"Hello

# // -----

# expected-error @+1 {{unterminated string}}
'Hello

# // -----

# expected-error @+1 {{invalid hex escape sequence: exactly two hex digits needed}}
"A\x4"

# // -----

# expected-error @+1 {{invalid hex escape sequence: exactly two hex digits needed}}
"A\x"

# // -----

# expected-error @+1 {{invalid escape sequence}}
"A\zB"

# // -----

# expected-error @+1 {{unterminated string}}
"AB\"

# // -----

# expected-error @+1 {{unterminated string}}
r"AB\"

# // -----

def foo():
# expected-error @+1 {{unexpected token in expression}}
  return pass

# // -----

# expected-note @+1 {{previous definition here}}
def redecl():
  pass

# expected-error @+1 {{invalid redefinition of "redecl"}}
def redecl():
  pass


# // -----

def fn():
  foo() # expected-error {{use of unknown declaration "foo"}}
  pass


# // -----

def fn(a: index):
  if a:
    pass
   elif a: # expected-error {{'elif' must match the indentation of the corresponding 'if'}}
    pass
  else:
    pass


# // -----

42 = 17 # expected-error {{cannot assign to expression}}

# // -----

return 32 # expected-error {{cannot return from this context}}

# // -----

def a():
  return 32, 17 # expected-error {{tuple return not supported yet}}

# // -----

def a() -> index:
  return # expected-error {{expected a return value from 'def' with return type 'index'}}

# // -----

def a() -> index:
  return 4.0 # expected-error {{returned value has type 'f64' but 'def' expected 'index'}}

# // -----

def bad[
      dt: index # expected-note {{previous definition here}}
    ](dt: index):    # expected-error {{invalid redefinition of "dt"}}
  pass

# // -----

# expected-note @below {{previous definition here}}
# expected-error @below {{invalid redefinition of "x"}}
def bad(x: index, x: index):
  pass

# // -----

# expected-error @+1 {{'def' statement must be on its own line}}
struct Struct: def foo(): pass

# // -----

struct Pair:
  # expected-error @+1 {{cannot return from this context}}
  return 42

# // -----

def f():
  # expected-error @+1 {{var declaration requires a type}}
  var x = 42

# // -----

struct Str:
  var x : index  # expected-note {{previous definition here}}
  var x : index  # expected-error {{invalid redefinition of "x"}}

# // -----

struct Float: pass

def var_decl():
  x = 123        # expected-note {{previous definition here}}
  var x : Float  # expected-error {{invalid redefinition of "x"}}
  x+4   # no follow-on error.

# // -----

x = 123
def err():
  var y : x  # expected-error {{'x' names a value, not a type}}

# // -----

struct Rec[param:
                Rec  # expected-error {{recursive reference to declaration}}
           ]:
  pass

# // -----

def f():
  var abc :
  pass # expected-error {{unexpected token in expression}}
  abc+abc
