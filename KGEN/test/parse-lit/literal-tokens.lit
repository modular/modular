0b10101       # CHECK-NEXT: %[[CST:.*]] = index.constant 21
0B10101       # CHECK-NEXT: %[[CST:.*]] = index.constant 21
0o711         # CHECK-NEXT: %[[CST:.*]] = index.constant 457
0O711         # CHECK-NEXT: %[[CST:.*]] = index.constant 457
1.1           # CHECK-NEXT: %[[CST:.*]] = pop.constant(1.100000e+00 : f64) : !pop.scalar<f64>
