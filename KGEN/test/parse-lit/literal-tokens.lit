1.e-2         # CHECK-NEXT: %[[CST:.*]] = pop.constant(1.000000e-02 : f64) : !pop.scalar<f64>
0.1           # CHECK-NEXT: %[[CST:.*]] = pop.constant(1.000000e-01 : f64) : !pop.scalar<f64>
