1.e2          # CHECK-NEXT: %[[CST:.*]] = pop.constant(1.000000e+02 : f64) : !pop.scalar<f64>
1e+2          # CHECK-NEXT: %[[CST:.*]] = pop.constant(1.000000e+02 : f64) : !pop.scalar<f64>
1.1e-2        # CHECK-NEXT: %[[CST:.*]] = pop.constant(1.100000e-02 : f64) : !pop.scalar<f64>
