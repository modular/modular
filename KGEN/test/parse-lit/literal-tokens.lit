# RUN: kgen-translate -import-lit %s | FileCheck %s

# CHECK: module {
a = 5             # 5
a = 55            # 55
a = 10500         # 10500
a = 12_500        # 12500
a = 0             # 0
a = 00            # 0
a = 0____0__0_0   # 0
a = 00__0_0       # 0
a = 1__9_         # 19
a = 0x123         # 291
a = 0X123         # 291
a = 0b10101       # 21
a = 0B10101       # 21
a = 0o711         # 457
a = 0O711         # 457
b = 1.1           # 1.100000e+00
b = .1            # 1.000000e-01
b = 1.            # 1.000000e+00
b = 1e2           # 1.000000e+02
b = 1.1e2         # 1.100000e+02
b = .1e2          # 1.000000e+01
b = 1.e2          # 1.000000e+02
b = 1e+2          # 1.000000e+02
b = 1.1e-2        # 1.100000e-02
b = .1e+2         # 1.000000e+01
b = 1.e-2         # 1.000000e-02
b = 0.1           # 1.000000e-01
b = 0.            # 0.000000e+00
b = 0e2           # 0.000000e+00
b = 0.1e2         # 1.000000e+01
b = 0.e2          # 0.000000e+00
b = 0e+2          # 0.000000e+00
b = 0.1e-2        # 1.000000e-03
b = 0.e-2         # 0.000000e+00
b = 12.31e+11     # 1.231000e+12
b = 1_2.3__1e+1_1 # 1.231000e+12
b = 12.31E-3      # 1.231000e-02


# HECK: "hello world"
"hello \
world"

# COM: match newline hex values via regex since they vary between OSs
# HECK: "hello \\\{{[0-9A-Z]+}}world"
r"hello \
world"

""                 # HECK: ""
"Hello"            # HECK: "Hello"
"Hello 'world'"    # HECK: "Hello 'world'"
"A\x42"            # HECK: "AB"
"A\x423"           # HECK: "AB3"
"A\102"            # HECK: "AB"
"A\1023"           # HECK: "AB3"

# COM: the MLIR textual representation escapes strings, so below \ is \\ and " is \"
'Hello "world"'    # HECK: "Hello \22world\22"
r"A\x42"           # HECK: "A\\x42"
R"A\x42"           # HECK: "A\\x42"
r"AB\\"            # HECK: "AB\\\\"
r"A\x"             # HECK: "A\\x"
"AB\\"             # HECK: "AB\\"
r"A\"B"            # HECK: "A\\\22B"
r'A\'B'            # HECK: "A\\'B"
"A\"B"             # HECK: "A\22B"
'A\'B'             # HECK: "A'B"
r"A\zB"            # HECK: "A\\zB"
