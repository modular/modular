# RUN: kgen-translate -import-lit %s | FileCheck %s

# CHECK: module {
a = 5             # CHECK: %[[CST:.*]] = index.constant 5
a = 55            # CHECK: %[[CST:.*]] = index.constant 55
a = 10500         # CHECK: %[[CST:.*]] = index.constant 10500
a = 12_500        # CHECK: %[[CST:.*]] = index.constant 12500
a = 0             # CHECK: %[[CST:.*]] = index.constant 0
a = 00            # CHECK: %[[CST:.*]] = index.constant 0
a = 0____0__0_0   # CHECK: %[[CST:.*]] = index.constant 0
a = 00__0_0       # CHECK: %[[CST:.*]] = index.constant 0
a = 1__9_         # CHECK: %[[CST:.*]] = index.constant 19
a = 0x123         # CHECK: %[[CST:.*]] = index.constant 291
a = 0X123         # CHECK: %[[CST:.*]] = index.constant 291
a = 0b10101       # CHECK: %[[CST:.*]] = index.constant 21
a = 0B10101       # CHECK: %[[CST:.*]] = index.constant 21
a = 0o711         # CHECK: %[[CST:.*]] = index.constant 457
a = 0O711         # CHECK: %[[CST:.*]] = index.constant 457
b = 1.1           # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.100000e+00>
b = .1            # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.000000e-01>
b = 1.            # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.000000e+00>
b = 1e2           # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.000000e+02>
b = 1.1e2         # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.100000e+02>
b = .1e2          # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.000000e+01>
b = 1.e2          # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.000000e+02>
b = 1e+2          # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.000000e+02>
b = 1.1e-2        # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.100000e-02>
b = .1e+2         # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.000000e+01>
b = 1.e-2         # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.000000e-02>
b = 0.1           # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.000000e-01>
b = 0.            # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <0.000000e+00>
b = 0e2           # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <0.000000e+00>
b = 0.1e2         # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.000000e+01>
b = 0.e2          # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <0.000000e+00>
b = 0e+2          # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <0.000000e+00>
b = 0.1e-2        # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.000000e-03>
b = 0.e-2         # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <0.000000e+00>
b = 12.31e+11     # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.231000e+12>
b = 1_2.3__1e+1_1 # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.231000e+12>
b = 12.31E-3      # CHECK: %[[CST:.*]] = kgen.param.constant : f64 = <1.231000e-02>
