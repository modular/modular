# RUN: kgen-translate -import-mojo %s --mlir-print-debuginfo > %t.mlir
# RUN: kgen-opt %t.mlir -lower-semantic-cf -check-lifetimes -verify-diagnostics

struct MemExample:
  fn __init__(self&): pass
  fn __copy__(self) -> Self:
    return MemExample{}
  fn __del___(owned self): pass

fn use(x: MemExample): pass

@register_passable
struct RegExample:
  fn __init__() -> Self:
    return RegExample{}
  fn __copy__(self) -> Self:
    return RegExample{}
  fn __del___(owned self):
    pass

fn use(x: RegExample): pass



fn use_of_init() -> RegExample:
  var a = RegExample()
  return a   # OK!

fn use_of_init2() -> MemExample:
  var a = MemExample()
  return a   # OK!

fn use_of_uninit() -> RegExample:
  var a : RegExample # expected-note {{value declared here}}
  return a   # expected-error {{invalid use of uninitialized value}}

fn use_of_uninit2() -> MemExample:
  var a : MemExample  # expected-note {{value declared here}}
  return a   # expected-error {{invalid use of uninitialized value}}

fn use_of_uninit_if(cond: Bool):
  var a : MemExample
  if cond:
    a = MemExample()
  else:
    a = MemExample()
  use(a)  # Ok

  var b : MemExample  # expected-note {{value declared here}}
  if cond:
    b = MemExample()
  use(b) # expected-error {{invalid use of uninitialized value}}

  var c : MemExample
  if True:
    c = MemExample()
  use(c) # Ok.


fn use_of_uninit_while(cond: Bool):
  var a : MemExample
  if cond:
    # Infinite loop never returns
    while True: pass
  else:
    a = MemExample()
  use(a)  # Ok

  var b : RegExample  # expected-note {{value declared here}}
  while cond:
    b = RegExample()

  use(b)  # expected-error {{invalid use of uninitialized value}}



fn use_of_uninit_raise(cond: Bool, err: Error):
  var a : MemExample
  try:
    raise err
  except:
    a = MemExample()
    pass
  use(a)  # ok

  var b : MemExample
  try:
    b = MemExample()
    raise err
  except:
    pass
  use(b)  # ok

  var c : MemExample  # expected-note {{value declared here}}
  try:
    if cond:
      c = MemExample()
      raise err
    else:
      raise err
  except:
    pass
  use(c)  # expected-error {{invalid use of uninitialized value}}

  var d : MemExample
  try:
    if cond:
      raise err
  except:
    d = MemExample()
  else:
    d = MemExample()
  use(d)  # Ok
