# CHECK-LABEL: lit.struct.decl @FieldSensitiveMemExample
struct FieldSensitiveMemExample:
  var f1 : MemExample
  var f2 : MemExample

  # CHECK: lit.func @"__init__
  fn __init__(self&):
    # CHECK-NEXT: %0 = lit.struct.gep %self[f1]
    # CHECK-NEXT: kgen.call {{.*}}__init__{{.*}}(%0)
    self.f1 = MemExample()
    # CHECK-NEXT: %2 = lit.struct.gep %self[f2]
    # CHECK-NEXT: kgen.call {{.*}}__init__{{.*}}(%2)
    self.f2 = MemExample()
    # CHECK-NEXT: kgen.param.constant: !lit.none = <#lit.none>
    # CHECK-NEXT: kgen.return

 # CHECK: lit.func @"__init__
  fn __init__(self&, a: MemExample, b: MemExample):
    self.f1 = a
    self.f2 = b

  fn __copyinit__(self&, existing: Self):
    self = Self(existing.f1, existing.f2)

 # CHECK-LABEL: lit.func @"mutate
 fn mutate(self&):
    # CHECK-NEXT: %0 = lit.struct.gep %self[f1]
    # CHECK-NEXT: kgen.call @{{.*}}@"__del___{{.*}}(%0)

    # CHECK-NEXT: %2 = lit.struct.gep %self[f1]
    # CHECK-NEXT: kgen.call {{.*}}__init__{{.*}}(%2)
    self.f1 = MemExample()
    # CHECK-NEXT: kgen.param.constant: !lit.none = <#lit.none>

 # CHECK-LABEL: lit.func @"mutate2
 fn mutate2(self&):
    # Disable the dtor of 'f1' before we overwrite it to show we can do this.
    # CHECK-NEXT: %0 = lit.struct.gep %self[f1]
    # CHECK-NEXT: lit.ownership.mark.destroyed %0
    __mlir_op.`lit.ownership.mark.destroyed`[_type : None](
       __get_lvalue_as_address(self.f1)
    )

    # CHECK-NEXT: %1 = lit.struct.gep %self[f1]
    # CHECK-NEXT: kgen.call {{.*}}__init__{{.*}}(%1)
    self.f1 = MemExample()
    # CHECK-NEXT: kgen.param.constant: !lit.none = <#lit.none>


  # CHECK-LABEL: lit.func @"__del__
  # CHECK-NEXT: %0 = lit.struct.gep %self[f1]
  # CHECK-NEXT: kgen.call @{{.*}}@"__del___{{.*}}(%0)
  # CHECK-NEXT: %2 = lit.struct.gep %self[f2]
  # CHECK-NEXT: kgen.call @{{.*}}@"__del___{{.*}}(%2)
  # CHECK-NEXT: kgen.param.constant: !lit.none
  # CHECK-NEXT: lit.ownership.mark.destroyed %self

# This disables the destructor of 'x' which causes the fields to be destroyed.
# CHECK-LABEL: lit.func @"disableDtor
fn disableDtor(owned x: FieldSensitiveMemExample):
  # CHECK-NEXT: %0 = lit.struct.gep %x[f1]
  # CHECK-NEXT: kgen.call @{{.*}}@"__del___{{.*}}(%0)
  # CHECK-NEXT: %2 = lit.struct.gep %x[f2]
  # CHECK-NEXT: kgen.call @{{.*}}@"__del___{{.*}}(%2)
  # CHECK-NEXT: lit.ownership.mark.destroyed %x
  # CHECK-NEXT: kgen.param.constant: !lit.none
  __mlir_op.`lit.ownership.mark.destroyed`[_type : None](
     __get_lvalue_as_address(x)
  )


# Result optimization cannot emit directly into a value that is passed as an
# argument, because this forms a mutable reference to something immutably
# borrowed implicitly.  We must invoke the copy ctor.
# CHECK-LABEL: lit.func @"use_and_return
fn use_and_return(a: FieldSensitiveMemExample) -> FieldSensitiveMemExample:
  # This will read from 'a' and write into the result slot in an arbitrary
  # order. They cannot alias.
  return FieldSensitiveMemExample(a.f2, a.f1)

fn use_and_return2(a: FieldSensitiveMemExample) -> MemExample:
  return a.f2

# CHECK-LABEL: lit.func @"test_result_optimization
fn test_result_optimization():
  # CHECK-NEXT: %example = lit.varlet.decl "example"
  # CHECK-NEXT: kgen.call @{{.*}}"__init__{{.*}}(%example)
  var example = FieldSensitiveMemExample()

  # Direct reuse of the result slot forces a temporary.

  # CHECK: %__call_result_tmp__ = lit.varlet.decl
  # CHECK-NEXT: kgen.call @"$ownership{{.*}}(%__call_result_tmp__, %example)
  # CHECK-NEXT: kgen.call @{{.*}}@"__del___{{.*}}(%example)
  # CHECK-NEXT: kgen.call @{{.*}}@"__copyinit__{{.*}}(%example, %__call_result_tmp__)
  # CHECK-NEXT: kgen.call @{{.*}}@"__del___{{.*}}(%__call_result_tmp__)
  example = use_and_return(example)

  # Aliased reuse of part of the result slot forces a temporary.

  # CHECK-NEXT: %__call_result_tmp___0 = lit.varlet.decl
  # CHECK-NEXT: [[F1:%.*]] = lit.struct.gep %example[f1]
  # CHECK-NEXT: kgen.call @"$ownership"::@"use_and_return2{{.*}}(%__call_result_tmp___0, %example)
  example.f1 = use_and_return2(example)
  # CHECK-NEXT: [[F1_2:%.*]] = lit.struct.gep %example[f1]
  # CHECK-NEXT: kgen.call @{{.*}}@"__del___{{.*}}([[F1_2]])
  # CHECK-NEXT: kgen.call @{{.*}}@"__copyinit__{{.*}}([[F1]], %__call_result_tmp___0)
  # CHECK-NEXT: kgen.call @{{.*}}@"__del___{{.*}}(%__call_result_tmp___0)

  example.mutate()
  # CHECK-NEXT: kgen.call @{{.*}}@"mutate{{.*}}(%example)
  # CHECK-NEXT: kgen.call @{{.*}}@"__del___{{.*}}(%example)

  # CHECK-NEXT: kgen.param.constant: !lit.none = <#lit.none>


