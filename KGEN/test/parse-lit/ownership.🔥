# RUN: kgen-translate -import-mojo %s --mlir-print-debuginfo -o %t.mlir
# RUN: kgen-opt %t.mlir -lower-semantic-cf -check-lifetimes | FileCheck %s

# CHECK-LABEL: lit.struct.decl @MemExample
struct MemExample:
  var x : Int
  fn __init__(self&): self.x = 42; pass
  fn noop(self): pass

  # Destructor should not recurse.
  # CHECK-LABEL: lit.func @"__del__
  # CHECK-NEXT:    kgen.call {{.*}}noop{{.*}}(%self)
  # CHECK-NEXT:    %1 = kgen.param.constant{{.*}} <#lit.none>
  # CHECK-NEXT:    kgen.return %1 : !lit.none
  fn __del___(owned self):
    self.noop()

# CHECK-LABEL: lit.struct.decl @RegExample
# CHECK: attributes {{.*}}destructor = #kgen.symbol.constant<@"$ownership"::@RegExample::@"__del___
@register_passable
struct RegExample:
  fn __init__() -> Self:
    return RegExample{}
  fn __copyinit__(self) -> Self:
    return RegExample{}
  # CHECK-LABEL: lit.func @"__del___
  # CHECK-NEXT: %self_0 = lit.varlet.decl "self", var = true
  # CHECK-NEXT: pop.store %self, %self_0

  # FIXME: infinite recursion is bad.
  # CHECK-NEXT: %0 = pop.load %self_0 : !pop.pointer<@"$ownership"::@RegExample>
  # CHECK-NEXT: %1 = kgen.call @"$ownership"::@RegExample::@"__del___($ownership::RegExample)"(%0) : (!kgen.declref<@"$ownership"::@RegExample>) -> !lit.none

  # CHECK-NEXT: %2 = kgen.param.constant{{.*}} <#lit.none>
  # CHECK-NEXT: kgen.return %2
  fn __del___(owned self):
    pass

# CHECK-LABEL: lit.func @"destructors
# CHECK-SAME: (%arg0: !pop.pointer<@"$ownership"::@MemExample> owned_in_mem)
fn destructors(owned arg0: MemExample):
  # CHECK-NEXT: kgen.call {{.*}}__del__{{.*}}(%arg0)

  # CHECK-NEXT: %mem1 = lit.varlet.decl "mem1", var = true
  var mem1 = MemExample()
  # CHECK-NEXT: kgen.call {{.*}}__init__{{.*}}(%mem1)
  # CHECK-NEXT: kgen.call {{.*}}__del__{{.*}}(%mem1)

  var mem2 = MemExample()
  # CHECK-NEXT: %mem2 = lit.varlet.decl "mem2", var = true
  # CHECK-NEXT: kgen.call {{.*}}__init__{{.*}}(%mem2)
  mem2.noop()
  # CHECK-NEXT: kgen.call {{.*}}noop{{.*}}(%mem2)
  # CHECK-NEXT: kgen.call {{.*}}__del__{{.*}}(%mem2)

  mem2 = MemExample()
  # CHECK-NEXT: kgen.call {{.*}}__init__{{.*}}(%mem2)

  # CHECK-NEXT: [[REGVAL:%.*]] = kgen.call @"$ownership"::@RegExample::@"__init__()"()
  let reg = RegExample()
  # CHECK-NEXT: %reg = lit.letreg.decl "reg" = [[REGVAL]]
  # CHECK-NEXT: kgen.call {{.*}}__del__{{.*}}(%reg)

  mem2.noop()
  # CHECK-NEXT: kgen.call {{.*}}noop{{.*}}(%mem2)
  # CHECK-NEXT: kgen.call {{.*}}__del__{{.*}}(%mem2)

# CHECK-LABEL: lit.func @"if_examples
fn if_examples(cond: __mlir_type.i1):
  # CHECK: %a = lit.varlet.decl
  var a: MemExample

  # CHECK-NEXT: %b = lit.varlet.decl
  # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%b)
  # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%b)
  var b = MemExample()

  # CHECK: hlcf.if %cond {
  if cond:
    # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%a)
    # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%a)
    a = MemExample()
  # CHECK-NEXT: hlcf.yield
  # CHECK-NEXT: } else {
  else:
    # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%b)
    # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%b)
    b = MemExample()
  # CHECK-NEXT:   hlcf.yield
  # CHECK-NEXT: }

  # CHECK-NEXT: %c = lit.varlet.decl
  # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%c)
  var c = MemExample()
  # CHECK: hlcf.if %cond {
  if cond:
    # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%c)
    # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%c)
    c = MemExample()
  # CHECK-NEXT:   hlcf.yield
  # CHECK-NEXT: } else {
  else:
    pass
  # CHECK-NEXT:   hlcf.yield
  # CHECK-NEXT: }
  # CHECK-NEXT: kgen.call @{{.*}}noop{{.*}}(%c)
  c.noop()
  # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%c)

  # CHECK-NEXT:  %d = lit.varlet.decl "d"
  # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%d)
  var d = MemExample()

  # CHECK-NEXT: [[ONE:%[0-9]+]] = kgen.param.constant: i1 = <1>
  # CHECK: hlcf.if [[ONE]] {
  if True:
    # CHECK-NEXT: kgen.call @{{.*}}noop{{.*}}(%d)
    d.noop()
  # CHECK-NEXT:   hlcf.yield
  # CHECK-NEXT: } else {
  # CHECK-NEXT:   kgen.unreachable
  # CHECK-NEXT: }

  # CHECK-NEXT: kgen.call @{{.*}}noop{{.*}}(%d)
  d.noop()
  # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%d)

# CHECK-LABEL: lit.func @"try_examples
fn try_examples(cond: __mlir_type.i1, err: Error):
  # CHECK-NEXT: %a = lit.varlet.decl
  var a : MemExample
  # CHECK-NEXT: lit.try {
  # CHECK-NOT: %a
  try:
    raise err
  # CHECK: } except (%arg0:
  except:
    # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%a)
    a = MemExample()
    # CHECK-NEXT: lit.try.yield
  # CHECK-NEXT: } else {
  # CHECK-NEXT:      kgen.unreachable
  # CHECK-NEXT: }
  # CHECK-NEXT: kgen.call @{{.*}}noop{{.*}}(%a)
  a.noop()  # ok
  # CHECK-NEXT: gen.call @{{.*}}__del__{{.*}}(%a)

  # CHECK-NEXT: %b = lit.varlet.decl
  var b : MemExample
  # CHECK-NEXT: lit.try {
  try:
    # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%b)
    b = MemExample()
    # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%b)
    raise err
  # CHECK: } except (%arg0:
  # CHECK-NEXT: lit.try.yield
  except:
    pass
  # CHECK-NEXT: } else {
  # CHECK-NEXT:      kgen.unreachable
  # CHECK-NEXT: }

  # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%b)
  b = MemExample()
  # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%b)

  # CHECK-NEXT: %c = lit.varlet.decl
  var c : MemExample
  # CHECK-NEXT: lit.try {
  try:
    # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%c)
    c = MemExample()
    # CHECK-NOT: %c
    raise err
  # CHECK: } except (%arg0:
  # CHECK-NEXT: lit.try.yield
  except:
    pass
  # CHECK-NEXT: } else {
  # CHECK-NEXT:      kgen.unreachable
  # CHECK-NEXT: }
  # CHECK-NEXT: kgen.call @{{.*}}noop{{.*}}(%c)
  c.noop()
  # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%c)

  # CHECK-NEXT: %d = lit.varlet.decl
  var d : MemExample
  # CHECK-NEXT: lit.try {
  try:
    # CHECK-NEXT:  hlcf.if %cond {
    if cond:
      raise err
    # CHECK-NOT: %d
  # CHECK: } except (%arg0:
  except:
    # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%d)
    d = MemExample()
    # CHECK-NEXT: lit.try.yield
  # CHECK-NEXT: } else {
  else:
    # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%d)
    d = MemExample()
    # CHECK-NEXT: lit.try.yield
  # CHECK-NEXT: }

  # CHECK-NEXT: kgen.call @{{.*}}noop{{.*}}(%d)
  d.noop()
  # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%d)

# CHECK-LABEL: lit.func @"loop_example
fn loop_example(cond1: __mlir_type.i1, cond2: __mlir_type.i1):
  # CHECK-NEXT: %a = lit.varlet.decl "a"
  var a : MemExample
  # CHECK-NEXT: %b = lit.varlet.decl "b"
  var b : MemExample
  # CHECK-NEXT: %c = lit.varlet.decl "c"
  var c : MemExample

  # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%a)
  a = MemExample()

  # Unneeded boilerplate due to 'while True':
  # CHECK-NEXT: hlcf.loop {
  # CHECK-NEXT:  = kgen.param.constant: i1 = <1>
  # CHECK-NEXT:      hlcf.if
  # CHECK-NEXT:        hlcf.yield
  # CHECK-NEXT:      } else {
  # CHECK-NEXT:        kgen.unreachable
  # CHECK-NEXT:      }
  while True:
    # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%c)
    c = MemExample()
    # CHECK-NEXT: hlcf.if %cond2 {
    if cond2:
      # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%b)
      b = MemExample()
      # CHECK-NEXT: hlcf.break
      break
    # CHECK-NEXT: } else {
    # CHECK-NEXT:   kgen.call @{{.*}}__del__{{.*}}(%c)
    # CHECK-NEXT:   kgen.call @{{.*}}__del__{{.*}}(%a)
    # CHECK-NEXT:   hlcf.yield
    # CHECK-NEXT: }

    # CHECK-NEXT: kgen.call @{{.*}}__init__{{.*}}(%a)
    # CHECK-NEXT: hlcf.continue
    a = MemExample()
  # CHECK-NEXT: }

  # CHECK-NEXT: kgen.call @{{.*}}noop{{.*}}(%a)
  a.noop()
  # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%a)

  # CHECK-NEXT: kgen.call @{{.*}}noop{{.*}}(%b)
  b.noop()
  # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%b)

  # CHECK-NEXT: kgen.call @{{.*}}noop{{.*}}(%c)
  c.noop()
  # CHECK-NEXT: kgen.call @{{.*}}__del__{{.*}}(%c)


# CHECK-LABEL: lit.func @"indirect_call
fn indirect_call[
        detail_fn: __mlir_type[
            `!kgen.signature<(!pop.pointer<`,
            MemExample,
            `> byref_result) -> !lit.none>`,
        ],
    ]():
       # CHECK: %mem = lit.varlet.decl
       # CHECK-NEXT: kgen.call_param{{.*}}(%mem)
       let mem = detail_fn()
       # CHECK-NEXT: kgen.call @{{.*}}noop{{.*}}(%mem)
       mem.noop()
       # CHECK-NEXT: kgen.call @{{.*}}@"__del___{{.*}}(%mem)
       # CHECK-NEXT: %3 = kgen.param.constant
       # CHECK-NEXT: kgen.return %3

@raises
fn somethingThatRaises(): pass

# FIXME(Issue#12196): We don't track the result slot at all to work around an
# IR modeling issue.
@raises
fn thing_that_raises(value: Int, c: Bool) -> MemExample:
    somethingThatRaises()
    if c:
        return MemExample()
    raise Error("TypeError: cannot invert values of this type")

struct Parameterized[level: Int]:
    fn __init__(self&): pass

    fn __del___(owned self):
        pass

# CHECK-LABEL: lit.func @"test_parameterized
fn test_parameterized():
  # CHECK: %x = lit.varlet.decl "x"
  let x = Parameterized[4]()
  # CHECK: kgen.call @"$ownership"::@Parameterized::@"__del___($ownership::Parameterized[level])"<:@"$Int"::@Int #lit.struct<{value: scalar<index> = 4}>>(%x)

struct Complicated:
  var a: MemExample
  var b: MemExample

# Issue #12068 - This shouldn't crash.
fn testPointerGEP(ptr: __mlir_type[`!pop.pointer<`, Complicated, `>`]) -> Int:
  let addr = ptr
  return __get_address_as_lvalue(addr).b.x


