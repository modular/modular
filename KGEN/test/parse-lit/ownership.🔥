# RUN: kgen-translate -import-mojo %s | FileCheck %s


# CHECK-LABEL: lit.struct.decl @MemExample
struct MemExample:
  fn __init__(self&): pass
  fn __del___(owned self): pass

# CHECK-LABEL: lit.struct.decl @RegExample
@register_passable
struct RegExample:
  fn __init__() -> Self: pass
  fn __del___(owned self): pass


# CHECK: lit.func @"destructors
# CHECK-SAME: (%arg0: !pop.pointer<@"$ownership"::@MemExample> owned_in_mem)
fn destructors(owned arg0: MemExample):
  # CHECK: %arg0.arg = lit.owned.arg.decl "arg0", %arg0, #kgen.symbol.constant<@"$ownership"::@MemExample::@"__del___($ownership::MemExample)" >

  # CHECK: %mem = lit.varlet.decl "mem", var = true,
  # CHECK-SAME: #kgen.symbol.constant<@"$ownership"::@MemExample::@"__del___($ownership::MemExample)" >
  var mem = MemExample()

  # CHECK: %reg = lit.letreg.decl "reg" = %1,
  # CHECK-SAME: #kgen.symbol.constant<@"$ownership"::@RegExample::@"__del___($ownership::RegExample)" > : !kgen.signature<(!kgen.declref<@"$ownership"::@RegExample>) -> !lit.none>
  # CHECK-SAME: : !kgen.declref<@"$ownership"::@RegExample>
  let reg = RegExample()
