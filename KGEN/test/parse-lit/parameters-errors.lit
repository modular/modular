# RUN: kgen-translate -import-lit -verify-diagnostics %s -I %stdlibdir -I %S/../lit-examples/

from prolog import Bool, DType, Error, F32, Int, object

##===----------------------------------------------------------------------===##
# Input parameters
##===----------------------------------------------------------------------===##

struct ParametricOnInt[a: Int]:
fn Rec2[
  a: ParametricOnInt[b], # expected-error {{use of unknown declaration 'b'}}
  b: ParametricOnInt[a]]():
  pass

# expected-note @+1 {{'Thing' declared here}}
struct Thing[a: __mlir_type.index, b: __mlir_type.index]:

def GoodUseOfThing(a: Thing[4, 5]):
  pass

def MissingThingMetaParams(a: Thing):  # expected-error {{use of type 'Thing' with 2 unbound parameters}}
  pass

# expected-error @+1 {{cannot apply more parameters to an already parameterized type '$parameters-errors::Thing[1, 2]'}}
def MultipleThingMetaparams(a: Thing[1,2][1]):
  pass

def OneMissingThingMetaParam(a: Thing[1]):  # expected-error {{'Thing' expects 2 input parameters but 1 was provided}}
  pass

# expected-error @+1 {{'Thing' parameter 'b' has '__mlir_type.index' type, but value has type '__mlir_type.f64'}}
def WeirdMetaParams(a: Thing[1, 1.5]):
  pass

# expected-note @+1 {{previous definition here}}
struct Parameterized[p1: __mlir_type.index]:
  # expected-error @+1 {{invalid redefinition of 'p1'}}
  fn a[p1: Int](self):  # Cannot shadow parameter names.

  # expected-error @+2 {{invalid redefinition of 'p2'}}
  # expected-note @+1 {{previous definition here}}
  fn b[p2: Int, p2: Int, p3: Int](self):  # Cannot shadow parameter names.

  fn __new__() -> Parameterized[p1]:
    var result: Parameterized[p1]
    return result

  # expected-note @+2 {{'method' declared here}}
  # expected-note @+1 {{function declared here}}
  fn method[B: __mlir_type.index](self, other: Parameterized[p1+B]):
    pass


# Test that we support partially bound parameters and diagnose incorrect uses
# of parameters.
fn testTestParamStruct(a: Parameterized[4]):
  a.method[7](Parameterized[11]())
  # expected-error @+1 {{invalid call to 'method': method argument #0 cannot be converted from '$parameters-errors::Parameterized[12]' to '$parameters-errors::Parameterized[11]'}}
  a.method[7](Parameterized[12]())
  a.method[2](Parameterized[6]())
  a.method[2, 7] # expected-error {{'method' expects 2 input parameters but 3 were provided}}


struct MySIMD[size: __mlir_type.index, type: __mlir_type.`!kgen.dtype`]:
  # expected-note @below {{function declared here}}
  fn __add__(self, rhs: MySIMD[size, type]):

fn testSIMD(a: MySIMD[1, __mlir_attr.`#kgen.dtype.constant<f64> : !kgen.dtype`],
            b: MySIMD[2, __mlir_attr.`#kgen.dtype.constant<si32> : !kgen.dtype`]):
  var x = a+a
  var y = b+b
  var z = b+a  # expected-error {{invalid call to '__add__': right side cannot be converted from '$parameters-errors::MySIMD[1, f64]' to '$parameters-errors::MySIMD[2, si32]'}}

# expected-note @+1 {{function declared here}}
fn badReboundType[type: __mlir_type.`!kgen.dtype`,
                  val: __mlir_type[`!pop.scalar<`, type, `>`]]():

fn badCallReboundType[val: __mlir_type.`!pop.scalar<f32>`]():
  # expected-error @+1 {{invalid call to 'badReboundType': callee parameter 'val' has '__mlir_type.!pop.scalar<f64>' type, but value has type '__mlir_type.!pop.scalar<f32>'}}
  badReboundType[__mlir_attr.`#kgen.dtype.constant<f64> : !kgen.dtype`, val]()

fn partialBindSignature[callable: __mlir_type.`!kgen.signature<<a, b>() -> ()>`, a: __mlir_type.index]():
  # expected-error @below {{parametric callable expected 2 parameters}}
  return callable[a]

# expected-note @+1 {{function declared here}}
def generic_fn[a: DType, b: __mlir_type.index](c : __mlir_type.index):

def call_generic[dt: DType]():
  generic_fn[dt, 1, 42](57) # expected-error {{invalid call to 'generic_fn': callee expects 2 input parameters but 3 were provided}}
  generic_fn[1, dt](57) # expected-error {{parameter 'a' has '$prolog::DType' type, but value has type '__mlir_type.index'}}

fn meta_param_then_param_redef[
      dt: __mlir_type.index # expected-note {{previous definition here}}
    ](dt: __mlir_type.index):    # expected-error {{invalid redefinition of 'dt'}}
  pass

# expected-note @below {{previous definition here}}
# expected-error @below {{invalid redefinition of 'x'}}
def param_redef(x: __mlir_type.index, x: __mlir_type.index):
  pass

##===----------------------------------------------------------------------===##
# Variadic Parameters
##===----------------------------------------------------------------------===##

# The keyword argument flags work in parameter lists.
fn funnyArgs[a: Int, /, b: Int, *,
             c: Int](): # expected-error {{TODO: keyword arguments not supported yet}}
  funnyArgs[1, 2, 3]()

# expected-error @+1 {{TODO: parameter lists do not support variadics}}
fn variadic[*a: Int]():



##===----------------------------------------------------------------------===##
# Result parameters
##===----------------------------------------------------------------------===##

# expected-error @+1 {{struct declarations do not support result parameters}}
struct ResultParams[a: Int -> Int, F32]:

# expected-note @+1 {{function declared here}}
fn hasResultParam[a: __mlir_type.index -> __mlir_type.index]():
  return[a]

# expected-note @+1 {{function declared here}}
fn hasInputParam[a: __mlir_type.index]():

fn useResultParams():
  # expected-error @+1 {{invalid call to 'hasResultParam': callee expects 1 result parameter but 0 were provided}}
  hasResultParam[1]()

  alias b: __mlir_type.index
  hasResultParam[1 -> b]()  # expected-note {{previously defined here}}

  # expected-error @+1 {{'b' alias was defined by another result}}
  hasResultParam[1 -> b]()

  alias c: __mlir_type.index
  alias d: __mlir_type.index
  # expected-error @+1 {{invalid call to 'hasResultParam': callee expects 1 result parameter but 2 were provided}}
  hasResultParam[1 -> c, d]()

  # expected-error @+1 {{unable to find forward-declared alias named 'e'}}
  hasResultParam[1 -> e]()

  alias f: __mlir_type.f32 # expected-note {{alias forward declared here}}
  # expected-error @+1 {{result parameter returns type '__mlir_type.index' but forward declaration is of type '__mlir_type.f32'}}
  hasResultParam[1 -> f]()

  var varNotAlias : __mlir_type.f32 # expected-note {{'varNotAlias' declared here}}
  # expected-error @+1 {{'varNotAlias' is not a forward declared alias}}
  hasResultParam[1 -> varNotAlias]()

  alias g: __mlir_type.index
  # expected-error @+1 {{calls with result parameters must be called directly}}
  _ = hasResultParam[1 -> g]

  # expected-error @+1 {{calls with result parameters must be called directly}}
  _ = hasResultParam

  # expected-error @+1 {{cannot use parameterized function of type '__mlir_type.!kgen.signature<<a>() -> !lit.none>' without binding all its parameters}}
  _ = hasInputParam

  # expected-error @+1 {{invalid call to 'hasInputParam': callee expects 1 input parameter but 0 were provided}}
  hasInputParam()

  # Issue #6856: Cannot bind parameter results is parameter expressions
  alias h: __mlir_type.index
  # expected-error @+1 {{cannot call 'hasResultParam' in parameter expression because it has a parameter result}}
  alias x = hasResultParam[1 -> h]()

fn incorrectParameterReturnType[()->__mlir_type.index]():
  # expected-error @+1 {{'__mlir_type.f64' value cannot be converted to '__mlir_type.index' in result parameter list}}
  return[4.0]

##===----------------------------------------------------------------------===##
# First-class functions as parameters.
##===----------------------------------------------------------------------===##

##===----------------------------------------------------------------------===##
# Alias resolution
##===----------------------------------------------------------------------===##

fn testAliases(variable: Int):
  # expected-error @+1 {{declaration must have either a type or an initializer}}
  alias MissingInit

  # expected-error @+1 {{cannot use a dynamic value in meta context}}
  alias NotConstant = variable*2

  # TODO(Issue #5975): This isn't getting resolved before the end of body.
  # xpected-error @+1 {{alias 'NotInitialized' was never defined by a result parameter}}
  alias NotInitialized : __mlir_type.index

  if variable != 0:
    alias x : Int # expected-error {{parameter results may only be declared in a function}}

struct BadAliasStruct:
  alias x: Int # expected-error {{parameter results may only be declared in a function}}


fn testConversionQoI():
  # expected-error @+1 {{'__mlir_type.f64' value cannot be converted to '$Int::Int' in alias}}
  alias intVal : Int = 1.2


@nodebug_inline
fn crash1_callee(a: __mlir_type.index, rhs: __mlir_type.index) -> __mlir_type.index:
  return __mlir_op.`index.add`(a, rhs)

fn crash1_caller[p: __mlir_type.index](a: __mlir_type.index):
  alias y = crash1_callee(a, p) # expected-error {{cannot use a dynamic value in meta context}}
