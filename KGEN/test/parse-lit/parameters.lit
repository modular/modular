# CHECK-LABEL: lit.func @"my_assert_param()"<cond: i1, message: string>() -> !lit.none {
fn my_assert_param[cond: __mlir_type.i1, message: __mlir_type.`!kgen.string`]():
    #CHECK: kgen.param.assert <cond>, message
    __mlir_op.`kgen.param.assert`[cond:cond, message:message]()
    return

# CHECK-LABEL: lit.func @"my_assert_param_inline{{.*}} attributes {noDebugInline} {
@nodebug_inline
fn my_assert_param_inline[cond: __mlir_type.i1, message: __mlir_type.`!kgen.string`]():
    #CHECK: kgen.param.assert <cond>, message
    __mlir_op.`kgen.param.assert`[cond:cond, message:message]()
    return


# CHECK-LABEL: lit.func @"pass_str_param
fn pass_str_param():
    # CHECK: kgen.call {{.+}}my_assert_param()"<cond: i1 = 1, message: string = "foo">() : () -> !lit.none
    my_assert_param[1==1, "foo"]()
    # CHECK: kgen.param.assert <1>, "foo2"
    my_assert_param_inline[2==2, "foo2"]()

##===----------------------------------------------------------------------===##
# Alias resolution
##===----------------------------------------------------------------------===##

# CHECK: kgen.param.declare boolDtype: dtype = <bool>
alias boolDtype = __mlir_attr.`#kgen.dtype.constant<bool> : !kgen.dtype`
# CHECK: kgen.param.declare FOURTY_TWO = <42>
alias FOURTY_TWO = 42

# CHECK-LABEL: lit.struct.decl @A<v>
struct A[v: __mlir_type.index]:
  # CHECK: kgen.param.declare member = <add(v, 42)>
  alias member = v + FOURTY_TWO

# CHECK-LABEL: lit.func @"testUseOfAliases
fn testUseOfAliases(a: Bool):
  # This type checks.
  _ = SIMD[4, boolDtype].splat(a.value)
  # CHECK: kgen.param.declare y = <44>
  alias y = A[2].member

struct MyDType:
  var state : __mlir_type.ui8

  fn __new__(value: __mlir_type.index) -> MyDType:
     var result: MyDType
     # TODO: store 'value' casted to ui8 into result.state
     return result

  fn __eq__(self, rhs: MyDType) -> Bool:
     return Bool.true()  # TODO: buggy impl :-)

  alias ui8 = MyDType(1)
  alias f32 = MyDType(2)
  alias f64 = MyDType(3)

struct MyVector[size: Int, dtype: MyDType]:

fn testMyDType[dt: MyDType](a: MyVector[4, MyDType.f32],
                            b: MyVector[4, dt]):

   assert_param[(dt == MyDType.f64).__lit_bool()]()

# Issue #6828: Unqualified name lookup into structs doesn't work
# CHECK-LABEL:  lit.struct.decl @UnqualAliasLookup<param>
struct UnqualAliasLookup[param: __mlir_type.index]:
  # CHECK: kgen.param.declare member = <add(param, 1)>
  alias member = param+1
  fn get(self) -> __mlir_type.index:
    # CHECK: %0 = kgen.param.constant = <add(param, 1)>
    return member

##===----------------------------------------------------------------------===##
# Variadic parameters
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"fnWithVariadics
# CHECK-SAME: <b: !pop.variadic<@"$Int"::@Int>>
fn fnWithVariadics[*b: Int]():

# CHECK-LABEL: lit.struct.decl @StructWithVariadics
# CHECK-SAME: <b: !pop.variadic<@"$Int"::@Int>>
struct StructWithVariadics[*b: Int]:

# CHECK-LABEL: lit.func @"useParamVariadics
fn useParamVariadics():
  #fnWithVariadics()
  #fnWithVariadics[1]()
  #fnWithVariadics[1, 2]()

  # This keeps the parameters unbound, allowing them to be used with different length..
  # CHECK-NEXT: kgen.param.declare fnAlias: <b: !pop.variadic<@"$Int"::@Int>>() -> !lit.none = <@"$parameters"::@"fnWithVariadics()">
  alias fnAlias = fnWithVariadics
  # This immediately binds to an empty variadic list.
  #let fn = fnWithVariadics

  #var a: StructWithVariadics
  #var b: StructWithVariadics[1]
  #var c: StructWithVariadics[1, 2]
