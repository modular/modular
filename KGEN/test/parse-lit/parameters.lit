fn fnToCall[size: __mlir_type.index, array: __mlir_type[`!pop.array<`, size, `, f32>`]]():
  pass

# CHECK: lit.func @"fnWithCall
fn fnWithCall[array: __mlir_type[`!pop.array<10, f32>`]]():
