 # CHECK: kgen.struct.field b : !kgen.declref<@Int>
  var a : OurSIMD[42, dt]
  var b : Int

  # CHECK: lit.func @"__new__{{.*}}() -> !kgen.declref<@Pair<dt: !kgen.declref<@DType> = dt>> attributes {isStatic}
  fn __new__() -> Pair[dt]:
    var result : Pair[dt]
    # TODO: Fill this in.
    return result
  # CHECK: }

# CHECK: }

# CHECK-LABEL: kgen.struct.decl @TypeParameter
struct TypeParameter[type: __mlir_type.`!kgen.mlirtype`]:
  # CHECK: @"bar(TypeParameter{{.*}})"(%self: {{.*}}, %val: !kgen.paramref<type>)
  fn bar(self, val: type):
    pass

# Test that parameter decls can refine subsequent ones in the same param list.
# CHECK-LABEL: kgen.struct.decl @ParamSubst<rank, shape: list<index[rank]>>
struct ParamSubst[
    rank: __mlir_type.index,
    shape: __mlir_type[`!kgen.list<index[`, rank, `]>`],
  ]: pass

# CHECK-LABEL: lit.func @"testParamSubst
fn testParamSubst():
  # CHECK: %xx = lit.var.decl "xx" : <@ParamSubst<rank = 2, shape: list<index[2]> = [1, 2]>>
  var xx : ParamSubst[2, __mlir_attr.`#kgen.list<1, 2> : !kgen.list<index[2]>`]

##===----------------------------------------------------------------------===##
# Result parameters
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"no_result_param()"<a>()
fn no_result_param[a: __mlir_type.index]():
  return

# CHECK-LABEL: lit.func @"idx_result_params()"<a -> index, index>()
fn idx_result_params[a: __mlir_type.index -> __mlir_type.index, __mlir_type.index]() -> Int:
  # CHECK: %0 = kgen.param.constant = <add(a, 2)>
  # CHECK: %1 = kgen.call @Int::@"__new__(__mlir_type.index)"(%0)
  # CHECK: kgen.return<a, add(a, 1)> %1
  return[a,a+1] a+2

# CHECK-LABEL: lit.func @"just_result_params()"<() -> index>()
fn just_result_params[() -> __mlir_type.index]():
  # CHECK: kgen.return<42>
  return[42]


# A bit grotty, but effective way to provide a kgen.param.search over three
# values.  This should be made variadic and generic and moved to the standard
# library at some point.

# CHECK-LABEL: lit.func @"search3()"<a, b, c -> index>()
fn search3[a: __mlir_type.index, b: __mlir_type.index, c: __mlir_type.index
              -> __mlir_type.index]():

   # Grotty but effective way to pull a param decl out and return it.
   # CHECK-NEXT: kgen.param.search result_hidden = <a, b, c>
   __mlir_op.`kgen.param.search`[
      paramDecls: __mlir_attr.`#kgen<param.decls[result_hidden : index]>`,
      values: __mlir_attr[`#kgen<exprs[`, a, `, `, b, `, `, c, `]>`]
   ]()
   # CHECK: kgen.param.declare result = <result_hidden>
   alias result = __mlir_attr.`#kgen.param.decl.ref<"result_hidden"> : index`
   # CHECK: kgen.return<result>
   return[result]

# CHECK-LABEL: lit.func @"useResultParams
fn useResultParams(i: Int):
  # Call function with input parameter, no result parameters.
  # CHECK: kgen.call @"no_result_param()"<a = 42>()
  no_result_param[42]()

  # CHECK: kgen.call @"search3()"<a = 1, b = 2, c = 3 -> xyz>()
  search3[1,2,3-> xyz]()

  # CHECK: kgen.call @"no_result_param()"<a = add(xyz, 1)>()
  no_result_param[xyz+1]()

  # Normal result and multi parameter results.
  # CHECK: [[TMP:%.*]] = kgen.call @"idx_result_params()"<a = mul(xyz, 2) -> a, b>() : () -> !kgen.declref<@Int>
  # CHECK-NEXT: kgen.call @Int::@"__mul__(Int,Int)"([[TMP]], %i)
  _ = idx_result_params[xyz*2 -> a, b]() * i

  # Function call with only a result parameter.
  # CHECK: kgen.call @"just_result_params()"<() -> c>()
  just_result_params[() -> c]()

##===----------------------------------------------------------------------===##
# First-class functions as parameters.
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"takeCallable(__mlir_type.index)"<callable: (index) -> index>(%a: index) -> index
fn takeCallable[
     callable: __mlir_type.`!kgen.signature<[], [], (index) -> index>`
   ](a: __mlir_type.index) -> __mlir_type.index:
  # CHECK-NEXT: %0 = kgen.call_param[(index) -> index: callable](%a)
  # CHECK-NEXT: kgen.return %0
  return callable(a)

fn takeAndReturnIndex(x: __mlir_type.index) -> __mlir_type.index:
  return x

# CHECK-LABEL: lit.func @"takeAndReturnIndex
fn passFunction(a: __mlir_type.index) -> __mlir_type.index:
  # CHECK: %0 = kgen.call @"takeCallable(__mlir_type.index)"
  # CHECK-SAME: <callable: (index) -> index =
  # CHECK-SAME: @"takeAndReturnIndex(__mlir_type.index)">(%a) : (index) -> index
  return takeCallable[takeAndReturnIndex](a)
