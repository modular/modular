# Input parameters
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.struct.decl @OurSIMD<size, dt: @"$DType"::@DType>
# CHECK-SAME: attributes {isRegisterPassable} {
@register_passable
struct OurSIMD[size: index, dt: DType]:
  pass

@register_passable
struct StructWithIntParam[size: Int]:
  pass

# CHECK-LABEL: lit.func @"paramArith{{.*}}"<x>(%y: index) -> !lit.none {
fn paramArith[x: __mlir_type.index](y : __mlir_type.index):
  # CHECK: kgen.call @"$Assert"::@"assert_param()"<cond: i1 = eq(x, -99)>()
  # HECK: kgen.param.assert <eq(x, -99)>, "param assertion failed"
  assert_param[x == -100+1]()

fn take_3index(a: __mlir_type.index, b: __mlir_type.index, c: __mlir_type.index) -> __mlir_type.index:
  return a

# CHECK-LABEL: lit.func @"fancy_signature
# CHECK-SAME: <dt: @"$DType"::@DType, size>
# CHECK-SAME: (%x: !kgen.declref<@"$parameters"::@OurSIMD<size = size, dt: @"$DType"::@DType = dt>>,
# CHECK-SAME:  %exp: !kgen.declref<@"$parameters"::@OurSIMD<size = size, dt: @"$DType"::@DType = dt>>) -> index {
fn fancy_signature[dt: DType, size: __mlir_type.index]
  (x: OurSIMD[size, dt], exp: (OurSIMD)[size, dt]) -> __mlir_type.index:

  # CHECK: %local = lit.varlet.decl "local", var = true : <index>
  # CHECK: %[[TMP1:.*]] = kgen.param.constant = <size>
  # CHECK: %[[TMP2:.*]] = kgen.param.constant = <size>
  # CHECK: %[[TMP3:.*]] = kgen.param.constant = <size>
  # CHECK: %[[RES:.*]] = kgen.call @"$parameters"::@"take_3index{{.*}}(%[[TMP1]], %[[TMP2]], %[[TMP3]]) : (index, index, index) -> index
  # CHECK: pop.store %[[RES]], %local : !pop.pointer<index>
  var local = take_3index(size, size, size)

  # CHECK: %[[TMP:.*]] = kgen.param.constant = <add(size, 42)>
  # CHECK: lit.return %[[TMP]] : index
  return size+42


fn generic_fn[a: DType, b: __mlir_type.index, c: __mlir_type.`!kgen.mlirtype`](d : __mlir_type.index):
  pass

# CHECK: lit.func @"call_generic()"<dt: @"$DType"::@DType>()
fn call_generic[dt: DType]():
  # CHECK: %idx57 = index.constant 57
  # CHECK: kgen.call @"$parameters"::@"generic_fn{{.*}}<a: @"$DType"::@DType = dt, b = 42, c: type = !kgen.declref<@"$DType"::@DType>>(%idx57)
  generic_fn[dt, 42, DType](57)

  # CHECK: [[TMP:%.*]] = index.constant 57
  # CHECK: kgen.call @"$parameters"::@"generic_fn{{.*}}<a: @"$DType"::@DType = dt, b = 13, c: type = !kgen.declref<@"$parameters"::@OurSIMD<size = 4, dt: @"$DType"::@DType = dt>>>([[TMP]])
  generic_fn[dt, 13, OurSIMD[4, dt]](57)

# CHECK-LABEL: lit.struct.decl @TestParamStruct<A>
@register_passable
struct TestParamStruct[A: __mlir_type.index]:

  fn __clone__(self&) -> Self:
    return Self{}

  fn __new__() -> TestParamStruct[A]:
    return TestParamStruct[A]{}

  # CHECK: lit.func @"method{{.*}}<B>(%self: !kgen.declref<@"$parameters"::@TestParamStruct<A = A>>, %other: !kgen.declref<@"$parameters"::@TestParamStruct<A = add(A, B)>>) -> !lit.none {
  fn method[B: __mlir_type.index](self: TestParamStruct[A], other: TestParamStruct[A+B]):
    pass

  # CHECK-LABEL: lit.func @"aliases{{.*}}%x: !kgen.declref<@"$parameters"::@TestParamStruct<A = mul(A, A)>>
  fn aliases(self, x: TestParamStruct[TestParamStruct[A].TypeLevelAlias]):
    # CHECK: kgen.param.declare B = <add(mul(A, A), 1)>
    alias B = A*A+1
    # CHECK: kgen.param.declare C = <mul(A, B)>
    alias C = B*A
    # CHECK: kgen.param.declare D: @"$parameters"::@TestParamStruct<A = 1> = <apply(:() -> !kgen.declref<@"$parameters"::@TestParamStruct<A = 1>> @"$parameters"::@TestParamStruct::@"__new__()"<A = 1>)>
    alias D = TestParamStruct[1]()
    # CHECK: %temp = lit.varlet.decl "temp", var = true : <@"$parameters"::@TestParamStruct<A = C>>
    var temp: TestParamStruct[C]

    # CHECK: kgen.param.declare intVal: @"$Int"::@Int = <#lit.struct<{value: scalar<index> = 42}>>
    alias intVal : Int = 42

    # CHECK:  %temp2 = lit.varlet.decl "temp2", var = true : <@"$parameters"::@TestParamStruct<A = mul(A, A)>>
    var temp2: TestParamStruct[TestParamStruct[A].TypeLevelAlias]

  # CHECK: kgen.param.declare TypeLevelAlias = <mul(A, A)>
  alias TypeLevelAlias = A*A

# Test that we support partially bound parameters.
fn testTestParamStruct(a: TestParamStruct[4]):
  # CHECK: %arg11 = lit.varlet.decl "arg11", var = true : <@"$parameters"::@TestParamStruct<A = 11>>
  # CHECK: %0 = kgen.call @"$parameters"::@TestParamStruct::@"__new__{{.*}}<A = 11>() : () -> !kgen.declref<@"$parameters"::@TestParamStruct<A = 11>>
  # CHECK: pop.store %0, %arg11 : !pop.pointer<@"$parameters"::@TestParamStruct<A = 11>>
  var arg11 = TestParamStruct[11]()

  # CHECK: %1 = kgen.call @"$parameters"::@TestParamStruct::@"__clone__($parameters::TestParamStruct[A]&)"<A = 11>(%arg11)
  # CHECK: %2 = kgen.call @"$parameters"::@TestParamStruct::@"method{{.*}}<A = 4, B = 7>(%a, %1) : (!kgen.declref<@"$parameters"::@TestParamStruct<A = 4>>, !kgen.declref<@"$parameters"::@TestParamStruct<A = 11>>) -> !lit.none
  a.method[7](arg11)

# CHECK-LABEL: lit.func @"testSIMD(
fn testSIMD(a: SIMD[1, DType.f64],
            b: SIMD[1, DType.si32],
            ref&: SIMD[1, DType.si32]):
  # CHECK: %field1 = lit.varlet.decl "field1", var = true : <scalar<f64>>
  var field1 = a.value
  # CHECK: %field2 = lit.varlet.decl "field2", var = true : <scalar<si32>>
  var field2 = ref.value

  # Test calls to methods and operators on parameterized type.
  _ = a.fma(a, a)
  _ = b.fma(b, b)
  # CHECK: kgen.call @"$SIMD"::@SIMD::@"__add__{{.*}}<size{{.*}} = 1{{.*}}, type:{{.*}} dtype = f64{{.*}}>(%a, %a)
  var x = a+a
  # CHECK: kgen.call @"$SIMD"::@SIMD::@"__add__{{.*}}<size{{.*}} = 1{{.*}}, type:{{.*}} dtype = si32{{.*}}>(%b, %b)
  var y = b+b

