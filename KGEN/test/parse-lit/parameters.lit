# CHECK-LABEL: lit.struct.decl @Pair<dt: @"$prolog"::@DType> {
struct Pair[dt: DType]:
 # CHECK: lit.struct.field a : !kgen.declref<@"$parameters"::@OurSIMD<size = 42, dt: @"$prolog"::@DType = dt>>
 # CHECK: lit.struct.field b : !kgen.declref<@"$Int"::@Int>
  var a : OurSIMD[42, dt]
  var b : Int

  # CHECK: lit.func @"__new__{{.*}} -> !kgen.declref<@"$parameters"::@Pair<dt: @"$prolog"::@DType = dt>> attributes {isStatic}
  fn __new__(a: OurSIMD[42, dt]) -> Pair[dt]:
    # CHECK: %0 = kgen.param.constant: @"$Int"::@Int = <#lit.struct<{value: scalar<index> = 4}>>
    # CHECK: %1 = lit.struct.create(a=%a, b=%0) : (!kgen.declref<@"$parameters"::@OurSIMD<size = 42, dt: @"$prolog"::@DType = dt>>, !kgen.declref<@"$Int"::@Int>) -> !kgen.declref<@"$parameters"::@Pair<dt: @"$prolog"::@DType = dt>>
    return Pair[dt]{a: a, b: 4}
  # CHECK: }

# CHECK: }

# CHECK: useParameterizedField
fn useParameterizedField[x: Pair[DType.f32]]():
  # CHECK: kgen.param.declare y:
  alias y : OurSIMD[42, DType.f32] = x.a


# CHECK-LABEL: lit.func @"makePair
fn makePair(a: OurSIMD[42, DType.f32], b: Int) -> Pair[DType.f32]:
  # CHECK: %0 = lit.struct.create(a=%a, b=%b)
  return Pair[DType.f32]{a: a, b: b}

