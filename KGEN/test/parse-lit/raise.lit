# RUN: kgen-translate %s -import-lit | FileCheck %s

__include "../lit-examples/prolog.lit"

# CHECK-LABEL: lit.func @defAlwaysRaises() throws -> !pop.variant<@Error, @Int> attributes {isDef, raises}
def defAlwaysRaises() -> Int:
    # CHECK: %[[RESULT:.*]] = pop.variant.create %{{.*}} : !kgen.declref<@Int> -> !pop.variant<@Error, @Int>
    # CHECK-NEXT: kgen.return %[[RESULT]]
    return Int(0)

# CHECK-LABEL: lit.func @fnThatRaises() throws -> !pop.variant<@Error, @Int> attributes {raises}
@raises
fn fnThatRaises() -> Int:
    # CHECK: %[[RESULT:.*]] = pop.variant.create %{{.*}} : !kgen.declref<@Int> -> !pop.variant<@Error, @Int>
    # CHECK-NEXT: kgen.return %[[RESULT]]
    return Int(0)

# CHECK-LABEL: lit.func @raisesReturnsNone() throws -> !pop.variant<@Error, !lit.none>
@raises
fn raisesReturnsNone():
    # CHECK: %0 = kgen.param.constant: !lit.none = <#lit.none>
    # CHECK-NEXT: %1 = pop.variant.create %0
    # CHECK-NEXT: kgen.return %1
    pass
