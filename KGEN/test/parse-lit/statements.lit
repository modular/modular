# RUN: kgen-translate %s -import-lit -I %stdlibdir -I %S/../lit-examples/ | FileCheck %s

from prolog import Error, Int


##===----------------------------------------------------------------------===##
# pass

# CHECK-LABEL: lit.func @"pass()
def `pass`():
  pass
  # CHECK-NEXT : kgen.return

##===----------------------------------------------------------------------===##
# return

# CHECK-LABEL lit.func @"return_impl_convert
fn return_impl_convert() -> Int:
  # CHECK: %idx4 = index.constant 4
  # CHECK: %0 = kgen.call @"$Int"::@Int::@"__new__(__mlir_type.index)"(%idx4)
  # CHECK: kgen.return %0
  return 4  # Implicit conversion from literal to Int

# CHECK-LABEL lit.func @"return_new_line
fn return_new_line() -> Int:
  # CHECK: %idx17 = index.constant 17
  return
     17  # Weird indentation should be fine

# CHECK-LABEL lit.func @"return_impl_convert_raises
@raises
fn return_impl_convert_raises() -> Int:
  # CHECK: %idx4 = index.constant 4
  # CHECK: %0 = kgen.call @"$Int"::@Int::@"__new__(__mlir_type.index)"(%idx4) : (index) -> !kgen.declref<@"$Int"::@Int>
  # CHECK: %1 = pop.variant.create %0 : !kgen.declref<@"$Int"::@Int> -> !pop.variant<@"$prolog"::@Error, @"$Int"::@Int>
  # CHECK: kgen.return %1 : !pop.variant<@"$prolog"::@Error, @"$Int"::@Int>
  return 4  # Implicit conversion from literal to Int


##===----------------------------------------------------------------------===##

