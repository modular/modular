# RUN: kgen-translate %s -import-lit -I %stdlibdir -I %S/../lit-examples/ | FileCheck %s

from prolog import Error, Int, Bool


##===----------------------------------------------------------------------===##
# pass
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"pass()
def `pass`():
  pass
  # CHECK-NEXT: lit.end_func

##===----------------------------------------------------------------------===##
# return
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"return_impl_convert
fn return_impl_convert() -> Int:
  # CHECK: kgen.param.constant: !pop.scalar<index> = <#pop.simd<4>>
  # CHECK: %1 = kgen.struct.create(%0)
  # CHECK: lit.return %1
  return 4  # Implicit conversion from literal to Int

# CHECK-LABEL: lit.func @"return_new_line
fn return_new_line() -> Int:
  # CHECK: %0 = kgen.param.constant: !pop.scalar<index> = <#pop.simd<17>>
  return
     17  # Weird indentation should be fine

# CHECK-LABEL: lit.func @"return_impl_convert_raises
@raises
fn return_impl_convert_raises() -> Int:
  # CHECK: %0 = kgen.param.constant: !pop.scalar<index> = <#pop.simd<4>>
  # CHECK: %1 = kgen.struct.create(%0)
  # CHECK: %2 = pop.variant.create %1
  # CHECK: lit.return %2 : !pop.variant<@"$prolog"::@Error, @"$Int"::@Int>
  return 4  # Implicit conversion from literal to Int


##===----------------------------------------------------------------------===##
# If
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"test_if
fn test_if(a: Bool, b: Bool, c: Bool) -> Bool:
  # CHECK:          hlcf.if
  if a:
    # CHECK-NEXT: %inside_a = lit.var.decl "inside_a"
    var inside_a: Int
  # CHECK:          } else {
  # CHECK:            hlcf.if
  elif b:
    # CHECK-NEXT: %inside_b = lit.var.decl "inside_b"
    var inside_b : Int
  # CHECK:            } else {
  # CHECK:              hlcf.if
  elif c:
    # CHECK-NEXT: %inside_c = lit.var.decl "inside_c"
    var inside_c: Int
  # CHECK:              } else {
  else:
    # CHECK-NEXT: %inside_else = lit.var.decl "inside_else"
    var inside_else: Int
  # CHECK:                hlcf.yield
  # CHECK-NEXT:         }
  # CHECK-NEXT:         hlcf.yield
  # CHECK-NEXT:       }
  # CHECK-NEXT:       hlcf.yield
  # CHECK-NEXT:     }
  var z: Int = Int(4)
  return a


# CHECK-LABEL: lit.func @"test_if_nested
fn test_if_nested(a: Bool, b: Bool, c: Bool) -> Bool:
  # CHECK-NEXT:   %[[LIT_BOOL:.*]] = kgen.struct.extract %a[value]
  # CHECK-NEXT:   %[[I1:.*]] = pop.cast_to_builtin %[[LIT_BOOL]] : !pop.scalar<bool> to i1
  # CHECK-NEXT:              hlcf.if %[[I1]]
  if a:
    # CHECK-NEXT: %inside_a = lit.var.decl "inside_a"
    var inside_a: Int
  # CHECK:                   } else {
  # CHECK:                     hlcf.if
  else:
    if b:
      # CHECK-NEXT: %inside_b = lit.var.decl "inside_b"
      var inside_b : Int
  # CHECK:                     } else {
  # CHECK:                       hlcf.if
    else:
      if c:
        # CHECK-NEXT: %inside_c = lit.var.decl "inside_c"
        var inside_c: Int
  # CHECK:                       } else {
      else:
        # CHECK-NEXT: %inside_else = lit.var.decl "inside_else"
        var inside_else: Int
  # CHECK:                         hlcf.yield
  # CHECK:                       }
  # CHECK:                       hlcf.yield
  # CHECK-NEXT:               }
  # CHECK:                    hlcf.yield
  # CHECK-NEXT:             }
  var z: Int = Int(4)
  return a

##===----------------------------------------------------------------------===##
# While
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"test_while
# CHECK:       %inside_a = lit.var.decl "inside_a"
# CHECK:       %inside_b = lit.var.decl "inside_b"
# CHECK:       %inside_else = lit.var.decl "inside_else"
# CHECK:       hlcf.loop {
# CHECK:         hlcf.if
# CHECK-NEXT:     hlcf.yield
# CHECK-NEXT:    } else {
# CHECK-NEXT:     kgen.param.constant: !pop.scalar<index> = <#pop.simd<2>>
# CHECK-NEXT:     kgen.struct.create
# CHECK-NEXT:     pop.store {{.+}}, %inside_else
# CHECK-NEXT:     hlcf.break
# CHECK-NEXT:    }
# CHECK-NEXT:    <#pop.simd<0>>
# CHECK-NEXT:    kgen.struct.create
# CHECK-NEXT:    pop.store {{.+}}, %inside_a
# CHECK:         hlcf.if
# CHECK-NEXT:      <#pop.simd<1>>
# CHECK-NEXT:      kgen.struct.create
# CHECK-NEXT:      pop.store {{.+}}, %inside_b
# CHECK-NEXT:      hlcf.yield
# CHECK-NEXT:    } else {
# CHECK-NEXT:      hlcf.yield
# CHECK-NEXT:    }
# CHECK-NEXT:    hlcf.continue
# CHECK-NEXT:  }
# CHECK-NEXT:  lit.return
# CHECK-NEXT:  lit.end_func
# CHECK-NEXT:  }
fn test_while(a: Bool, b: Bool) -> Bool:
    var inside_a: Int
    var inside_b: Int
    var inside_else: Int
    while a:
        inside_a = Int(0)
        if b:
            inside_b = Int(1)
    else:
        inside_else = Int(2)
    return a


# CHECK-LABEL: lit.func @"test_simple
# CHECK:       hlcf.loop {
# CHECK:       hlcf.if
# CHECK-NEXT:       hlcf.yield
# CHECK-NEXT:     } else {
# CHECK-NEXT:       hlcf.break
# CHECK-NEXT:     }
# CHECK-NEXT:     hlcf.continue
# CHECK-NEXT:   }
# CHECK-NEXT:   lit.end_func
# CHECK-NEXT: }
fn test_simple(a: Bool):
    while a:
        pass


# CHECK-LABEL: lit.func @"test_else_outside_while
def test_else_outside_while(a: Bool, b: Bool) -> Bool:
    # CHECK: hlcf.if {{.+}} {
    if b:
        # CHECK: hlcf.loop
        # CHECK: {{.+}} = pop.load %a
        while a:
            # CHECK: pop.store {{.+}}, %inside_a
            inside_a = Int(0)
            # CHECK: hlcf.continue
    # CHECK: } else {
    else:
        # CHECK: pop.store {{.+}}, %inside_else
        inside_else = Int(2)
    # CHECK: }
    # CHECK: lit.return
    return a

# CHECK-LABEL: lit.func @"test_break_continue_inside_while
def test_break_continue_inside_while(a: Bool) -> Bool:
    # CHECK: hlcf.loop
    # CHECK: hlcf.if
    while a:
        # CHECK:      hlcf.if
        if a:
            # CHECK-NEXT:   lit.break
            break
            # CHECK:   pop.store
            # CHECK-NEXT:   hlcf.yield
            c = 1
        else:
            # CHECK-NEXT: } else {
            # CHECK-NEXT:   lit.continue
            continue
            # CHECK-NEXT:   hlcf.yield
        # CHECK: hlcf.continue
    return a

# CHECK-LABEL: lit.func @"test_early_return
def test_early_return():
    # CHECK: hlcf.if
    var a: Bool
    if a:
        # CHECK: lit.return
        return
        # CHECK: pop.store
        b = 2
        # CHECK-NEXT: hlcf.yield
    # CHECK: else
    # CHECK-NEXT: yield
    # CHECK: lit.return
    return
    # CHECK: pop.store
    c = 3
    # CHECK: lit.return
    return
    # CHECK-NEXT: lit.end_func

##===----------------------------------------------------------------------===##
# Raise and Try
##===----------------------------------------------------------------------===##

# CHECK-LABEL: lit.func @"simpleTryExcept
fn simpleTryExcept():
    var a: Int
    # CHECK: lit.try
    try:
        # CHECK: pop.store
        a = Int(0)
        # CHECK-NEXT: lit.try.yield
    # CHECK-NEXT: except (%{{.*}}: !kgen.declref<@"$prolog"::@Error>)
    except:
        # CHECK-NEXT: lit.try.yield
        pass
    # CHECK-NEXT: else
    # CHECK-NEXT: lit.try.yield
    # CHECK: lit.end_func

# CHECK-LABEL: lit.func @"tryExceptElse
fn tryExceptElse():
    var a: Int
    # CHECK: lit.try
    try:
        pass
    except:
        pass
    # CHECK: else
    else:
        # CHECK: pop.store
        a = Int(0)
        # CHECK-NEXT: lit.try.yield

fn eatError(err: Error):
    pass

# CHECK-LABEL: lit.func @"tryExceptArg
fn tryExceptArg():
    try:
        pass
    # CHECK: except (%arg0: !kgen.declref<@"$prolog"::@Error>)
    except err:
        # CHECK-NEXT: kgen.call @"{{.*}}::@"eatError{{.*}}(%arg0)
        eatError(err)

# CHECK-LABEL: lit.func @"tryExceptArgDef
def tryExceptArgDef():
    try:
        pass
    # CHECK: except (%arg0: !kgen.declref<@"$prolog"::@Error>)
    except err:
        # CHECK-NEXT: lit.var.decl "err" : <@"$prolog"::@Error>
        # CHECK: %[[ERRVAL:.*]] = pop.load
        # CHECK: eatError{{.*}}(%[[ERRVAL]])
        eatError(err)

def maybeRaises() -> Int:
    return Int(0)

# CHECK-LABEL: lit.func @"propagateErrorInDef
def propagateErrorInDef():
    # CHECK: %[[MAYBE_ERR:.*]] = kgen.call @"{{.*}}"::@"maybeRaises
    # CHECK-NEXT: %[[VALUE:.*]] = lit.unwrap_or_propagate %[[MAYBE_ERR]]
    # CHECK-NEXT: pop.store %[[VALUE]], %a
    a = maybeRaises()

# CHECK-LABEL: lit.func @"propagateErrorInRaisingFn
@raises
fn propagateErrorInRaisingFn():
    var a: Int
    # CHECK: %[[MAYBE_ERR:.*]] = kgen.call @"{{.*}}"::@"maybeRaises
    # CHECK-NEXT: %[[VALUE:.*]] = lit.unwrap_or_propagate %[[MAYBE_ERR]]
    # CHECK-NEXT: pop.store %[[VALUE]], %a
    a = maybeRaises()

# CHECK-LABEL: lit.func @"propagateErrorInTry
fn propagateErrorInTry():
    var a: Int
    # CHECK: lit.try
    try:
        # CHECK: %[[MAYBE_ERR:.*]] = kgen.call @"{{.*}}"::@"maybeRaises
        # CHECK-NEXT: %[[VALUE:.*]] = lit.unwrap_or_propagate %[[MAYBE_ERR]]
        # CHECK-NEXT: pop.store %[[VALUE]], %a
        a = maybeRaises()
        # CHECK-NEXT: lit.try.yield
    except:
        pass

# CHECK-LABEL: lit.func @"raiseError
def raiseErrorInDef(err: Error):
    # CHECK: lit.raise %0
    raise err

# CHECK-LABEL: lit.func @"raiseErrorInIf
def raiseErrorInIf(cond: Bool, err: Error):
    # CHECK: hlcf.if
    if cond:
        # CHECK: lit.raise
        raise err

# CHECK-LABEL: lit.func @"raiseErrorInTry
fn raiseErrorInTry(err: Error):
    # CHECK: lit.try
    try:
        # CHECK-NEXT: lit.raise %err
        raise err
    except:
        pass


