# RUN: kgen-translate -import-lit %s | FileCheck %s

# CHECK-LABEL: lit.func @test_while(%a: index, %b: index) -> index {
# CHECK:       %inside_a = lit.var.decl "inside_a" : <index>
# CHECK:       %inside_b = lit.var.decl "inside_b" : <index>
# CHECK:       %inside_else = lit.var.decl "inside_else" : <index>
# CHECK:       hlcf.loop {
# CHECK-NEXT:    %[[LOAD_A:.*]] = pop.load  %[[VAR_A:.*]] : !pop.pointer<index>
# CHECK-NEXT:    %[[ONE:.*]] = index.constant 1
# CHECK-NEXT:    %[[CMP:.*]] = index.cmp eq(%[[LOAD_A]], %[[ONE]])
# CHECK-NEXT:    hlcf.if %[[CMP]] {
# CHECK-NEXT:     hlcf.yield
# CHECK-NEXT:    } else {
# CHECK-NEXT:     index.constant 2
# CHECK-NEXT:     pop.store {{.+}}, %inside_else : !pop.pointer<index>
# CHECK-NEXT:     hlcf.break
# CHECK-NEXT:    }
# CHECK-NEXT:    index.constant 0
# CHECK-NEXT:    pop.store {{.+}}, %inside_a : !pop.pointer<index>
# CHECK-NEXT:    %[[LOAD_B:.*]] = pop.load %[[VAR_B:.*]] : !pop.pointer<index>
# CHECK-NEXT:    %[[ONE:.*]] = index.constant 1
# CHECK-NEXT:    %[[CMP:.*]] = index.cmp eq(%[[LOAD_B]], %[[ONE]])
# CHECK-NEXT:    hlcf.if %[[CMP]] {
# CHECK-NEXT:      {{.+}} = index.constant 1
# CHECK-NEXT:      pop.store {{.+}}, %inside_b : !pop.pointer<index>
# CHECK-NEXT:      hlcf.yield
# CHECK-NEXT:    } else {
# CHECK-NEXT:      hlcf.yield
# CHECK-NEXT:    }
# CHECK-NEXT:    hlcf.continue
# CHECK-NEXT:  }
# CHECK-NEXT:  pop.load
# CHECK-NEXT:  kgen.return
# CHECK-NEXT:  }
def test_while(a: index, b: index) -> index:
    while a:
        inside_a = 0
        if b:
            inside_b = 1
    else:
        inside_else = 2
    return a


# CHECK-LABEL: lit.func @test_simple(%a: index)
# CHECK:       hlcf.loop {
# CHECK-NEXT:     %[[LOAD_A:.*]] = pop.load %[[VAR_A:.*]] : !pop.pointer<index>
# CHECK-NEXT:     %[[ONE:.*]] = index.constant 1
# CHECK-NEXT:     %[[CMP:.*]] = index.cmp eq(%[[LOAD_A]], %[[ONE]])
# CHECK-NEXT:     hlcf.if %[[CMP]] {
# CHECK-NEXT:       hlcf.yield
# CHECK-NEXT:     } else {
# CHECK-NEXT:       hlcf.break
# CHECK-NEXT:     }
# CHECK-NEXT:     hlcf.continue
# CHECK-NEXT:   }
# CHECK-NEXT:   [[NONE:%.*]] = kgen.param.constant: !lit.none = <#lit.none>
# CHECK-NEXT:   kgen.return [[NONE]]
# CHECK-NEXT: }
def test_simple(a: index):
    while a:
        pass


# CHECK-LABEL: lit.func @test_else_outside_while
def test_else_outside_while(a: index, b: index) -> index:
    # CHECK: hlcf.if {{.+}} {
    if b:
        # CHECK: hlcf.loop
        # CHECK: {{.+}} = pop.load %a
        while a:
            # CHECK: pop.store {{.+}}, %inside_a
            inside_a = 0
            # CHECK: hlcf.continue
    # CHECK: } else {
    else:
        # CHECK: pop.store {{.+}}, %inside_else
        inside_else = 2
    # CHECK: }
    # CHECK: kgen.return
    return a
