# RUN: kgen-translate -import-lit %s -I %stdlibdir -I %S/../lit-examples/ | FileCheck %s

from prolog import Bool, Error, Int

# CHECK-LABEL: lit.func @"test_while
# CHECK:       %inside_a = lit.var.decl "inside_a"
# CHECK:       %inside_b = lit.var.decl "inside_b"
# CHECK:       %inside_else = lit.var.decl "inside_else"
# CHECK:       hlcf.loop {
# CHECK:         hlcf.if
# CHECK-NEXT:     hlcf.yield
# CHECK-NEXT:    } else {
# CHECK-NEXT:     index.constant 2
# CHECK-NEXT:     kgen.call @"$Int"::@Int::@"__new__
# CHECK-NEXT:     pop.store {{.+}}, %inside_else
# CHECK-NEXT:     hlcf.break
# CHECK-NEXT:    }
# CHECK-NEXT:    index.constant 0
# CHECK-NEXT:    kgen.call @"$Int"::@Int::@"__new__
# CHECK-NEXT:    pop.store {{.+}}, %inside_a
# CHECK:         hlcf.if
# CHECK-NEXT:      {{.+}} = index.constant 1
# CHECK-NEXT:      kgen.call @"$Int"::@Int::@"__new__
# CHECK-NEXT:      pop.store {{.+}}, %inside_b
# CHECK-NEXT:      hlcf.yield
# CHECK-NEXT:    } else {
# CHECK-NEXT:      hlcf.yield
# CHECK-NEXT:    }
# CHECK-NEXT:    hlcf.continue
# CHECK-NEXT:  }
# CHECK-NEXT:  kgen.return
# CHECK-NEXT:  }
fn test_while(a: Bool, b: Bool) -> Bool:
    var inside_a: Int
    var inside_b: Int
    var inside_else: Int
    while a:
        inside_a = Int(0)
        if b:
            inside_b = Int(1)
    else:
        inside_else = Int(2)
    return a


# CHECK-LABEL: lit.func @"test_simple
# CHECK:       hlcf.loop {
# CHECK:       hlcf.if
# CHECK-NEXT:       hlcf.yield
# CHECK-NEXT:     } else {
# CHECK-NEXT:       hlcf.break
# CHECK-NEXT:     }
# CHECK-NEXT:     hlcf.continue
# CHECK-NEXT:   }
# CHECK-NEXT:   [[NONE:%.*]] = kgen.param.constant: !lit.none = <#lit.none>
# CHECK-NEXT:   kgen.return [[NONE]]
# CHECK-NEXT: }
fn test_simple(a: Bool):
    while a:
        pass


# CHECK-LABEL: lit.func @"test_else_outside_while
def test_else_outside_while(a: Bool, b: Bool) -> Bool:
    # CHECK: hlcf.if {{.+}} {
    if b:
        # CHECK: hlcf.loop
        # CHECK: {{.+}} = pop.load %a
        while a:
            # CHECK: pop.store {{.+}}, %inside_a
            inside_a = Int(0)
            # CHECK: hlcf.continue
    # CHECK: } else {
    else:
        # CHECK: pop.store {{.+}}, %inside_else
        inside_else = Int(2)
    # CHECK: }
    # CHECK: kgen.return
    return a

# CHECK-LABEL: lit.func @"test_break_continue_inside_while
def test_break_continue_inside_while(a: Bool) -> Bool:
    # CHECK: hlcf.loop
    # CHECK: hlcf.if
    while a:
        # CHECK:      hlcf.if
        if a:
            # CHECK-NEXT:   hlcf.break
            break
            # CHECK-NOT: ^bb1:
            # CHECK-NOT:   index.constant 1
            # CHECK-NOT:   pop.store
            # CHECK-NOT:   hlcf.yield
            c = 1
        else:
            # CHECK-NEXT: } else {
            # CHECK-NEXT:   hlcf.continue
            continue
            # CHECK-NOT: ^bb1:
            # CHECK-NOT:   hlcf.yield
        # CHECK: hlcf.continue
    return a

# CHECK-LABEL: lit.func @"test_early_return
def test_early_return():
    # CHECK: hlcf.if
    var a: Bool
    if a:
        # CHECK: hlcf.return
        return
        # CHECK-NOT: hlcf.yield
        b = 2
    # CHECK: else
    # CHECK-NEXT: yield
    # CHECK: kgen.return
    return
    # CHECK-NEXT: }
    c = 3
    return
