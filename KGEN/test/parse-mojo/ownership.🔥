fn chris_lifetime_example(a: Bool, b: Bool):
    let x : MemExample
    # CHECK: lit.try
    try:
        # CHECK-NEXT: lit.try
        try:
            # CHECK: hlcf.if
            if a:
                # CHECK: __init__{{.*}}(%x)
                x = MemExample()
                # CHECK: lit.try.raise
                raise Error()
        # CHECK: except
            # CHECK: hlcf.if
                # CHECK-NEXT: __del__{{.*}}(%x)
                # CHECK: return
            # CHECK: else
            # CHECK: lit.try.raise
        # CHECK: else
            # CHECK: hlcf.if
                # CHECK: return
            # CHECK: else
        finally:
            if b:
                return
    # CHECK: except
    except:
        # CHECK: %[[DEAD:.*]] = lit.ownership.end.lifetime %x
        # CHECK: __del__{{.*}}(%[[DEAD]])
        _ = x^
    # CHECK: else
        # CHECK-NEXT: lit.try.yield

