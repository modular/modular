load("//bazel:api.bzl", "modular_cc_binary")

package(default_visibility = ["//KGEN:consumers"])

modular_cc_binary(
    name = "compilation-server",
    srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    deps = [
        "//Init",
        "//KGEN:MojoTooling",
        "//KGEN:ObjectCompiler",
        "//KGEN:Pipeline",
        "//KGEN:Support",
        "//KGEN:ToolCommon",
        "//KGEN/tools/common/lsp-protocol",
        "//MLRT:AsyncRT/Runtime",
        "//MLRT:AsyncRT/RuntimeGlobals",
        "//Support:Base",
        "//Support:Context",
        "//Support:Globals",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:MlirLspServerLib",
    ],
)
