load("//bazel:api.bzl", "modular_cc_binary")

package(default_visibility = ["//KGEN:consumers"])

modular_cc_binary(
    name = "kgen-opt",
    srcs = glob(["*.cpp"]),
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,--export-dynamic-symbol=__jit_debug_*",
            "-Wl,--export-dynamic-symbol=mlir*",
        ],
        "//conditions:default": [],
    }),
    visibility = [
        "//KGEN:consumers",
        "//KGEN:plugin_consumers",
    ],
    deps = [
        "//AsyncRT:Runtime",
        "//AsyncRT:RuntimeGlobals",
        "//Init",
        "//KGEN:Compiler",
        "//KGEN:CompilerRT",
        "//KGEN:ExecutionEngine",
        "//KGEN:KGENDialect",
        "//KGEN:LITDialect",
        "//KGEN:ObjectCompiler",
        "//KGEN:Pipeline",
        "//KGEN:Support",
        "//KGEN:SupportForceLinkMLIRC",
        "//KGEN:ToolCommon",
        "//Support:Base",
        "//Support:Compiler",
        "//Support:Context",
        "//Support:Globals",
        "//Support:MDialect",
        "@llvm-project//mlir:MlirOptLib",
    ],
)
