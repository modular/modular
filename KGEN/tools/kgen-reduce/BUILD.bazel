        "*.h",
    ]),
    deps = [
        "//Init",
        "//KGEN:Compiler",
        "//KGEN:CompilerRT",
        "//KGEN:ExecutionEngine",
        "//KGEN:HLCFDialect",
        "//KGEN:KGENDialect",
        "//KGEN:MojoParser",
        "//KGEN:ObjectCompiler",
        "//KGEN:Pipeline",
        "//KGEN:ToolCommon",
        "//KGEN:TransformUtils",
        "//MLRT:AsyncRT/RuntimeGlobals",
        "//Support:Base",
        "//Support:Context",
        "//Support:Globals",
        "@llvm-project//mlir:MlirOptLib",
    ],
