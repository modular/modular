load("//bazel:api.bzl", "modular_cc_binary")

package(default_visibility = ["//KGEN:consumers"])

modular_cc_binary(
    name = "kgen",
    srcs = glob(["*.cpp"]),
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,--export-dynamic-symbol=__jit_debug_*",
            "-Wl,--export-dynamic-symbol=mlir*",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "//Config",
        "//Init",
        "//KGEN:Compiler",
        "//KGEN:ExecutionEngine",
        "//KGEN:KGENDialect",
        "//KGEN:MojoParser",
        "//KGEN:ObjectCompiler",
        "//KGEN:Pipeline",
        "//KGEN:Support",
        "//KGEN:SupportForceLinkMLIRC",
        "//KGEN:ToolCommon",
        "//MLRT:AsyncRT/Runtime",
        "//MLRT:AsyncRT/RuntimeGlobals",
        "//Support:Base",
        "//Support:Compiler",
        "//Support:Globals",
        "//Support:MArchTarget",
        "@llvm-project//mlir:BytecodeWriter",
    ],
)
