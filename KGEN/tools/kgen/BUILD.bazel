        "//Config",
        "//Init",
        "//KGEN:Compiler",
        "//KGEN:ExecutionEngine",
        "//KGEN:KGENDialect",
        "//KGEN:MojoParser",
        "//KGEN:ObjectCompiler",
        "//KGEN:Pipeline",
        "//KGEN:Support",
        "//KGEN:ToolCommon",
        "//Support:Base",
        "//Support:Compiler",
        "//Support:Globals",
        "//Support:MArchTarget",
        "@llvm-project//mlir:BytecodeWriter",
    ],
