load("//bazel:api.bzl", "modular_cc_binary")
load("//utils/bazel/build/rules:opt_wrapper.bzl", "opt_wrapper")

package(default_visibility = ["//visibility:public"])

modular_cc_binary(
    name = "kgen",
    srcs = glob(["*.cpp"]),
    deps = [
        "//Config",
        "//KGEN:Compiler",
        "//KGEN:CompilerRT",
        "//KGEN:ExecutionEngine",
        "//KGEN:KGENDialect",
        "//KGEN:MojoParser",
        "//KGEN:ObjectCompiler",
        "//KGEN:Pipeline",
        "//KGEN:Support",
        "//KGEN:ToolCommon",
        "//LLCL:Runtime",
        "//LLCL:RuntimeGlobals",
        "//Support:Base",
        "//Support:Compiler",
        "//Support:Globals",
        "//Support:Init",
        "//Support:MArchTarget",
        "@llvm-project//mlir:BytecodeWriter",
    ],
)

opt_wrapper(
    name = "kgen.opt",
    dep = ":kgen",
)
