load("//bazel:api.bzl", "modular_py_library", "modular_shared_library")

modular_shared_library(
    name = "IPythonExtension",
    srcs = glob(["IPythonExtension/lib/*.cpp"]),
    # hdrs = glob(["include/IPythonExtension/*.h"]),
    linkopts = select({
        # Allow undefined symbols when linking because
        # libpython symbols will be available
        # when the libIPythonExtension is loaded at runtime
        "@platforms//os:linux": ["-Wl,-z,undefs"],
        "@platforms//os:macos": ["-Wl,-undefined,dynamic_lookup"],
        "//conditions:default": [],
    }),
    deps = [
        "//Config",
        "//Init",
        "//KGEN:Compiler",
        "//KGEN:CompilerRT",
        "//KGEN:ExecutionEngine",
        "//KGEN:KGENDialect",
        "//KGEN:LITDialect",
        "//KGEN:MojoParser",
        "//KGEN:MojoTesting",
        "//KGEN:MojoTooling",
        "//KGEN:ObjectCompiler",
        "//KGEN:POPDialect",
        "//KGEN:Pipeline",
        "//KGEN:Support",
        "//KGEN:SupportForceLinkMLIRC",
        "//KGEN:ToolCommon",
        "//KGEN/tools/common",
        "//Support:Base",
        "//Support:CPython",
        "//Support:Compiler",
        "//Support:CrashReporting",
        "//Support:Driver",
        "//Support:Filesystem",
        "//Support:Globals",
        "//Support:MArchTarget",
        "//Support:MDialect",
        "//Support:Telemetry",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:IndexDialect",
    ],
)

modular_py_library(
    name = "mojomagic",
    srcs = glob(["mojomagic/**/*.py"]),
    deps = [
        "//KGEN/tools/mojo-ipython-extension:IPythonExtension",
    ],
)
