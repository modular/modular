load("//bazel:api.bzl", "modular_cc_binary")
load("//utils/bazel/build/rules:opt_wrapper.bzl", "opt_wrapper")

package(default_visibility = ["//visibility:public"])

modular_cc_binary(
    name = "mojo-lsp-server",
    srcs = glob([
        "*.cpp",
        "*.h",
    ]),
    deps = [
        "//KGEN:LITDialect",
        "//KGEN:MojoParser",
        "//KGEN:MojoTooling",
        "//KGEN:ObjectCompiler",
        "//KGEN:Pipeline",
        "//KGEN:Support",
        "//KGEN:ToolCommon",
        "//KGEN/tools/common/lsp-protocol",
        "//LLCL:Runtime",
        "//LLCL:RuntimeGlobals",
        "//Support:Base",
        "//Support:Globals",
        "//Support:Init",
        "//Support:Telemetry",
        "@llvm-project//llvm:Support",
        "@llvm-project//mlir:MlirLspServerLib",
    ],
)

opt_wrapper(
    name = "mojo-lsp-server.opt",
    dep = ":mojo-lsp-server",
)
