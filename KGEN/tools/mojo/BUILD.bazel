load("//bazel:api.bzl", "driver_option_tablegen", "modular_cc_binary", "pkg_files", "td_library")

[
    driver_option_tablegen(
        name = command,
        srcs = glob(["{}/*.td".format(command)]),
        manual_name = "mojo-{}".format(command.lower()),
        markdown_name = command.lower(),
        td_file = "{command}/{command}Options.td".format(command = command),
        deps = [
            ":MojoDescriptionTdFiles",
        ],
    )
    for command in [
        "Build",
        "Debug",
        "Demangle",
        "Doc",
        "Format",
        "Package",
        "REPL",
        "Run",
    ]
]

td_library(
    name = "MojoDescriptionTdFiles",
    srcs = glob([
        "*.td",
        "Common/*.td",
    ]),
    includes = ["."],
    deps = [
        "//Support:DriverCommandTdFiles",
        "//Support:OptTableTdFiles",
    ],
)

driver_option_tablegen(
    name = "Index",
    srcs = ["DriverOptions.td"],
    includes = ["."],
    manual_name = "mojo",
    markdown_name = "index",
    td_file = "DriverOptions.td",
    deps = [
        ":Build.td_library",
        ":Debug.td_library",
        ":Demangle.td_library",
        ":Doc.td_library",
        ":Format.td_library",
        ":MojoDescriptionTdFiles",
        ":Package.td_library",
        ":REPL.td_library",
        ":Run.td_library",
    ],
)

pkg_files(
    name = "docs",
    srcs = [
        ":Build.man_files",
        ":Debug.man_files",
        ":Demangle.man_files",
        ":Doc.man_files",
        ":Format.man_files",
        ":Index.man_files",
        ":Package.man_files",
        ":REPL.man_files",
        ":Run.man_files",
    ],
    visibility = ["//visibility:public"],
)

[
    modular_cc_binary(
        name = name,
        srcs = glob([
            "**/*.h",
            "**/*.cpp",
        ]),
        data = data,
        includes = ["."],
        linkopts = select({
            "@platforms//os:linux": [
                "-Wl,--export-dynamic-symbol=__jit_debug_*",
                "-Wl,--export-dynamic-symbol=mlir*",
            ],
            "//conditions:default": [],
        }),
        deps = [
            ":Build.inc_files",
            ":Debug.inc_files",
            ":Demangle.inc_files",
            ":Doc.inc_files",
            ":Format.inc_files",
            ":Index.inc_files",
            ":Package.inc_files",
            ":REPL.inc_files",
            ":Run.inc_files",
            "//AsyncRT:Runtime",
            "//AsyncRT:RuntimeGlobals",
            "//Config",
            "//Init",
            "//KGEN:Compiler",
            "//KGEN:ExecutionEngine",
            "//KGEN:KGENDialect",
            "//KGEN:LITDialect",
            "//KGEN:MojoParser",
            "//KGEN:MojoTooling",
            "//KGEN:ObjectCompiler",
            "//KGEN:POPDialect",
            "//KGEN:Support",
            "//KGEN:SupportForceLinkMLIRC",
            "//KGEN:ToolCommon",
            "//Support:Base",
            "//Support:Compiler",
            "//Support:CrashReporting",
            "//Support:Driver",
            "//Support:Filesystem",
            "//Support:Globals",
            "//Support:MArchTarget",
            "//Support:MDialect",
            "@llvm-project//mlir:IndexDialect",
        ],
    )
    for name, data in [
        (
            "mojo",
            [
                "//KGEN:MojoLLDB",
                "//KGEN:gdb-server",
                "//KGEN:mojo-lldb",
                "//KGEN/tools/mojo-repl-entry-point",
                "@llvm-project//lldb:lldb-argdumper",
                "@llvm-project//llvm:llvm-symbolizer",
            ],
        ),
        ("mojo-compiler-only", []),
    ]
]
