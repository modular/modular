load("//bazel:api.bzl", "modular_cc_library", "modular_cc_test")

package(default_visibility = ["//visibility:private"])

modular_cc_library(
    name = "Support",
    testonly = True,
    srcs = ["Support.cpp"],
    hdrs = ["Support.h"],
    deps = [
        "//KGEN/tools/mojo-lsp-test-client",
        "@llvm-project//lldb:liblldb.wrapper",
        "@llvm-project//lldb:lldb24.0.0git",
        "@llvm-project//third-party/unittest:gtest",
    ],
)

# Disabled due to nondeterminism. Tracking: QUA-852
# Re-enable tracking: https://linear.app/modularml/issue/MOTO-1646
modular_cc_test(
    name = "unittests",
    srcs = glob(
        ["*.cpp"],
        exclude = ["Support.cpp"],
    ),
    data = glob([
        "inputs/*.mojo",
    ]) + [
        "//KGEN:MojoLLDB",
        "//KGEN:gdb-server",
        "//KGEN/tools/mojo",
        "//KGEN/unittests:lit-lldb-init.in",
    ],
    env = {
        # HACK: This test invokes "mojo build" in a subprocess, but it can't see modular.cfg, so we need to
        # provide the run path here to find CompilerRT.
        "MODULAR_MOJO_MAX_SHARED_LIBS": "-Xlinker,-rpath,-Xlinker,KGEN",
        "MODULAR_PATH": ".",
    },
    mojo_deps = [
        "@mojo//:std",
    ],
    tags = [
        "resources:cpu:4",
    ],
    target_compatible_with = ["@platforms//:incompatible"],
    deps = [
        ":Support",
        "//Support:Globals",
    ],
)
