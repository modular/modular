load("//bazel:api.bzl", "modular_cc_library", "modular_cc_test")

modular_cc_library(
    name = "Support",
    testonly = True,
    srcs = ["Support.cpp"],
    hdrs = ["Support.h"],
    deps = [
        "//KGEN/tools/mojo-lsp-test-client",
        "//KGEN/unittests:include_shim",
        "@llvm-project//lldb:liblldb.wrapper",
        "@llvm-project//lldb:lldb20.0.0git",
        "@llvm-project//third-party/unittest:gtest",
    ],
)

modular_cc_test(
    name = "unittests",
    srcs = glob(
        ["*.cpp"],
        exclude = ["Support.cpp"],
    ),
    data = glob([
        "inputs/*.mojo",
    ]) + [
        "//KGEN:CompilerRT",
        "//KGEN:CompilerRT.distributable",
        "//KGEN:MojoLLDB",
        "//KGEN:gdb-server",
        "//KGEN/tools/mojo",
        "//open-source/mojo/stdlib/stdlib",
        "//utils:lit-lldb-init.in",
        "@llvm-project//compiler-rt:orc_rt",
    ],
    env = {
        "MODULAR_MOJO_MAX_IMPORT_PATH": "open-source/mojo/stdlib/stdlib",
        "MODULAR_PATH": ".",
    },
    tags = [
        "resources:cpu:4",
    ],
    # TODO: Disable only ODR checks when https://github.com/bazelbuild/bazel/pull/22420 is in
    # __jit_debug_descriptor exists in liblldb and libMojoLLDB
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":Support",
        "//Support:Globals",
    ],
)
