load("//bazel:api.bzl", "modular_cc_library", "modular_cc_test")

modular_cc_library(
    name = "Support",
    srcs = glob(["Support.*"]),
    deps = [
        "//KGEN/tools/mojo-lsp-test-client",
        "//KGEN/unittests:include_shim",
        "@googletest//:gtest",
    ],
)

modular_cc_test(
    name = "unittests",
    srcs = glob(
        ["*.cpp"],
        exclude = [
            "Support.cpp",
            # TODO: Fix these
            "CodeBlockTest.cpp",
            "CompletionTest.cpp",
            "HoverTest.cpp",
        ],
    ),
    data = glob(
        ["inputs/*.mojo"],
        exclude = ["inputs/__init__.mojo"],  # TODO: when this is included tests fail, but some of the excluded tests depend on it
    ) + [
        "//KGEN/tools/mojo-lsp-server:mojo-lsp-server.opt",
        "//Kernels/mojo/stdlib",
        "//Kernels/mojo/stdlib:stdlib_srcs",
        "@crashpad//:modular-crashpad-handler",
    ],
    env = {
        "MODULAR_MOJO_IMPORT_PATH": "Kernels/mojo/stdlib,Kernels/mojo",
        "MODULAR_MOJO_LSP_SERVER_PATH": "$(location //KGEN/tools/mojo-lsp-server:mojo-lsp-server.opt)",
        "MODULAR_PATH": ".",
        "MODULAR_CRASH_REPORTING_HANDLER_PATH": "$(location @crashpad//:modular-crashpad-handler)",
    },
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":Support",
        "//Support:Globals",
    ],
)
