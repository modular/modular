{
  "display_name": "Mojo",
  "argv": [
    "python3",
    "-m",
    "mojokernel",
    "-f",
    "{connection_file}"
  ],
  "language": "mojo",
  "language_info": {
    "name": "mojo",
    "mimetype": "text/x-mojo",
    "file_extension": ".mojo"
  },
  "env": {
    "PYTHONPATH": "${PYTHONPATH}:${MODULAR_PATH}/KGEN/utils/jupyter-mojo"
  }
}
