{
  "name": "vscode-lit",
  "displayName": "Lit",
  "description": "Lit Language Extension",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "keywords": [
    "LIT"
  ],
  "activationEvents": [
    "onLanguage:lit"
  ],
  "main": "./out/extension",
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -watch -p ./",
    "format": "clang-format -i --glob=\"{src,test}/*.ts\"",
    "package": "vsce package --out ./out/vscode-lit.vsix"
  },
  "devDependencies": {
    "@types/mocha": "^7.0.2",
    "@types/node": "^18.11.18",
    "@types/vscode": "~1.74.0",
    "@vscode/vsce": "^2.7.0",
    "typescript": "^4.6.4"
  },
  "dependencies": {
    "chokidar": "3.5.2",
    "vscode-languageclient": "^8.0.2-next.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/modularml/modular.git"
  },
  "contributes": {
    "languages": [
      {
        "id": "lit",
        "aliases": [
          "lit"
        ],
        "extensions": [
          ".lit"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "lit-injection"
      }
    ],
    "grammars": [
      {
        "language": "lit",
        "scopeName": "source.lit",
        "path": "./syntaxes/lit.syntax.json"
      },
      {
        "language": "lit-injection",
        "scopeName": "markdown.lit.codeblock",
        "path": "./syntaxes/markdown.syntax.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.lit": "lit"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Lit",
      "properties": {
        "lit.server_path": {
          "scope": "resource",
          "type": "string",
          "description": "The file path of the lit-lsp-server executable."
        },
        "lit.onSettingsChanged": {
          "type": "string",
          "default": "prompt",
          "description": "Action taken when a setting change requires a server restart to take effect.",
          "enum": [
            "prompt",
            "restart",
            "ignore"
          ],
          "enumDescriptions": [
            "Prompt the user for restarting the server",
            "Automatically restart the server",
            "Do nothing"
          ]
        }
      }
    },
    "commands": [
      {
        "command": "lit.restart",
        "title": "lit: Restart the extension"
      }
    ]
  }
}
