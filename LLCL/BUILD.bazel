package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

cc_library(
    name = "CompilerSupportHeaders",
    hdrs = glob([
        "include/LLCL/CompilerSupport/*.h",
    ]),
    strip_include_prefix = "include",
    deps = [
        ":RuntimeHeaders",
        "//Support:Threading",
    ],
)

cc_library(
    name = "RuntimeHeaders",
    hdrs = glob([
        "include/LLCL/Runtime/*.h",
        "include/LLCL/Runtime/Globals/*.h",
    ]) + [
        "include/LLCL/ForwardDecls.h",
    ],
    local_defines = select({
        "@platforms//os:linux": ["MODULAR_HAVE_SEM_TIMEDWAIT"],
        "//conditions:default": [],
    }),
    strip_include_prefix = "include",
    deps = [
        ":SupportHeaders",
        "//Support:ProfilingHeaders",
    ],
)

cc_library(
    name = "SupportHeaders",
    hdrs = glob(["include/LLCL/Support/*.h"]),
    strip_include_prefix = "include",
)

cc_library(
    name = "CompilerSupport",
    srcs = glob(["lib/CompilerSupport/*.cpp"]),
    hdrs = glob(["include/LLCL/CompilerSupport/*.h"]),
    strip_include_prefix = "include",
    deps = [
        ":Runtime",
    ],
)

cc_library(
    name = "Runtime",
    srcs = glob([
        "lib/Runtime/*.cpp",
        "lib/Runtime/Globals/*.cpp",
    ]),
    hdrs = glob([
        "include/LLCL/Runtime/*.h",
        "include/LLCL/Runtime/Globals/*.h",
    ]) + [
        "include/LLCL/ForwardDecls.h",
    ],
    local_defines = select({
        "@platforms//os:linux": ["MODULAR_HAVE_SEM_TIMEDWAIT"],
        "//conditions:default": [],
    }),
    strip_include_prefix = "include",
    deps = [
        ":Support",
        "//Support:ADT",
        "//Support:Profiling",
    ],
)

cc_library(
    name = "Support",
    srcs = glob(["lib/Support/*.cpp"]),
    hdrs = glob(["include/LLCL/Support/*.h"]),
    strip_include_prefix = "include",
    deps = [
        "//Support:MArchTarget",
        "//Support:Threading",
    ],
)
