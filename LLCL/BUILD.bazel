load("//bazel:api.bzl", "modular_cc_library")
load("//utils/bazel/build/rules:globals_library.bzl", "globals_library")

package(default_visibility = ["//visibility:public"])

modular_cc_library(
    name = "CompilerSupportHeaders",
    hdrs = glob([
        "include/LLCL/CompilerSupport/*.h",
    ]),
    deps = [
        ":RuntimeHeaders",
        "//Support:Threading",
    ],
)

modular_cc_library(
    name = "RuntimeHeaders",
    hdrs = glob([
        "include/LLCL/Runtime/*.h",
        "include/LLCL/Runtime/Globals/*.h",
    ]) + [
        "include/LLCL/ForwardDecls.h",
    ],
    visibility = ["//visibility:private"],
    deps = [
        ":SupportHeaders",
        "//Support:ProfilingHeaders",
    ],
)

modular_cc_library(
    name = "SupportHeaders",
    hdrs = glob(["include/LLCL/Support/*.h"]),
    visibility = ["//visibility:private"],
)

modular_cc_library(
    name = "CompilerSupport",
    srcs = glob(["lib/CompilerSupport/*.cpp"]),
    hdrs = glob(["include/LLCL/CompilerSupport/*.h"]),
    deps = [
        ":Runtime",
    ],
)

modular_cc_library(
    name = "Runtime",
    srcs = glob(["lib/Runtime/*.cpp"]),
    hdrs = glob([
        "include/LLCL/Runtime/Globals/*.h",
        "include/LLCL/Runtime/*.h",
    ]) + [
        "include/LLCL/ForwardDecls.h",
    ],
    local_defines = select({
        "@platforms//os:linux": ["MODULAR_HAVE_SEM_TIMEDWAIT"],
        "//conditions:default": [],
    }),
    deps = [
        ":RuntimeHeaders",
        ":Support",
        "//Support:ADT",
        "//Support:Profiling",
    ],
)

globals_library(
    name = "RuntimeGlobals",
    srcs = glob(["lib/Runtime/Globals/*.cpp"]),
    deps = [
        ":CompilerSupport",
        ":RuntimeHeaders",
        ":SupportHeaders",
        "//Support:Base",
        "//Support:Profiling",
        "//Support:SymbolExport",
        "@llvm-project//llvm:Support",
    ],
)

modular_cc_library(
    name = "Support",
    srcs = glob(["lib/Support/*.cpp"]),
    hdrs = glob(["include/LLCL/Support/*.h"]),
    local_defines = select({
        "//:llcl_no_affinity_setting": ["LLCL_NO_AFFINITY"],
        "//conditions:default": [],
    }),
    deps = [
        "//Support:MArchTarget",
        "//Support:Threading",
    ],
)
