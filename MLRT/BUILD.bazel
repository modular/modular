# Driver targets

# A leaf with no device-context dependency, so it can be taken from both the
# legacy and the HAL device-context builds. MEFModel needs it under
# --config=hal-device-context, where the legacy declarations are compiled out.
modular_cc_library(
    name = "Driver/KernelLoadGate",
    srcs = ["lib/Driver/DeviceContext/KernelLoadGate.cpp"],
    hdrs = ["include/MLRT/Driver/DeviceContext/KernelLoadGate.h"],
    includes = ["include"],
    visibility = ["//MLRT:consumers"],
    deps = [
        "//AsyncRT:Runtime",
        "@llvm-project//llvm:Support",
    ],
)

# Shared device-to-worker affinity logic used by both the graph compiler
# (MGPPrimitives) and the Mojo cpuDevice (via CompilerRT). Lives in the Driver
# layer (rather than AsyncRT) because it depends on Driver/DeviceContextAPI, so
# that //AsyncRT stays a clean leaf with no edge back into the Driver code.
modular_cc_library(
    name = "Driver/DeviceAffinity",
    srcs = ["lib/Driver/DeviceContext/DeviceAffinity.cpp"],
    hdrs = ["include/MLRT/Driver/DeviceContext/DeviceAffinity.h"],
    includes = ["include"],
    visibility = ["//MLRT:consumers"],
    deps = [
        ":Driver/DeviceContextAPI",
        "//AsyncRT:Runtime",
        "//Support:Base",
        "//Support:Configuration",
        "//Support:Threading",
        "@llvm-project//llvm:Support",
    ],
)

# Header-only target for DeviceContext/CompilationDevice interfaces.
# Broken out so that //Target:DriverPlugin can depend on these headers
# without creating a circular dependency with Driver/DeviceContextImpl.
modular_cc_library(
    name = "Driver/DeviceContextAPI",
    hdrs = [
        "include/MLRT/Driver/DeviceContext/CompilationDevice.h",
        "include/MLRT/Driver/DeviceContext/DeviceAPINames.h",
        "include/MLRT/Driver/DeviceContext/DeviceContext.h",
        "include/MLRT/Driver/DeviceContext/DeviceGraphBuilder.h",
        "include/MLRT/Driver/DeviceContext/ErrorMacros.h",
        "include/MLRT/Driver/DeviceContext/HALDeviceContext.h",
        "include/MLRT/Driver/DeviceContext/LaunchTraceEntry.h",
        "include/MLRT/Driver/DeviceContext/LaunchTraceRegistry.h",
    ],
    # Switches DeviceContext.h to the HAL shim declarations. Propagated from the
    # target that provides the header rather than a global `--copt`, which would
    # rekey every C++ action including LLVM onto a separate build cache
    # (DRIV-340). Targets that must keep the legacy declarations undefine it in
    # their own `copts`.
    defines = select({
        "//:hal_device_context_enabled": ["MODULAR_HAL_DEVICE_CONTEXT=1"],
        "//conditions:default": [],
    }),
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//AsyncRT:Runtime",
        "//AsyncRT:RuntimeGlobals",
        "//Support:Base",
        "//Support:Buffer",
        "//Support:Configuration",
        "//Support:SymbolExport",
        "//Support:TypeID",
        "@dlpack",
        "@llvm-project//llvm:Support",
    ],
)

# The AsyncRT_Device* C-ABI bindings for Mojo plus the legacy DeviceContext
# implementation. Linked into :Driver/DeviceContext in the default
# configuration. Under --config=hal-device-context nothing links it: the
# runtime DeviceContext is the HAL shim, and the compiler family uses the
# legacy-DeviceContext-free Driver/CompilationDeviceImpl + Driver/CompilerDeviceArch.
modular_cc_library(
    name = "Driver/AsyncRTMojoBindings",
    srcs = ["lib/Driver/DeviceContext/MojoBindings.cpp"],
    hdrs = ["include/MLRT/Driver/DeviceContext/BinaryID.h"],
    # Always compiles against the legacy DeviceContext declarations (see the
    # Driver/DeviceContextImplCpp comment).
    copts = ["-UMODULAR_HAL_DEVICE_CONTEXT"],
    deps = [
        ":Driver/DeviceContextImplCpp",
        ":Driver/KernelLoadGate",
        "//AsyncRT:Runtime",
        "//Support:Base",
        "//Support:BinaryID",
        "//Support:Buffer",
        "//Support:Configuration",
        "//Support:Profiling",
        "//Support:ProfilingRanges",
        "//Support:SymbolExport",
        "//Support:TimeProfiler",
        "@dlpack",
        "@llvm-project//llvm:Support",
    ],
    alwayslink = True,
)

# Minimal, plugin-direct provider of `M::Driver::Device::getAcceleratorArchOrEmpty`
# for the Mojo/KGEN compiler family, so those binaries can detect the target
# accelerator arch WITHOUT linking the DeviceContext runtime. dlopens the driver
# plugin and queries device 0 over the `M_driver_*` C ABI directly. Only built
# under --config=hal-device-context, where the compiler family links it (alongside
# Driver/CompilationDeviceImpl for PTX->cubin) in place of the DeviceContext runtime.
modular_cc_library(
    name = "Driver/CompilerDeviceArch",
    srcs = ["lib/Driver/DeviceContext/CompilerDeviceArch.cpp"],
    target_compatible_with = select({
        "//:hal_device_context_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = [
        "//Kernels/tools/max_license/gpu-query:__pkg__",
        "//Mojo:__subpackages__",
    ],
    deps = [
        ":Driver/DeviceContextAPI",
        "//SDK:HAL",
        "//Support:Base",
        "@llvm-project//llvm:Support",
    ],
    alwayslink = True,
)

# The DeviceContext runtime shared library. Toolchain-side consumers
# (//Mojo:CompilerRT, the mojo toolchain implicit deps) drop this target under
# --config=hal-device-context: the HAL arm reaches @mojo//:std, which would
# cycle back into the toolchain.
# Mojo bindings for the kernel-load gate. Its own target because both
# DeviceContext implementations need it: the gate's entry points tolerate a
# context without one, so a collective links on any backend, whereas each
# backend's own bindings are linked only under its configuration.
modular_cc_library(
    name = "Driver/KernelLoadGateBindings",
    srcs = ["lib/Driver/DeviceContext/KernelLoadGateBindings.cpp"],
    deps = [
        ":Driver/DeviceContextAPI",
        ":Driver/KernelLoadGate",
        "//AsyncRT:Runtime",
        "//Support:Base",
        "//Support:Profiling",
        "//Support:SymbolExport",
        "@llvm-project//llvm:Support",
    ],
    # Nothing in C++ references these exports (they exist for Mojo
    # external_call), so without alwayslink the linker drops the object.
    alwayslink = True,  # keep
)

modular_shared_library(
    name = "Driver/DeviceContext",
    srcs = [],
    hdrs = [
        "include/MLRT/Driver/DeviceContext/BinaryID.h",
        "include/MLRT/Driver/DeviceContext/CompilationDevice.h",
        "include/MLRT/Driver/DeviceContext/DeviceAPINames.h",
        "include/MLRT/Driver/DeviceContext/DeviceContext.h",
        "include/MLRT/Driver/DeviceContext/HALDeviceContext.h",
    ],
    output_name = "AsyncRTMojoBindings",
    deps = [
        ":Driver/DeviceContextAPI",
        ":Driver/KernelLoadGateBindings",
        ":Driver/MojoRuntimeBindingsImpl",
        "//AsyncRT:Runtime",
        "//Support:Base",
        "//Support:BinaryID",
        "//Support:Buffer",
        "//Support:Configuration",
        # The profiler host glue makes this DSO's copy of the range shim able
        # to load/adopt the profiler plugin. Required for the device-init
        # activation trigger: in Python processes the MLRT device contexts
        # (and their activatePendingTrace() call sites) resolve into THIS
        # DSO, not libmax, and a glue-less copy would silently drop the
        # notification — on AMD that permanently forfeits GPU recording
        # (rocprofiler tool registration must precede the first HIP call).
        "//Support:ProfilerHostGlue",
        "//Support:SymbolExport",
        "//Support:TypeID",
        "@dlpack",
        "@llvm-project//llvm:Support",
    ] + select({
        # Carries the implementation matching the
        # MODULAR_HAL_DEVICE_CONTEXT declaration switch: the HAL shim (and its
        # MojoHAL exports) under --config=hal-device-context, the legacy DeviceContext
        # implementation plus its AsyncRT_Device* Mojo bindings otherwise.
        "//:hal_device_context_enabled": [":Driver/DeviceContextImplHAL"],
        "//conditions:default": [":Driver/AsyncRTMojoBindings"],
    }),
)

alias(
    name = "Driver/DeviceContextImpl",
    actual = select({
        # Under --config=hal-device-context the implementation is the HAL shim
        # over the Mojo HAL DeviceContext; the legacy C++ implementation is
        # not linked. The HAL shim reaches @mojo//:std, so compiler-family
        # targets (//Mojo:CompilerRT, the toolchain implicit deps) drop
        # //MLRT:Driver/DeviceContext under this flag.
        "//:hal_device_context_enabled": ":Driver/DeviceContextImplHAL",
        "//conditions:default": ":Driver/DeviceContextImplCpp",
    }),
    visibility = [
        "//AsyncRT:__subpackages__",
        "//GraphCompiler:__subpackages__",
        "//MLRT:__subpackages__",
        "//max/python/max/_core/max_license:__subpackages__",
        "//plugins:__subpackages__",
    ],
)

# The Mojo side of the HAL C++ compatibility layer. The C++ shim links this
# and forwards each DeviceContext.h method to a MojoHAL_* symbol. Only
# meaningful under --config=hal-device-context.
mojo_shared_library(
    name = "Driver/HALDeviceContextExports",
    srcs = ["lib/Driver/DeviceContext/HAL/hal_device_context_exports.mojo"],
    shared_lib_name = "libHALDeviceContextMojo.so",
    tags = [ALLOW_UNUSED_TAG],
    # The exports reach into HAL-specific DeviceContext internals, which only
    # exist when std's DeviceContext is the HAL implementation.
    target_compatible_with = select({
        "//:hal_device_context_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    # Depends on HAL's `max` directly rather than through //max:max_mojo. This target
    # only builds under --config=hal-device-context, where that alias always
    # selects this very target, so the two are equivalent here -- but the alias
    # also names the non-HAL `max`, which now depends on
    # Driver/DeviceContext, and Driver/DeviceContext selects this library back
    # under the HAL branch. No single configuration closes that loop, yet it is
    # a cycle in the unconfigured graph that `bazel query` reports.
    deps = [
        "//max/mojo/max/_driver/max_license:max",
        "@mojo//:std",
    ],
)

# HAL replacement for the DeviceContext C++ API: a pure shim over the Mojo HAL
# DeviceContext (MojoHAL_* exports), implementing the HALDeviceContext.h
# declarations that DeviceContext.h dispatches to under
# --config=hal-device-context.
# Backend-independent runtime bindings (MojoBindings.cpp): symbols Mojo
# programs may call (AsyncRT_AsyncValue_*, MLRT_TaskIdForDevice),
# regardless of which DeviceContext implementation is active. Linked into the
# Driver/DeviceContext shared library under both configurations.
modular_cc_library(
    name = "Driver/MojoRuntimeBindingsImpl",
    srcs = ["lib/Driver/DeviceContext/MojoRuntimeBindings.cpp"],
    deps = [
        ":Core/Tensor",
        ":Driver/DeviceAffinity",
        "//AsyncRT:Runtime",
        "//Support:Base",
        "//Support:Profiling",
        "//Support:ProfilingRanges",
        "//Support:SymbolExport",
    ],
    # Nothing in C++ references these exports (they exist for Mojo
    # external_call), so without alwayslink the linker drops the object.
    alwayslink = True,  # keep
)

# Shared-library form of the std runtime bindings for the Mojo toolchain's
# runtime environment under --config=hal-device-context, where the toolchain
# does not link the DeviceContext runtime that normally carries them (see
# bazel/internal implicit_deps).
modular_shared_library(
    name = "Driver/MojoRuntimeBindings",
    srcs = [],
    output_name = "MojoRuntimeBindings",
    tags = [ALLOW_UNUSED_TAG],
    # Only meaningful under --config=hal-device-context.
    target_compatible_with = select({
        "//:hal_device_context_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        # The gate's bindings ride along here rather than in
        # MojoRuntimeBindingsImpl: that one is linked under both
        # configurations, including into the Mojo toolchain's runtime, where
        # pulling in the DeviceContext API would drag packages the open-source
        # export excludes.
        ":Driver/KernelLoadGateBindings",
        ":Driver/MojoRuntimeBindingsImpl",
    ],
)

# The launch-trace registry the device backends record into, and that
# `max.driver.begin_launch_trace` reads. Split out of
# Driver/DeviceContextImplCpp so both DeviceContext implementations carry it:
# the entry type and the registry are backend-independent, and the Python
# driver bindings reference them under either flag setting (the HAL shim simply
# never records, leaving the trace empty).
modular_cc_library(
    name = "Driver/LaunchTraceRegistry",
    srcs = ["lib/Driver/DeviceContext/LaunchTraceRegistry.cpp"],
    deps = [
        ":Driver/DeviceContextAPI",
        "//Support:Base",
        "//Support:HashUtils",
        "//Support:SymbolExport",
        "@llvm-project//llvm:Support",
    ],
    alwayslink = True,
)

