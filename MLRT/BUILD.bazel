# Minimal shared library that folds and re-exports the full NIXL symbol set for
# dkv / disagg consumers that link against `libmixl.so` directly (e.g. the dkv
# smoke test). Unlike libmax — which links libnixl.so dynamically via
# @nixl_upstream//:nixl_runtime — libmixl statically folds the `:nixl*` alwayslink object libraries
# so the symbols are exported from libmixl.so itself, preserving the existing dkv
# link contract. This is the legacy consumption path; the production
# dkv-connector links libnixl.so directly. Migrating dkv off libmixl onto
# libnixl.so is tracked as a GEX-3826 follow-up.
#
# The transport plugins are not carried as runfiles here (modular_shared_library
# takes no `data`); consumers build the `@nixl_upstream//:libplugin_*.so` targets
# alongside libmixl (see dkv/tools/smoke-test/Dockerfile).
modular_shared_library(
    name = "libmixl",
    srcs = [],
    output_name = "mixl",
    tags = [
        "maybe-unused",
        "no-clang-tidy",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@nixl_upstream//:nixl_api_headers",
    ] + select({
        "//:linux_x86_64": [
            "@nixl_upstream//:nixl",
            "@nixl_upstream//:nixl_common",
            "@nixl_upstream//:nixl_infra",
            "@nixl_upstream//:nixl_serdes",
            "@nixl_upstream//:nixl_stream",
        ],
        "//conditions:default": [],
    }),
)
