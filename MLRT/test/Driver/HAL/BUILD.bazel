load("//bazel:api.bzl", "modular_cc_binary", "modular_py_test", "mojo_shared_library", "mojo_test", "requirement")

package(
    default_visibility = ["//MLRT:consumers"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

# ---------------------------------------------------------------------------
# Mock plugin — lightweight C implementation of M_driver_* for testing the
# Mojo HAL bindings without GPU hardware.
# ---------------------------------------------------------------------------
modular_cc_binary(
    name = "MockPlugin.so",
    testonly = True,
    srcs = ["mock_plugin.c"],
    linkshared = True,
    linkstatic = False,
    deps = ["//SDK:HAL"],
)

# ---------------------------------------------------------------------------
# Mock-based test — runs without GPU, exercises full HAL lifecycle.
# ---------------------------------------------------------------------------
mojo_test(
    name = "test_hal_mock.mojo.test",
    srcs = ["test_hal_mock.mojo"],
    data = [":MockPlugin.so"],
    env = {
        "MODULAR_DRIVER_PLUGINS": "Mock@$(rootpath :MockPlugin.so)",
    },
    tags = ["gpu"],
    target_compatible_with = select({
        "//:nvidia_gpu": [],
        "//:apple_gpu": [],
        "//:amd_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
        "@mojo//:test_utils",
    ],
)

