load("//bazel:api.bzl", "modular_cc_binary")

package(
    default_visibility = ["//MLRT:__subpackages__"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

modular_cc_binary(
    name = "graphrt-opt",
    srcs = glob(["*.cpp"]),
    dynamic_deps = [
        "@llvm-project//llvm:LLVM",
        "//AsyncRT:RuntimeGlobals",
        "//Support:Globals",
        "@llvm-project//mlir:MLIR",
    ],
    deps = [
        "//AsyncRT:CompilerSupport",
        "//AsyncRT:RuntimeGlobals.static",
        "//Init",
        "//MLRT:GraphRT/AllDialects",
        "//Support:Context",
        "//Support:Globals.static",
        "@llvm-project//mlir:MlirOptLib",
        "@llvm-project//mlir:Pass",
        "@llvm-project//mlir:Transforms",
    ],
)
