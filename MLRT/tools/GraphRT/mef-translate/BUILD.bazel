load("//bazel:api.bzl", "modular_cc_binary")

package(
    default_visibility = ["//MLRT:__subpackages__"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

modular_cc_binary(
    name = "mef-translate",
    srcs = glob(["*.cpp"]),
    dynamic_deps = [
        "@llvm-project//llvm:LLVM",
        "//AsyncRT:RuntimeGlobals",
        "//Support:Globals",
        "@llvm-project//mlir:MLIR",
    ],
    deps = [
        "//AsyncRT:CompilerSupport",
        "//AsyncRT:RuntimeGlobals.static",
        "//MLRT:GraphRT/GRTDialect",
        "//MLRT:GraphRT/MEFToMLIR",
        "//MLRT:GraphRT/MLIRToMEF",
        "//Support:Globals.static",
        "@llvm-project//mlir:IR",
        "@llvm-project//mlir:QuantOps",
        "@llvm-project//mlir:Support",
        "@llvm-project//mlir:TranslateLib",
    ],
)
