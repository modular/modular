# The driver-backdoor path: MEMORY_MANAGER_ONLY is deliberately unset, so a
# manager miss falls through to the driver instead of surfacing
# allocationMissError. Diagnostics on, since this asserts the accounting
# attached to the driver's own failure.
# The size-rejection shape: cheap, needs only a small capped budget.
modular_cc_test(
    name = "MemoryManagerOomBackdoorTest",
    size = "medium",
    srcs = [
        "MemoryManagerOomBackdoorTest.cpp",
    ],
    args = ["--gtest_filter=*DriverRefusalIsNotedOnTheManagersReason"],
    env = {
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_VMM": "True",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_VMM_PAGE_MB": "32",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_SIZE": "268435456",  # 256 MiB
        # common.bazelrc sets MEMORY_MANAGER_ONLY for every test; this target
        # exists to exercise the fallthrough, so it switches it back off.
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_ONLY": "False",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_SELF_CHECK": "True",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_LOG": "False",
    },
    gpu_constraints = select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tags = ["gpu"],
    deps = [
        ":TestUtils",
        "//MLRT:Driver/DeviceContextImpl",
        "//Support:Base",
        "@llvm-project//llvm:Support",
    ],
)

# The classified shape: needs the whole device, since the condition is the
# device being exhausted while the manager still has budget. No MEMORY_MANAGER_
# SIZE cap, so the budget defaults to ~90% of device free and the manager keeps
# headroom while an untracked allocation exhausts the device.
modular_cc_test(
    name = "MemoryManagerOomBackdoorClassifiedTest",
    size = "large",
    srcs = [
        "MemoryManagerOomBackdoorTest.cpp",
    ],
    args = ["--gtest_filter=*ClassifiedMissCarriesTheBackdoorNote"],
    env = {
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_VMM": "True",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_VMM_PAGE_MB": "2",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_ONLY": "False",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_SELF_CHECK": "True",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_LOG": "False",
    },
    exec_properties = {
        # Consumes essentially all device memory, so reserve a whole GPU to
        # keep it off shared devices.
        "test.resources:gpu-memory": "180",
    },
    # NVIDIA-only. The 180 GiB reservation is a whole B200 but only part of an
    # MI355X, so other tests share the device. Separately, HIP does not
    # reliably refuse a small VMM allocation once hipMalloc has driven free
    # memory to zero: it either backs the 64 MiB request anyway or crashes
    # inside HIP while mapping it. Requiring a GPU also keeps this off CPU
    # lanes, which could not schedule the reservation.
    gpu_constraints = ["//:nvidia_gpu"],
    tags = ["gpu"],
    deps = [
        ":TestUtils",
        "//MLRT:Driver/DeviceContextImpl",
        "//Support:Base",
        "@llvm-project//llvm:Support",
    ],
)

