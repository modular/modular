# gazelle:default_visibility //visibility:private

package(
    default_visibility = ["//visibility:private"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

AMDGPU_GRAPH_CAPTURE_ARCHES = [
    "gfx950",
]

GRAPH_CAPTURE_HSACO_DATA = [
    ":graph_capture_vec_add_{}_hsaco".format(arch)
    for arch in AMDGPU_GRAPH_CAPTURE_ARCHES
]

[
    # Generate HSA code object to load in GraphCaptureTest.
    genrule(
        name = "graph_capture_vec_add_{}_hsaco".format(arch),
        srcs = ["graph_capture_vec_add.amdgpu.ll"],
        outs = ["graph_capture_vec_add_{}.hsaco".format(arch)],
        cmd = "$(location @llvm-project//llvm:llc) " +
              "-mtriple=amdgcn-amd-amdhsa " +
              "-mcpu={} ".format(arch) +
              "-filetype=obj $< -o $@.o && " +
              "$(location @llvm-project//lld:ld.lld) -shared $@.o -o $@ && " +
              "rm -f $@.o",
        tools = [
            "@llvm-project//lld:ld.lld",
            "@llvm-project//llvm:llc",
        ],
    )
    for arch in AMDGPU_GRAPH_CAPTURE_ARCHES
]

