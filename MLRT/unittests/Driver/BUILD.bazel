modular_cc_test(
    name = "GPUMemoryManagerFallthroughTest",
    size = "medium",
    srcs = [
        "GPUMemoryManagerFallthroughTest.cpp",
    ],
    env = {
        # Small cache (4MB) so allocations > 4MB fall through to the device
        # driver instead of being served from the memory manager's chunk cache.
        # This exercises the fallthrough path fixed in GEX-2965.
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_SIZE": "4194304",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_CHUNK_PERCENT": "100",
        # Disable memory-manager-only mode so the fallthrough path is reachable.
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_ONLY": "false",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_SELF_CHECK": "True",
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_LOG": "False",
        # The fallthrough-to-driver path only exists in the classic allocator
        # (`if (!vmmEnabled_)`); the VMM arena has no fallthrough. Pin VMM off so
        # the NVIDIA default-on does not bypass the path this test covers.
        "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_VMM": "False",
    },
    gpu_constraints = select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tags = ["gpu"],
    deps = [
        ":TestUtils",
        "//MLRT:Driver/DeviceContextImpl",
        "//Support:Base",
        "@llvm-project//llvm:Support",
    ],
)

