# Shared env for the OOM condition tests. Small VMM budget with 32 MiB granules
# so the conditions trigger cheaply; only-mode disables the driver backdoor so a
# miss surfaces as an error rather than a fallthrough.
_MEMORY_MANAGER_OOM_ENV = {
    "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_VMM": "True",
    "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_VMM_PAGE_MB": "32",
    "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_SIZE": "268435456",  # 256 MiB
    "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_ONLY": "True",
    "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_SELF_CHECK": "True",
    "MODULAR_DEVICE_CONTEXT_MEMORY_MANAGER_LOG": "False",
}

# One target per condition. The device MemoryManager is a process-wide singleton,
# so each condition runs in its own process to guarantee a clean starting state
# (a shared process lets one condition's leftover stream/free-list state perturb
# the next).
[
    modular_cc_test(
        name = "MemoryManagerOom{}Test".format(suffix),
        size = "medium",
        srcs = [
            "MemoryManagerOomTest.cpp",
        ],
        args = ["--gtest_filter=MemoryManagerOomTest.{}".format(test)],
        env = _MEMORY_MANAGER_OOM_ENV,
        gpu_constraints = select({
            "//:apple_gpu": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        tags = ["gpu"],
        deps = [
            ":TestUtils",
            "//MLRT:Driver/DeviceContextImpl",
            "//Support:Base",
            "@llvm-project//llvm:Support",
        ],
    )
    for suffix, test in [
        ("Genuine", "GenuineOutOfMemory"),
        ("Pending", "PendingMemoryBlocksUntilSync"),
        ("PendingRecovered", "PendingMemoryRecoveredWithoutCallerSync"),
        ("Fragmented", "FragmentedPartialGranulesBlockWholeGranule"),
        ("Reclaimable", "SnapshotCountsReclaimableGranule"),
    ]
]

