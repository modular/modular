load("//bazel:api.bzl", "modular_cc_library")

package(
    default_visibility = ["//visibility:private"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

modular_cc_library(
    name = "TestCommon",
    testonly = True,
    srcs = ["TestCommon.cpp"],
    hdrs = ["TestCommon.h"],
    visibility = ["//MLRT/unittests/Driver/NIXL:__subpackages__"],
    deps = [
        "//Support:NixlPluginDir",
        "@llvm-project//llvm:Support",
        "@llvm-project//third-party/unittest:gtest",
        "@nixl_upstream//:nixl_api_headers",
        "@nixl_upstream//:nixl_runtime",
    ],
)
