load("//bazel:api.bzl", "modular_cc_test")

# gazelle:default_visibility //visibility:private

package(
    default_visibility = ["//visibility:private"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

genrule(
    name = "buffer_lifetime_mef",
    srcs = ["buffer_lifetime.mlir"],
    outs = ["buffer_lifetime.mef"],
    cmd = "MODULAR_HOME=. $(location //MLRT/tools/GraphRT/mef-translate) " +
          "-export-mef -allow-unregistered-dialect $< -o $@",
    tools = ["//MLRT/tools/GraphRT/mef-translate"],
)

modular_cc_test(
    name = "MEFFileTest",
    size = "small",
    srcs = ["MEFFileTest.cpp"],
    data = [":buffer_lifetime.mef"],
    dynamic_deps = [
        "//AsyncRT:RuntimeGlobals",
        "//Support:Globals",
    ],
    deps = [
        "//AsyncRT:Runtime",
        "//AsyncRT:RuntimeGlobals.static",
        "//MLRT:GraphRT/MEFExecutor",
        "//Support:Base",
        "//Support:Buffer",
        "//Support:Globals.static",
        "//Support:ML",
        "@bazel_tools//tools/cpp/runfiles",
        "@llvm-project//llvm:Support",
    ],
)
