load("//bazel:api.bzl", "lit_tests", "modular_cc_binary")

package(default_visibility = ["//visibility:private"])

modular_cc_binary(
    name = "c_host",
    testonly = True,
    srcs = ["c_host.c"],
)

lit_tests(
    name = "lit_tests",
    srcs = glob(["*_c_host.mojo"]),
    data = [":c_host"],
    mojo_deps = [
        "@mojo//:std",
    ],
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = ["//Mojo/tools/mojo"],
)
