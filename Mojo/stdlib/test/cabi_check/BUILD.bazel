load("//bazel:api.bzl", "mojo_test")
load("//Mojo/stdlib/test:cabi_test.bzl", "mojo_cabi_test")

package(default_visibility = ["//visibility:private"])

mojo_cabi_test(
    name = "abi_probe",
    platforms = [
        "linux",
        "macos",
    ],
)

[
    mojo_test(
        name = src + ".test",
        srcs = [src],
        copts = [
            "--debug-level",
            "full",
        ],
        deps = [
            ":abi_probe_reference",
            "@mojo//:std",
            "@mojo//:test_utils",
        ],
    )
    for src in glob(["*.mojo"])
]
