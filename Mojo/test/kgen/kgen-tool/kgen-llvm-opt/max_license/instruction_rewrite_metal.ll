; Same ptr arg inserted at two different indices of a zeroinitializer: both
; fields must be promoted and the return type must reflect both promotions.

define { ptr, [1 x i64], [1 x i64], ptr, [1 x i64], [1 x i64] } @insertvalue_zeroinit_two_indices(ptr %0) #0 {
; CHECK-LABEL: define { ptr, [1 x i64], [1 x i64], ptr, [1 x i64], [1 x i64] } @insertvalue_zeroinit_two_indices(
; CHECK-SAME: ptr [[TMP0:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[TMP2:%.*]] = insertvalue { ptr, [1 x i64], [1 x i64], ptr, [1 x i64], [1 x i64] } zeroinitializer, ptr [[TMP0]], 0
; CHECK-NEXT:    [[TMP3:%.*]] = insertvalue { ptr, [1 x i64], [1 x i64], ptr, [1 x i64], [1 x i64] } [[TMP2]], ptr [[TMP0]], 3
; CHECK-NEXT:    ret { ptr, [1 x i64], [1 x i64], ptr, [1 x i64], [1 x i64] } [[TMP3]]
;
  %2 = insertvalue { ptr, [1 x i64], [1 x i64], ptr, [1 x i64], [1 x i64] } zeroinitializer, ptr %0, 0
  %3 = insertvalue { ptr, [1 x i64], [1 x i64], ptr, [1 x i64], [1 x i64] } %2, ptr %0, 3
  ret { ptr, [1 x i64], [1 x i64], ptr, [1 x i64], [1 x i64] } %3
}

; Masks tested (matches the switch in InstructionRewrite.cpp):
;   0x003 (qnan|snan)        -> fcmp uno val, val
;   0x001 (qnan only)        -> fcmp uno val, val
;   0x002 (snan only)        -> fcmp uno val, val
;   0x204 (posinf|neginf)    -> fabs(val); fcmp oeq abs, +inf
;   0x200 (posinf only)      -> fabs(val); fcmp oeq abs, +inf
;   0x004 (neginf only)      -> fabs(val); fcmp oeq abs, +inf
;   0x1F8 (finite)           -> fcmp ord val, val; fabs; fcmp one abs, +inf; and
;   0x060 (poszero|negzero)  -> fcmp oeq val, 0.0

; ---------------------------------------------------------------------------
; NaN cases (masks 0x3, 0x1, 0x2) -> unordered self-compare
; ---------------------------------------------------------------------------

define i1 @is_fpclass_nan(float %x) #0 {
; CHECK-LABEL: define i1 @is_fpclass_nan(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[RES:%.*]] = fcmp uno float [[X]], [[X]]
; CHECK-NEXT:    ret i1 [[RES]]
;
  %res = call i1 @llvm.is.fpclass.f32(float %x, i32 3)
  ret i1 %res
}

define i1 @is_fpclass_qnan(float %x) #0 {
; CHECK-LABEL: define i1 @is_fpclass_qnan(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[RES:%.*]] = fcmp uno float [[X]], [[X]]
; CHECK-NEXT:    ret i1 [[RES]]
;
  %res = call i1 @llvm.is.fpclass.f32(float %x, i32 1)
  ret i1 %res
}

define i1 @is_fpclass_snan(float %x) #0 {
; CHECK-LABEL: define i1 @is_fpclass_snan(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[RES:%.*]] = fcmp uno float [[X]], [[X]]
; CHECK-NEXT:    ret i1 [[RES]]
;
  %res = call i1 @llvm.is.fpclass.f32(float %x, i32 2)
  ret i1 %res
}

; ---------------------------------------------------------------------------
; Inf cases (masks 0x204, 0x200, 0x4) -> fabs + ordered compare against +inf
; ---------------------------------------------------------------------------

define i1 @is_fpclass_inf(float %x) #0 {
; CHECK-LABEL: define i1 @is_fpclass_inf(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[ABS:%.*]] = call float @llvm.fabs.f32(float [[X]])
; CHECK-NEXT:    [[RES:%.*]] = fcmp oeq float [[ABS]], +inf
; CHECK-NEXT:    ret i1 [[RES]]
;
  %res = call i1 @llvm.is.fpclass.f32(float %x, i32 516)
  ret i1 %res
}

define i1 @is_fpclass_posinf(float %x) #0 {
; CHECK-LABEL: define i1 @is_fpclass_posinf(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[ABS:%.*]] = call float @llvm.fabs.f32(float [[X]])
; CHECK-NEXT:    [[RES:%.*]] = fcmp oeq float [[ABS]], +inf
; CHECK-NEXT:    ret i1 [[RES]]
;
  %res = call i1 @llvm.is.fpclass.f32(float %x, i32 512)
  ret i1 %res
}

define i1 @is_fpclass_neginf(float %x) #0 {
; CHECK-LABEL: define i1 @is_fpclass_neginf(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[ABS:%.*]] = call float @llvm.fabs.f32(float [[X]])
; CHECK-NEXT:    [[RES:%.*]] = fcmp oeq float [[ABS]], +inf
; CHECK-NEXT:    ret i1 [[RES]]
;
  %res = call i1 @llvm.is.fpclass.f32(float %x, i32 4)
  ret i1 %res
}

; ---------------------------------------------------------------------------
; Finite case (mask 0x1F8) -> ord self-compare AND (fabs one +inf)
; ---------------------------------------------------------------------------

define i1 @is_fpclass_finite(float %x) #0 {
; CHECK-LABEL: define i1 @is_fpclass_finite(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[ORD:%.*]] = fcmp ord float [[X]], [[X]]
; CHECK-NEXT:    [[ABS:%.*]] = call float @llvm.fabs.f32(float [[X]])
; CHECK-NEXT:    [[NOTINF:%.*]] = fcmp one float [[ABS]], +inf
; CHECK-NEXT:    [[RES:%.*]] = and i1 [[ORD]], [[NOTINF]]
; CHECK-NEXT:    ret i1 [[RES]]
;
  %res = call i1 @llvm.is.fpclass.f32(float %x, i32 504)
  ret i1 %res
}

; ---------------------------------------------------------------------------
; Zero case (mask 0x60 = poszero | negzero) -> ordered compare against 0.0
; ---------------------------------------------------------------------------

define i1 @is_fpclass_zero(float %x) #0 {
; CHECK-LABEL: define i1 @is_fpclass_zero(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    [[RES:%.*]] = fcmp oeq float [[X]], 0.000000e+00
; CHECK-NEXT:    ret i1 [[RES]]
;
  %res = call i1 @llvm.is.fpclass.f32(float %x, i32 96)
  ret i1 %res
}

; Ensure that this pass always runs (doesn't skip optnone functions)
define i1 @is_fpclass_zero_optnone(float %x) #1 {
; CHECK-LABEL: define i1 @is_fpclass_zero_optnone(
; CHECK-SAME: float [[X:%.*]]) #[[ATTR1:[0-9]+]] {
; CHECK-NEXT:    [[RES:%.*]] = fcmp oeq float [[X]], 0.000000e+00
; CHECK-NEXT:    ret i1 [[RES]]
;
  %res = call i1 @llvm.is.fpclass.f32(float %x, i32 96)
  ret i1 %res
}

; ---------------------------------------------------------------------------
; stubUndefinedLibcCalls: free() erased, malloc() → null pointer
;
; Metal GPU has no libc allocator. free() calls are removed outright;
; malloc() calls are replaced with a null pointer constant so callers
; that check the result handle it gracefully.
; ---------------------------------------------------------------------------

declare void @free(ptr)
declare ptr @malloc(i64)


; Declarations must be erased when no uses remain.
define void @test_stub_libc(ptr %p, ptr addrspace(1) %out) #0 {
; CHECK-LABEL: define void @test_stub_libc(
; CHECK-SAME: ptr [[P:%.*]], ptr addrspace(1) [[OUT:%.*]]) #[[ATTR0]] {
; CHECK-NEXT:    store ptr null, ptr addrspace(1) [[OUT]], align 8
; CHECK-NEXT:    ret void
;
  call void @free(ptr %p)
  %m = call ptr @malloc(i64 64)
  store ptr %m, ptr addrspace(1) %out, align 8
  ret void
}

attributes #0 = { "metal.kernel"="true" }
attributes #1 = { "metal.kernel"="true" optnone noinline }
