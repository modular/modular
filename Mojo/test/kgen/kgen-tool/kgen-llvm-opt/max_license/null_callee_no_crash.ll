; CHECK-NEXT:    [[TMP3:%.*]] = bitcast ptr addrspace(1) [[TMP1]] to ptr addrspace(1)
; CHECK-NEXT:    [[DOTAGG_LOADED:%.*]] = load [1 x i64], ptr addrspace(1) [[TMP3]], align 8
; CHECK-NEXT:    [[TMP4:%.*]] = extractvalue [1 x i64] [[DOTAGG_LOADED]], 0
