declare void @trait_method()
declare void @consume_struct({ ptr, i32 }) #2

; A call instruction whose argument is a ConstantStruct containing a pointer
; element. The pass replaces the ConstantStruct with an insertvalue chain
; (undef base, then one insertvalue per field) before the call instruction,
; so that no ConstantAggregate with pointer fields appears in the bitcode.
; NOTE: MetalAIRPass outputs kernel functions before non-kernel functions, so
; this kernel (@test_demote_const_aggregate) appears before @myfunc_captures
; in the output even though it's defined after it in the input.
;
define void @test_demote_const_aggregate() #0 {
; CHECK: Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn
; CHECK-LABEL: define void @test_demote_const_aggregate(
; CHECK-SAME: <3 x i32> [[THREADGROUP_POSITION_IN_GRID:%.*]], <3 x i32> [[THREAD_POSITION_IN_THREADGROUP:%.*]], <3 x i32> [[THREADS_PER_THREADGROUP:%.*]], <3 x i32> [[THREADS_PER_GRID:%.*]], i32 [[THREAD_INDEX_IN_SIMDGROUP:%.*]]) local_unnamed_addr #[[ATTR2:[0-9]+]] {
; CHECK-NEXT:    [[AGG0:%.*]] = insertvalue { ptr, i32 } undef, ptr @trait_method, 0
; CHECK-NEXT:    [[AGG1:%.*]] = insertvalue { ptr, i32 } [[AGG0]], i32 99, 1
; CHECK-NEXT:    call void @consume_struct({ ptr, i32 } [[AGG1]])
; CHECK-NEXT:    ret void
;
  call void @consume_struct({ ptr, i32 } { ptr @trait_method, i32 99 })
  ret void
}

@shared_buf = internal addrspace(3) global [64 x i8] undef, align 4

; Nested pointer ConstantExpr (GEP wrapping addrspacecast of a SHARED
; global) that aborted the compiler in MOCO-4417.
; Kernels are emitted before non-kernels, so this appears before
; @myfunc_captures despite being defined after it here.
define void @test_demote_nested_pointer_constexpr(ptr %out, i64 %idx) #0 {
; CHECK: Function Attrs: mustprogress nofree norecurse nosync nounwind willreturn
; CHECK-LABEL: define void @test_demote_nested_pointer_constexpr(
; CHECK-SAME: ptr addrspace(1) "air-buffer-no-alias" "nocapture" "noundef" "readonly" [[TMP0:%.*]], ptr addrspace(2) "air-buffer-no-alias" "nocapture" "noundef" "readonly" [[TMP1:%.*]], <3 x i32> [[THREADGROUP_POSITION_IN_GRID:%.*]], <3 x i32> [[THREAD_POSITION_IN_THREADGROUP:%.*]], <3 x i32> [[THREADS_PER_THREADGROUP:%.*]], <3 x i32> [[THREADS_PER_GRID:%.*]], i32 [[THREAD_INDEX_IN_SIMDGROUP:%.*]]) local_unnamed_addr #[[ATTR3:[0-9]+]] {
; CHECK-NEXT:    [[TMP3:%.*]] = bitcast ptr addrspace(2) [[TMP1]] to ptr addrspace(2)
; CHECK-NEXT:    [[DOTLOADED:%.*]] = load i64, ptr addrspace(2) [[TMP3]], align 8
; CHECK-NEXT:    [[TMP4:%.*]] = bitcast ptr addrspace(3) @shared_buf to ptr addrspace(3)
; CHECK-NEXT:    [[TMP5:%.*]] = addrspacecast ptr addrspace(3) [[TMP4]] to ptr
; CHECK-NEXT:    [[TMP6:%.*]] = bitcast ptr [[TMP5]] to ptr
; CHECK-NEXT:    [[TMP7:%.*]] = getelementptr inbounds nuw i8, ptr [[TMP6]], i64 16
; CHECK-NEXT:    [[TMP8:%.*]] = bitcast ptr [[TMP7]] to ptr
; CHECK-NEXT:    [[TMP9:%.*]] = bitcast ptr [[TMP8]] to ptr
; CHECK-NEXT:    [[P:%.*]] = getelementptr inbounds i8, ptr [[TMP9]], i64 [[DOTLOADED]]
; CHECK-NEXT:    [[TMP10:%.*]] = bitcast ptr [[P]] to ptr
; CHECK-NEXT:    [[TMP11:%.*]] = bitcast ptr [[TMP10]] to ptr
; CHECK-NEXT:    [[V:%.*]] = load i32, ptr [[TMP11]], align 4
; CHECK-NEXT:    [[TMP12:%.*]] = bitcast ptr addrspace(1) [[TMP0]] to ptr addrspace(1)
; CHECK-NEXT:    store i32 [[V]], ptr addrspace(1) [[TMP12]], align 4
; CHECK-NEXT:    ret void
;
  %p = getelementptr inbounds i8, ptr getelementptr inbounds nuw (i8, ptr addrspacecast (ptr addrspace(3) @shared_buf to ptr), i64 16), i64 %idx
  %v = load i32, ptr %p
  store i32 %v, ptr %out
  ret void
}

define void @myfunc_captures(ptr captures(none) %0) {
