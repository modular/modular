// RUN: kgen %s -elaborate -S -o - | FileCheck %s


kgen.generator @"$mojo::mangled::name[int::Int](int::Int)"() {
  hlcf.return
}

// CHECK-LABEL: kgen.func export @mojo_main
kgen.generator export @mojo_main() -> (!kgen.string, !kgen.string) {
  kgen.param.declare nvptx: target = <#kgen.target<
    triple = "nvptx64-nvidia-cuda",
    arch = "sm_75",
    data_layout = "e-p6:32:32-i64:64-i128:128-i256:256-v16:16-v32:32-n16:32:64",
    simd_bit_width = 128
  >>
  // CHECK: constant: string
  // CHECK-SAME: "_mojo_mangled_name_int_Int[[MANGLE:.*]]"
  // CHECK: constant: string
  // CHECK-SAME: Generated by LLVM NVPTX
  // CHECK-SAME: .entry _mojo_mangled_name_int_Int[[MANGLE]]()
  %0 = kgen.param.constant: string = <#kgen.struct.extract<#kgen.compile_assembly<nvptx, =asm, "", false, :() -> () @"$mojo::mangled::name[int::Int](int::Int)">, 0>>
  %1 = kgen.param.constant: string = <#kgen.get_linkage_name<nvptx, #kgen.symbol.constant<@"$mojo::mangled::name[int::Int](int::Int)"> : !kgen.generator<() -> ()>>>
  hlcf.return %0, %1 : !kgen.string, !kgen.string
}

kgen.generator @no_params() {
  hlcf.return
}

kgen.generator @params<a, b>() -> (index, index) {
  %0 = kgen.param.constant = <a>
  %1 = kgen.param.constant = <b>
  hlcf.return %0, %1 : index, index
}

kgen.generator @func_param<f: <index, index>() -> (index, index)>() -> index {
  kgen.param.declare bind: () -> (index, index) = <bind_params(:<index, index>() -> (index, index) f, 7, 9)>
  %0, %1 = kgen.call_param[() -> (index, index): bind]()
  %2 = index.add %0, %1
  hlcf.return %2 : index
}

// CHECK-LABEL: kgen.func export @main()
kgen.generator export @main() -> (!kgen.string, !kgen.string, !kgen.string, !kgen.string, !kgen.string, !kgen.string) {
  kgen.param.declare nvptx: target = <#kgen.target<
    triple = "nvptx64-nvidia-cuda",
    arch = "sm_75",
    data_layout = "e-p6:32:32-i64:64-i128:128-i256:256-v16:16-v32:32-n16:32:64",
    simd_bit_width = 128
  >>
  // CHECK-DAG: .visible .entry no_params()
  %0 = kgen.param.constant: string = <#kgen.struct.extract<#kgen.compile_assembly<nvptx, =asm, "", false, :() -> () @no_params>, 0>>
  // CHECK-DAG: <"no_params">
  %1 = kgen.param.constant: string = <#kgen.get_linkage_name<nvptx, #kgen.symbol.constant<@no_params> : !kgen.generator<() -> ()>>>
  // CHECK-DAG: .visible .entry params_a_1_b_2
  %2 = kgen.param.constant: string = <#kgen.struct.extract<#kgen.compile_assembly<nvptx, =asm, "", false, :() -> (index, index) @params<1, 2>>, 0>>
  // CHECK-DAG: <"params_a_1_b_2{{.*}}">
  %3 = kgen.param.constant: string = <#kgen.get_linkage_name<nvptx, #kgen.symbol.constant<@params<1, 2>> : !kgen.generator<() -> (index, index)>>>
  // CHECK-DAG: .visible .entry func_param_f_params
  %4 = kgen.param.constant: string = <#kgen.struct.extract<#kgen.compile_assembly<nvptx, =asm, "", false, :() -> index @func_param<:<index, index>() -> (index, index) @params>>, 0>>
  // CHECK-DAG: <"func_param_f_params{{.*}}">
  %5 = kgen.param.constant: string = <#kgen.get_linkage_name<nvptx, #kgen.symbol.constant<@func_param<:<index, index>() -> (index, index) @params>> : !kgen.generator<() -> index>>>
  hlcf.return %0, %1, %2, %3, %4, %5 : !kgen.string, !kgen.string, !kgen.string, !kgen.string, !kgen.string, !kgen.string
}
