load("//bazel:api.bzl", "lit_tests")

# gazelle:default_visibility //visibility:private

package(default_visibility = ["//visibility:private"])

lit_tests(
    name = "lit",
    size = "large",
    srcs = glob(["**/*.mojo"]),
    data = ["cuda_gdb_runner.py"],
    generate_litcfg = False,
    gpu_constraints = ["//:has_gpu"],
    mojo_deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
    tags = ["gpu"],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = [
        "//Mojo/tools/kgen",
        "//Mojo/tools/kgen-opt",
        "//Mojo/tools/mojo",
    ],
)
