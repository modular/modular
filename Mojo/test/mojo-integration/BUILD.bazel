load("//bazel:api.bzl", "lit_tests")

package(default_visibility = ["//visibility:private"])

_DATA = [
    "inputs/**",
    "max_license/inputs/**",
]

filegroup(
    name = "fixtures",
    testonly = True,
    srcs = glob(
        [
            "inputs/**/*.ll",
            "inputs/**/*.mojo",
            "max_license/inputs/**/*.ll",
            "max_license/inputs/**/*.mojo",
        ],
        # `max_license/inputs/` fixtures may not include every extension.
        allow_empty = True,
    ),
)

# Crash tests that time out in external CI after the crash handler prints its
# trace. Temporary, until crash-test slowness is fixed.
_SKIP_EXTERNAL_CI = [
    "stack_trace_raising_main_terminated.mojo",
    "stack_trace_terminated.mojo",
]

_TEST_MOJO_DEPS = [
    "//max:layout",
    "//max:max_mojo",
    "@mojo//:std",
]

_TEST_TOOLS = [
    "//Mojo/tools/kgen",
    "//Mojo/tools/kgen-opt",
    "//Mojo/tools/kgen-translate",
    "//Mojo/tools/llvm-module-split",
    "//Mojo/tools/mojo",
    "@llvm-project//llvm:llvm-as",
    "@llvm-project//llvm:llvm-dis",
    "@llvm-project//llvm:llvm-nm",
    "@llvm-project//llvm:llvm-objdump",
]

_TEST_SRCS = glob(
    [
        "**/*.mlir",
        "**/*.mojo",
    ],
    exclude = _DATA,
)

lit_tests(
    name = "test",
    srcs = [src for src in _TEST_SRCS if src not in _SKIP_EXTERNAL_CI],
    data = [":fixtures"],
    mojo_deps = _TEST_MOJO_DEPS,
    tags = ["gpu"],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = _TEST_TOOLS,
)

lit_tests(
    name = "test_skip_external_ci",
    srcs = _SKIP_EXTERNAL_CI,
    data = [":fixtures"],
    mojo_deps = _TEST_MOJO_DEPS,
    tags = [
        "gpu",
        "skip-external-ci",
    ],
    target_compatible_with = select({
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tools = _TEST_TOOLS,
)

lit_tests(
    name = "test_std_srcs",
    # This tests require the std, where other tests do
    # not require them
    srcs = glob(["*.test"]),
    data = [
        ":fixtures",
        "@mojo//:std_srcs",
    ],
    env = {
        "MODULAR_MOJO_IMPORT_SRCS": "$(locations @mojo//:std_srcs)",
    },
    mojo_deps = [
        "@mojo//:std",
    ],
    tools = [
        "//Mojo/tools/hash-mlir",
        "//Mojo/tools/kgen",
        "//Mojo/tools/kgen-opt",
        "//Mojo/tools/kgen-translate",
    ],
)
