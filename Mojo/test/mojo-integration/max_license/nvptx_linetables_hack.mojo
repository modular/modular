# Hack tracked by https://github.com/modularml/modular/issues/27478
# REQUIRES: NVIDIA-GPU
# RUN: %mojo -debug-level line-tables %s | FileCheck %s

from max.gpu import thread_idx
from max.gpu.host.compile import _compile_code


def kernel(x: Int):
    _ = thread_idx.x + x


def main():
    # CHECK: Generated by LLVM NVPTX Back-End
    # CHECK: .target
    # CHECK-NOT: debug
    # CHECK: .address_size
    print(_compile_code[kernel]())
