# RUN: %parse-mojo-isolated %S/inputs/strip_file_prefix_input.mojo -strip-file-prefix=%S -mlir-print-debuginfo 2>&1 | FileCheck %s -check-prefix=PARENT --implicit-check-not='/inputs'
# RUN: %parse-mojo-isolated %S/inputs/strip_file_prefix_input.mojo -strip-file-prefix=. -mlir-print-debuginfo 2>&1 | FileCheck %s -check-prefix=PARENT --implicit-check-not='/inputs'
# PARENT: "inputs/strip_file_prefix_input.mojo"
# PARENT: "inputs/local_import.mojo"

# RUN: %parse-mojo-isolated %S/inputs/strip_file_prefix_input.mojo -strip-file-prefix=%S/inputs -mlir-print-debuginfo | FileCheck %s -check-prefix=DIRECT --implicit-check-not='inputs/strip_file_prefix_input'
# DIRECT: "strip_file_prefix_input.mojo"
# DIRECT: "local_import.mojo"

# RUN: %parse-mojo-isolated %S/inputs/strip_file_prefix_input.mojo -strip-file-prefix=%S/foo -mlir-print-debuginfo | FileCheck %s -check-prefix=NON-PARENT --implicit-check-not='"inputs/strip_file_prefix_input' --implicit-check-not='"strip_file_prefix_input'
# NON-PARENT: "/{{.+}}/inputs/strip_file_prefix_input.mojo"
# NON-PARENT: "/{{.+}}/inputs/local_import.mojo"
