# RUN: not %parse-mojo-isolated %S/inputs/strip_file_prefix_error_input.mojo -strip-file-prefix=%S 2>&1 | FileCheck %s -check-prefix=PARENT
# PARENT: {{^}}inputs/strip_file_prefix_error_input.mojo:16:5: error

# RUN: not %parse-mojo-isolated %S/inputs/strip_file_prefix_error_input.mojo -strip-file-prefix=%S/inputs 2>&1 | FileCheck %s -check-prefix=DIRECT
# DIRECT: {{^}}strip_file_prefix_error_input.mojo:16:5: error

# RUN: not %parse-mojo-isolated %S/inputs/strip_file_prefix_error_input.mojo -strip-file-prefix=%S/foo 2>&1 | FileCheck %s -check-prefix=NON-PARENT
# NON-PARENT: {{^}}/{{.+}}/inputs/strip_file_prefix_error_input.mojo:16:5: error
