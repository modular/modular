# UNSUPPORTED: asan

# Test the --llvm-timing option on a program that compiles offload targets.
# Each `compile_offload` target runs its own LLVM pipeline, with its own object
# compiler, inside the host pipeline. The report holds one part for each
# pipeline: one for each target below, and one for the host.

# The timers of LLVM are global to the process, so two threads that run the
# same code generation region start one timer two times, and LLVM stops with
# an assertion. The option sets the thread count to one. The command below
# asks for eight threads, and the option must win.

# The report goes to stderr. Drop stdout, so that the assembly that the
# program prints does not answer the checks below.
# RUN: rm -rf %t.split && env MODULAR_CACHE_DIR=%t.split %mojo --llvm-timing --num-threads 8 %s 2>&1 >/dev/null | FileCheck %s --check-prefix=CHECK_SPLIT

# The timing leaves the output of the program alone.
# RUN: rm -rf %t.prog && env MODULAR_CACHE_DIR=%t.prog %mojo --llvm-timing %s 2>/dev/null | FileCheck %s --check-prefix=CHECK_PROGRAM

# The MLIR report splits in the same way, but the report is a tree. Each
# offload target gets a scope of its own. The passes of that target are under
# that scope.
# RUN: rm -rf %t.mlir && env MODULAR_CACHE_DIR=%t.mlir %mojo --mlir-timing %s 2>&1 >/dev/null | FileCheck %s --check-prefix=CHECK_MLIR

# The `list` display collects the times by pass name over the whole report.
# Thus it merges the pass of the host pipeline with the pass of the same
# name of each offload pipeline. One row holds all of them.
# RUN: rm -rf %t.list && env MODULAR_CACHE_DIR=%t.list %mojo --mlir-timing --mlir-timing-display=list %s 2>&1 >/dev/null | FileCheck %s --check-prefix=CHECK_LIST

# The offload parts come before the host part, because the compiler runs each
# offload pipeline inside elaboration, and the host pipeline reaches LLVM after
# elaboration. The offload parts have no order of their own: the compiler sorts
# the offload work by the mangled name of the kernel, and takes the target only
# to break a tie. A new kernel name can thus put the parts in another order,
# and the checks below do not depend on that order.
# The label of a part carries the `compile_options` of the `compile_offload`.
# CHECK_SPLIT-DAG: LLVM pass timing (--llvm-timing): offload amdgpu
# CHECK_SPLIT-DAG: LLVM pass timing (--llvm-timing): offload nvptx64{{.*}}[target-abi=shortptr]
# CHECK_SPLIT-DAG: AMDGPU
# CHECK_SPLIT-DAG: NVPTX

# CHECK_SPLIT: LLVM pass timing (--llvm-timing): host
# The host part holds no pass of an offload target.
# CHECK_SPLIT-NOT: NVPTX
# CHECK_SPLIT-NOT: AMDGPU

# CHECK_PROGRAM: Generated by LLVM NVPTX Back-End

# The MLIR report is a tree. Each offload target gets a scope. The passes of
# that target are under that scope. The checks below give no target name. Thus
# the checks do not depend on the order of the two scopes.
#
# The row after a scope is the first pass of that target. This row shows that
# the scope is not empty. The label of a scope comes from the same function as
# the label of an LLVM part. The checks above already read that label. A rule
# around the name keeps the scope apart from the host passes, which are at the
# same depth.
# CHECK_MLIR: MLIR pass timing (--mlir-timing)
# CHECK_MLIR: ===--- offload
# CHECK_MLIR-NEXT: ElaborateGenerators
# CHECK_MLIR: ===--- offload
# CHECK_MLIR-NEXT: ElaborateGenerators

# The tree display gives one `ElaborateGenerators` row for each pipeline. The
# list display gives one row for all of them. The CHECK_LIST-NOT line covers
# the report after the first row, so the two lines together permit one row
# only. The lines give no target name, and they do not depend on the order of
# the rows, which the list display sorts by time.
# CHECK_LIST: MLIR pass timing (--mlir-timing)
# CHECK_LIST: ElaborateGenerators
# CHECK_LIST-NOT: ElaborateGenerators


from std.compile import compile_info
from max.gpu.host.info import A100, MI355X
from std.sys.info import CompilationTarget


def add_one(x: Pointer[Int32, MutAnyOrigin]):
    x[] = x[] + 1


def main():
    print(
        compile_info[
            add_one,
            emission_kind="asm",
            target=A100.target,
        ]()
    )
    print(
        compile_info[
            add_one,
            emission_kind="asm",
            target=MI355X.target,
        ]()
    )
