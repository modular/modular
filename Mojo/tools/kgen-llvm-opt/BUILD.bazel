load("//bazel:api.bzl", "modular_cc_binary")

package(default_visibility = ["//Mojo:consumers"])

modular_cc_binary(
    name = "kgen-llvm-opt",
    srcs = glob(["*.cpp"]),
    dynamic_deps = [
        "@llvm-project//llvm:LLVM",
        "//MLRT:Driver/Compilation",
        "//Support:Globals",
    ],
    deps = [
        "//Config",
        "//Mojo:Compiler",
        "//Mojo:ObjectCompiler",
        "//Mojo:ToolCommon",
        "//Support:Base",
        "//Support:Globals.static",
        "@llvm-project//llvm:Plugins",
        "@llvm-project//llvm:Support",
    ],
)
