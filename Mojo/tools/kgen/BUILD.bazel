load("//bazel:api.bzl", "modular_cc_binary")
load("//bazel:tablegen.bzl", "driver_option_tablegen")

package(default_visibility = ["//Mojo:consumers"])

driver_option_tablegen(
    name = "KGEN",
    srcs = ["KGENOptions.td"],
    manual_name = "kgen",
    markdown_name = "kgen",
    td_file = "KGENOptions.td",
    deps = ["//Mojo/tools/mojo:MojoDescriptionTdFiles"],
)

modular_cc_binary(
    name = "kgen",
    srcs = glob(["*.cpp"]),
    dynamic_deps = [
        "@llvm-project//llvm:LLVM",
        "//AsyncRT:RuntimeGlobals",
        "//MLRT:Driver/Runtime",
        "//Support:Globals",
        "@llvm-project//mlir:MLIR",
    ],
    linkopts = select({
        "@platforms//os:linux": [
            "-Wl,--export-dynamic-symbol=__jit_debug_*",
            "-Wl,--export-dynamic-symbol=mlir*",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":KGEN.inc_files",
        "//:accel_registration",
        "//AsyncRT:Runtime",
        "//AsyncRT:RuntimeGlobals.static",
        "//Config",
        "//Init",
        "//Mojo:Compiler",
        "//Mojo:ExecutionEngine",
        "//Mojo:KGENDialect",
        "//Mojo:MojoParser",
        "//Mojo:MojoTooling",
        "//Mojo:ObjectCompiler",
        "//Mojo:Pipeline",
        "//Mojo:Precompile",
        "//Mojo:Support",
        "//Mojo:SupportForceLinkMLIRC",
        "//Mojo:TargetTraits",
        "//Mojo:ToolCommon",
        "//Support:Base",
        "//Support:Compiler",
        "//Support:Driver",
        "//Support:Filesystem",
        "//Support:Globals.static",
        "//Support:MArchTarget",
        "//Support:MDialect",
        "@llvm-project//mlir:BytecodeWriter",
    ],
)
