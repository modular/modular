    dialect = "debuginfo",
    td_file = "include/Support/DebugInfoDialect/IR/DebugInfo.td",
    deps = [
        ":Base",
        ":DebugInfoTdFiles",
        "@llvm-project//mlir:BuiltinDialectTdFiles",
    ],
)

gentbl_cc_library(
    name = "DebugInfoTypeInterfaces",
    includes = ["include"],
    strip_include_prefix = "include",
    tbl_outs = [
        (
            [
                "-gen-op-interface-decls",
            ],
            "include/Support/DebugInfoDialect/IR/DebugInfoInterfaces.h.inc",
        ),
        (
            [
                "-gen-op-interface-defs",
            ],
            "include/Support/DebugInfoDialect/IR/DebugInfoInterfaces.cpp.inc",
        ),
    ],
    tblgen = "@llvm-project//mlir:mlir-tblgen",
    td_file = "include/Support/DebugInfoDialect/IR/DebugInfoInterfaces.td",
    deps = [
        ":Base",
        ":DebugInfoTdFiles",
        "@llvm-project//mlir:BuiltinDialectTdFiles",
    ],
)

