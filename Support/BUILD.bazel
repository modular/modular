# Always link and expose the FallbackTypeIDResolver::registerImplicitTypeID
# function. This is used by downstream libraries to decide whether MLIR types
# in different SOs are the same type or not.
#
# See https://github.com/llvm/llvm-project/pull/126999#issuecomment-2661526333
# for more details and breadcrumbs.
cc_autolink_deps(
    name = "mlir-typeid-registry",
    deps = [
        "@llvm-project//mlir:Support",
    ],
)

modular_shared_library(
    name = "Globals",
    srcs = glob(["lib/Globals/*.cpp"]),
    hdrs = glob(["include/Support/Globals/*.h"]) + [
        "include/Support/SymbolExport.h",
    ],
    output_name = "MSupportGlobals",
    deps = [
        ":mlir-typeid-registry",
        "@llvm-project//mlir:Support",
    ],
    # TODO: Missing define conditionals for symbol visibility
    # NOTE: This library should not have any deps to avoid shared object linking issues
)

modular_cc_library(
    name = "Diagnostics",
    srcs = glob(["lib/Diagnostics/**/*.cpp"]),
    hdrs = glob(["include/Support/Diagnostics/**/*.h"]) + [
        "include/Support/LLVMForwardDecls.h",
        "include/Support/LogicalResult.h",
    ],
    deps = ["@llvm-project//mlir:IR"],
)

modular_cc_library(
    name = "CPython",
    srcs = glob(["lib/CPython/*.cpp"]),
    hdrs = glob(["include/Support/CPython/*.h"]),
    # Intentionally propagated so it cannot be used with nanobind
    defines = ["Py_LIMITED_API=0x03090000"],
    deps = [
        "@llvm-project//llvm:Support",
        "@python_3_9//:python_headers",
    ],
)

modular_nanobind_library(
    name = "CPythonNanobind",
    srcs = glob(["lib/CPython/*.cpp"]),
    hdrs = glob(["include/Support/CPython/*.h"]),
    # NOTE: python headers are still version dependent
    local_defines = ["Py_LIMITED_API=0x03090000"],
    deps = [
        "@llvm-project//llvm:Support",
    ],
)

mlir_nanobind(
    name = "MDialectNanobindInc",
    srcs = glob(["include/Support/MDialect/*.td"]),
    output_dir = "include/Support/MDialect/Nanobind",
    visibility = ["//visibility:public"],
    deps = [
        ":MTdFiles",
    ],
)
