MODULAR_TELEMETRY_COPTS = [
    "-DWITH_OTLP_HTTP=ON",
    "-DENABLE_HTTP_SSL_PREVIEW=ON",
    "-DENABLE_OTLP_HTTP_SSL_PREVIEW=ON",
    "-Wno-global-constructors",  # Avoid errors coming from opentelemetry
]

cc_library(
    name = "Telemetry",
    srcs = glob(["lib/Telemetry/**/*.cpp"]),
    hdrs = glob(["include/Support/Telemetry/**/*.h"]),
    copts = MODULAR_TELEMETRY_COPTS,
    defines = [
        # FIXME(amscanne): These configurations should be removed. We
        # unilaterally set sensible configurations for now.
        "MODULAR_ENABLE_TELEMETRY",
        "HAVE_CPP_STDLIB",
    ] + select({
        "//:ProdBuild": [
            'MODULAR_TELEMETRY_URL=\\"https://telemetry.modular.com:443\\"',
        ],
        "//:DevBuild": [
            'MODULAR_TELEMETRY_URL=\\"https://telemetry-dev.modular.com:443\\"',
        ],
    }),
    strip_include_prefix = "include",
    deps = [
        ":Base",
        ":Configuration",
        ":Entitlements",
        ":MArchTarget",
        ":Settings",
        "@io_opentelemetry_cpp//api",
        "@io_opentelemetry_cpp//exporters/ostream:ostream_log_record_exporter",
        "@io_opentelemetry_cpp//exporters/ostream:ostream_metric_exporter",
        "@io_opentelemetry_cpp//exporters/otlp:otlp_grpc_exporter",
        "@io_opentelemetry_cpp//exporters/otlp:otlp_grpc_log_record_exporter",
        "@io_opentelemetry_cpp//exporters/otlp:otlp_grpc_metric_exporter",
        "@io_opentelemetry_cpp//exporters/otlp:otlp_http_exporter",
        "@io_opentelemetry_cpp//exporters/otlp:otlp_http_log_record_exporter",
        "@io_opentelemetry_cpp//exporters/otlp:otlp_http_metric_exporter",
        "@io_opentelemetry_cpp//sdk:headers",
    ],
)

