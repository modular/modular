#ifndef DECLARE_FLOAT
#error "FloatTypes.def must be used with DECLARE_FLOAT macro"
#endif // DECLARE_FLOAT

// Format is DECLARE_FLOAT(SHORT_NAME, LONG_NAME, M_TYPE, MLIR_TYPE, CXX_TYPE,
//                         APFLOAT_SEMANTICS, ...)

// The Float8 types.

DECLARE_FLOAT(f8e3m4,                   // SHORT_NAME
              float8_e3m4,              // LONG_NAME
              M_FLOAT8_E3M4,            // M_TYPE
              mlir::Float8E3M4Type,     // MLIR_TYPE
              M::Float8::float8_e3m4_t, // CXX_TYPE
              APFloat::Float8E3M4)      // APFLOAT_SEMANTICS

DECLARE_FLOAT(f8e4m3fn,                   // SHORT_NAME
              float8_e4m3fn,              // LONG_NAME
              M_FLOAT8_E4M3FN,            // M_TYPE
              mlir::Float8E4M3FNType,     // MLIR_TYPE
              M::Float8::float8_e4m3fn_t, // CXX_TYPE
              APFloat::Float8E4M3FN)      // APFLOAT_SEMANTICS

DECLARE_FLOAT(f8e4m3fnuz,                   // SHORT_NAME
              float8_e4m3fnuz,              // LONG_NAME
              M_FLOAT8_E4M3FNUZ,            // M_TYPE
              mlir::Float8E4M3FNUZType,     // MLIR_TYPE
              M::Float8::float8_e4m3fnuz_t, // CXX_TYPE
              APFloat::Float8E4M3FNUZ)      // APFLOAT_SEMANTICS

DECLARE_FLOAT(f8e5m2,                   // SHORT_NAME
              float8_e5m2,              // LONG_NAME
              M_FLOAT8_E5M2,            // M_TYPE
              mlir::Float8E5M2Type,     // MLIR_TYPE
              M::Float8::float8_e5m2_t, // CXX_TYPE
              APFloat::Float8E5M2)      // APFLOAT_SEMANTICS

DECLARE_FLOAT(f8e5m2fnuz,                   // SHORT_NAME
              float8_e5m2fnuz,              // LONG_NAME
              M_FLOAT8_E5M2FNUZ,            // M_TYPE
              mlir::Float8E5M2FNUZType,     // MLIR_TYPE
              M::Float8::float8_e5m2fnuz_t, // CXX_TYPE
              APFloat::Float8E5M2FNUZ)      // APFLOAT_SEMANTICS

// The Float16 types.
DECLARE_FLOAT(f16,                   // SHORT_NAME
              float16,               // LONG_NAME
              M_FLOAT16,             // M_TYPE
              mlir::Float16Type,     // MLIR_TYPE
              M::Float16::float16_t, // CXX_TYPE
              APFloat::IEEEhalf)     // APFLOAT_SEMANTICS

DECLARE_FLOAT(bf16,                  // SHORT_NAME
              bfloat16,              // LONG_NAME
              M_BFLOAT16,            // M_TYPE
              mlir::BFloat16Type,    // MLIR_TYPE
              M::BFloat::bfloat16_t, // CXX_TYPE
              APFloat::BFloat)       // APFLOAT_SEMANTICS

// The Float32 type.
DECLARE_FLOAT(f32,                 // SHORT_NAME
              float32,             // LONG_NAME
              M_FLOAT32,           // M_TYPE
              mlir::Float32Type,   // MLIR_TYPE
              float,               // CXX_TYPE
              APFloat::IEEEsingle) // APFLOAT_SEMANTICS

// The Float64 type.
DECLARE_FLOAT(f64,                 // SHORT_NAME
              float64,             // LONG_NAME
              M_FLOAT64,           // M_TYPE
              mlir::Float64Type,   // MLIR_TYPE
              double,              // CXX_TYPE
              APFloat::IEEEdouble) // APFLOAT_SEMANTICS
