load("//bazel:api.bzl", "modular_py_library", "modular_py_test", "pkg_files", "strip_prefix")

modular_py_library(
    name = "support",
    srcs = glob(["modular/**/*.py"]),
    data = ["modular/utils/debuglib/py.typed"],
    imports = ["."],
    visibility = ["//visibility:public"],
)

modular_py_test(
    name = "unittests",
    srcs = glob(["tests/**/*.py"]),
    args = ["--doctest-modules"],
    deps = [
        ":support",
    ],
)

pkg_files(
    name = "support_utils_files",
    srcs = glob(["**"]),
    prefix = "modular",
    strip_prefix = strip_prefix.from_pkg(""),
    visibility = ["//visibility:public"],
)
