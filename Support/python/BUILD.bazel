load("@pip_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library")
load("//bazel:api.bzl", "modular_py_test")

filegroup(
    name = "cfg",
    srcs = [
        "README.md",
        "modular/utils/version.py",
        "setup.py",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "support",
    srcs = glob(["modular/**/*.py"]),
    data = ["modular/utils/debuglib/py.typed"],
    imports = ["."],
    visibility = ["//visibility:public"],
    deps = [
        requirement("find_libpython"),
        requirement("numpy"),
        requirement("pyyaml"),
        requirement("ruamel.yaml"),
    ],
)

modular_py_test(
    name = "unittests",
    srcs = glob(["tests/**/*.py"]),
    args = ["--doctest-modules"],
    tags = ["requires-network"],
    deps = [
        ":support",
    ],
)
