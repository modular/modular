load("//bazel:api.bzl", "modular_cc_binary")

package(
    default_visibility = ["//visibility:public"],
    features = [
        "layering_check",
        "parse_headers",
    ],
)

modular_cc_binary(
    name = "system-info",
    srcs = glob(["*.cpp"]),
    dynamic_deps = [
        "@llvm-project//llvm:LLVM",
        "//Support:Globals",
    ],
    deps = [
        "//Support:Base",
        "//Support:Globals.static",
        "//Support:MArchTarget",
        "//Support:MArchTargetMinimal",
        "//Support:MDialect",
        "@llvm-project//llvm:Support",
        "@llvm-project//llvm:TargetParser",
    ],
)
