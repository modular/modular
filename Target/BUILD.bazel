modular_cc_binary(
    name = "MetalPlugin.so",
    srcs = glob([
        "lib/Metal/*.cpp",
        "lib/Metal/*.h",
    ]),
    # IOKit + CoreFoundation are used to read the AGXAccelerator
    # `gpu-core-count` for the MULTIPROCESSOR_COUNT device attribute.
    linkopts = select({
        "@platforms//os:macos": [
            "-Wl,-framework,IOKit",
            "-Wl,-framework,CoreFoundation",
        ],
        "//conditions:default": [],
    }),
    linkshared = True,
    linkstatic = False,
    visibility = ["//visibility:public"],
    deps = [
        ":Support",
        "//SDK:HAL",
        "//Support:Base",
        "@dlpack",
        "@metal-cpp//:metal-cpp",
        "@tl_expected",
    ],
)

