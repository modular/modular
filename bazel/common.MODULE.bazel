# .........................CUDA Driver and NVML ...............................

# Provide CUDA driver and NVML headers to projects requiring these defs.
# NVIDIA bundles the CUDA Driver header (cuda.h) inside the cuda_cudart
# redistributable.  Consumers (e.g. Tracy, CUPTI) may use the
# cuda_runtime_headers target for runtime API headers; libcudart.so is NOT
# linked directly — Tracy loads it on demand via a dlopen stub.

# Note that this does NOT package CUDA artifacts into our releases. The rules
# below are purely to make artifacts of interest available within Bazel's
# hermetic build-paths. On target systems, our stack picks up the libcuda.so
# preinstalled by sysadmins.

# See //bazel/third-party/BUILD.bazel for selection between x86_64 and aarch64.

NVML_VERSION = "13.1.115"

http_archive(
    name = "nvml_x86_64",
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "nvml_headers",
    hdrs = ["include/nvml.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)""",
    sha256 = "88fe69c3b2e73d414eea2101813ae5819b0f7c9a1c5e4e98fb44e1ef88748c7d",
    strip_prefix = "cuda_nvml_dev-linux-x86_64-{}-archive".format(NVML_VERSION),
    url = "https://developer.download.nvidia.com/compute/cuda/redist/cuda_nvml_dev/linux-x86_64/cuda_nvml_dev-linux-x86_64-{}-archive.tar.xz".format(NVML_VERSION),
)

http_archive(
    name = "nvml_sbsa",  # 64b ARM
    build_file_content = """
load("@rules_cc//cc:defs.bzl", "cc_library")
cc_library(
    name = "nvml_headers",
    hdrs = ["include/nvml.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)""",
    sha256 = "9e27291f5a70dbb03c102a75c94423b4748e2d05c54134a61ab638d41570d8b7",
    strip_prefix = "cuda_nvml_dev-linux-sbsa-{}-archive".format(NVML_VERSION),
    url = "https://developer.download.nvidia.com/compute/cuda/redist/cuda_nvml_dev/linux-sbsa/cuda_nvml_dev-linux-sbsa-{}-archive.tar.xz".format(NVML_VERSION),
)

