# libkineto is the on-demand CPU+GPU profiler MAX uses to emit Chrome trace
# JSON for HTA / Dynolog IPC capture (MXTOOLS-190). We pin to the exact SHA
# bundled with torch==2.12.0+cu130 because the PyTorch/HTA/libkineto/Dynolog
# compatibility chain at that pairing is empirically validated end-to-end
# (see MXTOOLS-190 initial spike). The accompanying
# bazel/public-patches/libkineto.BUILD wires up the CUPTI / CUDA Toolkit deps
# and exposes the cc_library target.
http_archive(
    name = "libkineto",
    build_file = "//bazel/public-patches:libkineto.BUILD",
    patch_args = ["-p1"],
    patches = [
        # Emit "Record Window End" on the (-1, 0) overhead track with thread
        # scope so it stops spawning an Unnamed SliceTrack in Perfetto. Covers
        # daemon-written (Dynolog) traces, which bypass the post-write fixup
        # in max/internal/profiler/lib/Range.cpp (MXTOOLS-266).
        "//bazel/public-patches:libkineto-record-window-end-track.patch",
    ],
    sha256 = "7615b3c028b3148d046ba7a34b890d9bf90e5178024c7b749b5018366fc9e631",
