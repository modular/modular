From 0b9ee8f4d40044274c7b3b683ac5abf33c2faeb6 Mon Sep 17 00:00:00 2001
From: Nicolas Miller <nicolas.pierre.miller@gmail.com>
Date: Mon, 9 Nov 2026 17:52:00 +0000
Subject: [PATCH] [Hexagon] Don't convert a redefined half of a refilled qf
 pair

Before a qf vector pair is spilled, the pass converts it to IEEE. After
the refill, it converts both halves back to qf before an instruction
that needs qf input, such as V6_vconv_hf_qf32.

If one half is redefined between the refill and that instruction, that
half no longer holds the refilled value. When the new value is already
qf, converting it again gives a wrong result.

Only convert the halves that still hold the refilled value. A redefined
half is converted only if its own def is IEEE, for example another
refill.

Assisted-by: AI
---
 .../Target/Hexagon/HexagonPostRAHandleQFP.cpp | 20 ++++-
 .../qfp-handle-pair-refill-partial.mir        | 88 +++++++++++++++++++
 2 files changed, 105 insertions(+), 3 deletions(-)
 create mode 100644 llvm/test/CodeGen/Hexagon/qfp-handle-pair-refill-partial.mir

diff --git a/llvm/lib/Target/Hexagon/HexagonPostRAHandleQFP.cpp b/llvm/lib/Target/Hexagon/HexagonPostRAHandleQFP.cpp
index b6f63f83f5e6..29aaebffba2b 100644
--- a/llvm/lib/Target/Hexagon/HexagonPostRAHandleQFP.cpp
+++ b/llvm/lib/Target/Hexagon/HexagonPostRAHandleQFP.cpp
@@ -960,9 +960,23 @@ void HexagonPostRAHandleQFP::collectConvQFInstr(NodeAddr<DefNode *> &RegDef) {
         if (QFNonSatMIs.contains(QFConvInstr))
           Op = QFNonSatMIs[QFConvInstr];
 
-        // Def is double type
-        if (Hexagon::HvxWRRegClass.contains(DefReg))
-          Op = ConvOperand::HiLo;
+        // Def is double type.
+        if (Hexagon::HvxWRRegClass.contains(DefReg)) {
+          // Don't convert lo or hi parts if they were re-defined after the def.
+          unsigned Redef = ConvOperand::Undefined;
+          for (NodeAddr<UseNode *> U :
+               UseStmt.Addr->members_if(DFG->IsUse, *DFG)) {
+            NodeId RD = U.Addr->getReachingDef();
+            if (RD == 0 || RD == RegDef.Id)
+              continue;
+            RegisterId R = DFG->addr<DefNode *>(RD).Addr->getRegRef(*DFG).Id;
+            if (R == HRI->getSubReg(UseReg, Hexagon::vsub_lo))
+              Redef |= ConvOperand::Lo;
+            else if (R == HRI->getSubReg(UseReg, Hexagon::vsub_hi))
+              Redef |= ConvOperand::Hi;
+          }
+          Op |= ConvOperand::HiLo & ~Redef;
+        }
         // Def is lo of double type
         else if (DefReg == HRI->getSubReg(UseReg, Hexagon::vsub_lo))
           Op |= ConvOperand::Lo;
diff --git a/llvm/test/CodeGen/Hexagon/qfp-handle-pair-refill-partial.mir b/llvm/test/CodeGen/Hexagon/qfp-handle-pair-refill-partial.mir
new file mode 100644
index 000000000000..b26bfad68b21
--- /dev/null
+++ b/llvm/test/CodeGen/Hexagon/qfp-handle-pair-refill-partial.mir
@@ -0,0 +1,88 @@
+# RUN: llc -mtriple=hexagon -mcpu=hexagonv81 -mattr=+hvxv81,+hvx-length128b,+hvx-qfloat \
+# RUN:   -run-pass=handle-qfp-spills-refills -verify-machineinstrs -o - %s | FileCheck %s
+#
+# A qf32 vector pair is spilled and refilled, then one half is redefined
+# before the pair is narrowed from qf32 to hf. The refill only reaches the
+# other half, so the refill only needs a qf32 = sf conversion on that half.
+# The redefined half needs one only if its own def is IEEE.
+
+# The lo half is redefined with a qf32 value and must not be converted.
+# CHECK-LABEL: name: pair_refill_lo_redefined
+# CHECK:       $w3 = PS_vloadrw_ai %stack.0, 0
+# CHECK-NEXT:  $v6 = V6_vadd_sf
+# CHECK-NEXT:  $v7 = V6_vconv_qf32_sf
+# CHECK-NEXT:  $v3 = V6_vconv_hf_qf32
+
+# The hi half is redefined with a qf32 value and must not be converted.
+# CHECK-LABEL: name: pair_refill_hi_redefined
+# CHECK:       $w3 = PS_vloadrw_ai %stack.0, 0
+# CHECK-NEXT:  $v7 = V6_vadd_sf
+# CHECK-NEXT:  $v6 = V6_vconv_qf32_sf
+# CHECK-NEXT:  $v3 = V6_vconv_hf_qf32
+
+# The lo half is redefined by a refill, so it is IEEE and both halves are
+# converted.
+# CHECK-LABEL: name: pair_refill_lo_refilled
+# CHECK:       $w3 = PS_vloadrw_ai %stack.0, 0
+# CHECK-NEXT:  $v6 = PS_vloadrv_ai %stack.1, 0
+# CHECK-NEXT:  $v6 = V6_vconv_qf32_sf
+# CHECK-NEXT:  $v7 = V6_vconv_qf32_sf
+# CHECK-NEXT:  $v3 = V6_vconv_hf_qf32
+
+---
+name:            pair_refill_lo_redefined
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: spill-slot, size: 256, alignment: 128 }
+body:             |
+  bb.0:
+    liveins: $r0, $r31, $v0, $v1, $v2
+
+    renamable $v7 = V6_vadd_sf renamable $v0, renamable $v0
+    renamable $v6 = V6_vadd_sf renamable $v1, renamable $v0
+    PS_vstorerw_ai %stack.0, 0, killed renamable $w3 :: (store (s2048) into %stack.0, align 128)
+    renamable $w3 = PS_vloadrw_ai %stack.0, 0 :: (load (s2048) from %stack.0, align 128)
+    renamable $v6 = V6_vadd_sf killed renamable $v2, renamable $v0
+    renamable $v3 = V6_vconv_hf_qf32 killed renamable $w3
+    V6_vS32b_ai killed renamable $r0, 0, killed renamable $v3 :: (store (s1024))
+    PS_jmpret $r31, implicit-def dead $pc
+...
+---
+name:            pair_refill_hi_redefined
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: spill-slot, size: 256, alignment: 128 }
+body:             |
+  bb.0:
+    liveins: $r0, $r31, $v0, $v1, $v2
+
+    renamable $v7 = V6_vadd_sf renamable $v0, renamable $v0
+    renamable $v6 = V6_vadd_sf renamable $v1, renamable $v0
+    PS_vstorerw_ai %stack.0, 0, killed renamable $w3 :: (store (s2048) into %stack.0, align 128)
+    renamable $w3 = PS_vloadrw_ai %stack.0, 0 :: (load (s2048) from %stack.0, align 128)
+    renamable $v7 = V6_vadd_sf killed renamable $v2, renamable $v0
+    renamable $v3 = V6_vconv_hf_qf32 killed renamable $w3
+    V6_vS32b_ai killed renamable $r0, 0, killed renamable $v3 :: (store (s1024))
+    PS_jmpret $r31, implicit-def dead $pc
+...
+---
+name:            pair_refill_lo_refilled
+tracksRegLiveness: true
+stack:
+  - { id: 0, type: spill-slot, size: 256, alignment: 128 }
+  - { id: 1, type: spill-slot, size: 128, alignment: 128 }
+body:             |
+  bb.0:
+    liveins: $r0, $r31, $v0, $v1, $v2
+
+    renamable $v7 = V6_vadd_sf renamable $v0, renamable $v0
+    renamable $v6 = V6_vadd_sf renamable $v1, renamable $v0
+    PS_vstorerw_ai %stack.0, 0, killed renamable $w3 :: (store (s2048) into %stack.0, align 128)
+    renamable $v6 = V6_vadd_sf killed renamable $v2, renamable $v0
+    PS_vstorerv_ai %stack.1, 0, killed renamable $v6 :: (store (s1024) into %stack.1, align 128)
+    renamable $w3 = PS_vloadrw_ai %stack.0, 0 :: (load (s2048) from %stack.0, align 128)
+    renamable $v6 = PS_vloadrv_ai %stack.1, 0 :: (load (s1024) from %stack.1, align 128)
+    renamable $v3 = V6_vconv_hf_qf32 killed renamable $w3
+    V6_vS32b_ai killed renamable $r0, 0, killed renamable $v3 :: (store (s1024))
+    PS_jmpret $r31, implicit-def dead $pc
+...
