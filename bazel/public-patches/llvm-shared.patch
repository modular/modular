 load(":tblgen.bzl", "gentbl_cc_library", "gentbl_sharded_op_defs", "gentbl_sharded_ops", "td_library")
 
@@ -5363,14 +5366,61 @@ cc_library(
     ],
 )
 
+# MLIR as a single shared library, like CMake's libMLIR (MLIR_LINK_MLIR_DYLIB),
+# so a process that loads several shared libraries built on MLIR has one copy
+# of its process-wide state. Linked against libLLVM under
+# --@llvm-project//llvm:link_llvm_dylib. Only direct deps are whole-archived,
+# so every library is listed in dylib.bzl rather than reached transitively.
+cc_shared_library(
+    name = "MLIR",
+    dynamic_deps = llvm_dylib_deps(),
+    exports_filter = ["//mlir:__subpackages__"],
+    tags = ["manual"],
+    # Like libLLVM: MLIR is built with default visibility, so without this
+    # every call within the library goes through the PLT.
+    user_link_flags = select({
+        "@platforms//os:linux": ["-Wl,-Bsymbolic-functions"],
+        "//conditions:default": [],
+    }),
+    deps = MLIR_DYLIB_LIBS,
+)
+
+# Narrow pieces of :Support for code that must not link MLIR's process-wide
+# state (the TypeID registry, StorageUniquer) just to use these. :Support lists
+# their headers too, so its dependents are unaffected.
+cc_library(
+    name = "SupportLLVM",
+    hdrs = ["include/mlir/Support/LLVM.h"],
+    includes = ["include"],
+    deps = ["//llvm:Support"],
+)
+
+cc_library(
+    name = "SupportFileUtilities",
+    srcs = ["lib/Support/FileUtilities.cpp"],
+    hdrs = ["include/mlir/Support/FileUtilities.h"],
+    includes = ["include"],
+    # Stateless, so each shared library may carry its own copy.
+    tags = ["LINKABLE_MORE_THAN_ONCE"],
+    deps = [
+        ":SupportLLVM",
+        "//llvm:Support",
+    ],
+)
+
 cc_library(
     name = "Support",
-    srcs = glob([
-        "lib/Support/*.cpp",
-    ]),
+    srcs = glob(
+        ["lib/Support/*.cpp"],
+        exclude = ["lib/Support/FileUtilities.cpp"],
+    ),
     hdrs = glob(["include/mlir/Support/*.h"]),
     includes = ["include"],
-    deps = ["//llvm:Support"],
+    deps = [
+        ":SupportFileUtilities",
+        ":SupportLLVM",
+        "//llvm:Support",
+    ],
 )
 
 cc_library(
