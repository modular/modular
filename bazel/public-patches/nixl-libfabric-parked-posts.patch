+    const auto timeout = postRetryTimeout();
+    return timeout.count() > 0 && std::chrono::steady_clock::now() - destination.last_progress >=
+        std::min(kParkedLimitGrace, timeout);
+}
+
+void
+nixlLibfabricRail::holdPost(const nixlLibfabricPostRequest &pr) {
+    // as in parkPost(), the post held back may have been the one meant to ring the doorbell
+    if (doorbell_owed_) {
+        ring_next_post_ = true;
+    }
+    held_post_ = pr;
+}
+
+void
+nixlLibfabricRail::countLimitFailures(size_t unparked, size_t cleared, fi_addr_t dest_addr) {
+    if (limit_unparked_ == 0 && limit_cleared_ == 0) {
+        limit_failures_since_ = std::chrono::steady_clock::now();
+    }
+    limit_unparked_ += unparked;
+    limit_cleared_ += cleared;
+    limit_last_addr_ = dest_addr;
+}
+
+void
+nixlLibfabricRail::reportLimitFailures() {
+    const auto now = std::chrono::steady_clock::now();
+    if ((limit_unparked_ == 0 && limit_cleared_ == 0) ||
+        now - limit_failures_reported_ < kLimitFailureReportInterval) {
+        return;
+    }
+    NIXL_ERROR << "Rail " << rail_id << " failed " << limit_unparked_
+               << " new posts without parking them and " << limit_cleared_
+               << " parked posts to make room in the last "
+               << std::chrono::duration_cast<std::chrono::milliseconds>(now -
+                                                                        limit_failures_since_)
+                      .count()
+               << " ms, because it held as many parked posts as it allows and their "
+                  "destinations, most recently fi_addr "
+               << limit_last_addr_ << ", had taken none for "
+               << std::min(kParkedLimitGrace, postRetryTimeout()).count()
+               << " ms, most likely because those peers never answered their handshakes";
+    limit_unparked_ = 0;
+    limit_cleared_ = 0;
+    limit_failures_reported_ = now;
+}
+
+bool
+nixlLibfabricRail::makeParkingRoom() {
+    if (parked_count_ < parked_limit_) {
+        return true;
+    }
+    // retrying forever means parked posts never fail, so the rail can only wait for room
+    const auto timeout = postRetryTimeout();
+    if (timeout.count() == 0) {
+        return false;
+    }
+    expireParkedPosts(std::min(kParkedLimitGrace, timeout), true);
+    return parked_count_ < parked_limit_;
+}
+
+void
+nixlLibfabricRail::retryParkedPosts(int &current_cuda_device, int &posted) {
+    // Serve the destinations one post at a time in rounds, starting just after the one that
+    // took the last post, so that when the provider frees only a few slots a destination
+    // with a long backlog cannot take them all and leave a healthy one to expire. Ordering
+    // by address keeps that rotation fair while destinations come and go. A destination
+    // whose head is refused sits out the rest of the pass, because its later posts would
+    // only be refused for the same reason.
+    std::vector<std::pair<fi_addr_t, parkedDestination *>> order;
+    order.reserve(parked_.size());
+    for (auto &[dest_addr, destination] : parked_) {
+        order.emplace_back(dest_addr, &destination);
+    }
+    if (order.empty()) {
+        return;
+    }
+    std::sort(order.begin(), order.end(), [](const auto &a, const auto &b) {
+        return a.first < b.first;
+    });
+    const auto first = std::upper_bound(
+        order.begin(), order.end(), parked_cursor_, [](fi_addr_t cursor, const auto &entry) {
+            return cursor < entry.first;
+        });
+    std::rotate(order.begin(), first, order.end());
+    std::vector<bool> refused(order.size(), false);
+
+    bool moved = true;
+    while (moved) {
+        moved = false;
+        for (size_t i = 0; i < order.size(); ++i) {
+            parkedDestination &destination = *order[i].second;
+            if (refused[i] || destination.posts.empty()) {
+                continue;
+            }
+
+            const nixlLibfabricPostRequest &head = destination.posts.front();
+            if (bindPostDevice(head, current_cuda_device)) {
+                const int ret = submitPost(head, true);
+                if (ret == -FI_EAGAIN) {
+                    refused[i] = true;
+                    continue;
+                }
+                if (ret != 0) {
+                    NIXL_ERROR << "drainPostQueue: parked post failed ret=" << ret << " ("
+                               << fi_strerror(-ret) << ") on rail " << rail_id;
+                    failPost(head, NIXL_ERR_BACKEND);
+                } else {
+                    // stamped now rather than at the start of the pass, which a handshake
+                    // reply sent from a completion callback can stretch past the bound
+                    destination.last_progress = std::chrono::steady_clock::now();
+                    parked_cursor_ = order[i].first;
+                    if (!destination.took_post) {
+                        destination.took_post = true;
+                        NIXL_INFO << "fi_addr " << order[i].first << " on rail " << rail_id
+                                  << " took a post "
+                                  << std::chrono::duration_cast<std::chrono::microseconds>(
+                                         destination.last_progress - destination.parked_since)
+                                         .count()
+                                  << " us after the provider first refused it";
+                    }
+                    if (++posted % POST_POLL_INTERLEAVE_RATIO == 0) {
+                        pollForCompletions();
+                    }
+                }
+            }
+            destination.posts.pop_front();
+            --parked_count_;
+            moved = true;
+        }
+    }
+
+    expireParkedPosts(postRetryTimeout(), false);
+}
+
+void
+nixlLibfabricRail::expireParkedPosts(std::chrono::milliseconds bound, bool at_limit) {
+    const auto now = std::chrono::steady_clock::now();
+    for (auto it = parked_.begin(); it != parked_.end();) {
+        parkedDestination &destination = it->second;
+
+        // A destination that has taken no post for the whole bound is most likely a peer that
+        // will never answer its handshake, and its later posts would only wait behind the
+        // same refusal, so fail every post parked for it.
+        if (bound.count() > 0 && !destination.posts.empty() &&
+            now - destination.last_progress >= bound) {
+            const size_t expired = destination.posts.size();
+            for (const nixlLibfabricPostRequest &post : destination.posts) {
+                failPost(post, NIXL_ERR_BACKEND);
+            }
+            destination.posts.clear();
+            parked_count_ -= expired;
+            if (at_limit) {
+                countLimitFailures(0, expired, it->first);
+            } else {
+                NIXL_ERROR << "Failed " << expired << " posts to fi_addr " << it->first
+                           << " on rail " << rail_id << " after the provider took none for "
+                           << bound.count()
+                           << " ms, most likely because the peer never answered its handshake";
+            }
+        }
+
+        it = destination.posts.empty() ? parked_.erase(it) : std::next(it);
+    }
+}
+
+void
+nixlLibfabricRail::parkPost(const nixlLibfabricPostRequest &pr,
+                            std::chrono::steady_clock::time_point refused_at) {
+    // A batch's FI_MORE writes are held until a post without it, and this may have been that
+    // post, so make sure the next one the rail accepts rings the doorbell.
+    if (doorbell_owed_) {
+        ring_next_post_ = true;
+    }
+
+    auto [it, inserted] = parked_.try_emplace(pr.dest_addr);
+    if (inserted) {
+        it->second.parked_since = refused_at;
+        it->second.last_progress = refused_at;
+    }
+    it->second.posts.push_back(pr);
+    ++parked_count_;
+}
+
+bool
+nixlLibfabricRail::hasParkedPosts() const {
+    return parked_count_ > 0 || held_post_.has_value();
+}
+
+void
+nixlLibfabricRail::failParkedPosts() {
+    size_t failed = parked_count_;
+    for (const auto &[dest_addr, destination] : parked_) {
+        for (const nixlLibfabricPostRequest &post : destination.posts) {
+            failPost(post, NIXL_ERR_BACKEND);
+        }
+    }
+    parked_.clear();
+    parked_count_ = 0;
+    if (held_post_) {
+        failPost(*held_post_, NIXL_ERR_BACKEND);
+        held_post_.reset();
+        ++failed;
+    }
+
+    NIXL_ERROR << "Failed " << failed << " parked posts on rail " << rail_id
+               << " without another attempt, because no local memory is registered on it";
+}
+
+bool
+nixlLibfabricRail::bindPostDevice(const nixlLibfabricPostRequest &pr, int &current_cuda_device) {
+#if HAVE_CUDA
+    if (pr.is_cuda_vram) {
+        // The engine is not asked to set the context in workaround mode yet, because that
+        // needs a larger refactor upstream, so the device is set with cudaSetDevice() when needed
+        bool use_cuda_addr_wa = false;
+        nixl_status_t status = LibfabricUtils::cudaSetCtx(use_cuda_addr_wa);
+        if (status != NIXL_SUCCESS) {
+            // completion is notified also for failed requests
+            // (otherwise counters would never match)
+            failPost(pr, status);
+
+            // the deferred request cannot be executed, so the caller moves on to the next
+            NIXL_ERROR << "Failed to set CUDA context, while posting deferred descriptor";
+            return false;
+        }
+
+        // otherwise set the CUDA device before the call when it changes
+        if (!use_cuda_addr_wa && pr.device_id != current_cuda_device) {
+            cudaError_t cuda_ret = cudaSetDevice(pr.device_id);
+            if (cuda_ret != cudaSuccess) {
+                // completion is notified also for failed requests
+                // (otherwise counters would never match)
+                failPost(pr, NIXL_ERR_BACKEND);
+
+                // the deferred request cannot be executed, so the caller moves on to the next
+                NIXL_ERROR << "Failed to set CUDA device " << pr.device_id
+                           << " while posting deferred descriptor: "
+                           << cudaGetErrorString(cuda_ret);
+                return false;
+            }
+            current_cuda_device = pr.device_id;
+        }
+    }
+#else
+    (void)pr;
+    (void)current_cuda_device;
+#endif
+    return true;
+}
+
+int
+nixlLibfabricRail::submitPost(const nixlLibfabricPostRequest &pr, bool parked) {
+    struct iovec iov{};
+    iov.iov_base = pr.local_addr;
+    iov.iov_len = pr.length;
+
+    struct fi_rma_iov rma_iov{};
+    rma_iov.addr = pr.remote_addr;
+    rma_iov.len = pr.length;
+    rma_iov.key = pr.remote_key;
+
+    void *desc = pr.local_desc;
+    struct fi_msg_rma msg = {};
+    msg.msg_iov = &iov;
+    msg.desc = &desc;
+    msg.iov_count = 1;
+    msg.addr = pr.dest_addr;
+    msg.rma_iov = &rma_iov;
+    msg.rma_iov_count = 1;
+    msg.context = &pr.req->ctx;
+
+    // A parked post no longer sits inside its batch, and a set aside post may have been the
+    // one meant to ring the doorbell, so either goes without FI_MORE and, once the provider
+    // takes it, rings the doorbell for the writes it holds.
+    uint64_t flags = pr.fi_flags;
+    if (parked || ring_next_post_) {
+        flags &= ~FI_MORE;
+    }
+
+    int ret;
+    if (pr.type == nixlLibfabricPostRequest::WRITE) {
+        msg.data = pr.immediate_data;
+        const std::lock_guard<std::mutex> ep_lock(ep_mutex_);
+        ret = fi_writemsg(endpoint, &msg, flags | FI_REMOTE_CQ_DATA);
+    } else {
+        const std::lock_guard<std::mutex> ep_lock(ep_mutex_);
+        ret = fi_readmsg(endpoint, &msg, flags);
+    }
+
+    if (ret == 0) {
+        doorbell_owed_ = (flags & FI_MORE) != 0;
+        if (!doorbell_owed_) {
+            ring_next_post_ = false;
+        }
+    }
+    return ret;
+}
+
+void
+nixlLibfabricRail::failPost(const nixlLibfabricPostRequest &pr, nixl_status_t status) {
+    // as in parkPost(), a failed post may have been the one meant to ring the doorbell
+    if (doorbell_owed_) {
+        ring_next_post_ = true;
+    }
+
+    // completion is notified also for failed requests
+    // (otherwise counters would never match)
+    if (pr.req && pr.req->completion_callback) {
+        pr.req->completion_callback(status);
+    }
+    if (pr.req) {
+        releaseRequest(pr.req);
+    }
+}
