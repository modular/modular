+    static const std::chrono::milliseconds timeout = [] {
+        constexpr std::chrono::milliseconds default_timeout(2000);
+        const char *env = getenv("NIXL_LIBFABRIC_POST_RETRY_TIMEOUT_MS");
+        if (!env || !*env) {
+            return default_timeout;
+        }
+        char *end = nullptr;
+        const long long ms = strtoll(env, &end, 10);
+        if (end == env || *end != '\0' || ms < 0) {
+            NIXL_WARN << "Ignoring invalid NIXL_LIBFABRIC_POST_RETRY_TIMEOUT_MS='" << env
+                      << "' and using " << default_timeout.count() << " ms";
+            return default_timeout;
