+void XMLToolCallingConverter::PropagateTightFraming(
+    const std::string& rule_name, const std::string& body
+) {
+  // Nothing is framed tightly until a bounded value registers, which is the common case.
+  if (tight_value_rules_.empty()) {
+    return;
+  }
+  // A union with a bounded alternative is framed tightly as a whole. Its other alternatives
+  // are scalars, which a parser that keeps framing whitespace would read verbatim as well.
+  size_t i = 0;
+  while (i < body.size()) {
+    unsigned char c = static_cast<unsigned char>(body[i]);
+    if (std::isalpha(c) || c == '_') {
+      size_t j = i;
+      while (j < body.size() &&
+             (std::isalnum(static_cast<unsigned char>(body[j])) || body[j] == '_')) {
+        ++j;
+      }
+      if (tight_value_rules_.count(body.substr(i, j - i)) > 0) {
+        tight_value_rules_.insert(rule_name);
+        return;
+      }
+      i = j;
+    } else if (c == '"') {
+      ++i;
+      while (i < body.size() && body[i] != '"') {
+        i += body[i] == '\\' ? 2 : 1;
+      }
+      ++i;
+    } else {
+      ++i;
+    }
+  }
