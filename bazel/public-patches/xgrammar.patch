+std::string RegexConverter::MakeCharClassJsonSafe(const std::string& char_class) {
+  // Only positive classes in a delimited JSON-string context need rewriting.
+  // Negated classes already exclude the forbidden set (appended at build time),
+  // and an empty forbidden set means this regex is not a string body.
+  if (forbidden_chars_.empty() || char_class.size() < 2 || char_class.front() != '[' ||
+      char_class.back() != ']' || char_class[1] == '^') {
+    return char_class;
+  }
+  auto is_unsafe = [&](TCodepoint c) {
+    return c <= 0x1F || c == '\\' || (c == '"' && quote_is_delim_);
+  };
+
+  const char* p = char_class.data() + 1;
+  const char* end = char_class.data() + char_class.size() - 1;
+
+  std::vector<std::string> escaped;  // escape-sequence terminals for unsafe points
+  std::string safe = "[";            // residual class of safe members
+  bool has_safe = false;
+
+  // Emit a class endpoint as a hex escape: safe members can include class-special
+  // characters (`]`, `\`, `^`, `-`, `[`) whose raw form would corrupt the EBNF
+  // class, and hex is always valid there.
+  auto endpoint = [](TCodepoint c) {
+    char buf[11];
+    std::snprintf(
+        buf, sizeof(buf), c <= 0xFFFF ? R"(\u%04x)" : R"(\U%08x)", static_cast<unsigned>(c)
+    );
+    return std::string(buf);
+  };
+  auto add_safe = [&](TCodepoint lo, TCodepoint hi) {
+    if (lo > hi) return;
+    has_safe = true;
+    safe += endpoint(lo);
+    if (hi != lo) {
+      safe += "-";
+      safe += endpoint(hi);
+    }
+  };
+  auto emit_range = [&](TCodepoint lo, TCodepoint hi) {
+    // A positive class member in the forbidden set would leak a structural byte
+    // into a bare-key body; flag it so the parser can reject fail-closed. This
+    // covers forbidden chars the JSON-safe rewrite does not touch (`:` `,` `{`
+    // `}` and whitespace), and scans the full range regardless of the 0x5C
+    // window below.
+    for (const auto& [flo, fhi] : forbidden_ranges_) {
+      if (lo <= fhi && flo <= hi) {
+        matched_forbidden_positive_ = true;
+        break;
+      }
+    }
+    // All unsafe codepoints are <= 0x5C ('\'); only scan that window, then keep
+    // the (safe) remainder as a range.
+    TCodepoint scan_hi = hi < 0x5C ? hi : 0x5C;
+    TCodepoint seg_lo = lo;
+    for (TCodepoint c = lo; c <= scan_hi; ++c) {
+      if (is_unsafe(c)) {
+        add_safe(seg_lo, c - 1);
+        escaped.push_back("\"" + FormatCharLiteral(c, /*json_escape=*/true) + "\"");
+        seg_lo = c + 1;
+      }
+    }
+    add_safe(seg_lo, hi);
+  };
+
+  if (!ScanCharClassBody(p, end, /*stop_on_error=*/true, [&](TCodepoint lo, TCodepoint hi) {
+        emit_range(lo, hi);
+      })) {
+    return char_class;  // parse failure: leave unchanged
+  }
+  safe += "]";
+
+  if (escaped.empty()) return char_class;  // nothing unsafe; keep the class
+
+  std::string result = "(";
+  for (size_t i = 0; i < escaped.size(); ++i) {
+    if (i) result += " | ";
+    result += escaped[i];
+  }
+  if (has_safe) result += " | " + safe;
+  result += ")";
+  return result;
+}
