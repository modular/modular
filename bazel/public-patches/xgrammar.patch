+      tag_dispatch.min_length, tag_dispatch.max_length, tag_dispatch.exclude_edges
+  );
+  auto product = FSMWithStartEnd::Intersect(exclusion, constraint, budget);
+  if (product.IsErr()) {
+    return ResultErr(over_budget);
+  }
+  FSMWithStartEnd result = std::move(product).Unwrap();
+  result.TrimEdgesToDeadStates();
+  return ResultOk(std::move(result));
+}
