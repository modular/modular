+      return {"\"\\\"\"", "\"\\\"\""};
+  }
+  XGRAMMAR_UNREACHABLE();
+}
+
+std::string JSONSchemaConverter::StringPatternForbiddenChars(const GenerationContext& ctx) const {
+  if (ctx.framing == GenerationContext::Framing::kTokenDelimited) {
+    return R"(\\\x00-\x1F)";
+  }
+  return R"(\"\\\x00-\x1F)";
+}
+
+std::string JSONSchemaConverter::WrapStringBody(
+    const std::string& body, const GenerationContext& ctx
+) const {
+  if (ctx.framing == GenerationContext::Framing::kBare) {
+    return "(" + body + ")";
+  }
+  // The body may be an alternation, which must not bind to a delimiter.
+  auto [open_delim, close_delim] = StringDelimiters(ctx);
+  return open_delim + " (" + body + ") " + close_delim;
+}
+
+std::string JSONSchemaConverter::GenerateStringLengthBody(
+    int min_length, int max_length, const GenerationContext& ctx
+) const {
+  if (ctx.pattern) {
+    int min = std::max(0, min_length - 1);
+    int max = max_length == -1 ? -1 : max_length - 1;
+    if (!ctx.allow_empty && max_length != -1 && max < min) {
+      XGRAMMAR_LOG(FATAL) << "maxLength admits only the empty string, which an "
+                             "alphabet-constrained string cannot represent";
+    }
+    const std::string prefix =
+        "[" + ctx.pattern->first_body + "] [" + ctx.pattern->rest_body + "]{";
+    if (max == -1) {
+      return prefix + std::to_string(min) + ",}";
+    }
+    return prefix + std::to_string(min) + "," + std::to_string(max) + "}";
+  }
+  const std::string char_class = ctx.framing == GenerationContext::Framing::kTokenDelimited
+                                     ? "[^" + StringPatternForbiddenChars(ctx) + "]"
+                                     : "[^\\0-\\x1f\\\"\\\\\\r\\n" +
+                                           ExtraJSONStringExcludedChars() + "]";
+  const std::string repetition = max_length == -1
+                                     ? "{" + std::to_string(min_length) + ",}"
+                                     : "{" + std::to_string(min_length) + "," +
+                                           std::to_string(max_length) + "}";
+  return char_class + repetition;
+}
+
+std::string JSONSchemaConverter::GenerateStringDefault(const GenerationContext& ctx) const {
+  if (ctx.framing == GenerationContext::Framing::kTokenDelimited) {
+    return DelimitedStringRuleBody();
+  }
+  return "[\"] " + kBasicStringSub;
+}
+
+std::string JSONSchemaConverter::WrapLiteral(
+    const std::string& inner, const GenerationContext& ctx
+) const {
+  const std::string escaped = JSONStrToPrintableStr(inner);
+  switch (ctx.framing) {
+    case GenerationContext::Framing::kBare:
+      return "\"" + escaped + "\"";
+    case GenerationContext::Framing::kTokenDelimited: {
+      const std::string delimiter = DelimiterTokenTerminal();
+      return delimiter + " \"" + escaped + "\" " + delimiter;
+    }
+    case GenerationContext::Framing::kQuotedJSON:
+      return "\"\\\"" + escaped + "\\\"\"";
+  }
+  XGRAMMAR_UNREACHABLE();
+}
+
+std::string JSONSchemaConverter::RenderLiteral(
+    const picojson::value& v, const GenerationContext& value_ctx, const GenerationContext& key_ctx
+) const {
+  if (v.is<std::string>()) {
+    std::string json = v.serialize();
+    return WrapLiteral(json.substr(1, json.size() - 2), value_ctx);
+  }
+  if (v.is<picojson::array>()) {
+    const auto& arr = v.get<picojson::array>();
+    std::string body = "\"[\"";
+    for (size_t i = 0; i < arr.size(); ++i) {
+      body += (i == 0 ? std::string(" ") : " \"" + item_sep_ + "\" ") +
+              RenderLiteral(arr[i], value_ctx, key_ctx);
+    }
+    body += " \"]\"";
+    return "(" + body + ")";
+  }
+  if (v.is<picojson::object>()) {
+    const auto& obj = v.get<picojson::object>();
+    std::string body = "\"{\"";
+    bool first = true;
+    for (const auto& key : obj.ordered_keys()) {
+      std::string kjson = picojson::value(key).serialize();
+      body += (first ? std::string(" ") : " \"" + item_sep_ + "\" ") +
+              WrapLiteral(kjson.substr(1, kjson.size() - 2), key_ctx) + " \"" + colon_sep_ + "\" " +
+              RenderLiteral(obj.at(key), value_ctx, key_ctx);
+      first = false;
+    }
+    body += " \"}\"";
+    return "(" + body + ")";
+  }
+  return "\"" + SerializeLiteral(v) + "\"";
+}
+
+std::string JSONSchemaConverter::SerializeLiteral(const picojson::value& v) {
+  if (v.is<picojson::array>()) {
+    std::string result = "[";
+    bool first = true;
+    for (const auto& item : v.get<picojson::array>()) {
+      if (!first) result += ",";
+      first = false;
+      result += SerializeLiteral(item);
+    }
+    return result + "]";
+  }
+  if (v.is<picojson::object>()) {
+    std::string result = "{";
+    bool first = true;
+    for (const auto& key : v.get<picojson::object>().ordered_keys()) {
+      if (!first) result += ",";
+      first = false;
+      result += picojson::value(key).serialize() + ":" + SerializeLiteral(v.get<picojson::object>().at(key));
+    }
+    return result + "}";
+  }
+  if (!v.is<int64_t>() && v.is<double>()) {
+    const double number = v.get<double>();
+    if (std::trunc(number) != number) {
+#ifndef __APPLE__
+        char buffer[64];
+        auto [end, error] = std::to_chars(buffer, buffer + sizeof(buffer), number);
+        XGRAMMAR_CHECK(error == std::errc()) << "could not render numeric literal";
+        return std::string(buffer, end);
+#else
+      // The supported macOS deployment target predates floating to_chars.
+      for (int precision = 1; precision <= std::numeric_limits<double>::max_digits10; ++precision) {
+        std::ostringstream output;
+        output.imbue(std::locale::classic());
+        output << std::setprecision(precision) << number;
+        std::istringstream input(output.str());
+        input.imbue(std::locale::classic());
+        double round_trip = 0;
+        input >> round_trip;
+        if (round_trip == number) return output.str();
+      }
+      XGRAMMAR_LOG(FATAL) << "could not render numeric literal";
+#endif
+    }
+  }
+  return v.serialize();
+}
