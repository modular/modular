+          return true;
+        } else if constexpr (std::is_same_v<T, ConstSpec>) {
+          return s.parsed_json_value.template is<std::string>();
+        } else if constexpr (std::is_same_v<T, EnumSpec>) {
+          for (const auto& value : s.parsed_json_values) {
+            if (!value.template is<std::string>()) {
+              return false;
+            }
+          }
+          return true;
+        } else if constexpr (std::is_same_v<T, RefSpec>) {
+          if (!visited_refs.insert(s.uri).second) {
+            return false;
+          }
+          return IsRawStringValue(json_leaf_ref_resolver_(s.uri, "ref"), visited_refs);
+        } else {
+          return false;
+        }
+      },
+      spec->spec
+  );
+}
