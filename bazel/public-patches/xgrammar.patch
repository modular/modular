+// Whether a JSON Schema `pattern`, which is a search, means the whole match the regex
+// converter builds: anchored at both ends, with no top-level alternation for an anchor to
+// bind to one side of.
+bool PatternSearchIsWholeMatch(const std::string& pattern) {
+  if (pattern.size() < 2 || pattern.front() != '^' || pattern.back() != '$') {
+    return false;
+  }
+  size_t trailing_backslashes = 0;
+  for (size_t i = pattern.size() - 1; i > 0 && pattern[i - 1] == '\\'; --i) {
+    ++trailing_backslashes;
+  }
+  if (trailing_backslashes % 2 == 1) {
+    return false;
+  }
+  int depth = 0;
+  bool in_class = false;
+  for (size_t i = 1; i + 1 < pattern.size(); ++i) {
+    const char c = pattern[i];
+    if (c == '\\') {
+      ++i;
+    } else if (in_class) {
+      in_class = c != ']';
+    } else if (c == '[') {
+      in_class = true;
+      if (i + 1 < pattern.size() && pattern[i + 1] == '^') ++i;
+      if (i + 1 < pattern.size() && pattern[i + 1] == ']') ++i;
+    } else if (c == '(') {
+      ++depth;
+    } else if (c == ')') {
+      --depth;
+    } else if (c == '|' && depth == 0) {
+      return false;
+    }
+  }
+  return !in_class && depth == 0;
+}
