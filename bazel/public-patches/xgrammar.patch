+// Every JSON spelling of `codepoint` as `\u` escapes: one, or a surrogate pair
+// past the BMP, with hex digits in either case.
+std::string JSONUnicodeEscape(TCodepoint codepoint) {
+  std::string result;
+  auto append_unit = [&](TCodepoint unit) {
+    if (!result.empty()) result += " ";
+    result += R"("\\u")";
+    for (int shift = 12; shift >= 0; shift -= 4) {
+      const char digit = "0123456789abcdef"[(unit >> shift) & 0xf];
+      if (digit >= 'a') {
+        result += " [" + std::string(1, digit) + std::string(1, digit - 'a' + 'A') + "]";
+      } else {
+        result += " \"" + std::string(1, digit) + "\"";
+      }
+    }
+  };
+  if (codepoint <= 0xffff) {
+    append_unit(codepoint);
+  } else {
+    append_unit(0xd800 + ((codepoint - 0x10000) >> 10));
+    append_unit(0xdc00 + ((codepoint - 0x10000) & 0x3ff));
+  }
+  return result;
+}
+
+const char kQuotedJSONForbidden[] = R"(\"\\\x00-\x1F)";
+
+// Every spelling of `codepoint` inside a JSON string: the one the regex converter
+// writes (raw, a short escape, or the `\u` escape that `required_escapes` forces),
+// every `\u` escape, and `\/` for a solidus.
+std::string JSONCharSpellings(TCodepoint codepoint, const std::string& required_escapes) {
+  std::string member;
+  AppendEscapedCodepoint(&member, codepoint, "]\\^-");
+  std::string spellings = "(" +
+                          RegexToEBNF(
+                              "[" + member + "]", false, kQuotedJSONForbidden, "", true,
+                              required_escapes
+                          ) +
+                          " | " + JSONUnicodeEscape(codepoint);
+  if (codepoint == '/') spellings += R"( | "\\/")";
+  return spellings + ")";
+}
