+void FSMWithStartEnd::TrimEdgesToDeadStates() {
+  const int num_states = NumStates();
+  std::vector<std::vector<int>> predecessors(num_states);
+  for (int state = 0; state < num_states; ++state) {
+    for (const auto& edge : fsm_.GetEdges(state)) {
+      predecessors[edge.target].push_back(state);
+    }
+  }
+  std::vector<bool> can_reach_end(num_states, false);
+  std::queue<int> queue;
+  for (int state = 0; state < num_states; ++state) {
+    if (IsEndState(state)) {
+      can_reach_end[state] = true;
+      queue.push(state);
+    }
+  }
+  while (!queue.empty()) {
+    int state = queue.front();
+    queue.pop();
+    for (int pred : predecessors[state]) {
+      if (!can_reach_end[pred]) {
+        can_reach_end[pred] = true;
+        queue.push(pred);
+      }
+    }
+  }
+  for (int state = 0; state < num_states; ++state) {
+    auto& edges = fsm_.GetEdges(state);
+    edges.erase(
+        std::remove_if(
+            edges.begin(),
+            edges.end(),
+            [&](const FSMEdge& edge) { return !can_reach_end[edge.target]; }
+        ),
+        edges.end()
+    );
+  }
+}
