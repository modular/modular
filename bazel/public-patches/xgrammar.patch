+bool XMLToolCallingConverter::ValueRegexCanReachClose(const std::string& regex) const {
+  if (MarkerTokenId(kValueClose) >= 0) {
+    return false;
+  }
+  const std::string& delim = ValueCloseDelimiter();
+  if (delim.empty()) {
+    return false;
+  }
+  // A regex that cannot spell the delimiter's first byte cannot spell the delimiter. The
+  // converse over-approximates: a regex that admits that byte but never the whole delimiter
+  // is refused too. The regex converter itself reports a positive literal or class member
+  // on that byte; a wildcard (`.`, a negated class, `\D`, `\W`, `\S`) always admits it.
+  char lead[7];
+  std::snprintf(lead, sizeof(lead), R"(\u%04x)", static_cast<unsigned char>(delim[0]));
+  if (RegexMatchesForbidden(regex, lead)) {
+    return true;
+  }
+  bool in_class = false;
+  for (size_t i = 0; i < regex.size(); ++i) {
+    const char c = regex[i];
+    if (c == '\\') {
+      if (i + 1 < regex.size() && std::strchr("DWS", regex[i + 1]) != nullptr) {
+        return true;
+      }
+      ++i;
+    } else if (in_class) {
+      in_class = c != ']';
+    } else if (c == '[') {
+      in_class = true;
+      if (i + 1 < regex.size() && regex[i + 1] == '^') {
+        return true;
+      }
+      if (i + 1 < regex.size() && regex[i + 1] == ']') ++i;
+    } else if (c == '.') {
+      return true;
+    }
+  }
+  return false;
+}
