+// the atom just before the brace, or the whole group its `)` closes, so that every atom
+// nested in a counted group is marked too. A brace that does not open a valid count
+// marks nothing.
+template <typename Seq>
+static std::vector<bool> CountedRepeatOperands(const Seq& s, size_t n) {
+  std::vector<bool> result(n, false);
