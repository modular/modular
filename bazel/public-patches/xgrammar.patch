+// The codepoints of a property name, or nullopt for invalid UTF-8. Not ParseUTF8:
+// it stops at a NUL, which a name carries legally via \u0000.
+std::optional<std::vector<TCodepoint>> DecodeName(const std::string& name) {
+  std::vector<TCodepoint> codepoints;
+  for (size_t offset = 0; offset < name.size();) {
+    auto [codepoint, num_bytes] = ParseNextUTF8(name.data() + offset);
+    if (codepoint == CharHandlingError::kInvalidUTF8) return std::nullopt;
+    codepoints.push_back(codepoint);
+    offset += num_bytes;
+  }
+  return codepoints;
+}
+
+// Build a trie of the names to carve out of an object's additional-key
+// pattern: the declared property names followed by the forbidden (false-schema)
+// properties. `accept`, when set, drops names that can never collide with an
+// additional key (e.g. names unspellable in a bare-key alphabet).
+TrieNode BuildNameTrie(
+    const std::vector<ObjectSpec::Property>& properties,
+    const std::vector<std::string>& forbidden_properties,
+    const std::function<bool(const std::string&)>& accept = nullptr
+) {
+  TrieNode root;
+  auto insert_name = [&](const std::string& name) {
+    if (accept && !accept(name)) return;
+    auto codepoints = DecodeName(name);
+    if (!codepoints) return;
+    TrieNode* cur = &root;
+    for (TCodepoint codepoint : *codepoints) {
+      cur = &cur->children[codepoint];
+    }
+    cur->is_terminal = true;
+  };
+  for (const auto& prop : properties) {
+    insert_name(prop.name);
+  }
+  for (const auto& key : forbidden_properties) {
+    insert_name(key);
+  }
+  return root;
+}
