+
+bool IsIntegerValue(const picojson::value& value) {
+  if (value.is<int64_t>()) {
+    return true;
+  }
+  if (!value.is<double>()) {
+    return false;
+  }
+  double number = value.get<double>();
+  return std::isfinite(number) && std::floor(number) == number;
