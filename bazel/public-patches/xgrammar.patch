+ private:
+  TCodepoint escape_codepoint_ = 0;
+
+  std::string PrintableJSONLiteral(const picojson::value& value) {
+    const std::string json = EscapeTerminatorInJSONStrings(SerializeLiteral(value));
+    return "\"" + JSONStrToPrintableStr(json) + "\"";
+  }
+
+  std::string EscapeTerminatorInJSONStrings(const std::string& json) {
+    std::string result;
+    bool in_string = false;
+    bool escaped = false;
+    for (TCodepoint c : ParseUTF8(json.c_str())) {
+      if (in_string && !escaped && c == escape_codepoint_) {
+        auto append_unit = [&](TCodepoint unit) {
+          result += "\\u";
+          for (int shift = 12; shift >= 0; shift -= 4) {
+            result += "0123456789abcdef"[(unit >> shift) & 0xf];
+          }
+        };
+        if (c <= 0xffff) {
+          append_unit(c);
+        } else {
+          const auto scalar = c - 0x10000;
+          append_unit(0xd800 + (scalar >> 10));
+          append_unit(0xdc00 + (scalar & 0x3ff));
+        }
+      } else {
+        result += CharToUTF8(c);
+      }
+      if (in_string) {
+        if (escaped) {
+          escaped = false;
+        } else if (c == '\\') {
+          escaped = true;
+        } else if (c == '"') {
+          in_string = false;
+        }
+      } else if (c == '"') {
+        in_string = true;
+      }
+    }
+    return result;
+  }
+};
