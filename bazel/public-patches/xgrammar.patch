+      (spec->max_length == -1 || (!unbounded && longest <= spec->max_length))) {
+    // The bounds forbid nothing the tier admits, so dropping them keeps the spec
+    // honest about what the grammar enforces.
+    spec->min_length = 0;
+    spec->max_length = -1;
+    return std::nullopt;
+  }
