+bool TryProveStrictDiscriminatorOneOf(const picojson::array& options, int64_t* work) {
+  if (options.empty()) {
+    return false;
+  }
+  for (const auto& discriminator_key : GetDiscriminatorCandidates(options.front(), work)) {
+    std::vector<std::vector<picojson::value>> branch_values;
+    bool all_branches_have_key = true;
+    for (const auto& option : options) {
+      auto values = GetDiscriminatorValues(option, discriminator_key, work);
+      if (!values.has_value()) {
+        all_branches_have_key = false;
+        break;
+      }
+      branch_values.push_back(std::move(values.value()));
+    }
+    if (!all_branches_have_key) {
+      continue;
+    }
