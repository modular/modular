+    for (size_t j = i + 1; j < proofs.size(); ++j) {
+      if (proofs[i].Overlaps(proofs[j], work)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+bool TryProvePairwiseDisjointOneOf(const picojson::array& options, int64_t* work) {
