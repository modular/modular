+    if (j < n && s[j] == ',') {
+      ++j;
+      digits();
+    }
+    return j < n && s[j] == '}' ? j : n;
+  };
+  std::vector<size_t> opens;
+  size_t operand = n;  // start of the atom or group that ends just before i
+  for (size_t i = 0; i < n;) {
+    const auto c = s[i];
+    size_t next = i + 1;
+    size_t start = n;
+    if (c == '\\') {
+      start = i;
+      next = i + 2;
+      if (i + 2 < n && s[i + 1] == 'u' && s[i + 2] == '{') {
+        while (next < n && s[next] != '}') ++next;
