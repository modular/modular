+Result<picojson::value, SchemaError> SchemaParser::MergeAllOf(const picojson::object& schema) {
+  // The checks below need to know which contributor a merged key came from.
+  AllOfFlattener flattener{GetRootSchema(), config_.reject_unsupported};
+  if (auto err = flattener.Collect(schema)) return ResultErr<SchemaError>(std::move(*err));
+  const std::vector<picojson::object>& contributors = flattener.contributors;
+  std::vector<const picojson::object*> contributor_ptrs;
+  contributor_ptrs.reserve(contributors.size());
+  for (const auto& contributor : contributors) contributor_ptrs.push_back(&contributor);
+
+  if (auto err = CheckFlattenPreservesBoundaries(contributor_ptrs, "allOf")) {
+    return ResultErr(std::move(*err));
+  }
+
+  constexpr size_t kSeveralSources = static_cast<size_t>(-1);
+  picojson::object merged;
+  std::unordered_map<std::string, size_t> key_source;
+  for (size_t i = 0; i < contributors.size(); ++i) {
+    for (const auto& key : contributors[i].ordered_keys()) {
+      const auto& value = contributors[i].at(key);
+      if (!merged.count(key)) {
+        merged[key] = value;
+        key_source[key] = i;
+        continue;
+      }
+      auto combined = IntersectKeyword(key, merged.at(key), value);
+      if (!combined.has_value()) {
+        return ResultErr<SchemaError>(
+            SchemaErrorType::kUnsupportedSchema,
+            "allOf members set conflicting \"" + key + "\""
+        );
+      }
+      if (!SameJson(merged.at(key), *combined)) key_source[key] = kSeveralSources;
+      merged[key] = std::move(*combined);
+    }
+  }
+
+  // No string-tier check here: the merged text carries every tier, and
+  // ReconcileStringTiers judges the combination once ParseString reaches it, so
+  // the allOf spelling and the plain one give the same verdict.
+
+  if (auto err = CheckExclusiveKeywordsUnmixed(merged, key_source, "allOf")) {
+    return ResultErr(std::move(*err));
+  }
+
+  return ResultOk(picojson::value(std::move(merged)));
+}
