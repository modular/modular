+namespace {
+bool HasRuleFsm(const Grammar& grammar, int32_t rule_id) {
+  return rule_id >= 0 && rule_id < grammar->NumRules() &&
+         static_cast<size_t>(rule_id) < grammar->per_rule_fsms.size() &&
+         grammar->per_rule_fsms[rule_id].has_value();
+}
+
+// Lookahead states use expression positions; ordinary states use FSM positions.
+bool HasStatePosition(const Grammar& grammar, const ParserState& state, bool allow_end) {
+  if (state.element_id < 0 || state.sub_element_id < 0 || state.repeat_count < 0) return false;
+  if (state.rule_id != -1) {
+    return HasRuleFsm(grammar, state.rule_id) &&
+           state.element_id < grammar->per_rule_fsms[state.rule_id]->GetFsm().NumStates();
+  }
+  if (state.sequence_id < 0 || state.sequence_id >= grammar->NumGrammarExprs()) return false;
+  const auto sequence = grammar->GetGrammarExpr(state.sequence_id);
+  if (sequence.type != GrammarExprType::kSequence &&
+      sequence.type != GrammarExprType::kEmptyStr) return false;
+  if (state.element_id == sequence.size()) return allow_end;
+  if (state.element_id > sequence.size()) return false;
+  const auto element_id = sequence[state.element_id];
+  if (element_id < 0 || element_id >= grammar->NumGrammarExprs()) return false;
+  const auto element = grammar->GetGrammarExpr(element_id);
+  if (element.type == GrammarExprType::kByteString) {
+    return state.sub_element_id < element.size();
+  }
+  return state.sub_element_id <= 3;
+}
