+FSMWithStartEnd GrammarFSMBuilderImpl::BuildTextConstraintFSM(
+    int32_t min_length, int32_t max_length, const std::vector<std::string>& exclude_edges
+) {
+  // Bytes a UTF-8 lead byte announces, or 0 for a byte that cannot start a code point. The
+  // shared table admits the leads that can only begin an overlong form (0xC0, 0xC1) or a
+  // codepoint past U+10FFFF (0xF5..0xF7), so those are excluded here.
+  auto lead_length = [](int byte) {
+    if ((byte >= 0xC0 && byte <= 0xC1) || byte >= 0xF5) {
+      return 0;
+    }
+    auto first_byte = HandleUTF8FirstByte(static_cast<uint8_t>(byte));
+    return std::get<0>(first_byte) ? std::get<1>(first_byte) : 0;
+  };
+  auto is_continuation = [](int byte) { return byte >= 0x80 && byte <= 0xBF; };
+
+  // The edge sequences (one code point each) form a byte trie. A multi-byte sequence is
+  // followed through tracking states; a mismatch means an ordinary code point was read.
+  struct TrieNode {
+    std::array<int, 256> child;
+    bool leaf = false;
+    // Continuation bytes still owed by the code point this node is part of.
+    int remaining = 0;
+    int tracking_index = -1;
+    TrieNode() { child.fill(-1); }
+  };
+  std::vector<TrieNode> trie(1);
+  for (const auto& edge : exclude_edges) {
+    XGRAMMAR_DCHECK(
+        !edge.empty() && lead_length(static_cast<unsigned char>(edge[0])) ==
+                             static_cast<int>(edge.size())
+    );
+    int node = 0;
+    for (size_t i = 0; i < edge.size(); ++i) {
+      unsigned char byte = static_cast<unsigned char>(edge[i]);
+      if (trie[node].child[byte] == -1) {
+        trie[node].child[byte] = static_cast<int>(trie.size());
+        trie.emplace_back();
+        trie.back().remaining = static_cast<int>(edge.size() - i - 1);
+      }
+      node = trie[node].child[byte];
+    }
+    trie[node].leaf = true;
+  }
+  int num_tracking = 0;
+  for (size_t node = 1; node < trie.size(); ++node) {
+    if (!trie[node].leaf) {
+      trie[node].tracking_index = num_tracking++;
+    }
+  }
+
+  // Code points are counted at their lead byte and must be completed: a stray continuation
+  // byte or a truncated sequence has no transition. With no upper bound the count saturates
+  // once the lower bound is met, so nothing past it needs a state of its own.
+  const int32_t top = max_length == -1 ? std::max(min_length, 1) : max_length;
+  // State 0 is the empty text. Each count c >= 1 has an inner state (last code point
+  // ordinary, the only kind that accepts), an edge state (last code point excluded from the
+  // edges), three pending states (1..3 continuation bytes still owed) and one tracking state
+  // per inner trie node. A sequence begun at the very start has its own tracking states,
+  // since completing it there is forbidden rather than an edge.
+  const int per_count = 5 + num_tracking;
+  auto inner = [&](int32_t c) { return 1 + (c - 1) * per_count; };
+  auto edge = [&](int32_t c) { return inner(c) + 1; };
+  auto pending = [&](int32_t c, int owed) { return inner(c) + 1 + owed; };
+  auto track = [&](int32_t c, int k) { return inner(c) + 5 + k; };
+  auto track_start = [&](int k) { return 1 + top * per_count + k; };
+  const int num_states = 1 + top * per_count + num_tracking;
+  FSM fsm(num_states);
+  std::vector<bool> ends(num_states, false);
+  ends[0] = min_length == 0;
+  for (int32_t c = 1; c <= top; ++c) {
+    ends[inner(c)] = c >= min_length;
+  }
+
+  auto add_row = [&](int state, const std::array<int, 256>& target) {
+    for (int byte = 0; byte < 256;) {
+      int range_end = byte;
+      while (range_end + 1 < 256 && target[range_end + 1] == target[byte]) {
+        ++range_end;
+      }
+      if (target[byte] != FSM::kNoNextState) {
+        fsm.AddEdge(state, target[byte], byte, range_end);
+      }
+      byte = range_end + 1;
+    }
+  };
+  // Where a code point may begin: the empty text, an inner state or an edge state. Edge
+  // states at the upper bound end up with no exits and are trimmed by the caller.
+  auto boundary_row = [&](int state, int32_t count, bool at_start) {
+    const bool can_grow = max_length == -1 || count < max_length;
+    const int32_t next = (max_length == -1 && count == top) ? count : count + 1;
+    std::array<int, 256> target;
+    target.fill(FSM::kNoNextState);
+    if (!can_grow) {
+      add_row(state, target);
+      return;
+    }
+    for (int byte = 0; byte < 256; ++byte) {
+      const int length = lead_length(byte);
+      if (length == 0) continue;
+      int child = trie[0].child[byte];
+      if (child != -1) {
+        if (trie[child].leaf) {
+          target[byte] = at_start ? FSM::kNoNextState : edge(next);
+        } else {
+          int k = trie[child].tracking_index;
+          target[byte] = at_start ? track_start(k) : track(next, k);
+        }
+      } else if (length == 1) {
+        target[byte] = inner(next);
+      } else {
+        target[byte] = pending(next, length - 1);
+      }
+    }
+    add_row(state, target);
+  };
+  // Inside a candidate edge sequence: the byte either follows the trie or continues an
+  // ordinary code point with the same lead byte.
+  auto tracking_row = [&](int state, int32_t count, int node, bool from_start) {
+    std::array<int, 256> target;
+    target.fill(FSM::kNoNextState);
+    for (int byte = 0; byte < 256; ++byte) {
+      int child = trie[node].child[byte];
+      if (child != -1) {
+        if (trie[child].leaf) {
+          target[byte] = from_start ? FSM::kNoNextState : edge(count);
+        } else {
+          int k = trie[child].tracking_index;
+          target[byte] = from_start ? track_start(k) : track(count, k);
+        }
+      } else if (is_continuation(byte)) {
+        int owed = trie[node].remaining - 1;
+        target[byte] = owed == 0 ? inner(count) : pending(count, owed);
+      }
+    }
+    add_row(state, target);
+  };
+  auto pending_row = [&](int state, int32_t count, int owed) {
+    std::array<int, 256> target;
+    target.fill(FSM::kNoNextState);
+    for (int byte = 0x80; byte <= 0xBF; ++byte) {
+      target[byte] = owed == 1 ? inner(count) : pending(count, owed - 1);
+    }
+    add_row(state, target);
+  };
+  boundary_row(0, 0, /*at_start=*/true);
+  for (int32_t c = 1; c <= top; ++c) {
+    boundary_row(inner(c), c, /*at_start=*/false);
+    boundary_row(edge(c), c, /*at_start=*/false);
+    for (int owed = 1; owed <= 3; ++owed) {
+      pending_row(pending(c, owed), c, owed);
+    }
+  }
+  if (top > 0) {
+    for (size_t node = 1; node < trie.size(); ++node) {
+      if (trie[node].leaf) continue;
+      int k = trie[node].tracking_index;
+      for (int32_t c = 1; c <= top; ++c) {
+        tracking_row(track(c, k), c, static_cast<int>(node), /*from_start=*/false);
+      }
+      tracking_row(track_start(k), 1, static_cast<int>(node), /*from_start=*/true);
+    }
+  }
+  return FSMWithStartEnd(fsm, 0, ends, /*is_dfa=*/true);
+}
