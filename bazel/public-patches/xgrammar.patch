+      const EnumSpec& spec, const std::string& rule_name, const GenerationContext& ctx
+  ) override {
+    std::string result = "(";
+    for (size_t i = 0; i < spec.parsed_json_values.size(); ++i) {
+      if (i != 0) result += " | ";
+      result += PrintableJSONLiteral(spec.parsed_json_values[i]);
+    }
+    return result + ")";
+  }
+
+  std::string FormatPropertyKey(const std::string& key) override {
+    return PrintableJSONLiteral(picojson::value(key));
+  }
+
+  Grammar ConvertObject(const ObjectSpec& spec) {
+    AddBasicRules();
+    auto root = ebnf_script_creator_.AllocateRuleName("root");
+    auto body = GenerateObject(spec, root, MakeValueContext());
+    ebnf_script_creator_.AddRuleWithAllocatedName(root, body);
+    return Grammar::FromEBNF(ebnf_script_creator_.GetScript());
+  }
