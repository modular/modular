+std::optional<std::set<char>> ExpandCharClassBodyToASCIISet(const std::string& class_body) {
+  // ScanCharClassBody has no negation semantics; a leading `^` would be taken
+  // as a literal member and silently invert the meaning.
+  if (class_body.empty() || class_body[0] == '^') return std::nullopt;
+  std::set<char> result;
+  bool ascii_only = true;
+  const char* p = class_body.c_str();
+  bool ok = ScanCharClassBody(
+      p,
+      p + class_body.size(),
+      /*stop_on_error=*/true,
+      [&](TCodepoint lo, TCodepoint hi) {
+        if (lo < 0 || hi > 127) {
+          ascii_only = false;
+          return;
+        }
+        for (TCodepoint c = lo; c <= hi; ++c) {
+          result.insert(static_cast<char>(c));
+        }
+      }
+  );
+  if (!ok || !ascii_only || result.empty()) return std::nullopt;
+  return result;
+}
