+Result<FSMWithStartEnd> GrammarFSMBuilderImpl::TryBuildConstrainedTagDispatch(
+    const Grammar::Impl::TagDispatch& tag_dispatch
+) {
+  XGRAMMAR_DCHECK(tag_dispatch.tag_rule_pairs.empty());
+  const int budget = Grammar::Impl::TagDispatch::kMaxConstrainedStates;
+  const std::string over_budget =
+      "TagDispatch length bound expands past " + std::to_string(budget) + " states";
+  // Every state of the constraint automaton survives into the product, so its size is
+  // checked before anything is allocated.
+  if (tag_dispatch.ConstrainedStateCount() > budget) {
+    return ResultErr(over_budget);
+  }
+  std::vector<int> end_states;
+  auto trie_result = TrieFSMBuilder::Build({}, tag_dispatch.excludes, &end_states, true, true);
+  if (!trie_result.has_value()) {
+    return ResultErr(std::string("Failed to build the exclusion automaton"));
+  }
+  // Every live state accepts: an excluded pattern's terminal is unreachable once the edges
+  // into it are gone. The Aho-Corasick automaton is deterministic with no epsilon edges, so
+  // the product below needs no determinization.
+  std::vector<bool> ends(trie_result->NumStates());
