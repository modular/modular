+std::optional<SchemaError> SchemaParser::ReconcileStringTiers(StringSpec* spec) {
+  // Strict refuses the pair. Permissive keeps pattern.
+  if (spec->format.has_value() && spec->pattern.has_value()) {
+    if (config_.reject_unsupported) {
+      return SchemaError(
+          SchemaErrorType::kUnsupportedSchema,
+          "\"format\" and \"pattern\" both constrain the string, and only one is enforced"
+      );
+    }
+    spec->format.reset();
+  }
+
+  // Permissive mode keeps upstream's bargain: GenerateString emits its first
+  // tier and the rest are dropped.
+  if (!config_.reject_unsupported) return std::nullopt;
+  if (!spec->format.has_value() && !spec->pattern.has_value()) return std::nullopt;
+
+  if (spec->min_length == 0 && spec->max_length == -1) return std::nullopt;
+
+  const std::string tier = spec->pattern.has_value() ? "pattern" : "format";
+  const std::optional<std::string> regex =
+      spec->pattern.has_value()
+          ? spec->pattern
+          : JSONSchemaConverter::JSONFormatToRegexPattern(*spec->format);
+  const std::optional<std::pair<int, int>> range = regex.has_value()
+                                                       ? RegexMatchLengthRange(
+                                                             *regex, &regex_work_remaining_
+                                                         )
+                                                       : std::nullopt;
+  const std::string pair_name = "\"" + tier + "\" and the length bounds";
+  if (!range.has_value()) {
+    return SchemaError(
+        SchemaErrorType::kUnsupportedSchema,
+        pair_name + " both constrain the string, and the lengths " + tier +
+            " admits cannot be measured"
+    );
+  }
+
+  // The bounds the emitted rule already guarantees. Confining the pattern to the
+  // string's forbidden characters can only shrink its language, so a range
+  // measured before that confinement stays an outer bound on what is emitted,
+  // and every verdict below holds for the narrower language too.
+  const int shortest = range->first;
+  const int longest = range->second;
+  const bool unbounded = longest == -1;
+
