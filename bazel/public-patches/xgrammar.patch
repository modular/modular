+    if (auto fsm_hash = CompleteFsmHash(impl, rule_id); fsm_hash.has_value()) {
+      return HashCombine(kHashedRefTag, fsm_hash.value());
+    }
+    auto [it, inserted] = local_ids.emplace(rule_id, static_cast<int32_t>(order.size()));
+    if (inserted) {
