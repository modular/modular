+    } else if (const size_t close = c == '{' ? count_end(i) : n; close != n) {
+      if (operand != n) std::fill(result.begin() + operand, result.begin() + i, true);
+      next = close + 1;
+    } else if (c != '*' && c != '+' && c != '?' && c != '|' && c != '^' && c != '$') {
+      start = i;
+    }
+    operand = start;
+    i = next;
+  }
