+// place so every later is<int64_t>() fails. Compare serialized text instead.
+static bool SameJson(const picojson::value& a, const picojson::value& b) {
+  return a.serialize(false) == b.serialize(false);
+}
+
+// Two members disagreeing on one of these disagree about nothing an instance can
+// violate. Narrower than NoConstraintKeywords, which also covers if/then/else.
+static bool IsAnnotationKeyword(const std::string& key) {
+  return AnnotationKeywords().count(key) > 0;
+}
+
+static bool IsFalseSchema(const picojson::value& v) { return v.is<bool>() && !v.get<bool>(); }
+
+static bool IsJsonLeaf(const picojson::value& v) {
+  if (!v.is<picojson::object>()) return false;
+  const auto& object = v.get<picojson::object>();
+  return object.count("x-modular-json-leaf") && object.at("x-modular-json-leaf").is<bool>() &&
+         object.at("x-modular-json-leaf").get<bool>();
+}
+
+// The conjunction of two values for one keyword, or nullopt when none expresses it.
+static std::optional<picojson::value> IntersectKeyword(
+    const std::string& key, const picojson::value& a, const picojson::value& b
+) {
+  if (SameJson(a, b)) return a;
+  // $id rebases $ref resolution, so differing ids are a real conflict.
+  if (key == "$id") return std::nullopt;
+  if (IsAnnotationKeyword(key)) return a;
+
+  if (key == "properties") {
+    if (!a.is<picojson::object>() || !b.is<picojson::object>()) return std::nullopt;
+    picojson::object merged = a.get<picojson::object>();
+    const auto& incoming = b.get<picojson::object>();
+    for (const auto& name : incoming.ordered_keys()) {
+      if (!merged.count(name)) {
+        merged[name] = incoming.at(name);
+        continue;
+      }
+      if (SameJson(merged.at(name), incoming.at(name))) continue;
+      // False accepts nothing, so the conjunction is false; ParseObject forbids it.
+      if (IsFalseSchema(merged.at(name)) || IsFalseSchema(incoming.at(name))) {
+        merged[name] = picojson::value(false);
+        continue;
+      }
+      // Both declarations must hold, which is itself an allOf; let Parse merge it
+      // a level down rather than intersect two arbitrary subschemas here.
+      picojson::object wrapper;
+      wrapper["allOf"] = picojson::value(picojson::array{merged.at(name), incoming.at(name)});
+      // Parse keeps only the wrapper's own leaf marker, and the planner, which
+      // decides the leaf on this conjunction, marks every declaration it joins.
+      if (IsJsonLeaf(merged.at(name)) || IsJsonLeaf(incoming.at(name))) {
+        wrapper["x-modular-json-leaf"] = picojson::value(true);
+      }
+      merged[name] = picojson::value(wrapper);
+    }
+    return picojson::value(merged);
+  }
+
+  if (key == "additionalProperties") {
+    // Each member's additionalProperties governs the keys that member leaves
+    // unnamed, so a conjunction is only well defined when both govern the same
+    // keys. The boundary check in MergeAllOf gives exactly that: it refuses a
+    // restricting member whose declared names differ from another's, so two
+    // restricting values reach here only over one shared set of keys.
+    if (IsFalseSchema(a) || IsFalseSchema(b)) return picojson::value(false);
+    if (!a.is<picojson::object>() || !b.is<picojson::object>()) return std::nullopt;
+    picojson::object wrapper;
+    wrapper["allOf"] = picojson::value(picojson::array{a, b});
+    return picojson::value(wrapper);
+  }
+
+  if (key == "required") {
+    if (!a.is<picojson::array>() || !b.is<picojson::array>()) return std::nullopt;
+    picojson::array merged = a.get<picojson::array>();
+    for (const auto& name : b.get<picojson::array>()) {
+      bool present = false;
+      for (const auto& seen : merged) {
+        if (SameJson(seen, name)) {
+          present = true;
+          break;
+        }
+      }
+      if (!present) merged.push_back(name);
+    }
+    return picojson::value(merged);
+  }
+
+  // No "allOf" case: CollectAllOfContributors strips it and walks the members,
+  // so the conjunction is already flat when two values for one keyword meet.
+
+  // true tightens by the larger value, false by the smaller.
+  static const std::unordered_map<std::string, bool> kTightenByMax = {
+      {"minProperties", true},
+      {"minItems", true},
+      {"minLength", true},
+      {"maxProperties", false},
+      {"maxItems", false},
+      {"maxLength", false}};
+  if (auto tier = kTightenByMax.find(key); tier != kTightenByMax.end()) {
+    if (!a.is<int64_t>() || !b.is<int64_t>()) return std::nullopt;
+    const int64_t x = a.get<int64_t>();
+    const int64_t y = b.get<int64_t>();
+    return picojson::value(tier->second ? std::max(x, y) : std::min(x, y));
+  }
+
+  return std::nullopt;
+}
+
+// Whether the URI is a pointer this converter can resolve: the root, or a
+// JSON pointer into it. A "#foo" plain-name anchor is neither.
+static bool DecodePercentEncoded(std::string* token);
+
+// A local reference is "#" or a JSON Pointer fragment. RFC 6901 evaluates a
+// fragment once it is percent-decoded, so "#%2F$defs%2Fx" names the same place
+// as "#/$defs/x" and the decoded text is what decides. The fragment is decoded
+// before evaluation in both modes; decode_escapes gates only whether a
+// malformed escape is reported or left to a best-effort not-found.
+static bool IsLocalPointerUri(const std::string& uri, bool decode_escapes) {
+  if (uri.empty() || uri[0] != '#') return false;
+  std::string path = uri.substr(1);
+  // A malformed escape is still a local reference. Saying otherwise would
+  // report it as a foreign URI instead of as the bad escape it is.
+  if (!DecodePercentEncoded(&path) && decode_escapes) return true;
+  return path.empty() || path[0] == '/';
+}
+
+enum class LocalPointerStatus { kResolved, kNotFound, kMalformedPercentEscape };
+struct LocalPointerResult {
+  LocalPointerStatus status;
+  const picojson::value* target;
+};
+
+static std::string MalformedPercentEscapeError(const std::string& uri) {
+  return "malformed percent escape in $ref \"" + uri +
+         "\": '%' must be followed by two hexadecimal digits";
+}
+
+// Decodes one RFC 6901 reference token in place: "~1" is "/" and "~0" is "~".
+// One left-to-right pass gives the order the spec fixes, so an encoded "~1"
+// stays text. False when a "~" carries anything else, which no pointer does.
+static bool DecodePointerToken(std::string* token) {
+  std::string decoded;
+  decoded.reserve(token->size());
+  for (size_t i = 0; i < token->size(); ++i) {
+    if ((*token)[i] != '~') {
+      decoded += (*token)[i];
+      continue;
+    }
+    if (i + 1 >= token->size()) return false;
+    const char escaped = (*token)[++i];
+    if (escaped == '0') {
+      decoded += '~';
+    } else if (escaped == '1') {
+      decoded += '/';
+    } else {
+      return false;
+    }
+  }
+  *token = std::move(decoded);
+  return true;
+}
+
+static bool DecodePercentEncoded(std::string* token) {
+  auto hex_value = [](char digit) {
+    if (digit >= '0' && digit <= '9') return digit - '0';
+    if (digit >= 'a' && digit <= 'f') return digit - 'a' + 10;
+    if (digit >= 'A' && digit <= 'F') return digit - 'A' + 10;
+    return -1;
+  };
+  std::string decoded;
+  decoded.reserve(token->size());
+  for (size_t i = 0; i < token->size(); ++i) {
+    if ((*token)[i] != '%') {
+      decoded += (*token)[i];
+      continue;
+    }
+    if (i + 2 >= token->size()) return false;
+    const int high = hex_value((*token)[i + 1]);
+    const int low = hex_value((*token)[i + 2]);
+    if (high < 0 || low < 0) return false;
+    decoded += static_cast<char>((high << 4) | low);
+    i += 2;
+  }
+  *token = std::move(decoded);
+  return true;
+}
+
+// Walks a local JSON pointer, one RFC 6901 token per "/". An empty token names
+// the "" member rather than nothing. The status distinguishes malformed percent
+// escapes from unresolved pointers; `missing` carries the token that stopped an
+// otherwise valid walk.
+static LocalPointerResult FindLocalPointerTarget(
+    const picojson::value& root,
+    const std::string& uri,
+    std::string* missing,
+    bool decode_escapes
+) {
+  if (uri == "#") return {LocalPointerStatus::kResolved, &root};
+  if (!IsLocalPointerUri(uri, decode_escapes)) return {LocalPointerStatus::kNotFound, nullptr};
+  const picojson::value* current = &root;
+  std::string path = uri.substr(1);
+  if (!DecodePercentEncoded(&path) && decode_escapes) {
+    return {LocalPointerStatus::kMalformedPercentEscape, nullptr};
+  }
+  for (size_t start = 0; start < path.size();) {
+    const size_t next = path.find('/', start + 1);
+    const std::string raw =
+        path.substr(start + 1, next == std::string::npos ? next : next - start - 1);
+    start = (next == std::string::npos) ? path.size() : next;
+    std::string token = raw;
+    if (!DecodePointerToken(&token) || !current->is<picojson::object>() ||
+        !current->contains(token)) {
+      if (missing != nullptr) *missing = raw;
+      return {LocalPointerStatus::kNotFound, nullptr};
+    }
+    current = &current->get(token);
+  }
+  return {LocalPointerStatus::kResolved, current};
+}
+
+// An "$id" below the document root declares a second resource, and a fragment
+// names a place inside the resource whose base URI it is resolved against. This
+// converter resolves every fragment against the document, so it can only honour
+// a document that is one resource. Answering per reference instead would have to
+// survive MergeAllOf and the folds, which copy subschemas between objects and
+// leave a reference somewhere it was not written; the question is settled here
+// instead, once, on the schema as written, where no later rewrite can reach it.
+//
+// Draft 4 spells the keyword "id", so a nested one declares a resource too. A
+// name map ($defs, properties) holds user-chosen names rather than keywords, and
+// const/enum/examples hold instance data, so neither declares anything.
+// How a keyword holds the subschemas it applies, if it holds any. Only a
+// keyword listed here is descended into: an unknown extension keyword such as
+// "x-meta" is an annotation whose value may be any JSON, so an "$id" inside it
+// is a member name and not an identifier. The same goes for const, enum,
+// default and examples, which hold instance data.
+enum class SchemaChildren { kNone, kOne, kList, kMap };
+
+static SchemaChildren ClassifyKeyword(const std::string& key) {
+  if (key == "additionalProperties" || key == "additionalItems" ||
+      key == "unevaluatedProperties" || key == "unevaluatedItems" || key == "contains" ||
+      key == "propertyNames" || key == "not" || key == "if" || key == "then" ||
+      key == "else" || key == "contentSchema") {
+    return SchemaChildren::kOne;
+  }
+  // "items" is one subschema in 2020-12 and a list of them in draft 7; kList
+  // takes either spelling.
+  if (key == "allOf" || key == "anyOf" || key == "oneOf" || key == "prefixItems" ||
+      key == "items") {
+    return SchemaChildren::kList;
+  }
+  // A map's keys are user-chosen names, never keywords. Draft 7 "dependencies"
+  // holds a subschema or a required-name list per member; a list holds no
+  // object, so walking it finds nothing.
+  if (key == "properties" || key == "patternProperties" || key == "$defs" ||
+      key == "definitions" || key == "dependentSchemas" || key == "dependencies") {
+    return SchemaChildren::kMap;
+  }
+  return SchemaChildren::kNone;
+}
+
+// Draft 6 renamed the identifier from "id" to "$id" and left "id" an ordinary
+// annotation, so which spelling names a resource is a property of the dialect
+// rather than of the subschema. Only the root's "$schema" says which dialect a
+// document is written in.
+enum class SchemaDialect { kModern, kLegacyId, kUnrecognized };
+
+// Matched against the metaschemas themselves, tolerating only the "#" suffix
+// and either scheme. A URI that merely spells a draft -- a vendor's
+// ".../draft-04-migration/v1" -- is not that draft.
+static SchemaDialect DetectDialect(const picojson::value& root, std::string* uri_out) {
+  if (!root.is<picojson::object>()) return SchemaDialect::kModern;
+  const auto& object = root.get<picojson::object>();
+  // Omitting "$schema" is how nearly every tool-call schema is written, and it
+  // means the current draft, whose identifier is "$id".
+  if (!object.count("$schema")) return SchemaDialect::kModern;
+  if (!object.at("$schema").is<std::string>()) return SchemaDialect::kUnrecognized;
+  std::string uri = object.at("$schema").get<std::string>();
+  *uri_out = uri;
+  if (!uri.empty() && uri.back() == '#') uri.pop_back();
+  if (uri.rfind("https://", 0) == 0) uri = "http://" + uri.substr(8);
+  if (uri == "http://json-schema.org/draft-04/schema") return SchemaDialect::kLegacyId;
+  if (uri == "http://json-schema.org/draft-06/schema" ||
+      uri == "http://json-schema.org/draft-07/schema" ||
+      uri == "http://json-schema.org/draft/2019-09/schema" ||
+      uri == "http://json-schema.org/draft/2020-12/schema") {
+    return SchemaDialect::kModern;
+  }
+  // Everything else is refused rather than read as a modern document. Draft 3
+  // is the reason: it names resources with "id" and puts subschemas under
+  // "extends" and inside "type"/"disallow", so assuming "$id" would walk past
+  // every resource it declares and resolve fragments against the wrong one in
+  // silence. Guessing is wrong the same way for any dialect this converter
+  // does not model, so no dialect is guessed at.
+  return SchemaDialect::kUnrecognized;
+}
+
+static std::optional<SchemaError> ScanSchema(
+    const picojson::value& schema,
+    bool is_root,
+    const char* identifier,
+    std::optional<ResourceDeclaration>* declared
+);
+
+static std::optional<SchemaError> ScanSchemaList(
+    const picojson::value& value,
+    const char* identifier,
+    std::optional<ResourceDeclaration>* declared
+) {
+  if (!value.is<picojson::array>()) {
+    return ScanSchema(value, /*is_root=*/false, identifier, declared);
+  }
+  for (const auto& item : value.get<picojson::array>()) {
+    if (auto err = ScanSchema(item, /*is_root=*/false, identifier, declared)) return err;
+  }
+  return std::nullopt;
+}
+
+static std::optional<SchemaError> ScanSchemaMap(
+    const picojson::value& value,
+    const char* identifier,
+    std::optional<ResourceDeclaration>* declared
+) {
+  if (!value.is<picojson::object>()) return std::nullopt;
+  const auto& object = value.get<picojson::object>();
+  for (const auto& key : object.ordered_keys()) {
+    if (auto err = ScanSchema(object.at(key), /*is_root=*/false, identifier, declared)) return err;
+  }
+  return std::nullopt;
+}
+
+static std::optional<SchemaError> ScanSchema(
+    const picojson::value& schema,
+    bool is_root,
+    const char* identifier,
+    std::optional<ResourceDeclaration>* declared
+) {
+  if (!schema.is<picojson::object>()) return std::nullopt;
+  const auto& object = schema.get<picojson::object>();
+  if (object.count(identifier)) {
+    const auto& id = object.at(identifier);
+    if (!id.is<std::string>()) {
+      return SchemaError(
+          SchemaErrorType::kInvalidSchema,
+          std::string("\"") + identifier + "\" must be a string"
+      );
+    }
+    // The root's identifier names the document, so it declares nothing to
+    // refuse -- but an unreadable one is unreadable there too, hence the type
+    // check above running either way. Engaged-but-empty is a declaration whose
+    // identifier is "", not the absence of one, so the first found is kept.
+    if (!is_root && !declared->has_value()) {
+      *declared = ResourceDeclaration{identifier, id.get<std::string>()};
+    }
+  }
+  for (const auto& key : object.ordered_keys()) {
+    const picojson::value& child = object.at(key);
+    std::optional<SchemaError> err;
+    switch (ClassifyKeyword(key)) {
+      case SchemaChildren::kNone:
+        continue;
+      case SchemaChildren::kOne:
+        err = ScanSchema(child, /*is_root=*/false, identifier, declared);
+        break;
+      case SchemaChildren::kList:
+        err = ScanSchemaList(child, identifier, declared);
+        break;
+      case SchemaChildren::kMap:
+        err = ScanSchemaMap(child, identifier, declared);
+        break;
+    }
+    if (err) return err;
+  }
+  return std::nullopt;
+}
+
+static std::optional<SchemaError> FindEmbeddedResource(
+    const picojson::value& root, std::optional<ResourceDeclaration>* declared
+) {
+  std::string uri;
+  const SchemaDialect dialect = DetectDialect(root, &uri);
+  if (dialect == SchemaDialect::kUnrecognized) {
+    return SchemaError(
+        SchemaErrorType::kUnsupportedSchema,
+        "unsupported \"$schema\" dialect: " + (uri.empty() ? std::string("(not a string)") : uri)
+    );
+  }
+  const char* identifier = dialect == SchemaDialect::kLegacyId ? "id" : "$id";
+  return ScanSchema(root, /*is_root=*/true, identifier, declared);
+}
+
+SchemaParser::SchemaParser(const picojson::value& root_schema, const Config& config)
+    : config_(config), root_schema_(root_schema) {
+  if (config_.reject_unsupported) {
+    embedded_resource_error_ = FindEmbeddedResource(root_schema_, &embedded_resource_);
+  }
+}
+
+// A member carrying nothing but a local $ref means exactly its target on every
+// draft. A $ref beside a sibling constraint does not: draft 7 ignores the
+// sibling and later drafts conjoin it, so the flatten refuses rather than pick.
+static bool IsBareLocalRef(const picojson::object& schema, bool decode_escapes) {
+  if (!schema.count("$ref") || !schema.at("$ref").is<std::string>()) return false;
+  const std::string& uri = schema.at("$ref").get<std::string>();
+  if (!IsLocalPointerUri(uri, decode_escapes)) return false;
+  for (const auto& key : schema.ordered_keys()) {
+    if (key == "$ref" || key == "$defs" || key == "definitions") continue;
+    if (!IsAnnotationKeyword(key)) return false;
+  }
+  return true;
+}
+
+// Several members may name one definition, so a set that doubles per level
+// would expand as 2^depth without a bound.
+constexpr int kMaxAllOfRefInlines = 64;
+
+// Collects a conjunction's contributors: a schema's own keywords, then each
+// allOf member's, in document order.
+struct AllOfFlattener {
+  const picojson::value& root;
+  bool reject_unsupported;
+  std::vector<picojson::object> contributors;
+  std::vector<std::string> ref_path;
+  int inline_budget = kMaxAllOfRefInlines;
+
+  std::optional<SchemaError> Collect(const picojson::object& schema);
+};
+
+// Every property name the schema can put in scope. An applicator names one just as
+// a sibling "properties" does, so "does this side add a name" sees through it.
+static std::vector<std::string> DeclaredPropertyNames(const picojson::object& schema) {
+  std::vector<std::string> names;
+  if (schema.count("properties") && schema.at("properties").is<picojson::object>()) {
+    names = schema.at("properties").get<picojson::object>().ordered_keys();
+  }
+  for (const char* applicator : {"anyOf", "oneOf", "allOf"}) {
+    if (!schema.count(applicator) || !schema.at(applicator).is<picojson::array>()) continue;
+    for (const auto& branch : schema.at(applicator).get<picojson::array>()) {
+      if (!branch.is<picojson::object>()) continue;
+      for (auto& name : DeclaredPropertyNames(branch.get<picojson::object>())) {
+        names.push_back(std::move(name));
+      }
+    }
+  }
+  return names;
+}
+
+// additionalProperties and the items family govern what their own object leaves
+// unnamed, so flattening reclassifies the other side's names as named and the flat
+// object accepts what the closing side rejects. `construct` names the error text.
+static std::optional<SchemaError> CheckFlattenPreservesBoundaries(
+    const std::vector<const picojson::object*>& contributors, const std::string& construct
+) {
+  const size_t n = contributors.size();
+  std::vector<bool> object_closed(n, false), array_closed(n, false);
+  size_t pattern_properties = 0, prefix_items = 0;
+  bool any_object_closed = false;
+  for (size_t i = 0; i < n; ++i) {
+    object_closed[i] = contributors[i]->count("additionalProperties") &&
+                       !SubschemaIsNoOp(contributors[i]->at("additionalProperties"));
+    any_object_closed = any_object_closed || object_closed[i];
+    for (const char* keyword : {"items", "additionalItems", "unevaluatedItems"}) {
+      if (contributors[i]->count(keyword) && !SubschemaIsNoOp(contributors[i]->at(keyword))) {
+        array_closed[i] = true;
+      }
+    }
+    pattern_properties += contributors[i]->count("patternProperties");
+    prefix_items += contributors[i]->count("prefixItems");
+  }
+
+  // One walk per contributor, not one per ordered pair: a name any other side
+  // declares is exactly a name in the union that this side does not declare.
+  std::vector<std::unordered_set<std::string>> declared(n);
+  std::vector<std::string> all_names;
+  if (any_object_closed) {
+    std::unordered_set<std::string> seen;
+    for (size_t i = 0; i < n; ++i) {
+      for (auto& name : DeclaredPropertyNames(*contributors[i])) {
+        declared[i].insert(name);
+        if (seen.insert(name).second) all_names.push_back(std::move(name));
+      }
+    }
+  }
+
+  for (size_t i = 0; i < n; ++i) {
+    // This needs the set every applicator evaluated, which a flat object no longer
+    // records. Nothing flattens into a lone contributor, so only a conjunction fails.
+    if (n > 1 && contributors[i]->count("unevaluatedProperties") &&
+        !SubschemaIsNoOp(contributors[i]->at("unevaluatedProperties"))) {
+      return SchemaError(
+          SchemaErrorType::kUnsupportedSchema,
+          construct + " cannot flatten under a restricting unevaluatedProperties"
+      );
+    }
+    if (object_closed[i]) {
+      if (pattern_properties > contributors[i]->count("patternProperties")) {
+        return SchemaError(
+            SchemaErrorType::kUnsupportedSchema,
+            construct + " forbids unlisted properties on one side while another sets " +
+                "patternProperties"
+        );
+      }
+      for (const auto& name : all_names) {
+        if (declared[i].count(name)) continue;
+        return SchemaError(
+            SchemaErrorType::kUnsupportedSchema,
+            construct + " forbids unlisted properties on one side while another declares \"" +
+                name + "\""
+        );
+      }
+    }
+    if (array_closed[i] && prefix_items > contributors[i]->count("prefixItems")) {
+      return SchemaError(
+          SchemaErrorType::kUnsupportedSchema,
+          construct + " forbids extra items on one side while another sets prefixItems"
+      );
+    }
+  }
+  return std::nullopt;
+}
+
+// Parse dispatches on these ahead of everything else and ignores the rest, so a
+// flatten pairing one with another side's constraint would drop it.
+static std::optional<SchemaError> CheckExclusiveKeywordsUnmixed(
+    const picojson::object& merged,
+    const std::unordered_map<std::string, size_t>& key_source,
+    const std::string& construct
+) {
+  for (const char* exclusive : {"$ref", "const", "enum"}) {
+    if (!merged.count(exclusive)) continue;
+    const size_t owner = key_source.at(exclusive);
+    for (const auto& key : merged.ordered_keys()) {
+      if (key == exclusive || IsNoConstraintKeyword(key) || key_source.at(key) == owner) continue;
+      return SchemaError(
+          SchemaErrorType::kUnsupportedSchema,
+          construct + " combines \"" + exclusive + "\" with \"" + key + "\" from another side"
+      );
+    }
+  }
+  return std::nullopt;
+}
+
 Result<SchemaSpecPtr, SchemaError> SchemaParser::Parse(
     const picojson::value& schema,
     const std::string& rule_name_hint,
     std::optional<std::string> default_type
 ) {
+  // Ahead of the cache, so no hit can carry a refused document past it.
+  if (auto err = CheckDocumentIsOneResource()) return ResultErr(std::move(*err));
+
   std::string cache_key = ComputeCacheKey(schema);
+  if (default_type.has_value()) {
+    // The same schema text parses differently under a default type (a bare {}
