+// Matches the rest of a JSON key after its opening quote, for any key except the
+// names in the trie, however the key spells them. A trie edge takes every spelling
+// of its codepoint, so no escape respells an excluded name into the key; a key
+// leaves the trie through the one spelling the regex converter writes for a
+// codepoint off every edge, which narrows only the redundant spellings there.
+std::string BuildTrieBody(const TrieNode& node, const std::string& required_escapes) {
+  std::string result;
+  auto add = [&](const std::string& body) {
+    if (!result.empty()) result += " | ";
+    result += body;
+  };
+  if (!node.is_terminal) add("\"\\\"\"");
+
+  std::string members;
+  for (const auto& [codepoint, _] : node.children) {
+    AppendEscapedCodepoint(&members, codepoint, "]\\^-");
+  }
+  add("(" +
+      RegexToEBNF("[^" + members + "]", false, kQuotedJSONForbidden, "", true, required_escapes) +
+      ") " + JSONSchemaConverter::kBasicStringSub);
+
+  for (const auto& [codepoint, child] : node.children) {
+    add(JSONCharSpellings(codepoint, required_escapes) + " " +
+        BuildTrieBody(child, required_escapes));
+  }
+  return "(" + result + ")";
