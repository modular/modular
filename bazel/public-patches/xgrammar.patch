+std::optional<SchemaError> AllOfFlattener::Collect(const picojson::object& schema) {
+  picojson::object own = schema;
+  own.erase("allOf");
+  // A no-op own half is not a contributor: it would inflate the count that the
+  // checks below read as "something folds into something else".
+  if (!SubschemaIsNoOp(own)) contributors.push_back(std::move(own));
+
+  if (!schema.count("allOf")) return std::nullopt;
+  if (!schema.at("allOf").is<picojson::array>()) {
+    return SchemaError(SchemaErrorType::kInvalidSchema, "allOf must be an array");
+  }
+
+  for (const auto& member : schema.at("allOf").get<picojson::array>()) {
+    if (member.is<bool>()) {
+      if (member.get<bool>()) continue;
+      return SchemaError(
+          SchemaErrorType::kUnsatisfiableSchema, "allOf member false accepts no value"
+      );
+    }
+    if (!member.is<picojson::object>()) {
+      return SchemaError(
+          SchemaErrorType::kInvalidSchema, "allOf member must be an object or a bool"
+      );
+    }
+    if (SubschemaIsNoOp(member)) continue;
+
+    const picojson::object& member_obj = member.get<picojson::object>();
+    if (IsBareLocalRef(member_obj)) {
+      const std::string& uri = member_obj.at("$ref").get<std::string>();
+      if (!refs_reach_root) {
+        return SchemaError(
+            SchemaErrorType::kUnsupportedSchema,
+            "allOf member \"" + uri + "\" resolves against an \"$id\" the flatten does not track"
+        );
+      }
+      if (std::find(ref_path.begin(), ref_path.end(), uri) != ref_path.end()) {
+        return SchemaError(
+            SchemaErrorType::kUnsupportedSchema,
+            "allOf member \"" + uri + "\" reaches itself, so the flatten does not terminate"
+        );
+      }
+      if (inline_budget <= 0) {
+        return SchemaError(
+            SchemaErrorType::kUnsupportedSchema, "allOf reaches too many $ref members to flatten"
+        );
+      }
+      const picojson::value* target = FindLocalPointerTarget(root, uri, nullptr);
+      if (target != nullptr && target->is<bool>()) {
+        if (target->get<bool>()) continue;
+        return SchemaError(
+            SchemaErrorType::kUnsatisfiableSchema, "allOf member \"" + uri + "\" accepts no value"
+        );
+      }
+      if (target != nullptr && target->is<picojson::object>()) {
+        --inline_budget;
+        ref_path.push_back(uri);
+        auto err = Collect(target->get<picojson::object>());
+        ref_path.pop_back();
+        if (err) return err;
+        continue;
+      }
+      // An unresolvable pointer stays put for the dispatch-exclusive check to judge.
+    }
+    if (auto err = Collect(member_obj)) return err;
+  }
+  return std::nullopt;
+}
