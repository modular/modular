+Result<AnyOfSpec, SchemaError> SchemaParser::ParseOneOf(const picojson::object& schema) {
+  if (!schema.at("oneOf").is<picojson::array>()) {
+    return ResultErr<SchemaError>(SchemaErrorType::kInvalidSchema, "oneOf must be an array");
+  }
+
+  const auto& options = schema.at("oneOf").get<picojson::array>();
+  if (options.empty()) {
+    // No branch can be satisfied, so no approximation exists to fall back to.
+    return ResultErr<SchemaError>(SchemaErrorType::kUnsatisfiableSchema, "oneOf has no branch");
+  }
+
+  // Prove before ParseAnyOf folds the base keywords in: folding only narrows, and
+  // narrowing cannot create an overlap the declared branches did not have.
+  if (!TryProvePairwiseDisjointOneOf(options, &work_remaining_)) {
+    return ResultErr<SchemaError>(
+        SchemaErrorType::kUnsupportedSchema,
+        "unsupported schema keyword: oneOf with overlapping or non-provably-disjoint branches"
+    );
+  }
+
+  // Disjoint branches make at-least-one the same language as exactly-one, so
+  // reuse anyOf's lowering and inherit its base-keyword fold.
+  return ParseAnyOf(schema, "oneOf");
+}
