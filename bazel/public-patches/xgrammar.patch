+GrammarMatcherForTokenMaskCache::LookaheadSuffixMatcher::Result
+GrammarMatcherForTokenMaskCache::MatchLookaheadSuffix(int offset, std::string_view suffix) {
+  using Result = LookaheadSuffixMatcher::Result;
+  if (static_cast<int>(lookahead_suffix_matchers_.size()) <= offset) {
+    lookahead_suffix_matchers_.resize(offset + 1);
+  }
+  auto& m = lookahead_suffix_matchers_[offset];
+  if (m.parser == nullptr) {
+    auto lookahead_assertion_id = grammar_->GetRule(init_rule_id_).lookahead_assertion_id;
+    m.parser = std::make_unique<EarleyParser>(
+        grammar_,
+        ParserState(/*rule_id*/ -1, lookahead_assertion_id, 0, ParserState::kNoPrevInputPos, 0)
+    );
+  }
+  int lcp_len =
+      std::mismatch(suffix.begin(), suffix.end(), m.prev_suffix.begin(), m.prev_suffix.end())
+          .first -
+      suffix.begin();
+  m.prev_suffix = suffix;
+  // The outcome is fixed by the first `matched` characters when the previous suffix completed
+  // the lookahead there, or by the first `matched + 1` when its next character was rejected.
+  if (m.prev_result == Result::kCompleted && lcp_len >= m.matched) {
+    return Result::kCompleted;
+  }
+  if (m.prev_result == Result::kRejected && lcp_len > m.matched) {
+    return Result::kRejected;
+  }
+  if (lcp_len < m.matched) {
+    m.parser->PopLastStates(m.matched - lcp_len);
+    m.matched = lcp_len;
+  }
+  // No prefix of length <= matched completes the lookahead: a completion would have stopped the
+  // previous suffix there.
+  m.prev_result = Result::kConsumed;
+  for (int pos = m.matched; pos < static_cast<int>(suffix.size()); ++pos) {
+    if (!m.parser->Advance(suffix[pos])) {
+      m.prev_result = Result::kRejected;
+      break;
+    }
+    ++m.matched;
+    if (m.parser->IsCompleted()) {
+      m.prev_result = Result::kCompleted;
+      break;
+    }
+  }
+  return m.prev_result;
+}
+
+bool GrammarMatcherForTokenMaskCache::InitFirstElementSplit() {
+  using GrammarExprType = Grammar::Impl::GrammarExprType;
+  if (split_state_ != -1) {
+    return split_state_ == 1;
+  }
+  split_state_ = 0;
+  if (first_element_store_ == nullptr) {
+    return false;
+  }
+  auto lookahead_assertion_id = grammar_->GetRule(init_rule_id_).lookahead_assertion_id;
+  auto lookahead = grammar_->GetGrammarExpr(lookahead_assertion_id);
+  if (lookahead.type != GrammarExprType::kSequence || lookahead.size() == 0) {
+    return false;
+  }
+  auto first = grammar_->GetGrammarExpr(lookahead[0]);
+  if (first.type != GrammarExprType::kRuleRef) {
+    return false;
+  }
+  int32_t rule_id = first[0];
+  auto rule_hash = GrammarFSMHasher::HashRule(grammar_, rule_id);
+  if (!rule_hash.has_value() || !grammar_->per_rule_fsms[rule_id].has_value()) {
+    return false;
+  }
+  split_first_rule_id_ = rule_id;
+  split_first_rule_hash_ = rule_hash.value();
+  split_rest_parser_ = std::make_unique<EarleyParser>(
+      grammar_,
+      ParserState(/*rule_id*/ -1, lookahead_assertion_id, 1, ParserState::kNoPrevInputPos, 0)
+  );
+  split_rest_is_nullable_ = split_rest_parser_->IsCompleted();
+  for (int ch = 0; ch < 256; ++ch) {
+    if (split_rest_parser_->Advance(static_cast<uint8_t>(ch))) {
+      split_rest_first_bytes_.set(ch);
+      split_rest_parser_->PopLastStates(1);
+    }
+  }
+  split_state_ = 1;
+  return true;
+}
+
+const FirstElementMatchStore::Chunk& GrammarMatcherForTokenMaskCache::GetFirstElementChunk(
+    int offset, uint8_t first_byte
+) {
+  const auto& fsm = grammar_->per_rule_fsms[split_first_rule_id_].value();
+  // Consecutive lookups at the same offset and first byte reuse the last chunk without taking the
+  // store's lock.
+  if (split_last_chunk_ != nullptr && split_last_offset_ == offset &&
+      split_last_first_byte_ == first_byte) {
+    return *split_last_chunk_;
+  }
+  auto build = [&](FirstElementMatchStore::Chunk* chunk) {
+    // Suffixes at a fixed offset of tokens with one first byte arrive in sorted order, so the
+    // parser only re-advances past the prefix shared with the previous suffix.
+    const auto& sorted_decoded_vocab = tokenizer_info_.GetSortedDecodedVocab();
+    auto before = [](const std::pair<int32_t, std::string>& entry, int byte) {
+      return entry.second.empty() || static_cast<uint8_t>(entry.second[0]) < byte;
+    };
+    int32_t begin =
+        std::lower_bound(
+            sorted_decoded_vocab.begin(), sorted_decoded_vocab.end(), first_byte, before
+        ) -
+        sorted_decoded_vocab.begin();
+    int32_t end = std::lower_bound(
+                      sorted_decoded_vocab.begin() + begin,
+                      sorted_decoded_vocab.end(),
+                      first_byte + 1,
+                      before
+                  ) -
+                  sorted_decoded_vocab.begin();
+    chunk->begin = begin;
+    chunk->start.reserve(end - begin + 1);
+    EarleyParser parser(
+        grammar_,
+        ParserState(
+            split_first_rule_id_,
+            ParserState::kUnexpandedRuleStartSequenceId,
+            0,
+            ParserState::kNoPrevInputPos,
+            0
+        )
+    );
+    std::vector<uint8_t> can_end = {static_cast<uint8_t>(parser.IsCompleted())};
+    std::string_view prev_suffix;
+    int matched = 0;
+    bool prev_rejected = false;
+    for (int32_t i = begin; i < end; ++i) {
+      std::string_view token(sorted_decoded_vocab[i].second);
+      std::string_view suffix =
+          static_cast<int>(token.size()) >= offset ? token.substr(offset) : std::string_view();
+      int lcp_len =
+          std::mismatch(suffix.begin(), suffix.end(), prev_suffix.begin(), prev_suffix.end())
+              .first -
+          suffix.begin();
+      prev_suffix = suffix;
+      // A suffix that shares the character the previous one was rejected at is rejected there too.
+      if (!(prev_rejected && lcp_len > matched)) {
+        if (lcp_len < matched) {
+          parser.PopLastStates(matched - lcp_len);
+          can_end.resize(lcp_len + 1);
+          matched = lcp_len;
+        }
+        prev_rejected = false;
+        for (int pos = matched; pos < static_cast<int>(suffix.size()); ++pos) {
+          if (!parser.Advance(suffix[pos])) {
+            prev_rejected = true;
+            break;
+          }
+          can_end.push_back(parser.IsCompleted());
+          ++matched;
+        }
+      }
+      chunk->start.push_back(chunk->flags.size());
+      chunk->flags.insert(chunk->flags.end(), can_end.begin(), can_end.begin() + matched + 1);
+    }
+    chunk->start.push_back(chunk->flags.size());
+  };
+  split_last_chunk_ = first_element_store_->GetOrBuild(
+      {split_first_rule_hash_, fsm.GetNodeNum(), fsm.GetEdgeNum(), offset, first_byte}, build
+  );
+  split_last_offset_ = offset;
+  split_last_first_byte_ = first_byte;
+  return *split_last_chunk_;
+}
+
+GrammarMatcherForTokenMaskCache::LookaheadSuffixMatcher::Result
+GrammarMatcherForTokenMaskCache::MatchBySplit(
+    int32_t sorted_index, int offset, const std::string& token
+) {
+  using Result = LookaheadSuffixMatcher::Result;
+  const auto& chunk = GetFirstElementChunk(offset, static_cast<uint8_t>(token[0]));
+  int32_t local = sorted_index - chunk.begin;
+  XGRAMMAR_DCHECK(local >= 0 && local + 1 < static_cast<int32_t>(chunk.start.size()));
+  const uint8_t* can_end = chunk.flags.data() + chunk.start[local];
+  int first_matched = static_cast<int>(chunk.start[local + 1] - chunk.start[local]) - 1;
+  std::string_view suffix = std::string_view(token).substr(offset);
+  int suffix_len = static_cast<int>(suffix.size());
+  bool consumed = first_matched == suffix_len;
+  for (int j = 0; j <= first_matched; ++j) {
+    if (!can_end[j]) {
+      continue;
+    }
+    // j == 0 with an empty rest would make the lookahead nullable, which the caller handles.
+    if (split_rest_is_nullable_ && j > 0) {
+      return Result::kCompleted;
+    }
+    if (j == suffix_len) {
+      consumed = true;
+      continue;
+    }
+    if (!split_rest_first_bytes_[static_cast<uint8_t>(suffix[j])]) {
+      continue;
+    }
+    int advanced = 0;
+    bool completed = false;
+    for (int pos = j; pos < suffix_len; ++pos) {
+      if (!split_rest_parser_->Advance(suffix[pos])) {
+        break;
+      }
+      ++advanced;
+      if (split_rest_parser_->IsCompleted()) {
+        completed = true;
+        break;
+      }
+    }
+    if (advanced > 0) {
+      split_rest_parser_->PopLastStates(advanced);
+    }
+    if (completed) {
+      return Result::kCompleted;
+    }
+    if (j + advanced == suffix_len) {
+      consumed = true;
+    }
+  }
+  return consumed ? Result::kConsumed : Result::kRejected;
+}
