+void GrammarFSMHasherImpl::HashLookaheadReferences() {
+  using GrammarExprType = Grammar::Impl::GrammarExprType;
+  auto& impl = *grammar_->ImplPtr();
+  const int32_t num_rules = impl.NumRules();
+  impl.per_rule_content_hashes.assign(num_rules, std::nullopt);
+  std::vector<bool> attempted(num_rules, false);
+  for (int32_t i = 0; i < num_rules; ++i) {
+    int32_t lookahead_id = impl.GetRule(i).lookahead_assertion_id;
+    if (lookahead_id == -1) {
+      continue;
+    }
+    for (int32_t element_id : impl.GetGrammarExpr(lookahead_id)) {
+      auto element = impl.GetGrammarExpr(element_id);
+      if (element.type != GrammarExprType::kRuleRef && element.type != GrammarExprType::kRepeat) {
+        continue;
+      }
+      int32_t ref_rule_id = element[0];
+      if (CompleteFsmHash(impl, ref_rule_id).has_value() || attempted[ref_rule_id]) {
+        continue;
+      }
+      attempted[ref_rule_id] = true;
+      impl.per_rule_content_hashes[ref_rule_id] = HashReachableRules(ref_rule_id);
+    }
   }
