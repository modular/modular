load("//bazel:api.bzl", "modular_py_binary", "modular_run_binary_test", "requirement")

package(default_visibility = ["//visibility:private"])

# layer-comparison.mdx loads this sample in its hidden setup.
exports_files(
    ["layer_comparison.py"],
    visibility = ["//max/docs/site/code/mdx_examples:__pkg__"],
)

# layer_comparison.py
modular_py_binary(
    name = "layer_comparison",
    srcs = ["layer_comparison.py"],
    # Eager ops use the optional _interpreter_ops kernels at runtime.
    # Without them, every eager op falls back to a full graph compile.
    ignore_extra_deps = ["//max/python/max/_interpreter_ops"],
    imports = ["."],
    deps = [
        "//max/python/max/_interpreter_ops",
        "//max/python/max/dtype",
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        requirement("numpy"),
        requirement("torch"),
    ],
)

modular_run_binary_test(
    name = "layer_comparison_test",
    size = "large",
    binary = "layer_comparison",
    tags = ["skip-ci-asan"],
    # FIXME: MOCO-3663 — doc example tests consistently timeout on remote macOS workers
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
