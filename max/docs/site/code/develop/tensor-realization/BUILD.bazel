load("//bazel:api.bzl", "modular_py_binary", "modular_run_binary_test")

package(default_visibility = ["//visibility:private"])

# functional_layer.py
modular_py_binary(
    name = "functional_layer",
    srcs = ["functional_layer.py"],
    imports = ["."],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/experimental/nn",
    ],
)

modular_run_binary_test(
    name = "functional_layer_test",
    size = "large",
    binary = "functional_layer",
    tags = ["skip-ci-asan"],
    # Incompatible with macOS: these doc-example tests time out on remote macOS CI workers; Linux CI provides equivalent coverage.
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
