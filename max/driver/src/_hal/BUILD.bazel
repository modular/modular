load("//bazel:api.bzl", "mojo_library")

package(default_visibility = ["//max:consumers"])

# Staged into the stdlib overlay under --config=hal-device-context (see
# mojo/stdlib/std/BUILD.bazel).
exports_files(glob([
    "*.mojo",
    "execution_config/*.mojo",
]))

# Base `_hal` sources. Downstream builds overlay backend-specific files onto
# this tree to extend device support (see the `_hal` overlay in
# @plugin//max/driver/src).
filegroup(
    name = "_hal_srcs",
    srcs = glob(["**/*.mojo"]),
    tags = ["maybe-unused"],  # Consumed by external plugin repos.
    visibility = ["//visibility:public"],
)

mojo_library(
    name = "_hal",
    srcs = [":_hal_srcs"],
    deps = [
        "//max:machine",
        "@mojo//:std",
    ],
)
