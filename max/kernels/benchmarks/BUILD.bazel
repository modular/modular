# --- SM100 FA4 warp-specialized (WS) vs baseline A/B benches ---
# Execute on a remote B200 via `bazel test --config=remote-b200[-benchmark] ...`
# (mojo_test so the run is a remote *test action*; `bazel run` would execute locally).
# Comptime cells (each a separate compiled target): FA4_FORCE_CONFIG (0=auto, 1=WS,
# 2=baseline) x FA4_WS_SPLITK_FORCE (P) x depth. Baseline (run_base, FORCE=2) comptime-kills
# the WS block (dispatch.mojo:558-559) -> byte-identical to main's selected non-WS path.
# Runtime shape (seq_len/num_keys/cache_len/batch_size) is forwarded per invocation via
# `--test_arg=--name=value` (arg_parse matches "--<name>=", internal_utils/_utils.mojo:205);
# always add `--nocache_test_results` for a benchmark. See plan crystalline-leaping-sunrise.md.
#
# The `run_wse*` / `*_g16` cells are the Layout-E (BM=64, m_pack=2) split-K
# threshold campaign (Phase 4). All are group=16: `_G16` bakes `group=16`
# (read by bench_mha; num_heads=32 default => kv=2) and `num_kv_heads=2` (read by
# the ragged bench; num_q_heads=32 default => group=16). Each bench ignores the
# other's unused define, so one cell drives both vehicles. Bench at seq=4 =>
# group*seq=64 = one fully-packed BM=64 tile. `run_wse*` force Layout-E
# (FA4_FORCE_CONFIG=3) at P in {1,2,4,6,8,10,16} to find the min-keys/partition
# crossovers; the `*_g16` comparators force Layout-G / baseline / auto at the
# same g16 shape for the ladder-boundary check.
_G16 = [
    "-D",
    "group=16",
    "-D",
    "num_kv_heads=2",
]

# Also group=16 but with num_q_heads=16 / num_kv_heads=1 (16 q-heads fused onto
# 1 kv-head), the absolute head counts matter: num_heads_sched = num_kv_heads
# sets the split-K grid (= tiles * num_kv_heads * batch), so 1 kv-head gives a
# smaller grid than `_G16`'s 2 and the wave-fit guard admits a larger cluster P.
# Ragged bench only (num_q_heads/num_kv_heads are its defines; bench_mha ignores
# them and keeps its own defaults, so its variant of this cell is unused).
_G16_1KV = [
    "-D",
    "num_q_heads=16",
    "-D",
    "num_kv_heads=1",
]

_FA4_WS_CELLS = {
    "run_auto": [
        "-D",
        "FA4_FORCE_CONFIG=0",
    ],
    "run_ws": [
        "-D",
        "FA4_FORCE_CONFIG=1",
    ],
    "run_ws_p2": [
        "-D",
        "FA4_FORCE_CONFIG=1",
        "-D",
        "FA4_WS_SPLITK_FORCE=2",
    ],
    "run_ws_p4": [
        "-D",
        "FA4_FORCE_CONFIG=1",
        "-D",
        "FA4_WS_SPLITK_FORCE=4",
    ],
    "run_base": [
        "-D",
        "FA4_FORCE_CONFIG=2",
    ],
    # Layout-E (BM=64) forced single-CTA, P in {1,2,4,6,8,10,16}.
    "run_wse": [
        "-D",
        "FA4_FORCE_CONFIG=3",
    ] + _G16,
    "run_wse_p2": [
        "-D",
        "FA4_FORCE_CONFIG=3",
        "-D",
        "FA4_WS_SPLITK_FORCE=2",
    ] + _G16,
    "run_wse_p4": [
        "-D",
        "FA4_FORCE_CONFIG=3",
        "-D",
        "FA4_WS_SPLITK_FORCE=4",
    ] + _G16,
    "run_wse_p6": [
        "-D",
        "FA4_FORCE_CONFIG=3",
        "-D",
        "FA4_WS_SPLITK_FORCE=6",
    ] + _G16,
    "run_wse_p8": [
        "-D",
        "FA4_FORCE_CONFIG=3",
        "-D",
        "FA4_WS_SPLITK_FORCE=8",
    ] + _G16,
    "run_wse_p10": [
        "-D",
        "FA4_FORCE_CONFIG=3",
        "-D",
        "FA4_WS_SPLITK_FORCE=10",
    ] + _G16,
    "run_wse_p16": [
        "-D",
        "FA4_FORCE_CONFIG=3",
        "-D",
        "FA4_WS_SPLITK_FORCE=16",
    ] + _G16,
    # g16 comparators for the ladder-boundary check (Layout-E vs these at seq=4).
    "run_wsg_g16": [
        "-D",
        "FA4_FORCE_CONFIG=1",
    ] + _G16,
    "run_base_g16": [
        "-D",
        "FA4_FORCE_CONFIG=2",
    ] + _G16,
    "run_auto_g16": [
        "-D",
        "FA4_FORCE_CONFIG=0",
    ] + _G16,
    # Auto dispatch at num_q_heads=16 / num_kv_heads=1 for a "vs main" sweep:
    # on this branch (seq=4 => single BM=64 tile) auto routes to Layout-E; on
    # main (no Layout-E) it routes to 1Q (BM=128). Same cell, both behaviors.
    "run_auto_g16_1kv": [
        "-D",
        "FA4_FORCE_CONFIG=0",
    ] + _G16_1KV,
}

