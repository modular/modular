load("//bazel:api.bzl", "mojo_library")
load("//max/kernels/src:deprecations.bzl", "IGNORED_POINTER_DEPRECATIONS")

package(default_visibility = ["//max:consumers"])

# Raw sources for the LSP parse-smoke test and for plugin overlays.
filegroup(
    name = "srcs",
    srcs = glob(["**/*.mojo"]),
    visibility = [
        "//Mojo/test/mojo-lsp-server/parse-tree:__pkg__",
        "//plugins:__subpackages__",
    ],
)

mojo_library(
    name = "nn",
    srcs = glob(["**/*.mojo"]),
    docs_base_path = "kernels",
    ignore_deprecated = IGNORED_POINTER_DEPRECATIONS,
    use_production_compiler_for_asan = True,
    validate_missing_docs = False,
    deps = [
        "//max:_cudnn",
        "//max:_cufft",
        "//max:_miopen",
        "//max:algorithm",
        "//max:comm",
        "//max:extensibility",
        "//max:kv_cache",
        "//max:layout",
        "//max:linalg",
        "//max:max_mojo",
        "//max:quantization",
        "//max:shmem",
        "//max:structured_kernels",
        "@mojo//:std",
    ],
)

# Mach's engine-kv tests read these to pin its dispatch against the kernels.
filegroup(
    name = "sm100_attention_sources",
    srcs = glob(["attention/gpu/nvidia/sm100/*.mojo"]),
    visibility = ["//mach:__subpackages__"],
)

# Mach's engine-kv tests read this to pin its HIP capture mirror against it.
exports_files(
    ["attention/gpu/mha_decode_partition_heuristic.mojo"],
    visibility = ["//mach:__subpackages__"],
)
