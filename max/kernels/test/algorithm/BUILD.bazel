load("//bazel:api.bzl", "mojo_test")
load("//max/kernels/src:deprecations.bzl", "IGNORED_POINTER_DEPRECATIONS_COPTS")

package(default_visibility = ["//max:consumers"])

_EXTRA_DEPS = {
    "test_rowwise_public_reduce.mojo": [
        "//max/kernels/test/common/rowwise_reduce_test_utils",
    ],
}

[
    mojo_test(
        name = src + ".test",
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        deps = [
            "//max:algorithm",
            "//max:builtin_kernels",
            "//max:layout",
            "//max:max_mojo",
            "@mojo//:std",
        ] + _EXTRA_DEPS.get(src, []),
    )
    for src in glob(["**/*.mojo"])
]
