# Regular tests for all other files
[
    mojo_test(
        name = src + ".test",
        size = "medium",  # MI355s only need small
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        enable_assertions = src not in DISABLE_ASSERTIONS_TESTS,
        exec_properties = {
            "test.resources:gpu-memory": _GPU_MEMORY.get(src, "3"),
        },
        main = src,
        tags = ["gpu"],
        target_compatible_with = _TARGET_COMPATIBLE_WITH.get(
            src,
            [
                "//:has_gpu",
                "//:has_multi_gpu",
            ],
        ),
        deps = [
            "//max:internal_utils",
            "//max:kv_cache",
            "//max:linalg",
            "//max:max_mojo",
            "//max:nn",
            "//max:quantization",
            "//max:shmem",
            "@mojo//:std",
        ],
    )
    for src in glob(
        ["**/*.mojo"],
        exclude = [
            "test_multimem_allreduce.mojo",
            "test_multimem_reducescatter.mojo",
            "test_allreduce_residual_rmsnorm.mojo",  # Has its own standalone rule above
            "test_enum_like_conformance.mojo",  # Has its own standalone rule below
            "test_bundled_allreduce_build_graph.mojo",  # Has its own standalone rule above
            "test_blocking_driver_calls.mojo",  # One rule per round, below
        ],
    )
]

# One driver call per round, landed in a collective's launch window on the
# worker a peer's launch is pinned to. The driver does its own blocking, so a
# round reproduces a deadlock only if the call really waits for a busy device.
#
# `pageable_copy` deadlocks today: the copy waits out device 0's whole spin
# bound. It is manual until the runtime survives it, and a fix moves it into
# `_BLOCKING_CALL_ROUNDS_PASSING`.
_BLOCKING_CALL_ROUNDS_PASSING = [
    "control",
    "device_free",
]

_BLOCKING_CALL_ROUNDS_HANGING = ["pageable_copy"]

[
    mojo_test(
        name = "test_blocking_driver_calls_" + round + ".mojo.test",
        size = "large",
        srcs = ["test_blocking_driver_calls.mojo"],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        env = {"BLOCKING_CALL": round},
        exec_properties = {
            "test.resources:gpu-memory": "4",
        },
        main = "test_blocking_driver_calls.mojo",
        tags = ["gpu"] + (["manual"] if round in _BLOCKING_CALL_ROUNDS_HANGING else []),
        target_compatible_with = [
            "//:has_gpu",
            "//:has_multi_gpu",
        ],
        deps = [
            "//max:comm",
            "//max:max_mojo",
            "@mojo//:std",
        ],
    )
    for round in _BLOCKING_CALL_ROUNDS_PASSING + _BLOCKING_CALL_ROUNDS_HANGING
]

# The hanging rounds are `manual`, so this non-manual build_test keeps them in
# the build graph.
build_test(
    name = "blocking_driver_calls_build_test",
    tags = ["gpu"],
    targets = [
        "test_blocking_driver_calls_" + round + ".mojo.test"
        for round in _BLOCKING_CALL_ROUNDS_HANGING
    ],
)

