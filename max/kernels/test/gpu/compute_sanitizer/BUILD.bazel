load("//bazel:api.bzl", "mojo_test")
load("//max/kernels/src:deprecations.bzl", "IGNORED_POINTER_DEPRECATIONS_COPTS")

package(default_visibility = ["//max:consumers"])

exports_files([
    "classify_synccheck.py",
    "run_sanitizer.sh",
    "stress_schedule.sh",
])

# Positive control for the compute-sanitizer lanes. This target intentionally
# performs an out-of-bounds global write and therefore only "passes" when run
# under `compute-sanitizer --tool memcheck --error-exitcode 1` (which turns the
# finding into a non-zero exit). It is tagged `manual` so it is excluded from
# `//...` and `//max/kernels/test/gpu/...` wildcard expansion -- it must never
# run in the normal GPU suite or the nightly sanitizer lane. Invoke it
# explicitly to validate that a sanitizer lane catches real bugs:
#
#   ./bazelw test --config=cs-memcheck \
#     //max/kernels/test/gpu/compute_sanitizer:positive_control_memcheck_oob.mojo.test
mojo_test(
    name = "positive_control_memcheck_oob.mojo.test",
    srcs = ["positive_control_memcheck_oob.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    tags = [
        "gpu",
        "manual",
    ],
    target_compatible_with = ["//:has_gpu"],
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

# Negative control for the compute-sanitizer `synccheck` lane. Both kernels are
# CORRECT -- they rendezvous on a `named_barrier` from two program points, which
# PTX permits and synccheck's single-instruction-address model does not. Running
# it under synccheck is the standing proof that the SM100 attention/MLA barrier
# findings are tool noise, and it is what the findings classifier in
# `run_sanitizer.sh` is calibrated against:
#
#   CS=max/kernels/test/gpu/compute_sanitizer
#   $CS/run_sanitizer.sh synccheck \
#     //$CS:negative_control_synccheck_named_barrier.mojo.test
#
# `named_barrier` is NVIDIA-only. Tagged `manual` -- never runs in the normal
# suite or in a sweep's wildcard expansion.
mojo_test(
    name = "negative_control_synccheck_named_barrier.mojo.test",
    srcs = ["negative_control_synccheck_named_barrier.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    tags = [
        "gpu",
        "manual",
    ],
    target_compatible_with = [
        "//:has_gpu",
        "//:nvidia_gpu",
    ],
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

# Positive control for the compute-sanitizer `synccheck` lane: the negative
# control's handoff with `barrier()` in place of `named_barrier`, which CUDA
# does not allow. The findings classifier must keep its report. NVIDIA-only.
# Tagged `manual` -- never runs in the normal suite.
mojo_test(
    name = "positive_control_synccheck_barrier.mojo.test",
    srcs = ["positive_control_synccheck_barrier.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    tags = [
        "gpu",
        "manual",
    ],
    target_compatible_with = [
        "//:has_gpu",
        "//:nvidia_gpu",
    ],
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

# Positive control for the NaN-poison allocator mode
# (`MODULAR_DEBUG_DEVICE_ALLOCATOR=poison-all`): a kernel that reads an
# uninitialized buffer. With poison ON it raises (dst is NaN); OFF it may
# silently pass on pool garbage. Tagged `manual` -- never runs in the normal
# suite.
mojo_test(
    name = "positive_control_poison_uninit.mojo.test",
    srcs = ["positive_control_poison_uninit.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    tags = [
        "gpu",
        "manual",
    ],
    target_compatible_with = ["//:has_gpu"],
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)
