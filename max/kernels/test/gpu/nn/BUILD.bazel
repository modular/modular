# MLA prefill paged-KV tests. These are a NEW set of tests that
# exercise the production MLA prefill code path: ``flare_mla_prefill``
# with a ``KVCacheT`` for K_rope, dispatched to ``mla_sm100_prefill_*``
# on B200. The existing
# ``test_mla_*.mojo``/``test_mla_prefill_*_fp8.mojo`` tests cover only the
# contiguous K_rope path and so do not
# exercise the sub-tile TMA loops in the kernel.
#
# When ``page_size < BN`` (= 128 for MLA prefill) AND a tile's sub-tile
# page indices exceed ``ceildiv(num_keys, page_size)``, the kernel emits
# sub-tile TMAs whose comptime page loop reads stale lookup-table
# entries past the end of the sequence (LUT padding slots) — the
# silent partial-page bug. The kernel-side ``debug_assert`` in each
# K_rope sub-tile loop fires on those configs pre-fix; post-fix, all
# combinations pass.
#
# ``page_size`` is a compile-time parameter (it flows into
# ``PagedKVCacheCollection[..., page_size]`` and the kernel's TMA
# descriptors), so each value here gets its own binary. ``num_keys`` is
# iterated at runtime — see ``num_keys_to_test`` in
# ``_paged_prefill_test_utils.mojo``. Each binary tests the full
# cartesian product {this page_size} × {all num_keys}.
_MLA_PREFILL_PAGED_PAGE_SIZES = [
    "16",
    "32",
    "64",
    "128",
    "256",
]

# (test_file, test_label_prefix, page_sizes, gpu_memory) — paged-prefill
# tests share the same ``_paged_prefill_test_utils.mojo`` helper and the
# same ``page_size`` parameterisation. Each variant has its own entry so
# the BUILD rule only differs by srcs/name/page_sizes/memory.
_MLA_PREFILL_PAGED_VARIANTS = [
    (
        "test_mla_prefill_generic_paged.mojo",
        "test_mla_prefill_generic_paged",
        _MLA_PREFILL_PAGED_PAGE_SIZES,
        "3",
    ),
    (
        "test_mla_prefill_blockscale_paged.mojo",
        "test_mla_prefill_blockscale_paged",
        _MLA_PREFILL_PAGED_PAGE_SIZES,
        "3",
    ),
    (
        "test_mla_prefill_per_token_scale_paged.mojo",
        "test_mla_prefill_per_token_scale_paged",
        _MLA_PREFILL_PAGED_PAGE_SIZES,
        "3",
    ),
    # CENG-282 regression: dense MLA prefill must honor v_head_dim independently
    # of qk_nope_head_dim. Runs CONTROL (v==nope), GLM (v<nope), and STRESS
    # (v>nope) shapes, plus REAL GLM (v=256, the single-O fallback) across a
    # seq_len sweep that crosses the single-O KV-tile boundaries (64/65/128/
    # 129/256) — the >=2-KV-tile cases exercise the single-O serial P@V path
    # that the earlier seq_len=64-only coverage missed (CUDA illegal-address
    # at seq_len > 64). A small page_size set is enough (both the V/output
    # geometry and the single-O boundary are page-size-independent).
    (
        "test_mla_prefill_vhead_repro.mojo",
        "test_mla_prefill_vhead_repro",
        [
            "64",
            "128",
        ],
        "3",
    ),
    # Large-cache_length finiteness sweep: production page_size (256) only,
    # targeting the softmax-accumulator / scale-range / partition-count axis at
    # cache_length up to 94715 (not the partial-page page_size < BN bug). Needs
    # more GPU memory than the partial-page variants.
    (
        "test_mla_prefill_blockscale_large_cache.mojo",
        "test_mla_prefill_blockscale_large_cache",
        ["256"],
        "4",
    ),
]

