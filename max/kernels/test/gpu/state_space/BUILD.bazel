load("//bazel:api.bzl", "mojo_test")
load("//max/kernels/src:deprecations.bzl", "IGNORED_POINTER_DEPRECATIONS_COPTS")

package(default_visibility = ["//max:consumers"])

# TODO(GEX-3342): Metal GPU execution not supported for state_space kernels
_EXTRA_CONSTRAINTS = {
    "test_causal_conv1d.mojo": select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    "test_causal_conv1d_update.mojo": select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    "test_varlen_causal_conv1d.mojo": select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    "test_selective_scan.mojo": select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    "test_varlen_selective_scan.mojo": select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    "test_mamba_split_conv1d_scan_combined.mojo": select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    "test_rms_norm_fused_residual.mojo": select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    "test_ssd_combined.mojo": select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    "test_gated_delta.mojo": select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    "test_gated_delta_conv1d.mojo": select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
}

_GPU_MEMORY = {
    # These three each hold a ~4 GiB state pool, to reach a row past a
    # 32-bit offset.
    "test_gated_delta.mojo": "8",
    "test_gated_delta_conv1d.mojo": "8",
    "test_varlen_causal_conv1d.mojo": "8",
    "bench_gated_delta_recurrence.mojo": "8",
}

[
    mojo_test(
        name = src + ".test",
        size = "large",
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        enable_assertions = True,
        exec_properties = {
            "test.resources:gpu-memory": _GPU_MEMORY.get(src, "2"),
        },
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"] + _EXTRA_CONSTRAINTS.get(src, []),
        deps = [
            "//max:internal_utils",
            "//max:linalg",
            "//max:testdata",
            "//max/kernels/src/state_space",
            "@mojo//:std",
        ],
    )
    for src in glob(["**/*.mojo"])
]
