[
    mojo_test(
        name = src + ".test",
        size = "large",
        srcs = [src],
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        exec_properties = {
            "test.resources:gpu-memory": _GPU_MEMORY.get(src, "2"),
        },
        tags = ["gpu"],
        target_compatible_with = ["//:has_gpu"] + _EXTRA_CONSTRAINTS.get(src, []),
        deps = _KDA_DEPS.get(src, []) + [
            "//max:internal_utils",
            "//max:linalg",
            "//max:testdata",
            "//max/kernels/src/state_space",
            "@mojo//:std",
        ],
    )
    for src in glob(["**/*.mojo"])
