load("//bazel:api.bzl", "lit_tests", "mojo_test")
load("//max/kernels/src:deprecations.bzl", "IGNORED_POINTER_DEPRECATIONS_COPTS")

package(default_visibility = ["//max:consumers"])

_LIT_TESTS = [
    "test_qmatmul_gpu_qint4_dtype_fail.mojo",
]

_EXTRA_DEPS = {
    "test_qmatmul_k.mojo": ["//max:max_mojo"],
    "test_gguf_kv_cache.mojo": [
        "//max:kv_cache",
        "//max:max_mojo",
        "//max:nn",
    ],
}

[
    mojo_test(
        name = src + ".test",
        srcs = [src] + (["test_qmatmul_k.mojo"] if src == "test_gguf_kv_cache.mojo" else []),
        copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
        main = src,
        deps = [
            "//max:quantization",
            "@mojo//:std",
        ] + _EXTRA_DEPS.get(src, []),
    )
    for src in glob(
        ["**/*.mojo"],
        exclude = _LIT_TESTS + ["test_per_channel_grouped_4bit.mojo"],
    )
]

lit_tests(
    name = "lit",
    size = "small",
    srcs = _LIT_TESTS,
    mojo_deps = [
        "//max:linalg",
        "//max:quantization",
        "@mojo//:std",
    ],
)

# TODO(KERN-1880): Re-enable this.
mojo_test(
    name = "test_per_channel_grouped_4bit.mojo.test",
    srcs = ["test_per_channel_grouped_4bit.mojo"],
    copts = IGNORED_POINTER_DEPRECATIONS_COPTS,
    tags = [
        "manual",
    ],
    deps = [
        "//max:quantization",
        "@mojo//:std",
    ],
)
