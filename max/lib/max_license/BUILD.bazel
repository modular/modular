load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//bazel:api.bzl", "modular_cc_library", "modular_shared_library")
load(":libmax_exports.bzl", "LIBMAX_EXPORTS")

package(default_visibility = ["//max:consumers"])

write_file(
    name = "libmax_version_script",
    out = "libmax.map",
    content = [
        "{",
        "  global:",
    ] + ["    {};".format(s) for s in LIBMAX_EXPORTS] + [
        "  local: *;",
        "};",
    ],
)

write_file(
    name = "libmax_exported_symbols_list",
    out = "libmax.exports",
    content = ["_" + s for s in LIBMAX_EXPORTS],
)

modular_cc_library(
    name = "MOFDriver",
    srcs = glob(["MOF/Driver/**/*.cpp"]),
    hdrs = ["//max/include/max/max_license:MOFDriver.headers"],
    deps = [
        "//GraphCompiler",
        "//Support:Base",
        "//Support:Buffer",
        "//max:CAPI.headers",
    ],
)

modular_shared_library(
    name = "max",
    srcs = glob(
        [
            "API/c/**/*.cpp",
            "MOF/API/**/*.cpp",
        ],
    ),
    hdrs = ["//max/include/max/max_license:max.headers"],
    additional_linker_inputs = [
        ":libmax.exports",
        ":libmax.map",
    ],
    dynamic_deps = [
        "@llvm-project//llvm:LLVM",
        "//AsyncRT:RuntimeGlobals",
        "//GraphCompiler:MGPRT",
        "//MLRT:Driver/DeviceContext",
        "//Mojo:CompilerRT",
        "//Support:Globals",
        "@llvm-project//mlir:MLIR",
    ],
    linkopts = select({
        "@platforms//os:linux": ["-Wl,--version-script,$(location :libmax.map)"],
        "@platforms//os:macos": [
            "-Wl,-exported_symbols_list,$(location :libmax.exports)",
            # ld64.lld warns for every hidden symbol an export glob matches,
            # and only -w, which silences all warnings, turns that off.
            "-Wl,-w",
        ],
        "//conditions:default": [],
    }),
    visibility = [
        "//mach:__subpackages__",
        "//max:consumers",
    ],
    # For mach's Rust crates, which can only link a library through CcInfo.
    with_import = True,
    exports = [
        "//GraphCompiler",
        "//GraphCompiler:CommonDriver",
        "//GraphCompiler:DeviceDriver",
        "//GraphCompiler:GraphCompilerConversion",
        "//GraphCompiler:GraphCompilerInterfaces",
        "//GraphCompiler:MAPDialect",
        "//GraphCompiler:MAPToMOGG",
        "//GraphCompiler:MAPTransforms",
        "//GraphCompiler:MEFModel",
        "//GraphCompiler:MGPDialect",
        "//GraphCompiler:MGPPrimitives",
        "//GraphCompiler:MGPTransforms",
        "//GraphCompiler:MOAnalysis",
        "//GraphCompiler:MODialect",
        "//GraphCompiler:MOGGAnonymizeDimNames",
        "//GraphCompiler:MOGGDialect",
        "//GraphCompiler:MOGGFusionSupport",
        "//GraphCompiler:MOGGToMGP",
        "//GraphCompiler:MOGGTransforms",
        "//GraphCompiler:MOPatterns",
        "//GraphCompiler:MOSHDialect",
        "//GraphCompiler:MOTarget",
        "//GraphCompiler:MOToMAP",
        "//GraphCompiler:MOTransforms",
        "//GraphCompiler:OperandInference",
        "//GraphCompiler:ParameterInference",
        "//GraphCompiler:RMODialect",
        "//GraphCompiler:RMOSupport",
        "//GraphCompiler:RMOTransforms",
        "//Kernels/lib/max_license:Tracing",
        "//Kernels/lib/max_license:WeightsRegistry",
        "//Kernels/lib/max_license:mojo_string_c_api",
        "//Kernels/lib/max_license:tracing_c_api",
        "//Kernels/lib/max_license:weights_registry_c_api",
        "//MLRT:GraphRT/GRTDialect",
        "//MLRT:GraphRT/MEFDialect",
        "//MLRT:GraphRT/MLIRToMEF",
        "//MLRT:GraphRT/Primitives",
        "//Support:Diagnostics",
        "//Support:MicroBenchmark",
    ],
    deps = [
        ":MOFDriver",
        "//GraphCompiler:FrameworkFrontend",
        "//GraphCompiler:MEFModel",
        "//GraphCompiler:SafeTensor",
        "//Init",
        "//Kernels/lib/max_license:WeightsRegistry",
        # The driver C API, so a consumer that loads libmax at run time
        # resolves the M_Driver* entry points against the driver
        # implementation this library already carries.
        "//MLRT:Driver/CAPI",
        "//Mojo:CompilerRT.static",
        "//Support:Context",
        "//Support:Diagnostics",
        "//Support:Globals.static",
        "//Support:SpanGuard",
        "//max:CAPI.headers",
        "@llvm-project//mlir:MLIRBindingsPythonCAPIObjects",
        "@nixl_upstream//:nixl_runtime",
    ],
)
