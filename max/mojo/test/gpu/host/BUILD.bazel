load("//bazel:api.bzl", "lit_tests", "mojo_test")

package(default_visibility = ["//max:consumers"])

mojo_test(
    name = "test_device_type_encoder_target.mojo.test",
    srcs = ["test_device_type_encoder_target.mojo"],
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

# Metal-only: `MetalDeviceTypeEncoder._buffers` is Metal-specific state, so this
# test is compatible only with the Apple GPU toolchain.
mojo_test(
    name = "test_metal_device_type_encoder.mojo.test",
    srcs = ["test_metal_device_type_encoder.mojo"],
    tags = ["gpu"],
    target_compatible_with = select({
        "//:apple_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

# Tests programmatic Metal GPU frame capture. The test handles non-Metal
# contexts gracefully, so it is not restricted to the Apple GPU toolchain.
# It does need a GPU build, though: `DeviceContext` resolves
# `get_gpu_info()` at compile time, which fails the
# "Unknown GPU architecture" constraint on CPU-only platforms (e.g. Graviton).
# `//:has_gpu` keeps it vendor-agnostic while excluding CPU-only build configs.
mojo_test(
    name = "test_metal_capture.mojo.test",
    srcs = ["test_metal_capture.mojo"],
    tags = ["gpu"],
    target_compatible_with = ["//:has_gpu"],
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

# Tests `DeviceBuffer.unsafe_host_ptr()`. Vendor-agnostic: the Metal half is
# gated on `ctx.api()` at runtime and the remaining test asserts that devices
# without unified memory raise. `//:has_gpu` excludes CPU-only build configs,
# where `DeviceContext` fails the compile-time GPU-arch constraint.
mojo_test(
    name = "test_device_buffer_host_ptr.mojo.test",
    srcs = ["test_device_buffer_host_ptr.mojo"],
    tags = ["gpu"],
    target_compatible_with = ["//:has_gpu"],
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

# `//:has_gpu` excludes CPU-only build configs, where `DeviceContext` fails the
# compile-time GPU-arch constraint.
mojo_test(
    name = "test_device_is_host_unified.mojo.test",
    srcs = ["test_device_is_host_unified.mojo"],
    tags = ["gpu"],
    target_compatible_with = ["//:has_gpu"],
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

# Under the HAL `DeviceContext`, `test_device_view` loads the CPU plugin for
# its CPU peer and the GPU vendor's plugin through `MODULAR_DRIVER_PLUGINS`.
[
    config_setting(
        name = "hal_" + vendor,
        constraint_values = ["//:" + vendor],
        flag_values = {"//:hal_device_context": "true"},
    )
    for vendor in [
        "nvidia_gpu",
        "amd_gpu",
        "apple_gpu",
    ]
]

mojo_test(
    name = "test_device_view.mojo.test",
    srcs = ["test_device_view.mojo"],
    copts = select({
        "//:hal_device_context_enabled": [
            "-D",
            "HAL_DEVICE_CONTEXT",
        ],
        "//conditions:default": [],
    }),
    data = select({
        ":hal_nvidia_gpu": [
            "//Target:CPUPlugin.so",
            "//Target:CUDAPlugin.so",
        ],
        ":hal_amd_gpu": [
            "//Target:CPUPlugin.so",
            "//Target:HIPPlugin.so",
        ],
        ":hal_apple_gpu": [
            "//Target:CPUPlugin.so",
            "//Target:MetalPlugin.so",
        ],
        "//conditions:default": [],
    }),
    env = select({
        ":hal_nvidia_gpu": {
            "MODULAR_DRIVER_PLUGINS": "CUDA@$(rootpath //Target:CUDAPlugin.so);CPU@$(rootpath //Target:CPUPlugin.so)",
        },
        ":hal_amd_gpu": {
            "MODULAR_DRIVER_PLUGINS": "HIP@$(rootpath //Target:HIPPlugin.so);CPU@$(rootpath //Target:CPUPlugin.so)",
        },
        ":hal_apple_gpu": {
            "MODULAR_DRIVER_PLUGINS": "Metal@$(rootpath //Target:MetalPlugin.so);CPU@$(rootpath //Target:CPUPlugin.so)",
        },
        "//conditions:default": {},
    }),
    tags = ["gpu"],
    target_compatible_with = ["//:has_gpu"],
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

# Kernel profiling ranges compile in only with a profiling define and only for
# NVIDIA and AMD GPUs, the two vendors with a range library.
mojo_test(
    name = "test_tracing_missing_library.mojo.test",
    srcs = ["test_tracing_missing_library.mojo"],
    copts = [
        "-D",
        "MODULAR_ENABLE_GPU_PROFILING_DETAILED=1",
    ],
    tags = ["gpu"],
    target_compatible_with = select({
        "//:amd_gpu": [],
        "//:nvidia_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

