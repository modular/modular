load("//bazel:api.bzl", "mojo_filecheck_test", "mojo_test")

package(default_visibility = ["//max:consumers"])

mojo_filecheck_test(
    name = "test_shared_address_space_cast_bitcast.mojo.test",
    srcs = ["test_shared_address_space_cast_bitcast.mojo"],
    copts = [
        "--debug-level",
        "full",
    ],
    tags = ["gpu"],
    # PointerRewriter (the pass under test) is Metal/AIR-only.
    target_compatible_with = ["//:has_gpu"] + select({
        "//:apple_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)

# CPU-runnable: exercises `ReduceOp`'s `EnumLike` conformance (runtime
# `__match`, discriminants) and its unchanged custom `write_to` mnemonics
# without launching any GPU work.
mojo_test(
    name = "test_reduce_op.mojo.test",
    srcs = ["test_reduce_op.mojo"],
    deps = [
        "//max:max_mojo",
        "@mojo//:std",
    ],
)
