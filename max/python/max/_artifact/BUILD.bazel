load("//bazel:api.bzl", "modular_py_library", "requirement")

package(default_visibility = ["//max:consumers"])

# The value types and the encoding, which max.experimental imports, so
# nothing here may depend on max.experimental or max.pipelines.
modular_py_library(
    name = "_artifact",
    srcs = [
        "__init__.py",
        "codec.py",
        "metadata.py",
        "value_types.py",
        "vision.py",
    ],
    deps = [
        "//max/python/max:tree",
        requirement("typing-extensions"),
    ],
)

# The writer and reader, the model component, which holds
# max.experimental CompiledCallables, the engine_config and kv_cache
# components, and the max.pipelines.lib WeightTransform.
modular_py_library(
    name = "model_artifact",
    srcs = [
        "batch_processor.py",
        "engine_config.py",
        "format_spec.py",
        "kv_cache.py",
        "model_artifact.py",
        "pipeline_modules.py",
        "serialization.py",
    ],
    deps = [
        ":_artifact",
        "//max/python/max:_core",
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/pipelines/lib",
        requirement("huggingface-hub"),
        requirement("typing-extensions"),
    ],
)

# max export, which builds a pipeline.
modular_py_library(
    name = "export",
    srcs = ["export.py"],
    deps = [
        ":_artifact",
        ":model_artifact",
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/weights",
    ],
)
