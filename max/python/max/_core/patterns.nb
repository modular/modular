max._core.dialects.rmo.__prefix__:
    # C++ overloads on different int types look the same in Python, ignore these
    # mypy: disable-error-code="overload-cannot-match"

    \from collections.abc import Sequence
    \from typing import Protocol
    \from max.mlir import Context, Location

# DiagnosticHandler not necessary here, but for some reason our stubgen setup and ruff are conflicting,
# so just working around.
max._core.dialects.rmo.passes.__prefix__:
    # C++ overloads on different int types look the same in Python, ignore these
    # mypy: disable-error-code="overload-cannot-match"

    \from collections.abc import Callable, Sequence
    \from typing import Protocol
    \from max.mlir import Context, Location
    DiagnosticHandler = Callable
