load(
    "//bazel:api.bzl",
    "modular_py_library",
    "requirement",
)

package(default_visibility = ["//max:consumers"])

modular_py_library(
    name = "deepseekV41_modulev3",
    srcs = [
        "__init__.py",
        "inputs.py",
        "interface.py",
        "layer_resolver.py",
        "layers/__init__.py",
        "layers/attention.py",
        "layers/candidate_pool.py",
        "layers/compressor.py",
        "layers/index_ops.py",
        "layers/indexer.py",
        "layers/mxfp8_linear.py",
        "layers/norm.py",
        "layers/rope.py",
        "model_config.py",
    ],
    deps = [
        requirement("transformers"),
        requirement("typing-extensions"),
        requirement("numpy"),
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/deepseekV41",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
    ],
