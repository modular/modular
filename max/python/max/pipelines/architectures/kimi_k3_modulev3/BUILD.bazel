load("//bazel:api.bzl", "modular_py_library", "requirement")

package(default_visibility = ["//max:consumers"])

# verify_full_depth.py isn't a bazel source (needs a real checkpoint on disk,
# so it can't be a hermetic test); the test directory's data= references it
# directly so it isn't flagged as unreferenced.
exports_files(["scripts/verify_full_depth.py"])

modular_py_library(
    name = "kimi_k3_modulev3",
    srcs = glob(
        ["**/*.py"],
        exclude = ["scripts/**"],
    ),
    # Recipe yamls (and the hw_recipes.yaml table) ship with the library so
    # any downstream runfiles tree can resolve them.
    data = glob(["recipes/*.yaml"]),
    visibility = ["//visibility:public"],
    deps = [
        requirement("numpy"),
        requirement("transformers"),
        requirement("typing-extensions"),
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/deepseekV3_modulev3",
        "//max/python/max/pipelines/architectures/llama3_modulev3",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/support",
    ],
)
