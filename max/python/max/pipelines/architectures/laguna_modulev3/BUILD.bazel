load("//bazel:api.bzl", "modular_py_library", "requirement")

package(default_visibility = ["//max:consumers"])

filegroup(
    name = "recipe_configs",
    srcs = glob(["**/recipes/**/*.yaml"]),
)

modular_py_library(
    name = "laguna_modulev3",
    srcs = glob(["**/*.py"]),
    data = [":recipe_configs"],
    deps = [
        requirement("numpy"),
        requirement("transformers"),
        requirement("typing-extensions"),
        "//max/python/max:tensor",
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/gemma4_modulev3",
        "//max/python/max/pipelines/architectures/laguna",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
    ],
)
