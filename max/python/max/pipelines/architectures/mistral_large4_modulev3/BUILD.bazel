load("//bazel:api.bzl", "modular_py_library", "requirement")

package(default_visibility = ["//max:consumers"])

# The formatspec crate embeds this document, so it reaches across the fence.
exports_files(
    ["formatspec.json"],
    visibility = ["//formatspec:__subpackages__"],
)

modular_py_library(
    name = "mistral_large4_modulev3",
    srcs = glob(["**/*.py"]),
    data = [
        "formatspec.json",
    ],
    deps = [
        # The processor imports PIL for its pixel path, and transformers pulls
        # it in; the import here is direct, so the dep is too.
        requirement("numpy"),
        requirement("pillow"),
        requirement("transformers"),
        requirement("typing-extensions"),
        "//max/python/max:tensor",
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/nn:core",
        "//max/python/max/nn/_graph_ops",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/deepseekV3_2",
        "//max/python/max/pipelines/architectures/deepseekV3_2_modulev3",
        "//max/python/max/pipelines/architectures/deepseekV3_modulev3",
        "//max/python/max/pipelines/architectures/deepseekV4",
        "//max/python/max/pipelines/architectures/pixtral_modulev3",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/pipelines/speculative",
        "//max/python/max/pipelines/weights",
        "//max/python/max/support",
    ],
)
