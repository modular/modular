{
  "argument_syntax": "parameter_tags",
  "call": {
    "begin": {
      "text": "<tool_call>"
    },
    "end": {
      "text": "</tool_call>"
    },
    "name_layout": {
      "close": "</function>",
      "kind": "function_tag",
      "open_prefix": "<function=",
      "open_suffix": ">"
    },
    "section": null,
    "sep": null
  },
  "delivery": {
    "kind": "text"
  },
  "format": "formatspec.spec",
  "json_whitespace": "spaced",
  "reasoning": {
    "close": {
      "text": "</think>"
    },
    "close_suffix": "\n\n",
    "default": "on",
    "open": {
      "text": "<think>"
    },
    "prompt_start": "prefilled_when_on",
    "strip_prefix": "",
    "strip_suffix": "\n"
  },
  "spec_version": 1,
  "terminators": [
    {
      "text": "<|im_end|>"
    }
  ]
}
