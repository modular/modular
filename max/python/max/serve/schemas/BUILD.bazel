load("//bazel:api.bzl", "modular_py_library", "pkg_files", "requirement", "strip_prefix")

package(default_visibility = ["//max:consumers"])

modular_py_library(
    name = "schemas",
    srcs = glob(["*.py"]),
    deps = [
        requirement("openai"),
        requirement("pydantic"),
        requirement("typing-extensions"),
    ],
)

# Read by //max/tests/tests/serve/schemas, which checks the hand-written
# docs against the request schema.
exports_files(["openai-docs.yaml"])

pkg_files(
    name = "docs-schema",
    srcs = [
        "openai-docs.yaml",
    ],
    prefix = "static",
    strip_prefix = strip_prefix.from_pkg(""),
)
