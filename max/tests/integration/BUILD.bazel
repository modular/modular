load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

# Exported so tests in other packages can read the lock file as data.
exports_files(["hf-repo-lock.tsv"])

modular_py_test(
    name = "test_hf_repo_lock_casing",
    size = "large",
    srcs = ["test_hf_repo_lock_casing.py"],
    data = ["hf-repo-lock.tsv"],
    env_inherit = ["HF_TOKEN"],
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
        "run-in-hf-workflow",
    ],
    deps = [
        requirement("huggingface-hub"),
    ],
)
