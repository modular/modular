    srcs = ["collect_scores.py"],
    imports = ["."],
    main = "collect_scores.py",
)

# Normalization for the OpenRouter AutoExacto harnesses. A library, not a
# binary: the shell runners execute it with the third-party harness venv's
# interpreter (see the stdlib-only note in the module), and a file may belong to
# only one rule.
modular_py_library(
    name = "exacto_report",
    testonly = True,
    srcs = ["exacto_report.py"],
    imports = ["."],
)

# OpenRouter's GPQA sample construction, ported from its benchmark harness.
# Stdlib only, so it is tested here and imported by exacto_gpqa_task.py inside
# the harness venv.
modular_py_library(
    name = "exacto_gpqa_openrouter",
    testonly = True,
    srcs = ["exacto_gpqa_openrouter.py"],
    imports = ["."],
)

# One-command GPQA-Diamond run at OpenRouter AutoExacto parity. A shell runner
# because the task runs in openbench's pinned venv, a third-party dependency
# tree, the same reason omnidocbench_eval_local is one. exacto_gpqa_task.py is
# plain data: it imports inspect_ai, which only that venv has.
#   ./bazelw run //max/tests/integration/accuracy/model_evals:exacto_gpqa_local -- \
#     --url http://localhost:8000 --limit 4 --epochs 1
sh_binary(
    name = "exacto_gpqa_local",
    testonly = True,
    srcs = ["run_exacto_gpqa_local.sh"],
    data = [
        "exacto_gpqa_smoke.py",
        ":exacto_gpqa_openrouter",
        ":exacto_gpqa_task",
        ":exacto_mcq",
        ":exacto_media",
        ":exacto_report",
        ":exacto_streaming",
    ],
    tags = ["manual"],
)

# The GPQA Inspect task, shared by the runner and its unit test. A filegroup
# for the same reason as exacto_streaming below.
filegroup(
    name = "exacto_gpqa_task",
    testonly = True,
    srcs = ["exacto_gpqa_task.py"],
)

# The streaming Inspect provider both runners load inside the harness venv. A
# filegroup, not a library: it imports inspect_ai, which only that venv has.
filegroup(
    name = "exacto_streaming",
    testonly = True,
    srcs = ["exacto_streaming.py"],
)

# How a video URL reaches the wire through Inspect, which cannot send one.
# Stdlib only; exacto_streaming.py imports it inside the harness venv.
modular_py_library(
    name = "exacto_media",
    testonly = True,
    srcs = ["exacto_media.py"],
    imports = ["."],
)

