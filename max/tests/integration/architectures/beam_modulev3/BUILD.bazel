load("//bazel:api.bzl", "modular_py_test")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_reasoning",
    srcs = ["test_reasoning.py"],
    deps = ["//max/python/max/pipelines/architectures/beam_modulev3"],
)

modular_py_test(
    name = "test_tool_parser",
    srcs = ["test_tool_parser.py"],
    deps = ["//max/python/max/pipelines/architectures/beam_modulev3"],
)

# The Python files, which test_no_legacy_ep_imports scans.
filegroup(
    name = "py_srcs",
    srcs = glob(["**/*.py"]),
)
