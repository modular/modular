load("//bazel:api.bzl", "modular_py_library", "modular_py_test", "requirement")
load("//max/tests/integration/xarch_warm:eager_py_test.bzl", "modular_eager_py_test")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

# Capture-padding regressions: padded decode rows must neither store
# into the paged caches (window store, ratio-2 ring save) nor gather
# past their request's pages, and a 128-row window list keeps its
# requests distinct.
modular_eager_py_test(
    name = "test_capture_padding",
    srcs = ["test_capture_padding.py"],
    cpu_only = True,
    env = {"MAX_EAGER_EXECUTOR": "fallback-internal"},
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/deepseekV41_modulev3",
        requirement("numpy"),
    ],
)

# The weight adapter's wo_a FP8 passthrough (the checkpoint's own
# bytes), the stacked-projection fold and the no-vision gate drop, on
# real E4M3/E8M0 pair arithmetic.
modular_py_test(
    name = "test_weight_adapters",
    srcs = ["test_weight_adapters.py"],
    deps = [
        requirement("transformers"),
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/deepseekV41_modulev3",
        requirement("numpy"),
    ],
)

modular_eager_py_test(
    name = "test_runtime",
    srcs = ["test_runtime.py"],
    cpu_only = True,
    # Needs mo.csa.window_kv_store, registered only by the closed-source kernels.
    env = {"MAX_EAGER_EXECUTOR": "fallback-internal"},
    # tokenizers is a transitive dependency of transformers but doesn't have
    # an unversioned bazel alias, so we need to ignore its unresolved imports
    ignore_unresolved_imports = [
        "tokenizers.Tokenizer",
        "tokenizers.models.WordLevel",
    ],
    tags = ["skip-external-ci"],
    deps = [
        ":runtime_config",
        requirement("transformers"),
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/architectures/deepseekV41_modulev3",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        requirement("numpy"),
    ],
)

modular_py_library(
    name = "runtime_config",
    testonly = True,
    srcs = ["runtime_config.py"],
    imports = ["."],
)

# No precompile_mefs: the eager executor stages device state before the
# first compile and compiles each op as it executes, so a CPU record
# captures none of these graphs (docs/internal/CompileOnCpuRunOnGpu.md,
# "When record cannot help").
modular_eager_py_test(
    name = "test_output_projection_gpu",
    size = "large",
    srcs = ["test_output_projection_gpu.py"],
    env = {"MAX_EAGER_EXECUTOR": "fallback-internal"},
    exec_properties = {
        "test.resources:gpu-1": "0",
        "test.resources:gpu-2": "0.01",
        "test.resources:gpu-memory": "4",
    },
    gpu_constraints = [
        "//:b200_gpu",
        "//:has_multi_gpu",
    ],
    tags = ["gpu"],
    deps = [
        ":runtime_config",
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/deepseekV41_modulev3",
        "//max/python/max/pipelines/lib",
        requirement("numpy"),
    ],
)

# The loader's pinned Engram host tables: page-locked against the
# accelerator (a ``CPU()`` staging buffer is pageable, which the UVA
# gather must not read), byte-exact against the checkpoint view, and
# deduplicated lazily across reloads of the same bytes.
modular_py_test(
    name = "test_pinned_tables_gpu",
    size = "large",
    srcs = ["test_pinned_tables_gpu.py"],
    exec_properties = {
        "test.resources:gpu-memory": "2",
    },
    gpu_constraints = ["//:b200_gpu"],
    tags = ["gpu"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/pipelines/architectures/deepseekV41_modulev3",
        requirement("numpy"),
    ],
)
