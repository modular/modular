load("//bazel:api.bzl", "modular_py_library", "requirement")
load("//max/tests/integration/xarch_warm:eager_py_test.bzl", "modular_eager_py_test")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

# Capture-padding regressions: padded decode rows must neither store
# into the paged caches (window store, ratio-2 ring save) nor gather
# past their request's pages, and a 128-row window list keeps its
# requests distinct.
modular_eager_py_test(
    name = "test_capture_padding",
    srcs = ["test_capture_padding.py"],
    cpu_only = True,
    env = {"MAX_EAGER_EXECUTOR": "fallback-internal"},
    deps = [
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        "//max/python/max/pipelines/architectures/deepseekV41_modulev3",
        requirement("numpy"),
    ],
)

modular_py_library(
    name = "runtime_config",
    testonly = True,
    srcs = ["runtime_config.py"],
    imports = ["."],
)

# No precompile_mefs: the eager executor stages device state before the
# first compile and compiles each op as it executes, so a CPU record
# captures none of these graphs (docs/internal/CompileOnCpuRunOnGpu.md,
# "When record cannot help").
modular_eager_py_test(
    name = "test_output_projection_gpu",
    size = "large",
    srcs = ["test_output_projection_gpu.py"],
    env = {"MAX_EAGER_EXECUTOR": "fallback-internal"},
    exec_properties = {
        "test.resources:gpu-1": "0",
        "test.resources:gpu-2": "0.01",
        "test.resources:gpu-memory": "4",
    },
    gpu_constraints = [
        "//:b200_gpu",
        "//:has_multi_gpu",
    ],
    tags = ["gpu"],
    deps = [
        ":runtime_config",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/deepseekV41_modulev3",
        "//max/python/max/pipelines/lib",
        requirement("numpy"),
    ],
)
