load("//bazel:api.bzl", "requirement")
load("//max/tests/integration/xarch_warm:eager_py_test.bzl", "modular_eager_py_test")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

# CPU numerical/reference tests for the V4.1 ModuleV3 attention-half
# layers. The fused/graph kernels those layers route to on GPU are
# GPU-only; these targets pin the layers' own math against independent
# NumPy oracles.
modular_eager_py_test(
    name = "layers_cpu_tests",
    srcs = [
        "test_attention_rows.py",
        "test_compressor.py",
        "test_indexer.py",
        "test_norm.py",
        "test_rope.py",
    ],
    cpu_only = True,
    env = {
        # Don't background-compile every eager graph (SDLC-4307 CI cpu/mem).
        "MAX_EAGER_EXECUTOR": "fallback-internal",
    },
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],  # FIXME: MOCO-2411
        "//:asan": ["@platforms//:incompatible"],  # Too slow under ASAN
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/experimental",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/deepseekV41_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/tests/integration/architectures/deepseekV41_modulev3/assembly:runtime_config",
        requirement("numpy"),
    ],
)

# Focused production-binding tests: the target executes the attention
# half's own graph-op bindings on a B200 -- the MXFP8 dense/grouped
# block-scaled matmuls -- rather than only comparing formulas.
#
# No precompile_mefs: the eager executor stages device state before the
# first compile and compiles each op as it executes, so a CPU record
# captures none of these graphs (docs/internal/CompileOnCpuRunOnGpu.md,
# "When record cannot help").
modular_eager_py_test(
    name = "layers_gpu_tests",
    size = "large",
    srcs = [
        "test_mxfp8_dense_gpu.py",
    ],
    env = {
        # These tests execute the layers' real fused/graph ops (fp8
        # casts and the MXFP8 block-scaled matmuls), which the
        # interpreter refuses: compile them.
        "MAX_EAGER_EXECUTOR": "fallback-internal",
    },
    exec_properties = {
        "test.resources:gpu-memory": "2",
    },
    gpu_constraints = ["//:b200_gpu"],
    tags = ["gpu"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//:asan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/experimental",
        "//max/python/max/pipelines/architectures/deepseekV41_modulev3",
        requirement("numpy"),
        requirement("torch"),
    ],
)
