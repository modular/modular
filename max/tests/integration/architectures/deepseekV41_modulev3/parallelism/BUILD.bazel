load("//bazel:api.bzl", "modular_py_test", "requirement")
load("//max/tests/integration/xarch_warm:eager_py_test.bzl", "modular_eager_py_test")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

# The DP4+EP4 graph stages on virtual SM100 devices, holds no
# residual-path all-reduce, and compiles through the export's entry point
# (the compile leg catches kernel-signature dtype drift without a GPU; it
# is the leg a DP4/EP4 MEF export failed on, and it instantiates the real
# CSA2, indexer and Engram kernels, so it runs minutes, not seconds):
#   ./bazelw test //max/tests/integration/architectures/deepseekV41_modulev3/parallelism:test_dp4_graph
modular_py_test(
    name = "test_dp4_graph",
    size = "large",
    timeout = "long",
    srcs = ["test_dp4_graph.py"],
    tags = ["skip-external-ci"],
    # Needs the CSA2 and Engram kernels, registered only by the closed-source kernels.
    target_compatible_with = select({
        # No NVPTX target for the staged sm_100a virtual devices.
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/deepseekV41",
        "//max/python/max/pipelines/architectures/deepseekV41_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/tests/integration/architectures/deepseekV41_modulev3/assembly:runtime_config",
        requirement("numpy"),
    ],
)

# The DP/EP wiring contracts: the CPU DP split pair's ABI position, the
# extra inputs' global row dim, the EP config the model builds, the
# derived dispatch scale's module leaf, the host row count, the DP batch
# packing, and the guards. CPU only, no graph staging (that is
# test_dp4_graph's); the host row count runs eagerly, so the target runs
# with the in-process fallback executor like layers_cpu_tests:
#   ./bazelw test //max/tests/integration/architectures/deepseekV41_modulev3/parallelism:test_dp_wiring
modular_eager_py_test(
    name = "test_dp_wiring",
    srcs = ["test_dp_wiring.py"],
    cpu_only = True,
    env = {"MAX_EAGER_EXECUTOR": "fallback-internal"},
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],  # FIXME: MOCO-2411
        "//:asan": ["@platforms//:incompatible"],  # Too slow under ASAN
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/deepseekV41_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/tests/integration/architectures/deepseekV41_modulev3/assembly:runtime_config",
        "//max/tests/integration/test_common:context_utils",
        requirement("numpy"),
    ],
)
