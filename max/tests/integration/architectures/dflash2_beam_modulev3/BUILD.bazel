load("//bazel:api.bzl", "modular_py_library", "modular_py_test")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
)

modular_py_test(
    name = "test_model_config",
    srcs = ["test_model_config.py"],
    data = [":testdata"],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/dflash2_beam_modulev3",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

# Builds the fused Beam + DFlash2 module on a CPU mesh from a tiny target
# and drafter.
modular_py_library(
    name = "beam_dflash2_fixtures",
    testonly = True,
    srcs = ["beam_dflash2_fixtures.py"],
    data = [":testdata"],
    imports = ["."],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn:core",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures/beam_modulev3",
        "//max/python/max/pipelines/architectures/dflash2_beam_modulev3",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

# Stages the fused graph on a 1-device CPU mesh: the pairing's resolution,
# the name and inputs Mach binds, the drafter's weight names and the
# trace's kernels. Never compiles, so it runs wherever bazel does.
modular_py_test(
    name = "test_fused_graph_cpu",
    size = "medium",
    srcs = ["test_fused_graph_cpu.py"],
    data = [":testdata"],
    ignore_extra_deps = [
        # The staged trace realizes eager tensors, which import the MO
        # interpreter; without its compiled ops the trace crawls.
        "//max/python/max/_interpreter_ops",
        # The pairing resolves its target and drafter by name.
        "//max/python/max/pipelines",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":beam_dflash2_fixtures",
        "//max/python/max:tensor",
        "//max/python/max/_interpreter_ops",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/_graph_ops",
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/dflash2_beam_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)
