load(
    "//bazel:api.bzl",
    "modular_py_library",
    "modular_py_test",
    "requirement",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

# The two module-level tests execute tiny CPU graphs against the DFlash2
# authors' scalar references; test_drafter only stages a module.
[
    modular_py_test(
        name = name,
        size = "large",
        srcs = [name + ".py"],
        deps = [
            "//max/python/max/driver",
            "//max/python/max/dtype",
            "//max/python/max/engine",
            "//max/python/max/graph",
            "//max/python/max/pipelines/architectures/dflash2_qwen3_5",
            requirement("numpy"),
        ],
    )
    for name in [
        "test_grouped_conv",
        "test_candidate_selector",
    ]
]

modular_py_test(
    name = "test_drafter",
    size = "small",
    srcs = ["test_drafter.py"],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/dflash2_qwen3_5",
        "//max/python/max/pipelines/architectures/llama3",
    ],
)

modular_py_library(
    name = "dflash2_pairing_harness",
    testonly = True,
    srcs = ["dflash2_pairing_harness.py"],
    imports = ["."],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/dflash2_qwen3_5",
        "//max/python/max/pipelines/architectures/llama3",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_arch_registration",
    srcs = ["test_arch_registration.py"],
    # The v1 draft's architecture is imported by the registry, not the test.
    ignore_extra_deps = [
        "//max/python/max/pipelines/architectures/dflash_llama3",
    ],
    deps = [
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/dflash2_qwen3_5",
        "//max/python/max/pipelines/architectures/dflash_llama3",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "test_model_config",
    srcs = ["test_model_config.py"],
    data = ["testdata/zlab_dflash2_config.json"],
    deps = [
        ":dflash2_pairing_harness",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/dflash2_qwen3_5",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

modular_py_test(
    name = "test_pairing_cache",
    srcs = ["test_pairing_cache.py"],
    deps = [
        ":dflash2_pairing_harness",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/dflash2_qwen3_5",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

modular_py_test(
    name = "test_graph_signature",
    srcs = ["test_graph_signature.py"],
    # Constructing the target reaches `Allreduce.__init__`, which instantiates
    # `Accelerator(id=0)` unconditionally; with no CUDA device that aborts
    # inside the driver rather than raising.
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    tags = ["gpu"],
    deps = [
        ":dflash2_pairing_harness",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "test_state_rollback_block",
    # Each acceptance length compiles its own graph.
    size = "large",
    srcs = ["test_state_rollback_block.py"],
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    precompile_mefs = True,
    tags = ["gpu"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/speculative",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_prefill_block",
    size = "large",
    srcs = ["test_prefill_block.py"],
    # The 280 MB signal buffer is a single allocation, so the default per-test
    # GPU budget cannot serve it whatever the model size.
    exec_properties = {
        "test.resources:gpu-memory": "3",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    precompile_mefs = True,
    tags = ["gpu"],
    deps = [
        ":dflash2_pairing_harness",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/nn",
        "//max/python/max/pipelines/speculative",
        requirement("numpy"),
    ],
)
