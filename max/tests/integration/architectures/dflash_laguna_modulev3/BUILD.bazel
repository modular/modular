load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
)

modular_py_test(
    name = "test_model_config",
    srcs = ["test_model_config.py"],
    data = [":testdata"],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/architectures/dflash_laguna_modulev3",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

# Compiles the drafter's two entries through `Module.compile`, so the
# compiles are recorded on CPU and the GPU worker only executes them.
modular_py_test(
    name = "test_drafter_gpu",
    size = "large",
    srcs = ["test_drafter_gpu.py"],
    exec_properties = {
        "test.resources:gpu-memory": "2",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    precompile_mefs = True,
    tags = ["gpu"],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures/dflash_laguna_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/tests/integration/test_common:simple_kv_cache",
        requirement("ml-dtypes"),
        requirement("numpy"),
    ],
)
