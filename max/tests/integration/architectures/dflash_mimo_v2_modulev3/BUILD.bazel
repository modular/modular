load("//bazel:api.bzl", "modular_py_library", "modular_py_test")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

# The fixture builders shared by the ModuleV3 MiMo-V2 DFlash tests: the
# synthetic target/drafter checkpoints, their KV trees and the fused module
# the pairing compiles, built on a CPU mesh.
modular_py_library(
    name = "mimo_dflash_v3_fixtures",
    testonly = True,
    srcs = ["mimo_dflash_v3_fixtures.py"],
    imports = ["."],
    visibility = [
        "//:__pkg__",
        "//mach/tools/gen-mef:__pkg__",
        "//max/tests:__subpackages__",
        "//oss/modular/max/tests:__subpackages__",
    ],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/dflash_mimo_v2",
        "//max/python/max/pipelines/architectures/dflash_mimo_v2_modulev3",
        "//max/python/max/pipelines/architectures/mimo_v2_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

modular_py_test(
    name = "test_drafter_loading",
    size = "small",
    srcs = ["test_drafter_loading.py"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":mimo_dflash_v3_fixtures",
        "//max/python/max:tensor",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/dflash_mimo_v2",
        "//max/python/max/pipelines/architectures/dflash_mimo_v2_modulev3",
    ],
)

# The data-parallel half of the no-GPU gates: the DP signature's batch-split
# pair, context lengths and EP tail; the DP2xEP2 graph staged on virtual
# B200s (the batch split, the dispatch/combine, the drafter's full heads per
# replica); the packed inputs' DP slots and the EP row budget, beside the
# refusals. Same host constraints as the TP staging gate below.
modular_py_test(
    name = "test_dp_construction_cpu",
    size = "medium",
    srcs = ["test_dp_construction_cpu.py"],
    ignore_extra_deps = [
        # The staged trace realizes eager tensors, which import the MO
        # interpreter; without its compiled ops the trace crawls.
        "//max/python/max/_interpreter_ops",
        # The pairing resolves its target and drafter by name.
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/mimo_v2",
    ],
    imports = ["."],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":mimo_dflash_v3_fixtures",
        "//max/python/max/_interpreter_ops",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        # The pairing resolves its target and drafter by name.
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/dflash_mimo_v2_modulev3",
        "//max/python/max/pipelines/architectures/mimo_v2",
        "//max/python/max/pipelines/architectures/mimo_v2_modulev3",
        "//max/python/max/pipelines/lib",
    ],
)

# Stages the fused graph on a 1-device CPU mesh: the name and input count
# the engine binds, the weight-name contract, and the staged trace's ops.
# Never compiles -- the W4A8 kernels have no CPU dispatch -- so it runs
# wherever bazel does.
modular_py_test(
    name = "test_fused_graph_cpu",
    size = "medium",
    srcs = ["test_fused_graph_cpu.py"],
    ignore_extra_deps = [
        # The staged trace realizes eager tensors, which import the MO
        # interpreter; without its compiled ops the trace crawls.
        "//max/python/max/_interpreter_ops",
        # The pairing resolves its target and drafter by name.
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/mimo_v2",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":mimo_dflash_v3_fixtures",
        "//max/python/max/_interpreter_ops",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max:tensor",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        # The pairing resolves its target and drafter by name.
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/dflash_mimo_v2_modulev3",
        "//max/python/max/pipelines/architectures/mimo_v2",
        "//max/python/max/pipelines/architectures/mimo_v2_modulev3",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/kv_cache/connectors/dkv",
        "//max/python/max/pipelines/speculative",
        "//max/python/max/pipelines/weights",
    ],
)

