load(
    "//bazel:api.bzl",
    "modular_py_library",
    "modular_py_test",
    "requirement",
)
load(
    "//max/tests/integration/xarch_warm:eager_py_test.bzl",
    "modular_eager_py_test",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_library(
    name = "attention_helpers",
    testonly = True,
    srcs = ["_attention_helpers.py"],
    imports = ["."],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/gemma4_modulev3",
        "//max/python/max/pipelines/kv_cache",
        "//max/tests/integration/architectures/gemma4:gemma4_torch_reference",
        requirement("torch"),
        requirement("transformers"),
    ],
)

# These run op by op through the eager interpreter, so they adopt the
# build-warmed eager op cache; they compile no graphs to record.
modular_eager_py_test(
    name = "tests",
    size = "large",
    srcs = [
        "test_attention_eager.py",
        "test_qkv_fusion.py",
        "test_quantization.py",
        "test_rotary_embedding.py",
        "test_text_model.py",
    ],
    env = {
        "MODULAR_TORCH_MEMORY_PERCENT": "0.5",
    },
    exec_properties = {
        "test.resources:gpu-memory": "16",
    },
    gpu_constraints = ["//:has_gpu"],
    tags = ["gpu"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":attention_helpers",
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/gemma4_modulev3",
        "//max/python/max/pipelines/weights",
        "//max/tests/integration/architectures/gemma4:gemma4_torch_reference",
        "//max/tests/integration/test_common:context_utils",
        requirement("numpy"),
        requirement("torch"),
        requirement("transformers"),
    ],
)

# These compile their graphs through `Module.compile`, so the compiles are
# recorded on CPU and the GPU worker only executes them.
modular_py_test(
    name = "compiled_tests",
    size = "large",
    srcs = [
        "test_attention.py",
        "test_pooling.py",
        "test_rms_norm.py",
        "test_vision_attention.py",
        "test_vision_patch_embedder.py",
    ],
    env = {
        "MODULAR_TORCH_MEMORY_PERCENT": "0.5",
    },
    exec_properties = {
        "test.resources:gpu-memory": "16",
    },
    gpu_constraints = ["//:has_gpu"],
    precompile_mefs = True,
    tags = ["gpu"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":attention_helpers",
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/gemma4_modulev3",
        "//max/python/max/pipelines/kv_cache",
        "//max/tests/integration/architectures/gemma4:gemma4_torch_reference",
        "//max/tests/integration/test_common:context_utils",
        "//max/tests/integration/test_common:graph_utils",
        requirement("numpy"),
        requirement("torch"),
        requirement("transformers"),
    ],
)
