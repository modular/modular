load("//bazel:api.bzl", "requirement")
load(
    "//max/tests/integration/xarch_warm:eager_py_test.bzl",
    "modular_eager_py_test",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_eager_py_test(
    name = "tests",
    size = "large",
    srcs = glob(["**/test_*.py"]),
    env = {
        "MODULAR_TORCH_MEMORY_PERCENT": "0.5",
    },
    exec_properties = {
        "test.resources:gpu-memory": "16",
    },
    gpu_constraints = ["//:has_gpu"],
    # Imported dynamically by max._interpreter, never statically; without it
    # every eager op falls back to a full graph compile and test_text_model
    # blows the 800s CI budget.
    ignore_extra_deps = ["//max/python/max/_interpreter_ops"],
    tags = ["gpu"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max:tree",
        "//max/python/max/_interpreter_ops",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/gemma4_modulev3",
        "//max/python/max/pipelines/kv_cache",
        "//max/tests/integration/architectures/gemma4:gemma4_torch_reference",
        "//max/tests/integration/test_common:context_utils",
        requirement("numpy"),
        requirement("torch"),
        requirement("transformers"),
    ],
)
