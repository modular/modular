# GLM-5.1 (GlmMoeDsa) layer integration tests.

load(
    "//bazel:api.bzl",
    "modular_py_library",
    "modular_py_test",
    "requirement",
)
load("//max/tests/integration/xarch_warm:eager_py_test.bzl", "modular_eager_py_test")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_library(
    name = "torch_reference",
    testonly = True,
    srcs = [
        "torch_reference/configuration_glm.py",
        "torch_reference/dense_mla_torch.py",
        "torch_reference/modeling_glm.py",
    ],
    ignore_unresolved_imports = [
        "flash_attn",
        "kernels-community.flash-mla",
    ],
    imports = ["."],
    tags = [
        "no-mypy",
    ],
    deps = [
        requirement("torch"),
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_tool_parser",
    srcs = ["test_tool_parser.py"],
    deps = [
        "//max/python/max/_xgrammar",
        "//max/python/max/pipelines/architectures/glm5_1",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
    ],
)

modular_py_test(
    name = "test_format_spec",
    srcs = ["test_format_spec.py"],
    deps = [
        "//max/python/max/pipelines/architectures/glm5_1",
        "//max/python/max/pipelines/weights",
    ],
)

modular_py_test(
    name = "test_hisparse_graph",
    srcs = ["test_hisparse_graph.py"],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/_graph_ops",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/deepseekV3_2_modulev3",
        "//max/python/max/pipelines/architectures/glm5_1_modulev3",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "test_hisparse_mtp_graph",
    srcs = ["test_hisparse_mtp_graph.py"],
    ignore_extra_deps = [
        # Eager tensors import the MO interpreter; without its compiled ops
        # the realizations fall back to compiling each graph, which cannot
        # initialize on a virtual device.
        "//max/python/max/_interpreter_ops",
        # The pairing resolves its architectures through the registry, which
        # only hydrates when the ``max.pipelines`` package's __init__ runs;
        # no test import names it directly.
        "//max/python/max/pipelines",
    ],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/_interpreter_ops",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/_graph_ops",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/glm5_1_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

modular_py_test(
    name = "test_hisparse_params",
    srcs = ["test_hisparse_params.py"],
    deps = [
        "//max/python/max/nn/_graph_ops",
    ],
)

modular_py_test(
    name = "test_modulev3_nvfp4_kv",
    srcs = ["test_modulev3_nvfp4_kv.py"],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures/glm5_1",
        "//max/python/max/pipelines/architectures/glm5_1_modulev3",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "test_mtp_draft",
    srcs = ["test_mtp_draft.py"],
    ignore_extra_deps = [
        "//max/python/max/pipelines",
    ],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/glm5_1_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_dp_mtp_contracts",
    # An eight-device CPU mesh builds a lot of graph ops per case.
    size = "large",
    srcs = ["test_dp_mtp_contracts.py"],
    ignore_extra_deps = [
        # Eager tensors import the MO interpreter; without its compiled ops
        # the realizations fall back to compiling each graph.
        "//max/python/max/_interpreter_ops",
    ],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/_interpreter_ops",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn:core",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures/deepseekV3_2_modulev3",
        "//max/python/max/pipelines/architectures/deepseekV3_modulev3",
        "//max/python/max/pipelines/architectures/glm5_1_modulev3",
        "//max/python/max/pipelines/speculative",
        requirement("numpy"),
    ],
)

# Each test realizes one eager graph of collectives on a CPU mesh. The
# interpreter serves its ops from the build-warmed eager cache: compiling each
# op and dtype on first use, about 10 s apiece, put the file past its timeout.
modular_eager_py_test(
    name = "test_prefill_context_parallel",
    size = "large",
    srcs = ["test_prefill_context_parallel.py"],
    cpu_only = True,
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/pipelines/architectures/deepseekV3_2_modulev3",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_chat_template",
    srcs = ["test_chat_template.py"],
    data = [
        "//max/tests/integration/architectures/glm5_1/testdata",
    ],
    env = {
        "PIPELINES_TESTDATA": "max/tests/integration/architectures/glm5_1/testdata",
    },
    ignore_extra_deps = [
        requirement("jinja2"),  # Required by transformers' chat-template renderer
    ],
    # tokenizers is a transitive dependency of transformers but doesn't have
    # an unversioned bazel alias, so we need to ignore its unresolved imports
    ignore_unresolved_imports = [
        "tokenizers.Tokenizer",
        "tokenizers.models.WordLevel",
    ],
    deps = [
        "//max/python/max/pipelines/architectures/glm5_1",
        "//max/python/max/pipelines/modeling",
        requirement("jinja2"),
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_tokenizer",
    srcs = ["test_tokenizer.py"],
    deps = [
        "//max/python/max/pipelines/architectures/glm5_1",
    ],
)

modular_py_test(
    name = "glm5_1",
    size = "large",
    srcs = glob(
        ["**/test_*.py"],
        exclude = [
            "test_chat_template.py",
            "test_dp_mtp_contracts.py",
            "test_format_spec.py",
            "test_hisparse_graph.py",
            "test_hisparse_mtp_graph.py",
            "test_hisparse_params.py",
            "test_modulev3_nvfp4_kv.py",
            "test_mtp_draft.py",
            "test_prefill_context_parallel.py",
            "test_tokenizer.py",
            "test_tool_parser.py",
        ],
    ) + [
        "conftest.py",
    ],
    data = [
        "//max/tests/integration/architectures/glm5_1/testdata",
    ],
    env = {
        "PIPELINES_TESTDATA": "max/tests/integration/architectures/glm5_1/testdata",
        "MODULAR_TORCH_MEMORY_PERCENT": "0.5",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    precompile_mefs = True,
    tags = [
        "gpu",
        "no-sandbox",
    ],
    deps = [
        ":torch_reference",
        "//max/python/max:_core",
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn:core",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/deepseekV3_2",
        "//max/python/max/pipelines/kv_cache",
        "//max/tests/integration/test_common:context_utils",
        "//max/tests/integration/test_common:graph_utils",
        requirement("numpy"),
        requirement("torch"),
    ],
)
