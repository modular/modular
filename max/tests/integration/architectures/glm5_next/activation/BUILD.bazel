load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_clamped_swiglu",
    srcs = ["test_clamped_swiglu.py"],
    ignore_extra_deps = [
        # lazy import
        "//max/python/max/_interpreter_ops",
    ],
    deps = [
        "//max/python/max/_interpreter_ops",
        requirement("numpy"),
        requirement("torch"),
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/pipelines/architectures/glm5_next",
    ],
)
