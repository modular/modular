load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_data_parallel_rejected",
    srcs = ["test_data_parallel_rejected.py"],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures/glm5_next",
    ],
)

modular_py_test(
    name = "test_initialize_guards",
    srcs = ["test_initialize_guards.py"],
    deps = [
        requirement("transformers"),
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures/glm5_next",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "test_nvfp4_precision_map",
    srcs = ["test_nvfp4_precision_map.py"],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/nn:core",
        "//max/python/max/pipelines/architectures/glm5_next",
    ],
)

# The Python files, which test_no_legacy_ep_imports scans.
filegroup(
    name = "py_srcs",
    srcs = glob(["**/*.py"]),
)
