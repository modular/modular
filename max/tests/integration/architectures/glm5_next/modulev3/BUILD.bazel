load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_weight_adapter",
    srcs = ["test_weight_adapter.py"],
    deps = [
        requirement("numpy"),
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/glm5_next_modulev3",
    ],
)

modular_py_test(
    name = "test_write_back",
    srcs = ["test_write_back.py"],
    exec_properties = {
        "test.resources:gpu-memory": "2",
    },
    gpu_constraints = ["//:has_gpu"],
    ignore_extra_deps = [
        # lazy import
        "//max/python/max/_interpreter_ops",
    ],
    precompile_mefs = True,
    tags = ["gpu"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/_interpreter_ops",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/pipelines/architectures/glm5_next_modulev3",
        requirement("torch"),
    ],
)

