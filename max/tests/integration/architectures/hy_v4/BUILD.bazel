load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_tool_call_grammar",
    size = "small",
    srcs = ["test_tool_call_grammar.py"],
    deps = [
        "//max/python/max/_xgrammar",
        "//max/python/max/pipelines/architectures/hy_v4",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "test_reasoning",
    size = "small",
    srcs = ["test_reasoning.py"],
    deps = [
        "//max/python/max/pipelines/architectures/hy_v4",
        requirement("numpy"),
        requirement("pytest-asyncio"),
    ],
)

modular_py_test(
    name = "test_registration",
    size = "small",
    srcs = ["test_registration.py"],
    deps = [
        "//max/python/max:tree",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn:core",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/hy_v4",
        "//max/python/max/pipelines/lib",
    ],
)

# The weight rules against the published checkpoint's tensor names.
modular_py_test(
    name = "test_weight_adapters",
    size = "small",
    srcs = ["test_weight_adapters.py"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/hy_v4",
        "//max/python/max/pipelines/lib",
        requirement("numpy"),
    ],
)

# Both Hy4 archs name formatspec.json, and an artifact stores it, so Mach runs
# the reasoning and tool parsers. It breaks if the arch drops format_spec, or
# if export.py's checkpoint_format_spec or the artifact's format_spec
# component change.
modular_py_test(
    name = "test_format_spec",
    size = "small",
    srcs = ["test_format_spec.py"],
    deps = [
        "//max/python/max/_artifact:export",
        "//max/python/max/_artifact:model_artifact",
        "//max/python/max/pipelines/architectures/hy_v4",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/weights",
    ],
)
