# The NumPy reference and runner the two mix_norm GPU targets share.
modular_py_library(
    name = "mix_norm_check",
    testonly = True,
    srcs = ["_mix_norm_check.py"],
    imports = ["."],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/pipelines/architectures/inkling2",
        requirement("numpy"),
    ],
)

# Guards the fused inkling2_mix_norm op against its NumPy reference at two
# shapes that reach every axis; test_mix_norm_gpu_sweep runs the rest.
modular_py_test(
    name = "test_mix_norm_gpu",
    size = "enormous",
    srcs = ["test_mix_norm_gpu.py"],
    env = {"MAX_EAGER_EXECUTOR": "fallback-internal"},
    exec_properties = {
        "test.resources:gpu-memory": "8",
    },
    tags = ["gpu"],
    target_compatible_with = ["//:b200_gpu"],
    deps = [
        ":mix_norm_check",
        "//max/python/max/dtype",
    ],
)

# The full shape sweep of inkling2_mix_norm, postsubmit only: every shape
# compiles the op on the GPU.
modular_py_test(
    name = "test_mix_norm_gpu_sweep",
    size = "enormous",
    srcs = ["test_mix_norm_gpu_sweep.py"],
    env = {"MAX_EAGER_EXECUTOR": "fallback-internal"},
    exec_properties = {
        "test.resources:gpu-memory": "8",
    },
    tags = [
        "gpu",
        "postsubmit",
    ],
    target_compatible_with = ["//:b200_gpu"],
    deps = [
        ":mix_norm_check",
        "//max/python/max/dtype",
    ],
)
