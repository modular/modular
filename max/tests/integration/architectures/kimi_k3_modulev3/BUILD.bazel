# EP=2 vs single-device parity for the latent MoE block's expert exchange.
# Needs two real devices -- a staged/symbolic mesh cannot register real
# SHMEM buffers -- so run on a 2-GPU executor, e.g. `./bazelw test
# //max/tests/integration/architectures/kimi_k3_modulev3:ep_mlp_moe_tests_gpu`
# on a 2-GPU dev box.
modular_eager_py_test(
    name = "ep_mlp_moe_tests_gpu",
    size = "enormous",
    srcs = ["test_ep_mlp_moe.py"],
    env = {"MAX_EAGER_EXECUTOR": "fallback-internal"},
    exec_properties = {
        "test.resources:gpu-1": "0",
        "test.resources:gpu-2": "0.01",
        "test.resources:gpu-memory": "16",
    },
    tags = ["gpu"],
    target_compatible_with = ["//:has_multi_gpu"],
    deps = [
        requirement("numpy"),
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/pipelines/architectures/kimi_k3_modulev3",
    ],
)

