# gfx950 numerics for the chunk routing; every case skips on any other GPU.
modular_eager_py_test(
    name = "kda_chunk_prefill_tests_gpu",
    size = "enormous",
    srcs = ["test_kda_chunk_prefill.py"],
    exec_properties = {
        "test.resources:gpu-memory": "2",
    },
    gpu_constraints = ["//:has_gpu"],
    precompile_mefs = True,
    tags = ["gpu"],
    # Needs kda_chunk, registered only by the closed-source kernels.
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }) + REQUIRES_INTERNAL_KERNELS,
    deps = [
        requirement("numpy"),
        requirement("torch"),
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/kimi_k3_modulev3",
    ],
)

