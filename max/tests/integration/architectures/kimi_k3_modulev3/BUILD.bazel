# The 8-rows-per-request verify of DSpark spec decode, postsubmit only (it
# runs past the 4-minute presubmit budget on both vendors): one GPU runs the
# production fold arm, its RED control and the plan-extent check; the
# 96-head prefill arm runs in its own postsubmit target below on both
# vendors (one more kernel family to JIT, and on B200 the SM100 dispatch
# table routes 96 heads through an entry the 12-head fold never takes),
# and the TP2 parity runs on the 2-GPU targets below.
modular_eager_py_test(
    name = "spec_mla_verify8_tests_gpu",
    size = "enormous",
    srcs = ["test_spec_mla_verify8.py"],
    args = [
        "-k",
        "'not tp2 and not prefill_arm_matches_stepwise'",
    ],
    exec_properties = {
        "test.resources:gpu-memory": "2",
    },
    gpu_constraints = ["//:has_gpu"],
    tags = [
        "gpu",
        "postsubmit",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":tp_model_test_utils",
        "//max/python/max:tree",
        requirement("numpy"),
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures/kimi_k3_modulev3",
        "//max/python/max/pipelines/architectures/kimi_k3_modulev3/dspark",
        "//max/python/max/support",
    ],
)

