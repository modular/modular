    name = "k3_dspark_reference",
    testonly = True,
    srcs = [
        "torch_reference.py",
    ],
    # safetensors.torch imports numpy in its save/load path without the wheel
    # declaring it.
    ignore_extra_deps = [requirement("numpy")],
    imports = ["."],
    deps = [
        requirement("numpy"),
        requirement("torch"),
    ],
)

