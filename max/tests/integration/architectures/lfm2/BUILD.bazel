load(
    "//bazel:api.bzl",
    "modular_py_test",
    "requirement",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "tests",
    size = "medium",
    srcs = glob(["test_*.py"]),
    deps = [
        "//max/python/max:tensor",
        "//max/python/max:tree",
        "//max/python/max/_artifact:export",
        "//max/python/max/_artifact:model_artifact",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/lfm2",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/tests/integration/test_common:context_utils",
        requirement("numpy"),
    ],
)
