load(
    "//bazel:api.bzl",
    "modular_py_test",
    "requirement",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "tests",
    size = "small",
    srcs = glob(["test_*.py"]),
    deps = [
        "//max/python/max/pipelines/architectures/lfm3_audio",
        "//max/python/max/pipelines/architectures/lfm3_vl",
        requirement("numpy"),
    ],
)
