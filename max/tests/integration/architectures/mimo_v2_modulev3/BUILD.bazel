# The migration's parity gate: the graph-API MiMo-V2 and the ModuleV3 port on
# the same fixture, through the V2 and V3 runners, logits row by row. The
# record run captures only the V3 graph (each runner needs hardware right
# after its compile, so the record stops at the first one — see the fixture
# for the ordering); the V2 graph compiles on the GPU via the plugin's
# past-stop path.
modular_py_test(
    name = "mimo_v3_parity_gpu",
    size = "large",
    srcs = ["test_v2_v3_parity_gpu.py"],
    data = ["//max/tests/integration/architectures/mimo_v2:tiny_goldens"],
    exec_properties = {
