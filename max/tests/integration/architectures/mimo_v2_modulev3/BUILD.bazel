# The replica check's trace and compare path, on four B200s for the bitwise
# check and on the two a remote B200 executor exposes for the smoke run. One
# source runs in both, distinguished by MIMO_REPLICA_TP.
modular_py_test(
    name = "mimo_local_routing_replica_gpu",
    size = "large",
    # A full-width compile and 56 steps outlast the large-size limit.
    timeout = "eternal",
    srcs = ["test_local_routing_replica_gpu.py"],
    env = {"MIMO_REPLICA_TP": "4"},
    # Set from a measurement: with the memory-manager log on, this arm's trace
    # peaks at 3.27 GiB in use per device. The rules cap the manager at this
    # request less 0.6 GB, so 6 leaves 5.4 GB.
    exec_properties = {"test.resources:gpu-memory": "6"},
    gpu_constraints = [
        "//:b200_gpu",
        "//:has_4_gpus",
    ],
    imports = ["."],
    precompile_device_count = 4,
    precompile_mefs = True,
    tags = [
        "gpu",
        "manual",
    ],
    deps = [
        ":mimo_replica_probe",
        ":mimo_v3_runner",
        "//max/python/max:tensor",
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/mimo_v2_modulev3",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/modeling",
        requirement("ml-dtypes"),
        requirement("numpy"),
    ],
)

# The replica check's step and compare path on the two GPUs a remote B200
# executor exposes, so it runs before a four-GPU box does. Postsubmit: the
# test takes 20.8 s, under a GPU-minute across its two devices.
modular_py_test(
    name = "mimo_local_routing_replica_smoke_gpu",
    size = "large",
    timeout = "eternal",
    srcs = ["test_local_routing_replica_gpu.py"],
    env = {"MIMO_REPLICA_TP": "2"},
    # Set from a measurement: with the memory-manager log on, this arm's trace
    # peaks at 1.60 GiB in use per device. The rules cap the manager at this
    # request less 0.6 GB, so 5 leaves 4.4 GiB.
    exec_properties = {"test.resources:gpu-memory": "5"},
    gpu_constraints = [
        "//:b200_gpu",
        "//:has_multi_gpu",
    ],
    imports = ["."],
    precompile_device_count = 2,
    precompile_mefs = True,
    tags = [
        "gpu",
        "postsubmit",
    ],
    deps = [
        ":mimo_replica_probe",
        ":mimo_v3_runner",
        "//max/python/max:tensor",
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/mimo_v2_modulev3",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/modeling",
        requirement("ml-dtypes"),
        requirement("numpy"),
    ],
)

