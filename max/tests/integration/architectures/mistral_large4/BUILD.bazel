# Guards the repo-id serve path: the config derived from the NVFP4 release's
# params.json (against the generator the bring-up staged and the HF converter's
# oracle) and the params.json a Hub snapshot never holds. CPU only, no network.
#
# The one check that reads the native tokenizer's own pin needs
# `ML4_TOKENIZER_PINNED_REVISIONS`, which this BUILD cannot supply:
# `//tokenizer` is not part of the OSS overlay (`utils/oss-bazel.sh`), so a
# label into it fails the smoke build's analysis. Point the variable at
# `tokenizer/crates/tokenizer-core/data/pinned_revisions.json` to run it; it
# skips otherwise.
modular_py_test(
    name = "test_repo_id_serve",
    srcs = ["test_repo_id_serve.py"],
    data = ["//max/tests/integration/architectures/mistral_large4/testdata"],
    ignore_extra_deps = [
        # Importing the pipelines package registers the architecture table and
        # the config generators a config-less checkpoint is derived through,
        # which the tests here exercise without naming the package.
        "//max/python/max/pipelines",
    ],
    deps = [
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/mistral_large4_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/weights",
        requirement("transformers"),
    ],
)

