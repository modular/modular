# Guards pipelines/architectures/mistral_large4_modulev3/dspark.py: the
# drafter's window mask (the last 2048 context latents up to the anchor, plus
# all three block rows, with no causal mask in the block) and its recurrent
# head's state chaining, against a numpy transcription of the reference. CPU
# only, on a geometry small enough to compile in about a minute; the target is
# compile-bound, ~150-225 s end to end depending on how loaded the box is (the
# file compiles four graphs: the attention layer, the whole step, and one per
# block-position convention), so it asks for the large budget rather than
# medium's 300 s.
modular_py_test(
    name = "test_dspark_drafter",
    size = "large",
    srcs = ["test_dspark_drafter.py"],
    data = ["//max/tests/integration/architectures/mistral_large4/testdata"],
    # Eager ops use the optional _interpreter_ops kernels at runtime, and both
    # the module's zero-filled parameters and its compiled graphs reach them.
    ignore_extra_deps = ["//max/python/max/_interpreter_ops"],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/_interpreter_ops",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/mistral_large4_modulev3",
        "//max/python/max/pipelines/lib",
        requirement("numpy"),
    ],
)

