# Guards the paged block graph's capturability: it stages at eight ranks with
# the drafter's own paged leaf as its cache, with one window gather and one
# context store per layer, no cross-device transfer and no host readback, and
# the batch still symbolic. A transfer or a readback there would cost the whole
# fused speculative graph its device-graph capture. Staged on virtual B200s: no
# compile, no GPU.
modular_py_test(
    name = "test_dspark_paged_capture_safe",
    size = "small",
    srcs = ["test_dspark_paged_capture_safe.py"],
    target_compatible_with = select({
        # No NVPTX target for the staged sm_100a virtual devices.
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":dspark_paged_fixtures",
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures/mistral_large4_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

