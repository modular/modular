# The two published ML4 checkpoints' `params.json` (metadata, no weights), the
# base repo's published `config.json`, and a headers-only dump of the NVFP4
# checkpoint plus the name/shape/dtype/scale table both loaders must produce.
# Each snapshot is copied verbatim from its published repo, so the JSON holds
# no local edits and can be regenerated by re-fetching that repo's file.

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

filegroup(
    name = "testdata",
    testonly = True,
    srcs = [
        "ml4_base_config.json",
        "ml4_base_params.json",
        "ml4_nvfp4_contract.json",
        "ml4_nvfp4_headers.json",
        "ml4_nvfp4_hf_config.json",
        "ml4_nvfp4_params.json",
    ],
    visibility = [
        "//mach:__subpackages__",
        "//max/tests/integration/architectures/mistral_large4:__pkg__",
    ],
)
