load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_weight_adapter",
    size = "large",
    srcs = ["test_weight_adapter.py"],
    deps = [
        "//max/python/max/pipelines/architectures/mtp_deepseekV3",
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_draft_config_ep_dispatch_dtype",
    size = "large",
    srcs = ["test_draft_config_ep_dispatch_dtype.py"],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn:core",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures/deepseekV3",
        "//max/python/max/pipelines/architectures/mtp_deepseekV3",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "test_registered_draft",
    size = "large",
    srcs = ["test_registered_draft.py"],
    ignore_extra_deps = [
        # Finds the target's architecture by name.
        "//max/python/max/pipelines",
    ],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn:core",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/deepseekV3_nextn",
        "//max/python/max/pipelines/architectures/mtp_deepseekV3",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)
