modular_py_test(
    name = "test_greedy_equivalence",
    size = "enormous",
    srcs = ["test_greedy_equivalence.py"],
    # Expert parallelism, whose MoE is capture-safe, needs NVSHMEM.
    data = ["@nvshmem_prebuilt//:host"],
    env = {
        "MODULAR_SHMEM_LIB_DIR": "../+http_archive+nvshmem_prebuilt",
    },
    exec_properties = {
        "test.resources:gpu-1": "0",
        "test.resources:gpu-2": "0.01",
        "test.resources:gpu-memory": "60",
    },
    gpu_constraints = ["//:has_multi_gpu"] + select({
        "//:amd_gpu": ["@platforms//:incompatible"],
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    # The architecture registry imports it by name, so pydeps sees it as
    # unused.
    ignore_extra_deps = [
        "//max/python/max/pipelines/architectures/mtp_glm5_next",
    ],
    # The MTP run's graphs compile in a CPU build action. The record stops
    # where that run first needs a GPU, so the plain run compiles here.
    precompile_device_count = 2,
    precompile_mefs = True,
    tags = ["gpu"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/architectures/glm5_next",
        "//max/python/max/pipelines/architectures/mtp_glm5_next",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
        requirement("numpy"),
        requirement("safetensors"),
        requirement("torch"),
    ],
)
