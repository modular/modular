# GLM-5.3-Flash MTP integration tests.

load(
    "//bazel:api.bzl",
    "modular_py_test",
    "requirement",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_state_regions",
    srcs = ["test_state_regions.py"],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/glm5_next",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

modular_py_test(
    name = "test_weight_adapter",
    srcs = ["test_weight_adapter.py"],
    deps = [
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/glm5_next",
        "//max/python/max/pipelines/architectures/mtp_glm5_next",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_arch_selection",
    srcs = ["test_arch_selection.py"],
    # The architecture registry imports them by name, so pydeps sees them as
    # unused.
    ignore_extra_deps = [
        "//max/python/max/pipelines/architectures/glm5_next",
        "//max/python/max/pipelines/architectures/mtp_glm5_next",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    deps = [
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/architectures/glm5_next",
        "//max/python/max/pipelines/architectures/mtp_glm5_next",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

modular_py_test(
    name = "test_state_rollback",
    size = "large",
    srcs = ["test_state_rollback.py"],
    gpu_constraints = ["//:has_gpu"] + select({
        "//:amd_gpu": ["@platforms//:incompatible"],
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    precompile_mefs = True,
    tags = ["gpu"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/deepseekV3_2",
        "//max/python/max/pipelines/architectures/glm5_next",
        "//max/python/max/pipelines/speculative",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_graph_signature",
    size = "large",
    srcs = ["test_graph_signature.py"],
    gpu_constraints = ["//:has_gpu"] + select({
        "//:amd_gpu": ["@platforms//:incompatible"],
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    # The architecture registry imports it by name, so pydeps sees it as
    # unused.
    ignore_extra_deps = [
        "//max/python/max/pipelines/architectures/mtp_glm5_next",
    ],
    # Staging constructs `Allreduce`, which instantiates an `Accelerator`.
    precompile_mefs = True,
    tags = ["gpu"],
    deps = [
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/architectures/glm5_next",
        "//max/python/max/pipelines/architectures/mtp_glm5_next",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

