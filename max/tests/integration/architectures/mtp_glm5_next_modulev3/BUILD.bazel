# GLM-5.3-Flash MTP integration tests on ModuleV3.

load(
    "//bazel:api.bzl",
    "modular_py_test",
    "requirement",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_weight_adapter",
    srcs = ["test_weight_adapter.py"],
    deps = [
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/glm5_next_modulev3",
        "//max/python/max/pipelines/lib",
        requirement("numpy"),
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_arch_selection",
    srcs = ["test_arch_selection.py"],
    # The architecture registry imports them by name, so pydeps sees them as
    # unused.
    ignore_extra_deps = [
        "//max/python/max/pipelines/architectures/glm5_next_modulev3",
        "//max/python/max/pipelines/architectures/mtp_glm5_next_modulev3",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    deps = [
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/architectures/glm5_next_modulev3",
        "//max/python/max/pipelines/architectures/mtp_glm5_next_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
    ],
)

modular_py_test(
    name = "test_graph_signature",
    size = "large",
    srcs = ["test_graph_signature.py"],
    gpu_constraints = ["//:has_gpu"] + select({
        "//:mi355_gpu": [],
        "//:nvidia_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    # The architecture registry imports it by name, so pydeps sees it as
    # unused.
    ignore_extra_deps = [
        "//max/python/max/pipelines/architectures/mtp_glm5_next_modulev3",
    ],
    precompile_mefs = True,
    tags = ["gpu"],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn:core",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/architectures/glm5_next",
        "//max/python/max/pipelines/architectures/glm5_next_modulev3",
        "//max/python/max/pipelines/architectures/mtp_glm5_next_modulev3",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
)

modular_py_test(
    name = "test_greedy_equivalence",
    size = "enormous",
    srcs = ["test_greedy_equivalence.py"],
    # Expert parallelism, whose MoE is capture-safe, needs NVSHMEM or
    # rocSHMEM.
    data = select({
        "//:nvidia_gpu": ["@nvshmem_prebuilt//:host"],
        "//conditions:default": [],
    }),
    env = select({
        "//:nvidia_gpu": {
            "MODULAR_SHMEM_LIB_DIR": "../+http_archive+nvshmem_prebuilt",
        },
        "//:amd_gpu": {
            "MODULAR_SHMEM_LIB_DIR": "../+http_archive+rocshmem/lib",
        },
        "//conditions:default": {},
    }),
    exec_properties = {
        "test.resources:gpu-1": "0",
        "test.resources:gpu-2": "0.01",
        "test.resources:gpu-memory": "60",
    },
    gpu_constraints = ["//:has_multi_gpu"] + select({
        "//:mi355_gpu": [],
        "//:nvidia_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    # The architecture registry imports it by name, so pydeps sees it as
    # unused.
    ignore_extra_deps = [
        "//max/python/max/pipelines/architectures/mtp_glm5_next_modulev3",
    ],
    # The MTP run's graphs compile in a CPU build action. The record stops
    # where that run first needs a GPU, so the plain run compiles here.
    precompile_device_count = 2,
    precompile_mefs = True,
    # About 10 GPU-minutes on 2xMI355 (306 s), past the presubmit budget.
    # The layer rollback and graph signature tests cover presubmit.
    tags = [
        "gpu",
        "postsubmit",
    ],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn:core",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/architectures/glm5_next",
        "//max/python/max/pipelines/architectures/glm5_next_modulev3",
        "//max/python/max/pipelines/architectures/mtp_glm5_next_modulev3",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
        requirement("numpy"),
        requirement("safetensors"),
        requirement("torch"),
    ],
)

modular_py_test(
    name = "test_kda_layer_rollback",
    size = "large",
    srcs = ["test_kda_layer_rollback.py"],
    gpu_constraints = ["//:has_gpu"] + select({
        "//:mi355_gpu": [],
        "//:nvidia_gpu": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    precompile_mefs = True,
    tags = ["gpu"],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/nn/_graph_ops",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/architectures/glm5_next",
        "//max/python/max/pipelines/architectures/glm5_next_modulev3",
        "//max/python/max/pipelines/speculative",
        requirement("numpy"),
    ],
)
