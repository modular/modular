load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

filegroup(
    name = "testdata",
    srcs = glob(["testdata/**"]),
)

# hf_config_shims.py is shared by many models, so this catches an edit to
# another shim, or a transformers upgrade that ships native muse_spark
# configs, changing how the published config parses.
modular_py_test(
    name = "test_hf_config_shim",
    srcs = ["test_hf_config_shim.py"],
    data = [":testdata"],
    deps = [
        "//max/python/max/pipelines/architectures",
        requirement("transformers"),
    ],
)

# The host-side inputs come from muse_glimmer's vision data processing,
# which Glimmer shares, so this catches an edit there that moves Spark's
# RoPE tables, window order or position taps off the reference.
modular_py_test(
    name = "test_vision",
    srcs = ["test_vision.py"],
    data = [":testdata"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/architectures/muse_glimmer",
        "//max/python/max/pipelines/architectures/muse_spark",
        requirement("numpy"),
        requirement("torch"),
        requirement("transformers"),
    ],
)
