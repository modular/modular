load(
    "//bazel:api.bzl",
    "modular_py_test",
    "requirement",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

# Structural tests: architecture registration, per-layer config math, weight
# adapter renames. No network or downloaded weights needed.
modular_py_test(
    name = "tests",
    size = "small",
    srcs = ["test_openelm_pipeline.py"],
    deps = [
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/openelm",
        "//max/python/max/pipelines/lib",
        requirement("numpy"),
    ],
)

# Real-checkpoint tests: download apple/OpenELM-270M-Instruct (and, for the
# output-consistency test, the gated meta-llama/Llama-2-7b-hf tokenizer)
# from the HuggingFace Hub. Kept in their own "_network"-suffixed files so
# this glob doesn't pull in the structural tests above.
modular_py_test(
    name = "tests_network",
    size = "large",
    srcs = glob(["test_*_network.py"]),
    tags = [
        "requires-network",
    ],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/openelm",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/request",
        requirement("huggingface-hub"),
        requirement("numpy"),
        requirement("safetensors"),
        requirement("torch"),
        requirement("transformers"),
    ],
)
