modular_py_test(
    name = "test_tap_capture",
    size = "large",
    srcs = ["test_tap_capture.py"],
    # The 280 MB signal buffer is a single allocation, so the default per-test
    # GPU budget cannot serve it whatever the model size.
    exec_properties = {
        "test.resources:gpu-memory": "3",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    # Eleven tiny Qwen3.5 compiles across six cases, recorded by CPU build
    # actions, one per shard. Raise `precompile_shards` before `shard_count` if
    # this file grows: a record action carries its shard's whole compile set
    # and the longest already runs about 380s of the 900s an action gets.
    precompile_mefs = True,
    shard_count = 3,
    tags = ["gpu"],
    deps = [
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/kv_cache",
        "//max/tests/integration/test_common:context_utils",
        requirement("numpy"),
    ],
)

