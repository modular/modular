modular_py_test(
    name = "test_vision_clip_graph",
    # Compiling the two encoder graphs takes 330 to 400 s on B200 CI, which
    # is at the 400 s limit for a medium test.
    size = "large",
    srcs = ["test_vision_clip_graph.py"],
    # The 280 MB signal buffer is a single allocation, so the default per-test
    # GPU budget cannot serve it whatever the encoder size.
    exec_properties = {
        "test.resources:gpu-memory": "3",
    },
    # `mo.spatial_merge` is `comptime assert is_gpu[target]()`.
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    precompile_mefs = True,
    tags = ["gpu"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/qwen2_5vl",
        "//max/python/max/pipelines/architectures/qwen3vl_moe",
        requirement("numpy"),
    ],
)

