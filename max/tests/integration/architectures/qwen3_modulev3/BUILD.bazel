# Qwen3-VL text-encoder benchmarks (the Qwen3-VL-8B text tower).

load(
    "//bazel:api.bzl",
    "modular_py_test",
    "requirement",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_profile_text_encoder",
    size = "large",
    timeout = "long",
    srcs = ["test_profile_text_encoder.py"],
    exec_properties = {
        "test.resources:gpu-memory": "40",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tags = [
        "gpu",
        "manual",
        "no-sandbox",
    ],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/qwen3_modulev3",
        "//max/python/max/pipelines/modeling",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_attention_paths",
    size = "large",
    timeout = "long",
    srcs = ["test_attention_paths.py"],
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tags = [
        "gpu",
        "no-sandbox",
    ],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/qwen3_modulev3",
        "//max/python/max/pipelines/modeling",
        requirement("numpy"),
        requirement("torch"),
    ],
)
