# Qwen3VL integration tests.

load(
    "//bazel:api.bzl",
    "modular_py_library",
    "modular_py_test",
    "requirement",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_vision_functions",
    srcs = ["test_vision_functions.py"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    deps = [
        ":utils",
        "//max/python/max/pipelines/architectures/qwen3vl_moe",
        requirement("torch"),
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_chunked_prefill",
    srcs = ["test_chunked_prefill.py"],
    deps = [
        "//max/python/max/pipelines/architectures/qwen3vl_moe",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/modeling",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_vision_rows",
    srcs = ["test_vision_rows.py"],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/pipelines/architectures/qwen3vl_moe",
    ],
)

modular_py_library(
    name = "utils",
    testonly = True,
    srcs = glob(["utils/*.py"]),
    data = [
        "configs/qwen3-VL-30B-A3B-Instruct.json",
    ],
    imports = ["."],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
    ],
)

modular_py_test(
    name = "test_image_processor",
    srcs = ["test_image_processor.py"],
    tags = [
        "manual",
        "requires-network",
    ],
    deps = [
        "//max/python/max/pipelines/architectures/qwen3vl_moe",
        requirement("numpy"),
        requirement("pillow"),
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_preprocess_cache",
    srcs = ["test_preprocess_cache.py"],
    deps = [
        "//max/python/max/pipelines/architectures/qwen3vl_moe",
        "//max/python/max/pipelines/lib",
        "//max/python/max/support",
        requirement("numpy"),
        requirement("pillow"),
    ],
)

modular_py_test(
    name = "test_tokenizer",
    srcs = ["test_tokenizer.py"],
    tags = [
        "manual",
        "requires-network",
    ],
    deps = [
        "//max/python/max/pipelines/architectures/qwen3vl_moe",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        requirement("numpy"),
        requirement("pillow"),
        requirement("transformers"),
    ],
)

modular_py_library(
    name = "generate_utils",
    testonly = True,
    srcs = ["generate_utils.py"],
    imports = [".."],
    deps = [
        "//max/tests/integration/test_common:storage",
        "//max/tests/integration/test_common:test_data",
        "//max/tests/integration/test_common:torch_utils",
        requirement("torch"),
        requirement("transformers"),
    ],
)
