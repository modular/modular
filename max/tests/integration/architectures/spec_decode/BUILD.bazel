load("//bazel:api.bzl", "modular_py_test")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_spec_decode_architecture",
    srcs = ["test_spec_decode_architecture.py"],
    ignore_extra_deps = [
        "//max/python/max/pipelines",
        # Resolve the Llama target and its EAGLE and DFlash drafts by name.
        "//max/python/max/pipelines/architectures/dflash_llama3",
        "//max/python/max/pipelines/architectures/eagle_llama3",
        "//max/python/max/pipelines/architectures/llama3",
    ],
    deps = [
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/dflash_llama3",
        "//max/python/max/pipelines/architectures/eagle_llama3",
        "//max/python/max/pipelines/architectures/llama3",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "test_spec_decode_kv_tree",
    srcs = ["test_spec_decode_kv_tree.py"],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "test_spec_decode_graph_names",
    srcs = ["test_spec_decode_graph_names.py"],
    ignore_extra_deps = [
        "//max/python/max/pipelines",
        # Resolve each target's architecture by name at runtime.
        "//max/python/max/pipelines/architectures/deepseekV3",
        "//max/python/max/pipelines/architectures/deepseekV4",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/kimik2_5",
        "//max/python/max/pipelines/architectures/mimo_v2",
        "//max/python/max/pipelines/architectures/qwen3_5",
    ],
    deps = [
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/deepseekV3",
        "//max/python/max/pipelines/architectures/deepseekV4",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/kimik2_5",
        "//max/python/max/pipelines/architectures/mimo_v2",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/lib",
    ],
)

modular_py_test(
    name = "test_spec_decode_pipeline_stage",
    srcs = ["test_spec_decode_pipeline_stage.py"],
    ignore_extra_deps = [
        "//max/python/max/pipelines",
        # Resolve the Gemma 4 and Llama targets and their drafts by name.
        "//max/python/max/pipelines/architectures/eagle_llama3",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/gemma4_assistant",
        "//max/python/max/pipelines/architectures/llama3",
    ],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/eagle_llama3",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/gemma4_assistant",
        "//max/python/max/pipelines/architectures/llama3",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/speculative",
    ],
