load(
    "//bazel:api.bzl",
    "modular_py_test",
    "requirement",
)

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "test_wiring",
    size = "large",
    srcs = ["test_wiring.py"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/pipelines/architectures/gemma4",
        "//max/python/max/pipelines/architectures/unified_mtp_gemma4_modulev3",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/pipelines/speculative",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_variable_rows",
    size = "large",
    srcs = ["test_variable_rows.py"],
    exec_properties = {
        "test.resources:gpu-memory": "16",
    },
    gpu_constraints = ["//:has_gpu"],
    tags = ["gpu"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/experimental",
        "//max/python/max/pipelines/speculative",
    ],
)
