modular_py_test(
    name = "test_state_pool_dtype",
    srcs = ["test_state_pool_dtype.py"],
    # Builds the base and speculative graphs to compare their declared pool
    # dtype. Construction reaches `Allreduce.__init__`, which instantiates
    # `Accelerator(id=0)` unconditionally; with no CUDA device that aborts the
    # process inside the driver rather than raising.
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    tags = ["gpu"],
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/architectures/unified_mtp_qwen3_5",
    ],
)

