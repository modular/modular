modular_cc_test(
    name = "DeviceGPUTest",
    srcs = ["DeviceGPUTest.cpp"],
    data = [
        ":mutable_buffer_gpu.mef",
        ":vector_add_gpu.mef",
    ],
    dynamic_deps = [
        "@llvm-project//llvm:LLVM",
        "//AsyncRT:RuntimeGlobals",
        "//GraphCompiler:MGPRT",
        "//MLRT:Driver/DeviceContext",
        "//Mojo:CompilerRT",
        "//Support:Globals",
        "@llvm-project//mlir:MLIR",
        "//max/lib/max_license:max",
    ],
    env = {
        "MUTATE_MEF_PATH": "$(rootpath :mutable_buffer_gpu.mef)",
        "TEST_MEF_PATH": "$(rootpath :vector_add_gpu.mef)",
    },
    # TODO(GEX-3548): ExecuteModelWithGPUTensors produces zeros instead of the
    # expected vector-add result on Apple GPU (Metal) workers and AMD MI355 GPUs.
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//:mi355_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tags = ["gpu"],
    deps = [
        ":Utils",
        "//max:CAPI.headers",
    ],
)

