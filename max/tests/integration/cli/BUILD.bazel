    # The architecture lookup materializes FLUX.2 by name at runtime.
    ignore_extra_deps = ["//max/python/max/pipelines/architectures/flux2"],
    tags = [
        "no-sandbox",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),  # FIXME: MOCO-2411
    deps = [
        "//max/python/max/_entrypoints",
        "//max/python/max/_entrypoints:pipelines",
        "//max/python/max/pipelines",
        "//max/python/max/pipelines/architectures/flux2",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/pipelines/request",
        "//max/python/max/profiler",
        "//max/tests/integration/test_common:fake_weights",
        requirement("click"),
        requirement("pillow"),
