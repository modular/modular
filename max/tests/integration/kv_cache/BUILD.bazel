    # roots, changing node IDs and preventing the recorded MEFs from matching.
    args = ["--rootdir=max/tests/integration/kv_cache"],
    exec_properties = {"test.resources:gpu-memory": "2"},
    gpu_constraints = ["//:b200_gpu"],
    precompile_mefs = True,
    tags = ["gpu"],
    deps = [
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/mimo_v2",
        "//max/tests/integration/test_common:graph_utils",
        "//max/tests/integration/test_common:simple_kv_cache",
        requirement("numpy"),
        requirement("torch"),
    ],
)

