# No kernels in the path, so unlike its neighbours this runs on Apple GPUs too.
modular_py_test(
    name = "test_chunked_staging_region_gpu",
    srcs = ["test_chunked_staging_region_gpu.py"],
    env = {
        # The HIP runtime backs pinned host allocations with movable user
        # pages unless this is set, so without it the driver_alloc cases
        # fail their startup check rather than exercising it. Harmless on
        # NVIDIA/Apple, where nothing reads this variable, and the
        # registered-path tests are unaffected either way.
        "HSA_USERPTR_FOR_PAGED_MEM": "0",
    },
    exec_properties = {
        "test.resources:gpu-memory": "2",
    },
    gpu_constraints = ["//:has_gpu"],
    tags = [
        "gpu",
    ],
    deps = [
        "//max/python/max/driver",
        requirement("numpy"),
    ],
)

