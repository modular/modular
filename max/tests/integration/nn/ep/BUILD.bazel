)

# One-launch fused EP MoE (`mega_ffn.ep_fused`) at EP4 (devices 0-3) with
# GLM-5.3's 256 routed experts (64 local), both formats: a balanced and a ragged
# cell under CUDA-graph replay and the capacity refusal.
modular_py_test(
    name = "ep_fused_megaffn_ep4_wide_tests",
    size = "large",
    srcs = _FUSED_EP4_WIDE_TESTS + ["conftest.py"],
    env = _COMMON_ENV,
    exec_properties = {
        # MAX gets 40% of (this - 0.6) GiB per GPU, torch the rest. A graph
