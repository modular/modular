        # 9.3 GiB on cuda:0 until they move to the host.
        "test.resources:gpu-memory": "35",
    },
    gpu_constraints = [
        "//:has_4_gpus",
    ],
    imports = ["."],
    mojo_deps = [
        "//max:shmem",
    ],
    tags = [
        "gpu",
        "manual",
        "requires-network",
    ],
    deps = _COMMON_DEPS + [":fused_megaffn_gates"],
)

