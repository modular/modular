load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "kvcache_tests",
    srcs = glob(
        ["*.py"],
        exclude = [
            "*_gpu.py",
            "test_mla_quantized_op_compiles.py",
        ],
    ),
    data = ["testdata/split_kv_decode_partitions.csv"],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],  # FIXME: MOCO-2411
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max:tree",
        "//max/python/max/_artifact",
        "//max/python/max/_kv_cache_ops",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/mlir",
        "//max/python/max/nn:core",
        "//max/python/max/nn/_graph_ops",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/pipelines/speculative",
        "//max/tests/integration/test_common:context_utils",
        "//max/tests/integration/test_common:mixed_step_split_ops",
        requirement("hypothesis"),
        requirement("numpy"),
        requirement("pytest-asyncio"),
    ],
)

# Compiles the quantized dense MLA op, which no Python builder emits, on a
# virtual B200. Virtual-device mode latches process-wide, so it needs its own
# target; the virtual CUDA graph needs the Linux-only NVPTX compiler.
modular_py_test(
    name = "test_mla_quantized_op_compiles",
    size = "medium",
    srcs = ["test_mla_quantized_op_compiles.py"],
    tags = [
        "skip-ci-asan",
        "skip-ci-m7g",
        "skip-ci-ubsan",
        "skip-external-ci",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn:core",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/nn/legacy",
    ],
)

modular_py_test(
    name = "kvcache_gpu_tests",
    srcs = glob(
        ["*_gpu.py"],
    ) + ["conftest.py"],
    exec_properties = {
        "test.resources:gpu-memory": "2",
    },
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],  # FIXME: MOCO-2411
        "//conditions:default": [],
    }),
    tags = [
        "gpu",
    ],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn/kv_cache",
        "//max/python/max/pipelines/kv_cache",
        "//max/tests/integration/test_common:context_utils",
        requirement("hypothesis"),
        requirement("numpy"),
    ],
)

# Mach's engine-kv tests check its split-KV partitions against this.
exports_files(
    [
        "testdata/split_kv_decode_partitions.csv",
    ],
    visibility = ["//mach:__subpackages__"],
)
