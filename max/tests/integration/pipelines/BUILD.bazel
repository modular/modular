# Builds real Module weights, so unwarmed the first eager dispatch
# cold-compiles a GC model and blows the 60s budget.
modular_eager_py_test(
    name = "test_modulev3_lora_manager",
    size = "small",
    srcs = ["test_modulev3_lora_manager.py"],
    cpu_only = True,
    env = {
        # Don't background-compile every eager graph (SDLC-4307 CI cpu/mem).
        "MAX_EAGER_EXECUTOR": "fallback-internal",
    },
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],  # FIXME: MOCO-2411
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max:tree",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/pipelines/lora",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_model_config_encoding_resolution",
    size = "medium",
    srcs = ["test_model_config_encoding_resolution.py"],
    # These are offline unit tests: a stray hub lookup for a gated repo turns
    # into a 401 instead of a cache miss. Linux CI passes HF_HUB_OFFLINE=1 for
    # the whole invocation (ci/default/test.sh); the macOS lane does not, so
    # pin it per target.
    env = {"HF_HUB_OFFLINE": "1"},
    tags = ["skip-external-ci"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/graph",
        "//max/python/max/pipelines/diffusion",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/pipelines/weights",
        "//max/tests/integration/test_common:fake_weights",
    ],
)

