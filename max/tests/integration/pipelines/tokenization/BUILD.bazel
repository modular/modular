# The prompt tokenizer is faked, so unlike test_pixel_tokenizer this needs
# neither a checkpoint nor network access, and runs on CI.
modular_py_test(
    name = "test_audio_tokenizer",
    size = "small",
    srcs = [
        "test_audio_tokenizer.py",
    ],
    env = {
        "MODULAR_PATH": ".",
    },
    # Import-bound: pulling the whole pipelines stack dominates the wall time
    # and outruns the 300s "small" budget on the shared BuildBuddy macOS
    # workers, timing out during pytest collection. Nothing here is actually
    # macOS-incompatible, so skip the CI job rather than the platform -- it
    # still runs locally on a Mac.
    tags = ["skip-ci-macos"],
    deps = [
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/pipelines/request",
        requirement("numpy"),
        requirement("pytest-asyncio"),
    ],
)

modular_py_test(
    name = "test_pixel_tokenizer",
    size = "large",
    srcs = [
        "test_pixel_tokenizer.py",
    ],
    env = {
        "MODULAR_PATH": ".",
        "MODULAR_TELEMETRY_ENABLED": "true",
    },
    env_inherit = ["HF_TOKEN"],
    # Removed in PR #85020 once `_class_name` population is fixed and these
    # deps become load-bearing at runtime.
    ignore_extra_deps = [
        "//max/python/max/pipelines/architectures",
        requirement("jinja2"),
    ],
    tags = [
        "manual",
        "no-sandbox",
        "requires-network",
    ],
    deps = [
        "//max/python/max/pipelines/architectures",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        "//max/python/max/pipelines/request",
        requirement("jinja2"),
        requirement("numpy"),
        requirement("pytest-asyncio"),
    ],
)

modular_py_test(
    name = "test_vision_tokenizer_token_ids",
    size = "medium",
    srcs = [
        "test_vision_tokenizer_token_ids.py",
    ],
    env_inherit = ["HF_TOKEN"],
    ignore_extra_deps = [
        # Runtime deps of the Hugging Face processors.
        requirement("jinja2"),
        requirement("torchvision"),
    ],
    # The BuildBuddy macOS workers have no HF_TOKEN, so the gated
    # google/gemma-3-4b-it download fails with a 401. Skip the CI job rather
    # than the platform; it still runs locally on a Mac with a token.
    tags = [
        "no-sandbox",
        "requires-network",
        "skip-ci-macos",
    ],
    deps = [
        "//max/python/max/pipelines/architectures/qwen2_5vl",
        "//max/python/max/pipelines/architectures/qwen3_5",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        requirement("jinja2"),
        requirement("numpy"),
        requirement("pytest-asyncio"),
        requirement("torchvision"),
        requirement("transformers"),
    ],
)

