load("//bazel:api.bzl", "modular_py_library", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

# Shared by the unit test targets below, so each source has one owning rule.
modular_py_library(
    name = "unit_test_helpers",
    testonly = True,
    srcs = [
        "benchmark_fakes.py",
        "conftest.py",
    ],
    # Lets tests import the shared fakes as `tests.benchmark.benchmark_fakes`.
    imports = ["../.."],
    deps = [
        "//max/python/max/benchmark:benchmark_serving_lib",
        "//max/python/max/benchmark/benchmark_shared",
        requirement("aiohttp"),
        requirement("pytest"),
        requirement("pytest-mock"),
    ],
)

# Cap the tokenizer spawn pool so unit tests don't fan out across cpu_count
# workers.
_UNIT_TEST_ENV = {"MAX_BENCHMARK_MAX_TOKENIZER_THREADS": "2"}

# TODO(MXTOOLS-443): The glob below fans out into 20 py_test targets, each
# paying a full `transformers` import. Scheduled together on a contended macOS
# worker they starve each other and time out at the 1200s cap, still inside
# pytest collection.
_NOT_ON_MACOS = select({
    "@platforms//os:macos": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

modular_py_test(
    name = "tests",
    size = "large",
    srcs = glob(
        ["*.py"],
        exclude = [
            "benchmark_fakes.py",
            "conftest.py",
            "test_benchmark_client_session.py",
            "test_benchmark_datasets.py",
            "test_benchmark_datasets_functional.py",
        ],
    ),
    env = _UNIT_TEST_ENV,
    target_compatible_with = _NOT_ON_MACOS,
    deps = [
        ":unit_test_helpers",
        "//max/python/max/benchmark:benchmark_serving_lib",
        "//max/python/max/benchmark/benchmark_shared",
        "//max/python/max/benchmark/benchmark_shared:backend_names",
        "//max/python/max/benchmark/benchmark_shared:model_csv",
        "//max/python/max/benchmark/benchmark_shared:percentile_metrics",
        "//max/python/max/profiler",
        requirement("aiohttp"),
        requirement("msgspec"),
        requirement("numpy"),
        requirement("openai"),
        requirement("pydantic"),
        requirement("pytest-asyncio"),
        requirement("pytest-mock"),
        requirement("pyyaml"),
        requirement("requests"),
        requirement("tqdm"),
        requirement("transformers"),
        requirement("uvloop"),
    ],
)

# Kept out of the glob so only this target carries the 9 MB tokenizer.
modular_py_test(
    name = "test_benchmark_datasets",
    size = "large",
    srcs = ["test_benchmark_datasets.py"],
    data = ["//max/tests/tests/serve/testdata:tokenizer.json"],
    env = _UNIT_TEST_ENV | {
        "BYTE_LEVEL_BPE_TOKENIZER_JSON": "$(rootpath //max/tests/tests/serve/testdata:tokenizer.json)",
    },
    target_compatible_with = _NOT_ON_MACOS,
    deps = [
        ":unit_test_helpers",
        "//max/python/max/benchmark/benchmark_shared",
        requirement("huggingface-hub"),
        requirement("msgspec"),
        requirement("numpy"),
        requirement("pillow"),
        requirement("transformers"),
    ],
)

modular_py_test(
    name = "test_benchmark_client_session",
    srcs = ["test_benchmark_client_session.py"],
    # Binds a loopback socket to watch one connection serve several requests.
    tags = [
        "requires-network",
    ],
    deps = [
        "//max/python/max/benchmark/benchmark_shared",
        requirement("aiohttp"),
        requirement("pytest-asyncio"),
    ],
)

modular_py_test(
    name = "test_benchmark_datasets_functional",
    srcs = ["test_benchmark_datasets_functional.py"],
    env = {
        # Cap the tokenizer spawn pool so the functional tests don't fan
        # out across cpu_count workers.
        "MAX_BENCHMARK_MAX_TOKENIZER_THREADS": "2",
    },
    tags = [
        "requires-network",
    ],
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],  # FIXME: PERF-2442
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max/benchmark/benchmark_shared",
        "//max/python/max/pipelines/lib",
        requirement("transformers"),
    ],
)
