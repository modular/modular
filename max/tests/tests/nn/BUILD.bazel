load("//bazel:api.bzl", "modular_py_test", "requirement")
load("//bazel:config.bzl", "REQUIRES_INTERNAL_KERNELS")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

_COMMON_DEPS = [
    "//max/python/max/driver",
    "//max/python/max/dtype",
    "//max/python/max/engine",
    "//max/python/max/graph",
    "//max/python/max/nn",
    requirement("numpy"),
]

modular_py_test(
    name = "cpu_tests",
    srcs = [
        "__init__.py",
        "conftest.py",
        "norm_test_utils.py",
    ] + glob(
        ["test_*.py"],
        exclude = [
            "*_gpu.py",
            "test_state_dict.py",
        ],
    ),
    per_test_tags = {
        "test_ep_config.py": ["skip-external-ci"],
        "test_module.py": ["skip-external-ci"],
    },
    per_test_target_compatible_with = {
        # Needs mega_ffn.ep_fused_init, registered only by the closed-source kernels.
        "test_ep_config.py": REQUIRES_INTERNAL_KERNELS,
    },
    deps = _COMMON_DEPS + [
        "//max/python/max:tree",
        "//max/python/max/_artifact",
        "//max/python/max/mlir",
        requirement("torch"),
    ],
)

modular_py_test(
    name = "test_state_dict",
    srcs = ["test_state_dict.py"],
    # TODO(MODELS-1494): Times out at 600s on slow macOS BuildBuddy workers.
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        requirement("numpy"),
    ],
)

modular_py_test(
    name = "test_sampling_gpu",
    timeout = "long",
    srcs = [
        "conftest.py",
        "test_sampling_gpu.py",
    ],
    gpu_constraints = ["//:has_gpu"],
    precompile_mefs = True,
    precompile_shards = 12,
    tags = ["gpu"],
    target_compatible_with = select({
        # FIXME(KERN-2604): topk kernel uses external_memory unsupported on Apple GPU
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = _COMMON_DEPS + [
        "//max/python/max/pipelines/sampling",
        "//max/python/max/support",
    ],
)
