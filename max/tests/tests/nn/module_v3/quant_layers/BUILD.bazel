load("//bazel:api.bzl", "requirement")
load("//max/tests/integration/xarch_warm:eager_py_test.bzl", "modular_eager_py_test")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_eager_py_test(
    name = "tests",
    srcs = glob(["test_*.py"]) + ["conftest.py"],
    cpu_only = True,
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/nn/legacy",
        "//max/python/max/pipelines/architectures/deepseekV3",
        "//max/python/max/pipelines/architectures/deepseekV3_2_modulev3",
        "//max/python/max/pipelines/architectures/deepseekV3_modulev3",
        requirement("numpy"),
        "//max/python/max:tree",
    ],
)
