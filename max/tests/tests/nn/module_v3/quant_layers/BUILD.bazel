load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "tests",
    srcs = glob(["test_*.py"]) + ["conftest.py"],
    # The eager Tensor ops these lazy-trace tests realize load this at
    # runtime (max._interpreter._interpreter_ops is an optional import), so it
    # has to be in the runfiles even though nothing imports it statically.
    ignore_extra_deps = ["//max/python/max/_interpreter_ops"],
    deps = [
        "//max/python/max:tensor",
        "//max/python/max/_interpreter_ops",
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/deepseekV3",
        "//max/python/max/pipelines/architectures/deepseekV3_2_modulev3",
        "//max/python/max/pipelines/architectures/deepseekV3_modulev3",
        requirement("numpy"),
        "//max/python/max:tree",
    ],
)
