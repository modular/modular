load("//bazel:api.bzl", "modular_py_library", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_library(
    name = "block_step_helpers",
    testonly = True,
    srcs = ["block_step_helpers.py"],
    imports = ["."],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/pipelines/speculative",
        "//max/tests/tests/pipelines:spec_step_stubs",
        requirement("numpy"),
    ],
)

modular_py_library(
    name = "cpu_step_session",
    testonly = True,
    srcs = ["cpu_step_session.py"],
    imports = ["."],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/engine",
        requirement("pytest"),
    ],
)

modular_py_library(
    name = "sequential_step_helpers",
    testonly = True,
    srcs = ["sequential_step_helpers.py"],
    imports = ["."],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/graph",
        "//max/python/max/nn:core",
        "//max/python/max/pipelines/speculative",
        "//max/tests/tests/pipelines:spec_step_stubs",
        requirement("numpy"),
    ],
)
