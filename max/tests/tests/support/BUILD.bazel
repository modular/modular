load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = [
    "//:__pkg__",
    "//max/tests:__subpackages__",
    "//oss/modular/max/tests:__subpackages__",
])

modular_py_test(
    name = "tests",
    srcs = glob(
        ["**/*.py"],
        exclude = ["test_host_memory.py"],
    ),
    deps = [
        "@mojo//:python",
        requirement("hypothesis"),
        requirement("ipython"),
    ],
)

# Separate from :tests, whose Mojo driver fails to load max._core's staged
# transport libraries on some hosts.
modular_py_test(
    name = "host_memory",
    srcs = ["test_host_memory.py"],
    deps = ["//max/python/max/support"],
)
