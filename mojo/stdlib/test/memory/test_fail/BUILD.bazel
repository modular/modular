load("//bazel:api.bzl", "lit_tests", "mojo_test")

package(default_visibility = ["//visibility:private"])

_MOJO_TESTS = [
    "layout_invalid_alignment_abort.mojo",
]

[
    mojo_test(
        name = src + ".test",
        srcs = [src],
        copts = [
            "--debug-level",
            "full",
        ],
        deps = [
            "@mojo//:std",
            "@mojo//:test_utils",
        ],
    )
    for src in _MOJO_TESTS
]

lit_tests(
    name = "lit_tests",
    size = "large",
    srcs = glob(["*.mojo"], exclude = _MOJO_TESTS),
    mojo_deps = [
        "@mojo//:std",
    ],
    target_compatible_with = select({
        "//:asan": ["@platforms//:incompatible"],
        "//:tsan": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
