package(default_visibility = ["//rust_kv:consumers"])

# The binding source of max._kv_core. The extension itself is declared in
# //max/python/max (`_kv_core.bindings`). This package is also the Cargo
# workspace root for the open-sourced kv-core crates (MXSERV-665), so the OSS
# crate universe reads its manifests.
filegroup(
    name = "srcs",
    srcs = glob(["src/**/*.rs"]),
)

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])
