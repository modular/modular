load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")
load("//rust_kv:test_compat.bzl", "GPU_PLATFORM")

package(default_visibility = ["//rust_kv:consumers"])

rust_library(
    name = "kv-tier-connector",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    target_compatible_with = GPU_PLATFORM,
    deps = [
        "//rust_kv/kv-core",
        "//rust_kv/max-profiler",
        "@crates//:itertools",
        "@crates//:libc",
        "@crates//:libloading",
        "@crates//:parking_lot",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rust_test(
    name = "kv-tier-connector-test",
    crate = ":kv-tier-connector",
    edition = "2024",
    target_compatible_with = GPU_PLATFORM,
)
