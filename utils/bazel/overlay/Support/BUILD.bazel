genrule(
    name = "CertificatesHeader",
    srcs = select({
        "//:ProdBuild": glob([
            "lib/Entitlements/RootCertificates/RootCert.inc.in",
            "lib/Entitlements/RootCertificates/prod/*",
        ]),
        "//:DevBuild": glob([
            "lib/Entitlements/RootCertificates/RootCert.inc.in",
            "lib/Entitlements/RootCertificates/dev/*",
        ]),
    }),
    outs = ["RootCert.inc"],
    # FIXME: This will be broken when we actually have prod certificates, this
    # logic is complex enough that we should probably do it properly and encode
    # it into a Starlark rule. It should also go in its own directory. The rule
    # to support this is quite trivial with `actions.expand_template` [1], we
    # would just need to enumerate and read the inputs properly.
    # [1] https://github.com/bazelbuild/examples/blob/main/rules/expand_template/hello.bzl
    cmd = "cert=$$(cat $$(echo $(SRCS) | tr ' ' '\\n' | grep /cert.pem) | sed -e 's/[\\&]/\\&/g' | awk '{printf \"%s\\\\n\", $$0}') && " +
          "key=$$(cat $$(echo $(SRCS) | tr ' ' '\\n' | grep /key.pem) | sed -e 's/[\\&]/\\&/g' | awk '{printf \"%s\\\\n\", $$0}') && " +
          "cat $(location lib/Entitlements/RootCertificates/RootCert.inc.in) | " +
          "sed -e \"s|@CERTIFICATE_PEM@|$${cert}|g\" | " +
          "sed -e \"s|@KEY_PEM@|$${key}|g\" | " +
          "cat > $@",
)

cc_library(
    name = "Certificates",
    hdrs = [":CertificatesHeader"],
    # FIXME: This should really be namedspace in the proper place, but now it
    # relies on being in the same directory as the entitlements code.
    include_prefix = "./",
)

