load("//bazel:api.bzl", "modular_py_binary", "modular_py_library", "pkg_files", "requirement", "strip_prefix")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "src/mblib2to3/Grammar.txt",
    "src/mblib2to3/PatternGrammar.txt",
])

modular_py_library(
    name = "mblack-lib",
    srcs = glob(
        ["src/**/*.py"],
        exclude = ["src/mblack/__main__.py"],
    ),
    data = glob(["src/**/*.txt"]),
    imports = ["src"],
    tags = ["no-mypy"],  # mypy_extensions conflicts with builtin from mypy
    deps = [
        requirement("click"),
        requirement("mypy-extensions"),
        requirement("pathspec"),
        requirement("platformdirs"),
        requirement("tomli"),
    ],
)

modular_py_binary(
    name = "mblack",
    srcs = ["src/mblack/__main__.py"],
    tags = ["no-mypy"],  # mypy_extensions conflicts with builtin from mypy
    deps = [":mblack-lib"],
)

pkg_files(
    name = "mblack_files",
    srcs = glob(["**"]),
    prefix = "mblack",
    strip_prefix = strip_prefix.from_pkg(""),
)
